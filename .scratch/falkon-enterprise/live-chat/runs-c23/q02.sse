data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-b1b9015e0c538e39","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/model/Bill.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.api.model;\n11: \n12: import java.math.BigDecimal;\n13: import java.security.AccessControlException;\n14: import java.util.ArrayList;\n15: import java.util.Collections;\n16: import java.util.HashSet;\n17: import java.util.List;\n18: import java.util.Set;\n19: \n20: import lombok.Getter;\n21: import lombok.Setter;\n22: import lombok.extern.slf4j.Slf4j;\n23: import org.openmrs.BaseOpenmrsData;\n24: import org.openmrs.Patient;\n25: import org.openmrs.Provider;\n26: import org.openmrs.Visit;\n27: import org.openmrs.api.context.Context;\n28: import org.openmrs.module.billing.api.util.PrivilegeConstants;\n29: import org.openmrs.module.stockmanagement.api.model.StockItem;\n30: \n31: /**\n32:  * Model class that represents a list of {@link BillLineItem}s and {@link Payment}s created by a\n33:  * cashier for a patient.\n34:  */\n35: @Getter\n36: @Setter\n37: @Slf4j\n38: public class Bill extends BaseOpenmrsData {\n39: \t\n40: \tprivate static final long serialVersionUID = 0L;\n41: \t\n42: \tprivate Integer billId;\n43: \t\n44: \tprivate String receiptNumber;\n45: \t\n46: \tprivate Provider cashier;\n47: \t\n48: \tprivate Patient patient;\n49: \t\n50: \tprivate CashPoint cashPoint;\n51: \t\n52: \tprivate Visit visit;\n53: \t\n54: \tprivate Bill billAdjusted;\n55: \t\n56: \tprivate BillStatus status;\n57: \t\n58: \tprivate List<BillLineItem> lineItems;\n59: \t\n60: \tprivate Set<Payment> payments;\n61: \t\n62: \tprivate Set<Bill> adjustedBy;\n63: \t\n64: \tprivate Boolean receiptPrinted = false;\n65: \t\n66: \tprivate String adjustmentReason;\n67: \t\n68: \tprivate Set<BillDiscount> discounts;\n69: \t\n70: \tprivate Set<BillRefund> refunds;\n71: \t\n72: \t/**\n73: \t * Returns every non-voided refund on this bill. Voided rows are excluded — for the full audit\n74: \t * history, query {@code BillRefundService.getRefundsByBillId} (or the equivalent REST search at\n75: \t * {@code /billRefund?bill=<uuid>}).\n76: \t */\n77: \tpublic List<BillRefund> getActiveRefunds() {\n78: \t\tif (refunds == null) {\n79: \t\t\treturn Collections.emptyList();\n80: \t\t}\n81: \t\tList<BillRefund> active = new ArrayList<>();\n82: \t\tfor (BillRefund r : refunds) {\n83: \t\t\tif (r != null && !r.getVoided()) {\n84: \t\t\t\tactive.add(r);\n85: \t\t\t}\n86: \t\t}\n87: \t\treturn active;\n88: \t}\n89: \t\n90: \t/**\n91: \t * Returns every non-voided discount on this bill (bill-level and line-item scoped). Voided rows are\n92: \t * excluded — for the full audit history, query {@code BillDiscountService.getDiscountsByBillId} (or\n93: \t * the equivalent REST search at {@code /billDiscount?bill=<uuid>}).\n94: \t */\n95: \tpublic List<BillDiscount> getActiveDiscounts() {\n96: \t\tif (discounts == null) {\n97: \t\t\treturn Collections.emptyList();\n98: \t\t}\n99: \t\tList<BillDiscount> active = new ArrayList<>();\n100: \t\tfor (BillDiscount d : discounts) {\n101: \t\t\tif (d != null && !d.getVoided()) {\n102: \t\t\t\tactive.add(d);\n103: \t\t\t}\n104: \t\t}\n105: \t\treturn active;\n106: \t}\n107: \t\n108: \t/**\n109: \t * Bill total net of every approved, non-voided discount. Pending and rejected discounts are visible\n110: \t * on the bill but do not affect the total or the status flip.\n111: \t */\n112: \tpublic BigDecimal getAmountAfterDiscount() {\n113: \t\treturn effectiveTotal().max(BigDecimal.ZERO);\n114: \t}\n115: \t\n116: \t/**\n117: \t * @return {@code true} when the sum of approved discount amounts exceeds {@link #getTotal()} —\n118: \t *         typically because a line item was voided after a FIXED_AMOUNT discount was approved.\n119: \t *         Callers (notably {@link #synchronizeBillStatus()}) should refuse to auto-flip PAID in\n120: \t *         this state so the drift surfaces for manual reconciliation.\n121: \t */\n122: \tpublic boolean hasDiscountDrift() {\n123: \t\treturn effectiveTotal().compareTo(BigDecimal.ZERO) < 0;\n124: \t}\n125: \t\n126: \tprivate BigDecimal effectiveTotal() {\n127: \t\tBigDecimal total = getTotal();\n128: \t\tif (discounts != null) {\n129: \t\t\tfor (BillDiscount d : discounts) {\n130: \t\t\t\tif (d != null && !d.getVoided() && d.getStatus() == DiscountStatus.APPROVED) {\n131: \t\t\t\t\ttotal = total.subtract(d.getDiscountAmount());\n132: \t\t\t\t}\n133: \t\t\t}\n134: \t\t}\n135: \t\treturn total;\n136: \t}\n137: \t\n138: \tpublic BigDecimal getTotal() {\n139: \t\tBigDecimal total = BigDecimal.ZERO;\n140: \t\t\n141: \t\tList<BillLineItem> lineItems = getLineItems();\n142: \t\tif (lineItems != null) {\n143: \t\t\tfor (BillLineItem line : lineItems) {\n144: \t\t\t\tif (line != null && !line.getVoided()) {\n145: \t\t\t\t\ttotal = total.add(line.getTotal());\n146: \t\t\t\t}\n147: \t\t\t}\n148: \t\t}\n149: \t\t\n150: \t\treturn total;\n151: \t}\n152: \t\n153: \tpublic BigDecimal getTotalPayments() {\n154: \t\tBigDecimal total = BigDecimal.ZERO;\n155: \t\t\n156: \t\tSet<Payment> payments = getPayments();\n157: \t\tif (payments != null) {\n158: \t\t\tfor (Payment payment : payments) {\n159: \t\t\t\tif (payment != null && !payment.getVoided()) {\n160: \t\t\t\t\ttotal = total.add(payment.getAmountTendered());\n161: \t\t\t\t}\n162: \t\t\t}\n163: \t\t}\n164: \t\t\n165: \t\treturn total;\n166: \t}\n167: \t\n168: \t@Override\n169: \tpublic Integer getId() {\n170: \t\treturn this.getBillId();\n171: \t}\n172: \t\n173: \t@Override\n174: \tpublic void setId(Integer id) {\n175: \t\tthis.setBillId(id);\n176: \t}\n177: \t\n178: \t// Custom setter - updates adjusted bill status\n179: \tpublic void setBillAdjusted(Bill billAdjusted) {\n180: \t\tthis.billAdjusted = billAdjusted;\n181: \t\t\n182: \t\tif (billAdjusted != null) {\n183: \t\t\tbillAdjusted.setStatus(BillStatus.ADJUSTED);\n184: \t\t}\n185: \t}\n186: \t\n187: \tpublic BillLineItem addLineItem(StockItem item, BigDecimal price, String priceName, int quantity) {\n188: \t\tif (item == null) {\n\n(Output capped at 5KB. Showing lines 1-188 of 338. Use offset=189 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Bill.java","name":"Bill.java","revision":"HEAD"}]}}

