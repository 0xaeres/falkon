            "\t\tProvider cashier = resolveCashier(order);",
            "\t\tif (cashier == null) {",
            "\t\t\tlog.error(\"Cannot resolve cashier for order: {}\", order.getUuid());",
            "\t\t\treturn BillingResult.skipped(\"Cannot resolve cashier\");",
            "\t\t}",
            "\t\t",
            "\t\tCashPoint cashPoint = resolveCashPoint();",
            "\t\tif (cashPoint == null) {",
            "\t\t\tlog.error(\"Cannot resolve cash point for order: {}\", order.getUuid());",
            "\t\t\treturn BillingResult.skipped(\"Cannot resolve cash point\");",
            "\t\t}",
            "\t\t",
            "\t\tBill bill = new Bill();",
            "\t\tbill.setPatient(patient);",
            "\t\tbill.setStatus(BillStatus.PENDING);",
            "\t\tbill.setCashier(cashier);",
            "\t\tbill.setCashPoint(cashPoint);",
            "\t\tif (order.getEncounter() != null) {",
            "\t\t\tbill.setVisit(order.getEncounter().getVisit());",
            "\t\t}",
