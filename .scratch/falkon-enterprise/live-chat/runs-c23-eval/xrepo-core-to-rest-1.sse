data: {"type":"tool-output-available","toolCallId":"call-b9630b63-b18d-4141-bde3-e6b9482dadd9","output":{"output":"<repo>github.com/openmrs/openmrs-module-webservices.rest</repo>\n<path>omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_9/EncounterResource1_9.java</path>\n<url>undefined</url>\n<content>\n1: /**\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.webservices.rest.web.v1_0.resource.openmrs1_9;\n11: \n12: import org.openmrs.Encounter;\n13: import org.openmrs.EncounterProvider;\n14: import org.openmrs.api.context.Context;\n15: import org.openmrs.module.webservices.rest.web.RestConstants;\n16: import org.openmrs.module.webservices.rest.web.annotation.PropertyGetter;\n17: import org.openmrs.module.webservices.rest.web.annotation.PropertySetter;\n18: import org.openmrs.module.webservices.rest.web.annotation.Resource;\n19: import org.openmrs.module.webservices.rest.web.representation.DefaultRepresentation;\n20: import org.openmrs.module.webservices.rest.web.representation.FullRepresentation;\n21: import org.openmrs.module.webservices.rest.web.representation.Representation;\n22: import org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource;\n23: import org.openmrs.module.webservices.rest.web.resource.impl.DelegatingResourceDescription;\n24: import org.openmrs.module.webservices.rest.web.response.ResourceDoesNotSupportOperationException;\n25: import org.openmrs.module.webservices.rest.web.v1_0.resource.openmrs1_8.EncounterResource1_8;\n26: \n27: import java.util.LinkedHashSet;\n28: import java.util.List;\n29: import java.util.Set;\n30: \n31: /**\n32:  * {@link Resource} for {@link EncounterResource1_9}, supporting standard CRUD operations\n33:  */\n34: @Resource(name = RestConstants.VERSION_1 + \"/encounter\", supportedClass = Encounter.class, supportedOpenmrsVersions = {\n35:         \"1.9.* - 2.1.*\" })\n36: public class EncounterResource1_9 extends EncounterResource1_8 {\n37: \t\n38: \t/**\n39: \t * @see DelegatingCrudResource#getRepresentationDescription(Representation)\n40: \t */\n41: \t@Override\n42: \tpublic DelegatingResourceDescription getRepresentationDescription(Representation rep) {\n43: \t\tif (rep instanceof DefaultRepresentation) {\n44: \t\t\tDelegatingResourceDescription description = super.getRepresentationDescription(rep);\n45: \t\t\tdescription.addProperty(\"visit\", Representation.REF);\n46: \t\t\tdescription.removeProperty(\"provider\");\n47: \t\t\tdescription.addProperty(\"encounterProviders\", Representation.REF);\n48: \t\t\treturn description;\n49: \t\t} else if (rep instanceof FullRepresentation) {\n50: \t\t\tDelegatingResourceDescription description = super.getRepresentationDescription(rep);\n51: \t\t\tdescription.addProperty(\"visit\", Representation.DEFAULT);\n52: \t\t\tdescription.removeProperty(\"provider\");\n53: \t\t\tdescription.addProperty(\"encounterProviders\", Representation.DEFAULT);\n54: \t\t\treturn description;\n55: \t\t}\n56: \t\treturn null;\n57: \t}\n58: \t\n59: \t@Override\n60: \tpublic DelegatingResourceDescription getUpdatableProperties() throws ResourceDoesNotSupportOperationException {\n61: \t\tDelegatingResourceDescription description = super.getUpdatableProperties();\n62: \t\tdescription.addProperty(\"encounterProviders\");\n63: \t\treturn description;\n64: \t}\n65: \t\n66: \t/**\n67: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.BaseDelegatingResource#getCreatableProperties()\n68: \t */\n69: \t@Override\n70: \tpublic DelegatingResourceDescription getCreatableProperties() {\n71: \t\tDelegatingResourceDescription description = super.getCreatableProperties();\n72: \t\tdescription.addProperty(\"visit\");\n73: \t\tdescription.addProperty(\"encounterProviders\");\n74: \t\treturn description;\n75: \t}\n76: \t\n77: \t@Override\n78: \tpublic Encounter save(Encounter delegate) {\n79: \t\t//This is a hack to save encounterProviders correctly. Without this they are created without encounter_id in\n80: \t\t//the database.\n81: \t\tfor (EncounterProvider ep : delegate.getEncounterProviders()) {\n82: \t\t\tep.setEncounter(delegate);\n83: \t\t}\n84: \t\tContext.getEncounterService().saveEncounter(delegate);\n85: \t\treturn delegate;\n86: \t}\n87: \t\n88: \t@PropertyGetter(\"encounterProviders\")\n89: \tpublic static Set<EncounterProvider> getActiveEncounterProviders(Encounter instance) {\n90: \t\tSet<EncounterProvider> encounterProviders = instance.getEncounterProviders();\n91: \t\tSet<EncounterProvider> providers = new LinkedHashSet<EncounterProvider>();\n92: \t\tfor (EncounterProvider encounterProvider : encounterProviders) {\n93: \t\t\tif (!encounterProvider.isVoided()) {\n94: \t\t\t\tproviders.add(encounterProvider);\n95: \t\t\t}\n96: \t\t}\n97: \t\treturn providers;\n98: \t}\n99: \n100: \t@PropertySetter(\"encounterProviders\")\n101: \tpublic void setEncounterProviders(Encounter instance, List<EncounterProvider> encounterProviders) {\n102: \t\tfor (EncounterProvider newEncounterProvider : encounterProviders) {\n103: \t\t\tboolean isProviderAlreadyPresent = false;\n104: \t\t\tfor (EncounterProvider existingProvider : instance.getEncounterProviders()) {\n105: \t\t\t\tif (existingProvider.getProvider().getUuid().equals(newEncounterProvider.getProvider().getUuid())\n106: \t\t\t\t\t\t&& existingProvider.getEncounterRole().getUuid().equals(newEncounterProvider.getEncounterRole().getUuid())) {\n107: \t\t\t\t\tisProviderAlreadyPresent = true;\n108: \t\t\t\t\tbreak;\n109: \t\t\t\t}\n110: \t\t\t}\n111: \t\t\tif (!isProviderAlreadyPresent) {\n112: \t\t\t\tinstance.getEncounterProviders().add(newEncounterProvider);\n113: \t\t\t}\n114: \t\t}\n115: \t}\n116: \t\n117: \t/**\n\n(Output capped at 5KB. Showing lines 1-117 of 126. Use offset=118 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_9/EncounterResource1_9.java","name":"EncounterResource1_9.java","revision":"HEAD"}]}}

