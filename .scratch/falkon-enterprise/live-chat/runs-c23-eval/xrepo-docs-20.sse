data: {"type":"tool-output-available","toolCallId":"call-6960febb-9723-42e1-897c-b7ccdd7f4788","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-extensions/src/render.ts</path>\n<url>undefined</url>\n<content>\n1: /** @module @category Extension */\n2: import {\n3:   mountRootParcel,\n4:   type AppProps,\n5:   type CustomProps,\n6:   type LifeCycles,\n7:   type Parcel,\n8:   type ParcelConfig,\n9:   type ParcelProps,\n10: } from 'single-spa';\n11: import { getExtensionNameFromId, getExtensionRegistration } from './extensions';\n12: import { registerExtensionRendering, unregisterExtensionRendering } from './store';\n13: \n14: export interface CancelLoading {\n15:   (): void;\n16: }\n17: \n18: type MountParcel = AppProps['mountParcel'];\n19: \n20: let parcelCount = 0;\n21: let parcelMounter: Promise<MountParcel> | null = null;\n22: \n23: type ParcelConfigObject = Extract<ParcelConfig, LifeCycles>;\n24: type LifecycleFn = Exclude<LifeCycles['mount'], readonly unknown[]>;\n25: type LifecycleName = keyof typeof lifecycleDeadlines;\n26: \n27: /** Reports how one of a parcel's lifecycles settled. */\n28: type LifecycleSettled = (which: LifecycleName, failed: boolean) => void;\n29: \n30: /** Follows the props object single-spa holds for a parcel, so it can be emptied on failure. */\n31: interface PropsTracker {\n32:   /** Reports how one of the parcel's lifecycles settled. */\n33:   onSettled: LifecycleSettled;\n34:   /** Tracks a copy of `next` in place of the props tracked so far, and returns it to pass on. */\n35:   retarget(next: Record<string, unknown>): Record<string, unknown>;\n36:   /** Empties the tracked props. */\n37:   release(): void;\n38: }\n39: \n40: /**\n41:  * How long each lifecycle gets before the parcel is marked dead. Loading and unloading are left\n42:  * out, as their timing is unpredictable. These are meant to be generous.\n43:  *\n44:  * These are enforced by {@link withDeadline} rather than through single-spa's `timeouts`, because\n45:  * `reasonableTime()` never clears the timers it schedules from that config: until one fires its\n46:  * closure retains the parcel, the `domElement` it was given and the whole subtree rendered into it.\n47:  */\n48: const lifecycleDeadlines = {\n49:   bootstrap: 15_000,\n50:   mount: 15_000,\n51:   unmount: 15_000,\n52: };\n53: \n54: /** single-spa's own test for a thenable, which is all it requires a lifecycle to return. */\n55: function isPromiseLike(value: unknown): value is Promise<unknown> {\n56:   const thenable = value as Promise<unknown> | undefined;\n57:   return typeof thenable?.then === 'function' && typeof thenable?.catch === 'function';\n58: }\n59: \n60: /**\n61:  * Collapses single-spa's \"function or array of functions\" lifecycle shape into one function that\n62:  * runs each in turn, rejecting if any of them returns something that is not a promise.\n63:  */\n64: function toSingleFn(lifecycle: LifecycleFn | Array<LifecycleFn>, name: string, which: LifecycleName): LifecycleFn {\n65:   const fns = Array.isArray(lifecycle) ? lifecycle : [lifecycle];\n66: \n67:   return (props) =>\n68:     fns.reduce<Promise<unknown>>(\n69:       (chain, fn, index) =>\n70:         chain.then(() => {\n71:           const result = fn(props);\n72: \n73:           return isPromiseLike(result)\n74:             ? result\n75:             : Promise.reject(\n76:                 new Error(\n77:                   `Lifecycle function ${which} at array index ${index} for parcel ${name} did not return a promise`,\n78:                 ),\n79:               );\n80:         }),\n81:       Promise.resolve<unknown>(undefined),\n82:     );\n83: }\n84: \n85: /**\n86:  * Empties the props object single-spa is holding for a parcel.\n87:  *\n88:  * If a parcel's `unmount()` rejects, single-spa retains it in the `SKIP_BECAUSE_BROKEN` state,\n89:  * including holding on to the props, which can include the DOM node if it was successfully\n90:  * mounted. Since we hand single-spa the props, we can clear that object here which helps reduce\n91:  * the memory pressure of the retained parcels\n92:  */\n93: function releaseProps(props: Record<string, unknown>) {\n94:   for (const key of Object.keys(props)) {\n95:     delete props[key];\n96:   }\n97: }\n98: \n99: /**\n100:  * Watches a parcel's lifecycles and releases its props once single-spa has no further use for them,\n101:  * which is only ever after a failure: a parcel that unmounts cleanly is dropped by single-spa\n102:  * itself, taking its props with it.\n103:  *\n104:  * The timing matters, because single-spa keeps calling lifecycles past the failure that broke the\n105:  * parcel and they are handed these same props.\n106:  *\n107:  * Which object gets released moves over the parcel's life, since `update()` replaces the props\n108:  * single-spa holds rather than merging into them. See {@link trackUpdates}.\n109:  *\n110:  * @param props The object single-spa was mounted with, which must not be the caller's own\n111:  */\n112: function trackProps(props: Record<string, unknown>): PropsTracker {\n113:   let tracked = props;\n114:   let mountFailed = false;\n115:   const release = () => releaseProps(tracked);\n116: \n117:   return {\n118:     retarget(next) {\n119:       tracked = { ...next };\n120: \n121:       return tracked;\n122:     },\n123:     release,\n124:     onSettled(which, failed) {\n125:       switch (which) {\n126:         case 'bootstrap':\n127:           // single-spa breaks the parcel there and then, without calling anything else.\n128:           if (failed) {\n129:             release();\n130:           }\n131: \n132:           return;\n133:         case 'mount':\n134:           // A parcel whose mount fails is unmounted before it is broken, so that the extension gets\n135:           // to tear down whatever it managed to render. The release waits for that unmount.\n136:           mountFailed ||= failed;\n137: \n138:           return;\n139:         case 'unmount':\n140:           if (failed || mountFailed) {\n141:             release();\n142:           }\n143: \n144:           return;\n\n(Output capped at 5KB. Showing lines 1-144 of 483. Use offset=145 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-extensions/src/render.ts","name":"render.ts","revision":"HEAD"}]}}

