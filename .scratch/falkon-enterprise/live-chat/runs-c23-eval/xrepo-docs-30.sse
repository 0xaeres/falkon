data: {"type":"tool-output-available","toolCallId":"call-75515065-0a51-4522-9db3-da3553840148","output":{"output":"/\n  .github/\n    workflows/\n  app/\n    _dictionaries/\n    [lang]/\n  components/\n    adaptive-logo.jsx\n    api-docs.jsx\n    head.jsx\n    latest-release.jsx\n    nav-logo.jsx\n    path-cards.jsx\n    use-locales-map.js\n  content/\n    en-US/\n    fr-FR/\n  patches/\n    nextra-theme-docs@4.6.1.patch\n  public/\n    android-icon-144x144.png\n    android-icon-192x192.png\n    android-icon-36x36.png\n    android-icon-48x48.png\n    android-icon-72x72.png\n    android-icon-96x96.png\n    app-menu-items-hover.png\n    app-menu-items.png\n    apple-icon-114x114.png\n    apple-icon-120x120.png\n    apple-icon-144x144.png\n    apple-icon-152x152.png\n    apple-icon-180x180.png\n    apple-icon-57x57.png\n    apple-icon-60x60.png\n    apple-icon-72x72.png\n    apple-icon-76x76.png\n    apple-icon-precomposed.png\n    apple-icon.png\n    browserconfig.xml\n    button.png\n    CNAME\n    favicon-16x16.png\n    favicon-32x32.png\n    favicon-96x96.png\n    favicon.ico\n    feature-flag.png\n    left-panel-home.png\n    logo-dark.svg\n    logo-light.svg\n    manifest.json\n    ms-icon-144x144.png\n    ms-icon-150x150.png\n    ms-icon-310x310.png\n    ms-icon-70x70.png\n    named-export-error.png\n    nav-logo.svg\n    navbar.png\n    o3-architecture.svg\n    patient-lists-app.png\n    release-workflow.jpeg\n    siderail-icon.png\n    ward-allocation.png\n    ward-page.png\n    widget-title-underline-color.png\n  scripts/\n    fixtures/\n    check-forms-doc-ownership.mjs\n    check-forms-doc-ownership.test.mjs\n    fetch-releases.mjs\n    post-export.mjs\n    remark-localize-links.mjs\n  translations/\n    text.js\n  .gitignore\n  .npmrc\n  .nvmrc\n  LICENSE\n  mdx-components.js\n  next-env.d.ts\n  next.config.mjs\n  package.json\n  pnpm-lock.yaml\n  pnpm-workspace.yaml\n  postcss.config.js\n  README.md\n  styles.css\n  tsconfig.json","sources":[{"type":"file