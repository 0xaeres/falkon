data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-core","path":"api/src/main/java/org/openmrs/api/impl/EncounterServiceImpl.java","name":"EncounterServiceImpl.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-ea6876c8-3cf6-4036-8243-6dc764cfa3be","output":{"output":"<repo>github.com/openmrs/openmrs-core</repo>\n<path>api/src/main/java/org/openmrs/api/impl/EncounterServiceImpl.java</path>\n<url>undefined</url>\n<content>\n159: \t\t\t\t// encounter, fix it\n160: \t\t\t\tif (!obs.getPerson().getPersonId().equals(p.getPatientId())) {\n161: \t\t\t\t\tobs.setPerson(p);\n162: \t\t\t\t}\n163: \t\t\t}\n164: \t\t}\n165: \t\t// same goes for Orders\n166: \t\tfor (Order o : encounter.getOrders()) {\n167: \t\t\tif (!p.equals(o.getPatient())) {\n168: \t\t\t\to.setPatient(p);\n169: \t\t\t}\n170: \t\t}\n171: \n172: \t\t// do the actual saving to the database\n173: \t\tdao.saveEncounter(encounter);\n174: \n175: \t\t// save the new orderGroups\n176: \t\tfor (OrderGroup orderGroup : encounter.getOrderGroups()) {\n177: \t\t\tContext.getOrderService().saveOrderGroup(orderGroup);\n178: \t\t}\n179: \t\t//save the new orders which do not have order groups\n180: \t\tfor (Order o : encounter.getOrdersWithoutOrderGroups()) {\n181: \t\t\tif (o.getOrderId() == null) {\n182: \t\t\t\tContext.getOrderService().saveOrder(o, null);\n183: \t\t\t} else {\n184: \t\t\t\t// Since orders are only saved via the OrderService if they are new,\n185: \t\t\t\t// we need to explicitly re-validate any existing orders\n186: \t\t\t\tValidateUtil.validate(o);\n187: \t\t\t}\n188: \t\t}\n189: \n190: \t\t// save the Obs\n191: \t\tString changeMessage = Context.getMessageSourceService().getMessage(\"Obs.void.reason.default\");\n192: \t\tObsService os = Context.getObsService();\n193: \t\tList<Obs> obsToRemove = new ArrayList<>();\n194: \t\tList<Obs> obsToAdd = new ArrayList<>();\n195: \t\tfor (Obs o : encounter.getObsAtTopLevel(true)) {\n196: \t\t\tif (o.getId() == null) {\n197: \t\t\t\tos.saveObs(o, null);\n198: \t\t\t} else {\n199: \t\t\t\tObs newObs = os.saveObs(o, changeMessage);\n200: \t\t\t\t//The logic in saveObs evicts the old obs instance, so we need to update the collection\n201: \t\t\t\t//with the newly loaded and voided instance, apparently reloading the encounter\n202: \t\t\t\t//didn't do the tick\n203: \t\t\t\tobsToRemove.add(o);\n204: \t\t\t\tobsToAdd.add(os.getObs(o.getId()));\n205: \t\t\t\tobsToAdd.add(newObs);\n206: \t\t\t}\n207: \t\t}\n208: \n209: \t\tremoveGivenObsAndTheirGroupMembersFromEncounter(obsToRemove, encounter);\n210: \t\taddGivenObsAndTheirGroupMembersToEncounter(obsToAdd, encounter);\n211: \n212: \t\t// save the conditions\n213: \t\tencounter.getConditions().forEach(Context.getConditionService()::saveCondition);\n214: \n215: \t\t// save the allergies\n216: \t\tencounter.getAllergies().forEach(Context.getPatientService()::saveAllergy);\n217: \n218: \t\t// save the diagnoses\n219: \t\tencounter.getDiagnoses().stream().forEach(diagnosis -> {\n220: \t\t\tdiagnosis.setPatient(p);\n221: \t\t\tdiagnosis.setEncounter(encounter);\n222: \t\t});\n223: \t\tencounter.getDiagnoses().forEach(Context.getDiagnosisService()::save);\n224: \n225: \t\treturn encounter;\n226: \t}\n227: \n228: \t/**\n\n(Showing lines 159-228 of 1032. Use offset=229 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-core","path":"api/src/main/java/org/openmrs/api/impl/EncounterServiceImpl.java","name":"EncounterServiceImpl.java","revision":"HEAD"}]}}

