data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-core","path":"api/src/main/java/org/openmrs/api/impl/EncounterServiceImpl.java","name":"EncounterServiceImpl.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-e481fe76-061a-49f1-922e-edd4017cc89c","output":{"output":"<repo>github.com/openmrs/openmrs-core</repo>\n<path>api/src/main/java/org/openmrs/api/impl/EncounterServiceImpl.java</path>\n<url>undefined</url>\n<content>\n80: \t\tthis.dao = dao;\n81: \t}\n82: \n83: \t/**\n84: \t * @see org.openmrs.api.EncounterService#getEncountersByPatient(java.lang.String, boolean)\n85: \t */\n86: \t@Override\n87: \t@Transactional(readOnly = true)\n88: \tpublic List<Encounter> getEncountersByPatient(String query, boolean includeVoided) throws APIException {\n89: \t\tif (query == null) {\n90: \t\t\tthrow new IllegalArgumentException(\"The 'query' parameter is required and cannot be null\");\n91: \t\t}\n92: \n93: \t\treturn Context.getEncounterService()\n94: \t\t        .filterEncountersByViewPermissions(dao.getEncounters(query, null, null, null, includeVoided), null);\n95: \t}\n96: \n97: \t/**\n98: \t * @see org.openmrs.api.EncounterService#saveEncounter(org.openmrs.Encounter)\n99: \t */\n100: \t@Override\n101: \tpublic Encounter saveEncounter(Encounter encounter) throws APIException {\n102: \n103: \t\t// if authenticated user is not supposed to edit encounter of certain type\n104: \t\tfailIfDeniedToEdit(encounter);\n105: \n106: \t\t//If new encounter, try to assign a visit using the registered visit assignment handler.\n107: \t\tcreateVisitForNewEncounter(encounter);\n108: \n109: \t\t// check permissions\n110: \t\tboolean isNewEncounter = requirePrivilege(encounter);\n111: \n112: \t\t// This must be done after setting dateCreated etc on the obs because\n113: \t\t// of the way the ORM tools flush things and check for nullity\n114: \t\t// This also must be done before the save encounter so we can use the\n115: \t\t// orig date\n116: \t\t// after the save\n117: \t\tPatient p = encounter.getPatient();\n118: \t\tDate originalDate;\n119: \t\tLocation originalLocation = null;\n120: \n121: \t\tif (!isNewEncounter) {\n122: \t\t\t// fetch the datetime from the database prior to saving for this\n123: \t\t\t// encounter\n124: \t\t\t// to see if it has changed and change all obs after saving if so\n125: \t\t\toriginalDate = dao.getSavedEncounterDatetime(encounter);\n126: \t\t\tif (encounter.getLocation() != null) {\n127: \t\t\t\toriginalLocation = dao.getSavedEncounterLocation(encounter);\n128: \t\t\t}\n129: \t\t\t// Our data model duplicates the patient column to allow for\n130: \t\t\t// observations to\n131: \t\t\t// not have to look up the parent Encounter to find the patient\n132: \t\t\t// Therefore, encounter.patient must always equal\n133: \t\t\t// encounter.observations[0-n].patient\n134: \n135: \t\t\t// If we are changing encounter.encounterDatetime, then we need to\n136: \t\t\t// also apply that\n137: \t\t\t// to Obs that inherited their obsDatetime from the encounter in the\n138: \t\t\t// first place\n139: \n140: \t\t\tDate newDate = encounter.getEncounterDatetime();\n141: \t\t\tLocation newLocation = encounter.getLocation();\n142: \t\t\tfor (Obs obs : encounter.getAllFlattenedObs(true)) {\n143: \t\t\t\t// if the date was changed\n144: \t\t\t\tif (OpenmrsUtil.compare(originalDate, newDate) != 0\n145: \t\t\t\t        && OpenmrsUtil.compare(obs.getObsDatetime(), originalDate) == 0) {\n146: \n147: \t\t\t\t\t// if the obs datetime is the same as the\n148: \t\t\t\t\t// original encounter datetime, fix it\n149: \t\t\t\t\tobs.setObsDatetime(newDate);\n150: \n151: \t\t\t\t}\n152: \n153: \t\t\t\tif (!OpenmrsUtil.nullSafeEquals(newLocation, originalLocation)\n154: \t\t\t\t        && obs.getLocation().equals(originalLocation)) {\n155: \t\t\t\t\tobs.setLocation(newLocation);\n156: \t\t\t\t}\n157: \n158: \t\t\t\t// if the Person in the obs doesn't match the Patient in the\n159: \t\t\t\t// encounter, fix it\n\n(Showing lines 80-159 of 1032. Use offset=160 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-core","path":"api/src/main/java/org/openmrs/api/impl/EncounterServiceImpl.java","name":"EncounterServiceImpl.java","revision":"HEAD"}]}}

