data: {"type":"text-delta","id":"txt-0","delta":" — `BillValidator.validateNewPaymentsHaveCash"}

data: {"type":"text-delta","id":"txt-0","delta":"ier` rejects the save with `b"}

data: {"type":"text-delta","id":"txt-0","delta":"illing.error.paymentCashierRequired` if a new"}

data: {"type":"text-delta","id":"txt-0","delta":", non-voided payment still has no cashier"}

data: {"type":"text-delta","id":"txt-0","delta":" @file:{github.com/openmrs"}

