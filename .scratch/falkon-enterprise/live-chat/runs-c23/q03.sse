data: {"type":"data-evidence","data":{"id":35,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/impl/ItemPriceServiceImpl.java","revision":"HEAD","startLine":63,"code":["\t\treturn null;","\t}","\t","\t@Override","\tpublic List<CashierItemPrice> getItemPrice(StockItem stockItem) {","\t\t// Criteria criteria = getRepository().createCriteria(getEntityClass());","\t\tCriteria criteria = getRepository().createCriteria(CashierItemPrice.class);","\t\t","\t\tcriteria.add(Restrictions.eq(\"item\", stockItem));","\t\tcriteria.addOrder(Order.desc(\"id\"));","\t\t","\t\t// List<ItemPrice> results = getRepository().select(getEntityClass(), criteria);","\t\t// return(results);","\t\treturn criteria.list();","\t}","\t","\t@Override","\tpublic List<CashierItemPrice> getServicePrice(BillableService billableService) {"],"highlightedLines":[66,67,68,69,70,71,72,73,74,75,76,77]}}

