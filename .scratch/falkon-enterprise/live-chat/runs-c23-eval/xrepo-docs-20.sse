data: {"type":"tool-output-available","toolCallId":"call-e6c18832-32a4-45b6-ac68-4abc9d0e7d96","output":{"output":"Found 6 matches in 3 files\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-routes/src/loaders/load-lifecycles.ts:\n  35: export async function loadLifeCycles(routesAppName: string, fullComponentName: string): Promise<LifeCycles> {\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-routes/src/loaders/pages.ts:\n  22: import { loadLifeCycles } from './load-lifecycles';\n  238:   const loader = () => loadLifeCycles(page.appName, page.component);\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-routes/src/loaders/components.ts:\n  18: import { loadLifeCycles } from './load-lifecycles';\n  58:     load: () => loadLifeCycles(appName, extension.component),\n  102:     load: () => loadLifeCycles(appName, modal.component),","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-routes/src/loaders/load-lifecycles.ts","name":"load-lifecycles.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-routes/src/loaders/pages.ts","name":"pages.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-routes/src/loaders/components.ts","name":"components.ts","revision":"HEAD"}]}}

