{
  // Sourcebot v3 config format (https://docs.sourcebot.dev/docs/configuration/config-file); comments allowed.
  "$schema": "https://raw.githubusercontent.com/sourcebot-dev/sourcebot/main/schemas/v3/index.json",
  "settings": {
    "reindexIntervalMs": 3600000,
    "resyncConnectionIntervalMs": 86400000
  },
  "connections": {
    "github": {
      "type": "github",
      "token": { "env": "GITHUB_TOKEN" },
      "repos": ["sourcebot-dev/sourcebot"],
      "orgs": [],
      "exclude": { "forks": true, "archived": true }
    },
    "hello": { "type": "git", "url": "https://github.com/octocat/Hello-World.git" },
    "local": { "type": "git", "url": "file:///absolute/path/to/repos/*" }
  },
  "contexts": {
    "web": { "include": ["github.com/sourcebot-dev/*"], "description": "Web repos" }
  },
  // Clone-only: generated architecture docs (on by default; needs LLM_* env vars, skipped without them).
  "knowledgeBase": {
    "enabled": true,
    "repos": "all",
    "scanMode": "delta",
    "refreshIntervalHours": 24,
    "tokenBudget": 2000000,
    "parallelism": 4,
    "citeRepos": [],
    "models": {}
  }
}
