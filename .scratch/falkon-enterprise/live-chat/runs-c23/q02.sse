data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-88cb12860f0ba1b1","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillResource.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.web.rest.resource;\n11: \n12: import java.util.ArrayList;\n13: import java.util.Arrays;\n14: import java.util.Date;\n15: import java.util.HashSet;\n16: import java.util.List;\n17: import java.util.Locale;\n18: import java.util.Set;\n19: import java.util.stream.Collectors;\n20: \n21: import lombok.extern.slf4j.Slf4j;\n22: import org.apache.commons.lang3.StringUtils;\n23: import org.openmrs.Provider;\n24: import org.openmrs.Visit;\n25: import org.openmrs.api.AdministrationService;\n26: import org.openmrs.api.context.Context;\n27: import org.openmrs.module.billing.api.base.ProviderUtil;\n28: import org.openmrs.module.billing.ModuleSettings;\n29: import org.openmrs.module.billing.api.BillService;\n30: import org.openmrs.module.billing.api.ITimesheetService;\n31: import org.openmrs.module.billing.api.base.PagingInfo;\n32: import org.openmrs.module.billing.api.model.Bill;\n33: import org.openmrs.module.billing.api.model.BillDiscount;\n34: import org.openmrs.module.billing.api.model.BillLineItem;\n35: import org.openmrs.module.billing.api.model.BillRefund;\n36: import org.openmrs.module.billing.api.model.BillStatus;\n37: import org.openmrs.module.billing.api.model.CashPoint;\n38: import org.openmrs.module.billing.api.model.DiscountStatus;\n39: import org.openmrs.module.billing.api.model.Payment;\n40: import org.openmrs.module.billing.api.model.RefundStatus;\n41: import org.openmrs.module.billing.api.model.Timesheet;\n42: import org.openmrs.module.billing.api.search.BillSearch;\n43: import org.openmrs.module.billing.api.util.PrivilegeConstants;\n44: import org.openmrs.module.billing.api.util.RoundingUtil;\n45: import org.openmrs.module.billing.web.base.resource.BaseRestDataResource;\n46: import org.openmrs.module.billing.web.base.resource.PagingUtil;\n47: import org.openmrs.module.billing.web.rest.controller.base.CashierResourceController;\n48: import org.openmrs.module.webservices.rest.web.RequestContext;\n49: import org.openmrs.module.webservices.rest.web.ConversionUtil;\n50: import org.openmrs.module.webservices.rest.web.RestConstants;\n51: import org.openmrs.module.webservices.rest.web.annotation.PropertyGetter;\n52: import org.openmrs.module.webservices.rest.web.annotation.PropertySetter;\n53: import org.openmrs.module.webservices.rest.web.annotation.Resource;\n54: import org.openmrs.module.webservices.rest.web.representation.DefaultRepresentation;\n55: import org.openmrs.module.webservices.rest.web.representation.FullRepresentation;\n56: import org.openmrs.module.webservices.rest.web.representation.Representation;\n57: import org.openmrs.module.webservices.rest.web.resource.impl.AlreadyPaged;\n58: import org.openmrs.module.webservices.rest.web.resource.impl.DataDelegatingCrudResource;\n59: import org.openmrs.module.webservices.rest.web.resource.impl.DelegatingResourceDescription;\n60: import org.openmrs.module.webservices.rest.web.response.ConversionException;\n61: import org.openmrs.module.webservices.rest.web.response.InvalidSearchException;\n62: import org.openmrs.module.webservices.rest.web.response.ResponseException;\n63: import org.springframework.web.client.RestClientException;\n64: \n65: /**\n66:  * REST resource representing a {@link Bill}.\n67:  */\n68: @Slf4j\n69: @Resource(name = RestConstants.VERSION_1 + CashierResourceController.BILLING_NAMESPACE\n70:         + \"/bill\", supportedClass = Bill.class, supportedOpenmrsVersions = { \"2.0 - 2.*\" })\n71: public class BillResource extends DataDelegatingCrudResource<Bill> {\n72: \t\n73: \t@Override\n74: \tpublic DelegatingResourceDescription getRepresentationDescription(Representation rep) {\n75: \t\tif (rep instanceof DefaultRepresentation || rep instanceof FullRepresentation) {\n76: \t\t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n77: \t\t\tdescription.addProperty(\"adjustedBy\", Representation.REF);\n78: \t\t\tdescription.addProperty(\"billAdjusted\", Representation.REF);\n79: \t\t\tdescription.addProperty(\"cashPoint\", Representation.REF);\n80: \t\t\tdescription.addProperty(\"visit\", Representation.REF);\n81: \t\t\tdescription.addProperty(\"cashier\", Representation.REF);\n82: \t\t\tdescription.addProperty(\"dateCreated\");\n83: \t\t\tdescription.addProperty(\"lineItems\");\n84: \t\t\tdescription.addProperty(\"patient\", Representation.REF);\n85: \t\t\tdescription.addProperty(\"payments\", Representation.FULL);\n86: \t\t\tdescription.addProperty(\"receiptNumber\");\n87: \t\t\tdescription.addProperty(\"status\");\n88: \t\t\tdescription.addProperty(\"adjustmentReason\");\n89: \t\t\tdescription.addProperty(\"discounts\", Representation.DEFAULT);\n90: \t\t\tdescription.addProperty(\"refunds\", Representation.DEFAULT);\n91: \t\t\tdescription.addProperty(\"total\");\n92: \t\t\tdescription.addProperty(\"amountAfterDiscount\");\n93: \t\t\tdescription.addProperty(\"uuid\");\n94: \t\t\treturn description;\n95: \t\t}\n96: \t\treturn null;\n97: \t}\n98: \t\n99: \t@Override\n100: \tpublic DelegatingResourceDescription getCreatableProperties() {\n101: \t\t// Discounts are deliberately excluded — they go through BillDiscountResource so the\n\n(Output capped at 5KB. Showing lines 1-101 of 429. Use offset=102 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillResource.java","name":"BillResource.java","revision":"HEAD"}]}}

