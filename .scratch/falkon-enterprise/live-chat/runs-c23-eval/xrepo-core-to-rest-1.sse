data: {"type":"tool-output-available","toolCallId":"call-bd497fe7-741f-4f94-a074-224c0afd5f9d","output":{"output":"<repo>github.com/openmrs/openmrs-module-webservices.rest</repo>\n<path>omod-common/src/main/java/org/openmrs/module/webservices/rest/web/resource/impl/DelegatingCrudResource.java</path>\n<url>undefined</url>\n<content>\n60: \t\n61: \t/**\n62: \t * Default implementation that returns REF, DEFAULT, and FULL\n63: \t * \n64: \t * @see org.openmrs.module.webservices.rest.web.resource.api.Retrievable#getAvailableRepresentations()\n65: \t */\n66: \t@Override\n67: \tpublic List<Representation> getAvailableRepresentations() {\n68: \t\treturn Arrays.asList(Representation.DEFAULT, Representation.FULL, Representation.REF);\n69: \t}\n70: \t\n71: \t/**\n72: \t * @see org.openmrs.module.webservices.rest.web.resource.api.Creatable#create(org.springframework.web.context.request.WebRequest)\n73: \t */\n74: \t@Override\n75: \tpublic Object create(SimpleObject propertiesToCreate, RequestContext context) throws ResponseException {\n76: \t\tT delegate = convert(propertiesToCreate);\n77: \t\tdelegate = save(delegate);\n78: \t\tSimpleObject ret = (SimpleObject) ConversionUtil.convertToRepresentation(delegate, context.getRepresentation());\n79: \t\t\n80: \t\t// add the 'type' discriminator if we support subclasses\n81: \t\tif (hasTypesDefined()) {\n82: \t\t\tret.add(RestConstants.PROPERTY_FOR_TYPE, getTypeName(delegate));\n83: \t\t}\n84: \t\t\n85: \t\treturn ret;\n86: \t}\n87: \t\n88: \tpublic T convert(SimpleObject propertiesToCreate) {\n89: \t\tDelegatingResourceHandler<? extends T> handler;\n90: \t\tif (hasTypesDefined()) {\n91: \t\t\tString type = (String) propertiesToCreate.remove(RestConstants.PROPERTY_FOR_TYPE);\n92: \t\t\tif (type == null)\n93: \t\t\t\tthrow new IllegalArgumentException(\n94: \t\t\t\t        \"When creating a resource that supports subclasses, you must indicate the particular subclass with a \"\n95: \t\t\t\t                + RestConstants.PROPERTY_FOR_TYPE + \" property\");\n96: \t\t\thandler = getResourceHandler(type);\n97: \t\t} else {\n98: \t\t\thandler = this;\n99: \t\t}\n100: \n101: \t\tT delegate = handler.newDelegate(propertiesToCreate);\n102: \t\tDelegatingResourceDescription description = buildCreatableProperties(delegate, handler, propertiesToCreate);\n103: \t\tsetConvertedProperties(delegate, propertiesToCreate, description, true);\n104: \t\treturn delegate;\n105: \t}\n106: \t\n107: \t/**\n108: \t * @see org.openmrs.module.webservices.rest.web.resource.api.Updatable#update(java.lang.String,\n109: \t *      org.openmrs.module.webservices.rest.SimpleObject)\n110: \t */\n111: \t@Override\n112: \tpublic Object update(String uuid, SimpleObject propertiesToUpdate, RequestContext context) throws ResponseException {\n113: \t\tT delegate = getByUniqueId(uuid);\n114: \t\tif (delegate == null)\n115: \t\t\tthrow new ObjectNotFoundException();\n116: \t\t\n117: \t\tif (hasTypesDefined() && propertiesToUpdate.containsKey(RestConstants.PROPERTY_FOR_TYPE)) {\n118: \t\t\t// if they specify a type discriminator it must match the expected one--type can't be modified\n119: \t\t\tString type = (String) propertiesToUpdate.remove(RestConstants.PROPERTY_FOR_TYPE);\n120: \t\t\tif (!delegate.getClass().equals(getActualSubclass(type))) {\n121: \t\t\t\tString nameToShow = getTypeName(delegate);\n122: \t\t\t\tif (nameToShow == null)\n123: \t\t\t\t\tnameToShow = delegate.getClass().getName();\n124: \t\t\t\tthrow new IllegalArgumentException(\"You passed \" + RestConstants.PROPERTY_FOR_TYPE + \"=\" + type\n125: \t\t\t\t        + \" but this instance is a \" + nameToShow);\n126: \t\t\t}\n127: \t\t}\n128: \t\t\n129: \t\tDelegatingResourceHandler<? extends T> handler = getResourceHandler(delegate);\n130: \t\t\n131: \t\tDelegatingResourceDescription description = handler.getUpdatableProperties();\n132: \t\tif (isRetirable()) {\n133: \t\t\tdescription.addProperty(\"retired\");\n134: \t\t} else if (isVoidable()) {\n135: \t\t\tdescription.addProperty(\"voided\");\n136: \t\t}\n137: \t\t\n138: \t\tsetConvertedProperties(delegate, propertiesToUpdate, description, false);\n139: \t\tdelegate = save(delegate);\n140: \t\t\n141: \t\tSimpleObject ret = (SimpleObject) ConversionUtil.convertToRepresentation(delegate, context.getRepresentation());\n142: \t\t\n143: \t\t// add the 'type' discriminator if we support subclasses\n144: \t\tif (hasTypesDefined()) {\n145: \t\t\tret.add(RestConstants.PROPERTY_FOR_TYPE, getTypeName(delegate));\n146: \t\t}\n147: \t\t\n148: \t\treturn ret;\n149: \t}\n\n(Showing lines 60-149 of 316. Use offset=150 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod-common/src/main/java/org/openmrs/module/webservices/rest/web/resource/impl/DelegatingCrudResource.java","name":"DelegatingCrudResource.java","revision":"HEAD"}]}}

