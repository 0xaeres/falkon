DATABASE_URL=postgresql://sbc:sbc@localhost:5432/sbc
REDIS_URL=redis://localhost:6379
DATA_DIR=./data
ZOEKT_URL=http://localhost:6070
CONFIG_PATH=./config.json
# Optional: require `Authorization: Bearer <key>` on /api/*
SOURCEBOT_API_KEY=
# Ask agent: any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Tokens referenced from config.json as { "env": "GITHUB_TOKEN" }
GITHUB_TOKEN=
# Optional: JSON file of per-key scopes, {"keys":[{"name":"o3","sha256":"<hex sha256 of the key>","repos":["github.com/openmrs/*"]}]}
# Repo entries are exact names or a trailing-* prefix; "*" allows all. With ACCESS_FILE set, only listed keys
# (and SOURCEBOT_API_KEY, which keeps full access) are accepted. With neither set, the API is open.
ACCESS_FILE=
