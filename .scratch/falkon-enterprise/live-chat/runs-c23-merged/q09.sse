data: {"type":"tool-output-available","toolCallId":"call-4d0e5a31-d41f-46f0-87ba-30d97cf344d6","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/model/Payment.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.api.model;\n11: \n12: import java.math.BigDecimal;\n13: \n14: import lombok.AllArgsConstructor;\n15: import lombok.Builder;\n16: import lombok.Getter;\n17: import lombok.NoArgsConstructor;\n18: import lombok.Setter;\n19: \n20: import org.openmrs.Provider;\n21: import org.openmrs.module.billing.api.base.entity.model.BaseInstanceCustomizableData;\n22: \n23: /**\n24:  * Model class that represents the {@link Bill} payment information.\n25:  */\n26: @Builder\n27: @NoArgsConstructor\n28: @AllArgsConstructor\n29: public class Payment extends BaseInstanceCustomizableData<PaymentMode, PaymentAttribute> {\n30: \t\n31: \tprivate static final long serialVersionUID = 0L;\n32: \t\n33: \tprivate Integer paymentId;\n34: \t\n35: \t@Getter\n36: \t@Setter\n37: \tprivate Bill bill;\n38: \t\n39: \t@Getter\n40: \t@Setter\n41: \tprivate BigDecimal amount;\n42: \t\n43: \t@Getter\n44: \t@Setter\n45: \tprivate BigDecimal amountTendered;\n46: \t\n47: \t@Getter\n48: \t@Setter\n49: \tprivate Provider cashier;\n50: \t\n51: \tpublic Integer getId() {\n52: \t\treturn paymentId;\n53: \t}\n54: \t\n55: \tpublic void setId(Integer id) {\n56: \t\tpaymentId = id;\n57: \t}\n58: \t\n59: \tpublic PaymentAttribute addAttribute(PaymentModeAttributeType type, String value) {\n60: \t\tif (type == null) {\n61: \t\t\tthrow new NullPointerException(\"The payment mode attribute type must be defined.\");\n62: \t\t}\n63: \t\tif (value == null) {\n64: \t\t\tthrow new NullPointerException((\"The payment attribute value must be defined.\"));\n65: \t\t}\n66: \t\t\n67: \t\tPaymentAttribute attribute = new PaymentAttribute();\n68: \t\tattribute.setAttributeType(type);\n69: \t\tattribute.setValue(value);\n70: \t\t\n71: \t\taddAttribute(attribute);\n72: \t\t\n73: \t\treturn attribute;\n74: \t}\n75: }\n76: \n\n(End of file - 76 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Payment.java","name":"Payment.java","revision":"HEAD"}]}}

