data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-banner-app/src/banner-tags/visit-tag.extension.tsx","name":"visit-tag.extension.tsx","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-037fd475-f684-4996-bc08-2466aedd8b03","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-banner-app/src/banner-tags/visit-tag.extension.tsx</path>\n<url>undefined</url>\n<content>\n1: import React from 'react';\n2: import { useTranslation } from 'react-i18next';\n3: import { Tag, Toggletip, ToggletipButton, ToggletipContent } from '@carbon/react';\n4: import { type Visit, formatDatetime, parseDate, useVisit } from '@openmrs/esm-framework';\n5: import { usePatientChartStore } from '@openmrs/esm-patient-common-lib';\n6: import styles from './visit-tag.scss';\n7: \n8: interface VisitTagProps {\n9:   patientUuid: string;\n10:   patient: fhir.Patient;\n11: }\n12: \n13: function VisitTag({ patientUuid, patient }: VisitTagProps) {\n14:   const { activeVisit, isLoading } = useVisit(patientUuid);\n15:   const { visitContext } = usePatientChartStore(patientUuid);\n16:   const isNotDeceased = !patient?.deceasedDateTime;\n17:   const isPastVisitContext = Boolean(visitContext && visitContext.stopDatetime);\n18:   return !isLoading && activeVisit && isNotDeceased && !isPastVisitContext ? (\n19:     <ActiveVisitTag activeVisit={activeVisit} />\n20:   ) : null;\n21: }\n22: \n23: interface ActiveVisitTagProps {\n24:   activeVisit: Visit;\n25: }\n26: \n27: const ActiveVisitTag: React.FC<ActiveVisitTagProps> = ({ activeVisit }) => {\n28:   const { t } = useTranslation();\n29:   return (\n30:     <Toggletip align=\"bottom\">\n31:       <ToggletipButton label={t('activeVisit', 'Active Visit')}>\n32:         <Tag type=\"blue\">{t('activeVisit', 'Active Visit')}</Tag>\n33:       </ToggletipButton>\n34:       <ToggletipContent>\n35:         <div role=\"tooltip\">\n36:           <h6 className={styles.heading}>{activeVisit?.visitType?.display}</h6>\n37:           <span>\n38:             <span className={styles.tooltipSmallText}>{t('started', 'Started')}: </span>\n39:             <span>{formatDatetime(parseDate(activeVisit?.startDatetime), { mode: 'wide' })}</span>\n40:           </span>\n41:         </div>\n42:       </ToggletipContent>\n43:     </Toggletip>\n44:   );\n45: };\n46: \n47: export { VisitTagProps };\n48: export default VisitTag;\n49: \n\n(End of file - 49 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-banner-app/src/banner-tags/visit-tag.extension.tsx","name":"visit-tag.extension.tsx","revision":"HEAD"}]}}

