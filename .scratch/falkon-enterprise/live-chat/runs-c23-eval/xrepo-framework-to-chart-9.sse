data: {"type":"tool-output-available","toolCallId":"call-95212f12-c7ee-4873-9d00-1ad3463e271a","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-common-lib/src/visit/visit-mutations.ts</path>\n<url>undefined</url>\n<content>\n155: \n156:   /**\n157:    * Revalidates only the current visit data with a single targeted request.\n158:    * This confirms the optimistic update with fresh server data.\n159:    */\n160:   const revalidateCurrentVisit = useCallback(() => {\n161:     // Single revalidation request for current visit only\n162:     return mutate(`${restBaseUrl}/visit?patient=${patientUuid}&v=custom`);\n163:   }, [mutate, patientUuid]);\n164: \n165:   /**\n166:    * Fallback function that triggers full revalidation when optimistic updates fail.\n167:    * This ensures data consistency when errors occur.\n168:    */\n169:   const revalidateAllVisitData = useCallback(() => {\n170:     // Revalidate current visit\n171:     mutate(`${restBaseUrl}/visit?patient=${patientUuid}&v=custom`);\n172: \n173:     // Revalidate visit lists\n174:     mutate(new RegExp(`${restBaseUrl}/visit\\\\?patient=${patientUuid}`));\n175: \n176:     // Revalidate related data\n177:     return invalidateVisitRelatedData({\n178:       encounters: true,\n179:       notes: true,\n180:       orders: true,\n181:       observations: true,\n182:     });\n183:   }, [mutate, patientUuid, invalidateVisitRelatedData]);\n184: \n185:   return {\n186:     addVisitOptimistically,\n187:     invalidateVisitRelatedData,\n188:     removeVisitOptimistically,\n189:     revalidateAllVisitData,\n190:     revalidateCurrentVisit,\n191:     updateVisitOptimistically,\n192:   };\n193: }\n194: \n\n(End of file - 194 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-common-lib/src/visit/visit-mutations.ts","name":"visit-mutations.ts","revision":"HEAD"}]}}

