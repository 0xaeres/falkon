data: {"type":"text-delta","id":"txt-0","delta":" a module configurable; implementers configuring"}

data: {"type":"text-delta","id":"txt-0","delta":" an instance should read the Configure O3 guide @file"}

data: {"type":"text-delta","id":"txt-0","delta":":{github.com/openmrs/openm"}

data: {"type":"text-delta","id":"txt-0","delta":"rs-contrib-o3-docs::"}

data: {"type":"text-delta","id":"txt-0","delta":"content/en-US/docs/configuration-system.mdx:"}

data: {"type":"text-delta","id":"txt-0","delta":"15-15}.\n\nThe main task for"}

data: {"type":"text-delta","id":"txt-0","delta":" a module author is to \"create a config schema for"}

data: {"type":"text-delta","id":"txt-0","delta":" your module … what configuration files should look like, including"}

data: {"type":"text-delta","id":"txt-0","delta":" defaults and validations\" @file:{"}

data: {"type":"text-delta","id":"txt-0","delta":"github.com/openmrs/openmrs"}

