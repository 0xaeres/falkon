data: {"type":"tool-output-available","toolCallId":"call-a286ea98-ce2c-4234-9de6-03db908dd60f","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-config/src/types.ts</path>\n<url>undefined</url>\n<content>\n1: export enum Type {\n2:   Array = 'Array',\n3:   Boolean = 'Boolean',\n4:   ConceptUuid = 'ConceptUuid',\n5:   Number = 'Number',\n6:   Object = 'Object',\n7:   String = 'String',\n8:   UUID = 'UUID',\n9:   PersonAttributeTypeUuid = 'PersonAttributeTypeUuid',\n10:   PatientIdentifierTypeUuid = 'PatientIdentifierTypeUuid',\n11: }\n12: \n13: // Full-powered typing for Config and Schema trees depends on being able to\n14: // have types like `string not \"_default\"`. There is an experimental PR\n15: // for this feature, https://github.com/microsoft/TypeScript/pull/29317\n16: // But it is not likely to be merged any time terribly soon. (Nov 11, 2020)\n17: export interface ConfigSchema {\n18:   [key: string]: ConfigSchema | ConfigValue;\n19:   _type?: Type;\n20:   _validators?: Array<Validator>;\n21:   _elements?: ConfigSchema;\n22: }\n23: \n24: export interface Config {\n25:   [moduleName: string]: { [key: string]: any };\n26: }\n27: \n28: export interface ConfigObject {\n29:   [key: string]: any;\n30:   /** Options that control when this extension is displayed  */\n31:   'Display conditions'?: DisplayConditionsConfigObject;\n32:   'Translation overrides'?: Record<string, Record<string, string>>;\n33: }\n34: \n35: export interface DisplayConditionsConfigObject {\n36:   /** The privileges a user should have to see this extension */\n37:   privileges?: string[];\n38:   /** An expression to evaluate whether or not the user should see this extension */\n39:   expression?: string;\n40: }\n41: \n42: export type ConfigValue = string | number | boolean | void | Array<any> | object;\n43: \n44: export interface ExtensionSlotConfig {\n45:   /** Additional extension IDs to assign to this slot, in addition to those `attach`ed in code. */\n46:   add?: Array<string>;\n47:   /** Extension IDs which were `attach`ed to the slot but which should not be assigned. */\n48:   remove?: Array<string>;\n49:   /** Overrides the default ordering of extensions. */\n50:   order?: Array<string>;\n51:   configure?: ExtensionSlotConfigureValueObject;\n52: }\n53: \n54: export interface ExtensionSlotConfigureValueObject {\n55:   [key: string]: object;\n56: }\n57: \n58: export type ProvidedConfig = {\n59:   source: string;\n60:   config: Config;\n61: };\n62: \n63: export type ValidatorFunction = (value: any) => boolean;\n64: \n65: export type Validator = (value: any) => void | string;\n66: \n\n(End of file - 66 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-config/src/types.ts","name":"types.ts","revision":"HEAD"}]}}

