data: {"type":"tool-output-available","toolCallId":"call-68fe6076-d0d5-4146-b6ab-5004c7701458","output":{"output":"<repo>github.com/openmrs/openmrs-esm-billing-app</repo>\n<path>src/invoice/payments/payments.component.tsx</path>\n<url>undefined</url>\n<content>\n140:                 <PaymentHistory bill={bill} />\n141:                 <PaymentForm disablePayment={amountDue <= 0} />\n142:               </>\n143:             )}\n144:           </div>\n145:         </div>\n146:         <div className={styles.divider} />\n147:         <div className={styles.paymentTotals}>\n148:           <InvoiceBreakDown\n149:             label={t('totalAmount', 'Total amount')}\n150:             value={convertToCurrency(bill.totalAmount ?? 0, defaultCurrency)}\n151:           />\n152:           <InvoiceBreakDown\n153:             label={t('totalTendered', 'Total tendered')}\n154:             value={convertToCurrency(bill.tenderedAmount ?? 0, defaultCurrency)}\n155:           />\n156:           <InvoiceBreakDown\n157:             label={t('discount', 'Discount')}\n158:             value={`- ${convertToCurrency((bill.totalAmount ?? 0) - (bill.netAmount ?? 0), defaultCurrency)}`}\n159:           />\n160:           <InvoiceBreakDown\n161:             label={t('refunds', 'Refunds')}\n162:             value={`- ${convertToCurrency(refundTotal, defaultCurrency)}`}\n163:           />\n164:           <InvoiceBreakDown\n165:             hasBalance={amountDue < 0}\n166:             label={t('amountDue', 'Amount due')}\n167:             value={convertToCurrency(amountDue, defaultCurrency)}\n168:           />\n169:           <div className={styles.processPayments}>\n170:             <Button onClick={handleNavigateToBillingDashboard} kind=\"secondary\">\n171:               {t('discard', 'Discard')}\n172:             </Button>\n173:             {!isPending && (\n174:               <Button\n175:                 onClick={handleProcessPayment}\n176:                 disabled={!formValues?.method || formValues.amount == null || !methods.formState.isValid}>\n177:                 {t('processPayment', 'Process Payment')}\n178:               </Button>\n179:             )}\n180:           </div>\n181:         </div>\n182:       </div>\n183:     </FormProvider>\n184:   );\n185: };\n186: \n187: export default Payments;\n188: \n\n(End of file - 188 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/invoice/payments/payments.component.tsx","name":"payments.component.tsx","revision":"HEAD"}]}}

