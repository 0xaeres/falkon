data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-b380036f971b2566","output":{"output":"<repo>github.com/openmrs/openmrs-esm-billing-app</repo>\n<path>src/billing-form/billing-form.workspace.tsx</path>\n<url>undefined</url>\n<content>\n80:     () => (isEditMode ? calculateTotalAmount(bill.lineItems) : 0),\n81:     [isEditMode, bill?.lineItems],\n82:   );\n83: \n84:   const availableBillableItems = useMemo(() => {\n85:     if (!data) return [];\n86:     if (!isEditMode) return data;\n87:     const lineItems = bill.lineItems ?? [];\n88:     const existingNames = new Set(\n89:       lineItems.flatMap((lineItem) => [lineItem.billableService, lineItem.item].filter(Boolean)),\n90:     );\n91:     return data.filter((item) => item.name && !existingNames.has(item.name));\n92:   }, [data, isEditMode, bill?.lineItems]);\n93: \n94:   const selectBillableItem = (item: BillableItem) => {\n95:     if (!item) {\n96:       return;\n97:     }\n98: \n99:     const existingItem = selectedItems.find((selectedItem) => selectedItem.uuid === item.uuid);\n100:     if (existingItem) {\n101:       const updatedItem = { ...existingItem, quantity: existingItem.quantity + 1 };\n102:       setSelectedItems(\n103:         [...selectedItems].map((selectedItem) => (selectedItem.uuid === item.uuid ? updatedItem : selectedItem)),\n104:       );\n105:       return;\n106:     }\n107: \n108:     const availablePaymentMethods = item.servicePrices || [];\n109:     let defaultPrice = 0;\n110:     let selectedPaymentMethod = null;\n111: \n112:     if (availablePaymentMethods.length === 1) {\n113:       const price = availablePaymentMethods[0].price;\n114:       defaultPrice = typeof price === 'number' ? price : parseFloat(price);\n115:       selectedPaymentMethod = availablePaymentMethods[0];\n116:     }\n117: \n118:     const mappedItem: ExtendedLineItem = {\n119:       uuid: item.uuid,\n120:       display: item.name,\n121:       quantity: 1,\n122:       price: defaultPrice,\n123:       billableService: item.uuid,\n124:       status: BillLineItemStatus.PENDING,\n125:       lineItemOrder: 0,\n126:       selectedPaymentMethod: selectedPaymentMethod,\n127:       availablePaymentMethods: availablePaymentMethods,\n128:     };\n129: \n130:     setSelectedItems([...selectedItems, mappedItem]);\n131:   };\n132: \n133:   const updateQuantity = (uuid: string, quantity: number) => {\n134:     const updatedItems = [...selectedItems].map((item) => (item.uuid === uuid ? { ...item, quantity } : item));\n135:     setSelectedItems(updatedItems);\n136:   };\n137: \n138:   const removeSelectedBillableItem = (uuid: string) => {\n139:     const updatedItems = [...selectedItems].filter((item) => item.uuid !== uuid);\n140:     setSelectedItems(updatedItems);\n141:   };\n142: \n143:   const updatePaymentMethod = (itemUuid: string, paymentMethod: ServicePrice) => {\n144:     const updatedItems = [...selectedItems].map((item) =>\n145:       item.uuid === itemUuid\n146:         ? {\n147:             ...item,\n148:             selectedPaymentMethod: paymentMethod,\n149:             price: typeof paymentMethod.price === 'number' ? paymentMethod.price : parseFloat(paymentMethod.price),\n150:             priceName: paymentMethod.name,\n151:             priceUuid: paymentMethod.uuid,\n152:           }\n153:         : item,\n154:     );\n155:     setSelectedItems(updatedItems);\n156:   };\n157: \n158:   const validateSelectedItems = (): boolean => {\n159:     if (selectedItems.length === 0) {\n160:       return false;\n161:     }\n162:     for (const item of selectedItems) {\n163:       if (item.availablePaymentMethods && item.availablePaymentMethods.length > 1 && !item.selectedPaymentMethod) {\n164:         showSnackbar({\n165:           title: t('validationError', 'Validation error'),\n166:           subtitle: t('paymentMethodRequired', 'Payment method is required for all items'),\n167:           kind: 'error',\n168:         });\n169:         return false;\n170:       }\n171:       if (!item.quantity || item.quantity < 1) {\n172:         return false;\n173:       }\n174:     }\n175:     return true;\n176:   };\n177: \n178:   const postBillItems = async () => {\n179:     if (isSubmitting || selectedItems.length === 0) {\n180:       return;\n181:     }\n182:     if (isEditMode && (isLoadingBillableServices || billableServicesError)) {\n183:       return;\n184:     }\n185:     if (!validateSelectedItems()) {\n186:       return;\n187:     }\n188: \n189:     setIsSubmitting(true);\n190: \n191:     const newLineItems: Array<LineItem> = selectedItems.map((item) => ({\n192:       quantity: item.quantity,\n193:       price: item.price,\n194:       lineItemOrder: 0,\n195:       status: BillLineItemStatus.PENDING,\n196:       billableService: item.uuid,\n197:     }));\n198: \n199:     try {\n200:       if (isEditMode) {\n201:         const existingLineItems = bill.lineItems.map((item) => {\n202:           const serviceUuid = getBillableServiceUuid(billableServices, item.billableService || item.item);\n203:           if (!serviceUuid) {\n204:             throw new Error(\n205:               t('serviceResolutionError', 'Could not resolve service \"{{service}}\"', {\n206:                 service: item.billableService || item.item,\n207:               }),\n208:             );\n209:           }\n210:           return {\n211:             uuid: item.uuid,\n212:             quantity: item.quantity,\n213:             price: item.price,\n214:             lineItemOrder: item.lineItemOrder,\n215:             status: item.status,\n216:             billableService: serviceUuid,\n217:             priceName: item.priceName,\n218:             priceUuid: item.priceUuid,\n219:           };\n220:         });\n221: \n222:         const payload = {\n223:           cashPoint: bill.cashPointUuid,\n224:           cashier: bill.cashier.uuid,\n225:           lineItems: [...existingLineItems, ...newLineItems],\n226:           patient: bill.patientUuid,\n227:           status: bill.status,\n228:           uuid: bill.uuid,\n229:         };\n\n(Showing lines 80-229 of 457. Use offset=230 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/billing-form/billing-form.workspace.tsx","name":"billing-form.workspace.tsx","revision":"HEAD"}]}}

