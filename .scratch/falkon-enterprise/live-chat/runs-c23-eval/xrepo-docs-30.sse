data: {"type":"tool-output-available","toolCallId":"call-b3b9629d-15bd-4638-b27f-7163f721961f","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-utils/src/dates/date-util.ts</path>\n<url>undefined</url>\n<content>\n343:     if ((_locale.language === 'en' || _locale.language === 'am') && mode == 'standard' && year && day) {\n344:       // Custom formatting for English and Amharic. Use hyphens instead of spaces.\n345:       parts = parts.map(formatParts('-'));\n346:     }\n347: \n348:     if (mode == 'wide') {\n349:       parts = parts.map(formatParts(' — ')); // space-emdash-space\n350:     }\n351: \n352:     // omit the era when using the Ethiopic calendar\n353:     if (formatterOptions.calendar === 'ethiopic') {\n354:       parts = parts.filter((part, idx, values) => {\n355:         if (\n356:           part.type === 'era' ||\n357:           (part.type === 'literal' && idx < values.length - 1 && values[idx + 1].type === 'era')\n358:         ) {\n359:           return false;\n360:         }\n361: \n362:         return true;\n363:       });\n364:     }\n365: \n366:     localeString = parts.map((p) => p.value).join('');\n367:   }\n368:   if (time === true || (isToday && time === 'for today')) {\n369:     localeString += `, ${formatTime(date)}`;\n370:   }\n371:   return localeString;\n372: }\n373: \n374: // Internal curried call-back for map()\n375: const formatParts = (separator: string) => {\n376:   return (part: Intl.DateTimeFormatPart, idx: number, values: Array<Intl.DateTimeFormatPart>) => {\n377:     if (part.type !== 'literal' || part.value !== ' ') {\n378:       return part;\n379:     }\n380: \n381:     if (idx < values.length - 1 && values[idx + 1].type === 'era') {\n382:       return part;\n383:     }\n384: \n385:     return { type: 'literal', value: separator } as Intl.DateTimeFormatPart;\n386:   };\n387: };\n388: \n389: /**\n390:  * Formats the input as a time, according to the current locale.\n391:  * 12-hour or 24-hour clock depends on locale.\n392:  *\n393:  * @param date The date whose time portion should be formatted.\n394:  * @returns The formatted time string (e.g., \"2:30 PM\" or \"14:30\").\n395:  */\n396: export function formatTime(date: Date) {\n397:   return date.toLocaleTimeString(getLocale(), {\n398:     hour: '2-digit',\n399:     minute: '2-digit',\n400:   });\n401: }\n402: \n403: /**\n404:  * Formats the input into a string showing the date and time, according\n405:  * to the current locale. The `mode` parameter is as described for\n406:  * `formatDate`.\n407:  *\n408:  * This is created by concatenating the results of `formatDate`\n409:  * and `formatTime` with a comma and space. This agrees with the\n410:  * output of `Date.prototype.toLocaleString` for *most* locales.\n411:  *\n412:  * @param date The date to format.\n413:  * @param options Optional formatting options (same as formatDate, except time is always included).\n414:  * @returns The formatted date and time string.\n415:  */\n416: export function formatDatetime(date: Date, options?: Partial<Omit<FormatDateOptions, 'time'>>) {\n417:   return formatDate(date, { ...options, time: true });\n418: }\n419: \n420: /**\n421:  * Converts a calendar date to the equivalent locale calendar date.\n422:  * @returns CalendarDate\n423:  */\n424: export function convertToLocaleCalendar(\n425:   date: CalendarDate | CalendarDateTime | ZonedDateTime,\n426:   locale: string | Intl.Locale,\n427: ) {\n428:   let locale_ = typeof locale === 'string' ? new Intl.Locale(locale) : locale;\n429:   const localCalendarName = getDefaultCalendar(locale_);\n430: \n431:   return localCalendarName ? toCalendar(date, createCalendar(localCalendarName)) : date;\n432: }\n433: \n434: /**\n435:  * Formats the input duration according to the current locale.\n436:  *\n437:  * @param duration The duration to format (DurationInput object).\n438:  * @param options Optional options for formatting.\n439:  * @returns The formatted duration string.\n440:  */\n441: export function formatDuration(duration: Intl.DurationInput, options?: Intl.DurationFormatOptions) {\n442:   const formatter = new Intl.DurationFormat(getLocale(), options);\n443:   return formatter.format(duration);\n444: }\n445: \n446: /**\n447:  * Parses a date input into a dayjs object. String inputs are interpreted using\n448:  * any-date-parser with corrections for its month/day representation differences\n449:  * with dayjs. Non-string inputs are passed directly to dayjs.\n450:  *\n451:  * @param dateInput The date to parse.\n452:  * @param referenceDate Used as the base when resolving partial string dates (e.g., '2000' resolves missing fields from this date).\n453:  * @returns A dayjs object, or null if the string could not be parsed.\n454:  */\n455: export function parseDateInput(dateInput: dayjs.ConfigType, referenceDate: dayjs.Dayjs): dayjs.Dayjs | null {\n456:   if (dateInput == null) {\n457:     return null;\n458:   }\n459: \n460:   if (typeof dateInput === 'string') {\n461:     const locale = getLocale();\n462:     let parsedDate = attempt(dateInput, locale);\n\n(Showing lines 343-462 of 725. Use offset=463 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-utils/src/dates/date-util.ts","name":"date-util.ts","revision":"HEAD"}]}}

