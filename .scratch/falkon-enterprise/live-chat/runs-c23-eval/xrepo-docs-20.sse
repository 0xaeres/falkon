data: {"type":"tool-output-available","toolCallId":"call-19c4624d-3bda-4073-bd0e-8a5bd31c2edb","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-dynamic-loading/src/dynamic-loading.ts</path>\n<url>undefined</url>\n<content>\n1: /** @module @category Dynamic Loading */\n2: 'use strict';\n3: import { dispatchToastShown, type ImportMap } from '@openmrs/esm-globals';\n4: import { getCoreTranslation } from '@openmrs/esm-translations';\n5: import { getCurrentPageMap, getImportMapOverrideMap, resetImportMapOverrides } from './import-maps';\n6: \n7: /**\n8:  * @internal\n9:  *\n10:  * Transforms an ESM module name to a valid JS identifier\n11:  *\n12:  * @param name the name of a module\n13:  * @returns An opaque, equivalent JS identifier for the module\n14:  */\n15: export function slugify(name: string) {\n16:   return name.replace(/[\\/\\-@]/g, '_');\n17: }\n18: \n19: /**\n20:  * Loads the named export from a named package. This might be used like:\n21:  *\n22:  * ```js\n23:  * const { someComponent } = importDynamic(\"@openmrs/esm-template-app\")\n24:  * ```\n25:  *\n26:  * @param jsPackage The package to load the export from.\n27:  * @param share Indicates the name of the shared module; this is an advanced feature if the package you are loading\n28:  *   doesn't use the default OpenMRS shared module name \"./start\".\n29:  * @param options Additional options to control loading this script.\n30:  * @param options.importMap The import map to use to load the script. This is useful for situations where you're\n31:  *   loading multiple scripts at a time, since it allows the calling code to supply an importMap, saving multiple\n32:  *   calls to `getCurrentImportMap()`.\n33:  * @param options.maxLoadingTime A positive integer representing the maximum number of milliseconds to wait for the\n34:  *   script to load before the promise returned from this function will be rejected. Defaults to 600,000 milliseconds,\n35:  *   i.e., 10 minutes.\n36:  */\n37: export async function importDynamic<T = any>(\n38:   jsPackage: string,\n39:   share: string = './start',\n40:   options?: {\n41:     importMap?: ImportMap;\n42:     maxLoadingTime?: number;\n43:   },\n44: ): Promise<T> {\n45:   // default to 10 minutes\n46:   const maxLoadingTime = !options?.maxLoadingTime || options.maxLoadingTime <= 0 ? 600_000 : options.maxLoadingTime;\n47: \n48:   let timeout: ReturnType<typeof setTimeout> | undefined = undefined;\n49:   await Promise.race([\n50:     preloadImport(jsPackage, options?.importMap),\n51:     new Promise((_, reject) => {\n52:       timeout = setTimeout(() => {\n53:         reject(\n54:           new Error(`Could not resolve requested script, ${jsPackage}, within ${humanReadableMs(maxLoadingTime)}.`),\n55:         );\n56:       }, maxLoadingTime);\n57:     }),\n58:   ]);\n59: \n60:   if (timeout) {\n61:     clearTimeout(timeout);\n62:   }\n63: \n64:   const jsPackageSlug = slugify(jsPackage);\n65: \n66:   const container = window[jsPackageSlug] as unknown;\n67:   if (!isFederatedModule(container)) {\n68:     const error = `The global variable ${jsPackageSlug} does not refer to a federated module`;\n69:     console.error(error);\n70:     throw new Error(error);\n71:   }\n72: \n73:   container.init(__webpack_share_scopes__.default);\n74: \n75:   const factory = await container.get(share);\n76:   const module = factory();\n77: \n78:   if (!(typeof module === 'object') || module === null) {\n79:     const error = `Container for ${jsPackage} did not return an ESM module as expected`;\n80:     console.error(error);\n81:     throw new Error(error);\n82:   }\n83: \n84:   return module as unknown as T;\n85: }\n86: \n87: /**\n88:  * Utility function to convert milliseconds into human-readable strings with rather absurd\n89:  * levels of precision.\n90:  *\n91:  * @param ms Number of milliseconds\n92:  * @returns A human-readable string useful only for error logging, where we can assume English\n93:  */\n94: function humanReadableMs(ms: number) {\n95:   if (ms < 1_000) {\n96:     return `${ms} milliseconds`;\n97:   } else if (ms < 60_000) {\n98:     return `${Math.floor(ms / 1000)} seconds`;\n99:   } else if (ms < 3_600_000) {\n100:     return `${Math.floor(ms / 60_000)} minutes`;\n101:   } else if (ms < 86_400_000) {\n102:     return `${Math.floor(ms / 3_600_000)} hours`;\n103:   } else {\n104:     return `${Math.floor(ms / 86_400_000)} days`;\n105:   }\n106: }\n107: \n108: /**\n109:  * @internal\n110:  *\n111:  * This internal method is used to ensure that the script belonging\n112:  * to the given package is loaded and added to the head. Concurrent and\n113:  * repeat calls for the same package share a single request for it.\n114:  *\n115:  * @param jsPackage The package to load\n116:  * @param importMap The import map to use for loading this package.\n117:  *  The main reason for specifying this is to avoid needing to call\n118:  *  `getCurrentPageMap()` for every script when bulk loading.\n119:  */\n120: export async function preloadImport(jsPackage: string, importMap?: ImportMap) {\n121:   if (typeof jsPackage !== 'string' || jsPackage.trim().length === 0) {\n122:     const error = 'Attempted to call importDynamic() without supplying a package to load';\n123:     console.error(error);\n124:     throw new Error(error);\n125:   }\n126: \n127:   const jsPackageSlug = slugify(jsPackage);\n128: \n129:   if (!window[jsPackageSlug]) {\n130:     const activeImportMap = importMap ?? (await getCurrentImportMap());\n131:     if (!activeImportMap.imports.hasOwnProperty(jsPackage)) {\n132:       const error = `Could not find the package ${jsPackage} defined in the current importmap`;\n133:       console.error(error);\n134:       throw new Error(error);\n135:     }\n136: \n137:     let url = activeImportMap.imports[jsPackage];\n138:     if (url.startsWith('./')) {\n139:       url = window.spaBase + url.substring(1);\n140:     }\n141: \n142:     const isOverridden = jsPackage in getImportMapOverrideMap().imports;\n143:     try {\n144:       return await loadScript(url);\n145:     } catch (err: any) {\n146:       if (isOverridden) {\n\n(Output capped at 5KB. Showing lines 1-146 of 278. Use offset=147 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-dynamic-loading/src/dynamic-loading.ts","name":"dynamic-loading.ts","revision":"HEAD"}]}}

