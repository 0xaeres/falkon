data: {"type":"tool-output-available","toolCallId":"call-1a5aa69e-12bf-4f17-80e0-27a543f86e44","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-chart-app/src/actions-buttons/delete-visit.component.tsx</path>\n<url>undefined</url>\n<content>\n1: import React, { useCallback } from 'react';\n2: import { useTranslation } from 'react-i18next';\n3: import { OverflowMenuItem } from '@carbon/react';\n4: import { useVisit, showModal } from '@openmrs/esm-framework';\n5: import styles from './action-button.scss';\n6: \n7: interface DeleteVisitOverflowMenuItemProps {\n8:   patientUuid: string;\n9:   closeMenu?: () => void;\n10: }\n11: \n12: /**\n13:  * This button shows up in the patient banner action menu, but only when the patient has an active visit.\n14:  * On click, it opens the modal in delete-visit-dialog.component.tsx to DELETE the visit\n15:  */\n16: const DeleteVisitOverflowMenuItem: React.FC<DeleteVisitOverflowMenuItemProps> = ({ patientUuid, closeMenu }) => {\n17:   const { t } = useTranslation();\n18:   const { activeVisit } = useVisit(patientUuid);\n19: \n20:   const handleLaunchModal = useCallback(() => {\n21:     const dispose = showModal('delete-visit-dialog', {\n22:       closeModal: () => dispose(),\n23:       visit: activeVisit,\n24:     });\n25:   }, [activeVisit]);\n26: \n27:   return (\n28:     activeVisit && (\n29:       <OverflowMenuItem\n30:         className={styles.menuitem}\n31:         closeMenu={closeMenu}\n32:         hasDivider\n33:         isDelete\n34:         itemText={t('deleteActiveVisit', 'Delete active visit')}\n35:         onClick={handleLaunchModal}\n36:       />\n37:     )\n38:   );\n39: };\n40: \n41: export default DeleteVisitOverflowMenuItem;\n42: \n\n(End of file - 42 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/actions-buttons/delete-visit.component.tsx","name":"delete-visit.component.tsx","revision":"HEAD"}]}}

