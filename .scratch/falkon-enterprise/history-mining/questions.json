  "subject": "TRUNK-6697: HandlerUtil's cache should not be garbage collected (#6494)",
  "pr": 6494,
  "prUrl": "https://github.com/openmrs/openmrs-core/pull/6494",
  "ticket": "TRUNK-6697",
  "ticketUrl": "https://openmrs.atlassian.net/browse/TRUNK-6697",
  "mergedAt": "2026-08-25T15:39:20Z",
  "commitDate": "2026-08-25T11:39:19-04:00",
  "sourceFrom": "jira",
  "source": "HandlerUtil caches handler lookups in a WeakHashMap whose keys are referenced by nothing but the map itself, so any GC cycle can evict the entire cache."
 },
