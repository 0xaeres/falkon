data: {"type":"text-delta","id":"txt-0","delta":"answer-->\nThe O3 frontend formats"}

data: {"type":"text-delta","id":"txt-0","delta":" dates through one utility, `formatDate`,"}

data: {"type":"text-delta","id":"txt-0","delta":" which lives in the framework package `@open"}

data: {"type":"text-delta","id":"txt-0","delta":"mrs/esm-framework` ("}

data: {"type":"text-delta","id":"txt-0","delta":"a shared library of UI/utility code that"}

data: {"type":"text-delta","id":"txt-0","delta":" all O3 apps import). It is locale"}

data: {"type":"text-delta","id":"txt-0","delta":"-aware because it delegates the actual formatting to the browser's"}

data: {"type":"text-delta","id":"txt-0","delta":" built-in `Intl` API rather"}

data: {"type":"text-delta","id":"txt-0","delta":" than hard-coding patterns, and it special"}

data: {"type":"text-delta","id":"txt-0","delta":"-cases \"today\" by producing the word for"}

data: {"type":"text-delta","id":"txt-0","delta":" today in the active language.\n\n## Where"}

data: {"type":"text-delta","id":"txt-0","delta":" it lives\n\n| Piece | Location |\n|---|---|\n|"}

