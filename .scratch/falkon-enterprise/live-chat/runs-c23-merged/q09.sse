olumn=\"provider_id\"/>\n  119: \t\t<many-to-one name=\"visit\" class=\"org.openmrs.Visit\" column=\"visit_id\" index=\"cashier_bill_visit_id_idx\"/>\n  165: \t<class name=\"org.openmrs.module.billing.api.model.BillLineItem\" table=\"cashier_bill_line_item\">\n  170: \t\t\t\t<param name=\"sequence\">cashier_bill_line_item_bill_line_item_id_seq</param>\n  208: \t<class name=\"org.openmrs.module.billing.api.model.Payment\" table=\"cashier_bill_payment\">\n  213: \t\t\t\t<param name=\"sequence\">cashier_bill_payment_bill_payment_id_seq</param>\n  224: \t\t<many-to-one name=\"cashier\" class=\"org.openmrs.Provider\" column=\"provider_id\" not-null=\"false\"/>\n  243: \t<class name=\"org.openmrs.module.billing.api.model.PaymentAttribute\" table=\"cashier_bill_payment_attribute\">\n  248: \t\t\t\t<param name=\"sequence\">cashier_bill_payment_attribute_bill_payment_attribute_id_seq</param>\n  262: \t<class name=\"org.openmrs.module.billing.api.model.PaymentMode\" table=\"cashier_payment_mode\">\n  267: \t\t\t\t<param name=\"sequence\">cashier_payment_mode_payment_mode_id_seq</param>\n  295: \t       table=\"cashier_payment_mode_attribute_type\">\n  300: \t\t\t\t<param name=\"sequence\">cashier_payment_mode_attribute_type_payment_mode_attribute_type_id_seq</param>\n\n[github.com/openmrs/openmrs-module-billing] api/src/main/resources/messages.properties:\n  11: openhmis.cashier.title=OpenMRS Billing Module\n  12: openhmis.cashier.error.nameRequired=A name is required\n  13: openhmis.cashier.error.fieldRequired=This is a required field.\n  14: openhmis.cashier.general.showing=Showing\n  15: openhmis.cashier.general.of=of\n  16: openhmis.cashier.general.to=to\n  17: openhmis.cashier.general.entries=entries\n  18: openhmis.cashier.general.error=Access Denied\n  20: openhmis.cashier.admin.role=Cashier Role Creation\n  21: openhmis.cashier.admin.paymentModes=Manage Payment Modes\n  22: openhmis.cashier.admin.cashPoints=Manage Cash Points\n  23: openhmis.cashier.admin.receiptNumberGenerator=Manage Receipt Number Generator\n  24: openhmis.cashier.admin.seqReceiptNumberGenerator=Configure Sequential Receipt Number Generator\n  25: openhmis.cashier.admin.cashierSettings=Cashier Settings\n  27: openhmis.cashier.page=Cashier\n  28: openhmis.cashier.admin.task.dashboard=Cashier Task Dashboard\n  29: openhmis.cashier.page.timesheet=Cashier Timesheet Entry\n  30: openhmis.cashier.page.reports=Cashier Reports\n  31: openhmis.cashier.page.reports.error.timesheetRequired=You must select a timesheet to run the report.\n  32: openhmis.cashier.page.timesheet.box.title=Timesheet Entry\n  (5 more lines)\n\n(Output was cut short: narrow the path or pattern, name a repo, or raise the limit.)","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/resources/config.xml","name":"config.xml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/resources/Bill.hbm.xml","name":"Bill.hbm.xml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/resources/messages.properties","name":"messages.properties","revision":"HEAD"}]}}

