data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/AbstractDefaultOrderBillingStrategy.java","name":"AbstractDefaultOrderBillingStrategy.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-bdad16bd73955afd","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/billing/impl/AbstractDefaultOrderBillingStrategy.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.api.billing.impl;\n11: \n12: import java.math.BigDecimal;\n13: import java.util.Date;\n14: import java.util.EnumSet;\n15: import java.util.HashMap;\n16: import java.util.List;\n17: import java.util.Map;\n18: import java.util.Optional;\n19: import java.util.stream.Collectors;\n20: \n21: import lombok.Setter;\n22: import lombok.extern.slf4j.Slf4j;\n23: import org.openmrs.Order;\n24: import org.openmrs.Patient;\n25: import org.openmrs.PatientProgram;\n26: import org.openmrs.Provider;\n27: import org.openmrs.api.ProgramWorkflowService;\n28: import org.openmrs.module.billing.api.BillExemptionService;\n29: import org.openmrs.module.billing.api.BillLineItemService;\n30: import org.openmrs.module.billing.api.BillService;\n31: import org.openmrs.module.billing.api.CashPointService;\n32: import org.openmrs.module.billing.api.billing.BillingResult;\n33: import org.openmrs.module.billing.api.evaluator.ExemptionRuleEngine;\n34: import org.openmrs.module.billing.api.model.Bill;\n35: import org.openmrs.module.billing.api.model.BillExemption;\n36: import org.openmrs.module.billing.api.model.BillLineItem;\n37: import org.openmrs.module.billing.api.model.BillLineItemStatus;\n38: import org.openmrs.module.billing.api.model.BillStatus;\n39: import org.openmrs.module.billing.api.model.CashPoint;\n40: import org.openmrs.module.billing.api.model.ExemptionType;\n41: import org.springframework.beans.factory.annotation.Autowired;\n42: import org.springframework.beans.factory.annotation.Qualifier;\n43: import org.springframework.transaction.PlatformTransactionManager;\n44: import org.springframework.transaction.support.TransactionTemplate;\n45: \n46: /**\n47:  * Default implementation base class that provides shared logic for bill creation, line item\n48:  * voiding, exemption checking, and idempotency. Subclasses implement\n49:  * {@link #createBillLineItem(Order)} to build the line item specific to their order type.\n50:  * <p>\n51:  * Strategies that need completely custom behavior should extend\n52:  * {@link AbstractOrderBillingStrategy} directly instead.\n53:  */\n54: @Slf4j\n55: @Setter(onMethod_ = @Autowired)\n56: public abstract class AbstractDefaultOrderBillingStrategy extends AbstractOrderBillingStrategy {\n57: \t\n58: \tprotected BillService billService;\n59: \t\n60: \tprotected BillLineItemService billLineItemService;\n61: \t\n62: \tprotected CashPointService cashPointService;\n63: \t\n64: \tprotected BillExemptionService billExemptionService;\n65: \t\n66: \t@Qualifier(\"ruleEngine\")\n67: \tprotected ExemptionRuleEngine exemptionRuleEngine;\n68: \t\n69: \tprotected ProgramWorkflowService programWorkflowService;\n70: \t\n71: \tprotected PlatformTransactionManager transactionManager;\n72: \t\n73: \t{\n74: \t\tsetSupportedActions(EnumSet.of(Order.Action.NEW, Order.Action.RENEW, Order.Action.REVISE, Order.Action.DISCONTINUE));\n75: \t}\n76: \t\n77: \t@Override\n78: \tprotected BillingResult handleNewOrder(Order order) {\n79: \t\treturn createBillIfAbsent(order);\n80: \t}\n81: \t\n82: \t@Override\n83: \tprotected BillingResult handleRenewOrder(Order order) {\n84: \t\treturn createBillIfAbsent(order);\n85: \t}\n86: \t\n87: \t@Override\n88: \tprotected BillingResult handleRevisedOrder(Order order) {\n89: \t\tTransactionTemplate txTemplate = new TransactionTemplate(transactionManager);\n90: \t\treturn txTemplate.execute(status -> {\n91: \t\t\tvoidPreviousLineItem(order, \"Order revised\");\n92: \t\t\treturn createBillIfAbsent(order);\n93: \t\t});\n94: \t}\n95: \t\n96: \t@Override\n97: \tprotected BillingResult handleDiscontinuedOrder(Order order) {\n98: \t\tvoidPreviousLineItem(order, \"Order discontinued\");\n99: \t\treturn BillingResult.discontinued();\n100: \t}\n101: \t\n102: \tprotected void voidPreviousLineItem(Order order, String reason) {\n103: \t\tOrder previousOrder = order.getPreviousOrder();\n104: \t\tif (previousOrder == null) {\n105: \t\t\tlog.warn(\"No previous order found for {} order: {}\", order.getAction(), order.getUuid());\n106: \t\t\treturn;\n107: \t\t}\n108: \t\t\n109: \t\tBillLineItem existingLineItem = billLineItemService.getBillLineItemByOrder(previousOrder);\n110: \t\tif (existingLineItem == null) {\n111: \t\t\tlog.warn(\"No bill line item found for previous order: {}\", previousOrder.getUuid());\n112: \t\t\treturn;\n113: \t\t}\n114: \t\t\n115: \t\tbillLineItemService.voidBillLineItem(existingLineItem, reason);\n116: \t}\n117: \t\n118: \t/**\n119: \t * Create the order-type-specific bill line item. Called by the default bill creation pipeline.\n120: \t *\n121: \t * @param order the order to create a line item for\n122: \t * @return the line item, or empty if the order should not be billed\n123: \t */\n124: \tprotected abstract Optional<BillLineItem> createBillLineItem(Order order);\n125: \t\n126: \tprotected BillingResult createBillIfAbsent(Order order) {\n127: \t\tBillLineItem existingLineItem = billLineItemService.getBillLineItemByOrder(order);\n128: \t\tif (existingLineItem != null) {\n129: \t\t\tlog.info(\"Bill line item already exists for order: {}, skipping duplicate bill creation\", order.getUuid());\n130: \t\t\treturn BillingResult.skipped(\"Duplicate — bill already exists\");\n131: \t\t}\n132: \t\t\n133: \t\tOptional<BillLineItem> lineItemOpt = createBillLineItem(order);\n134: \t\tif (!lineItemOpt.isPresent()) {\n135: \t\t\treturn BillingResult.skipped(\"No billable item found for order\");\n136: \t\t}\n137: \t\t\n\n(Output capped at 5KB. Showing lines 1-137 of 232. Use offset=138 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/AbstractDefaultOrderBillingStrategy.java","name":"AbstractDefaultOrderBillingStrategy.java","revision":"HEAD"}]}}

