data: {"type":"tool-output-available","toolCallId":"call-8c0a4ed8-ba30-464a-a967-2769694ae7b8","output":{"output":"/\n  .github/\n    workflows/\n      build.yml\n      claude-pr-review.yml\n      codecov.yml\n      release.yml\n  api/\n    src/\n      main/\n      test/\n    pom.xml\n  bamboo-specs/\n    bamboo.yml\n  fhir/\n    src/\n      main/\n      test/\n    pom.xml\n  omod/\n    src/\n      main/\n      test/\n    pom.xml\n  uml/\n    Entity Services.uml\n  .gitattributes\n  .gitignore\n  atlassian-ide-plugin.xml\n  LICENSE.txt\n  lombok.config\n  pom.xml\n  README.md\n  SECURITY.md","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":".gitattributes","name":".gitattributes","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":".gitignore","name":".gitignore","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"atlassian-ide-plugin.xml","name":"atlassian-ide-plugin.xml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"LICENSE.txt","name":"LICENSE.txt","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"lombok.config","name":"lombok.config","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"pom.xml","name":"pom.xml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"README.md","name":"README.md","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"SECURITY.md","name":"SECURITY.md","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":".github/workflows/build.yml","name":"build.yml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":".github/workflows/claude-pr-review.yml","name":"claude-pr-review.yml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":".github/workflows/codecov.yml","name":"codecov.yml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":".github/workflows/release.yml","name":"release.yml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/pom.xml","name":"pom.xml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"bamboo-specs/bamboo.yml","name":"bamboo.yml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"fhir/pom.xml","name":"pom.xml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/pom.xml","name":"pom.xml","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"uml/Entity Services.uml","name":"Entity Services.uml","revision":"HEAD"}]}}

data: {"type":"tool-output-available","toolCallId":"call-cb8cc67f-2860-4c31-aec8-0f24eeef8977","output":{"output":"{\"commits\":[{\"hash\":\"6409aa01cf31b462149416a7eeb19d1d34cd6f8d\",\"date\":\"2026-10-01T12:26:10-04:00\",\"message\":\"Remove distribution override\",\"refs\":\"HEAD, origin/main, origin/HEAD\",\"body\":\"\",\"authorName\":\"Ian\",\"authorEmail\":\"ian.c.bacher@gmail.com\"},{\"hash\":\"68a3ecae994f911e54c4cf0bd6c4c4fa25f822da\",\"date\":\"2026-10-01T12:07:23-04:00\",\"message\":\"Update parent to 2.3.0\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Ian\",\"authorEmail\":\"ian.c.bacher@gmail.com\"},{\"hash\":\"cd2bd08216c22d8a82d77cad82d9ce968b6ed112\",\"date\":\"2026-09-24T11:55:56Z\",\"message\":\"[maven-release-plugin] prepare for next development iteration\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"648720c8ae09689595150fbd0ecbab9760a094b5\",\"date\":\"2026-09-24T11:55:54Z\",\"message\":\"[maven-release-plugin] prepare release 2.5.0\",\"refs\":\"tag: 2.5.0\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"5547ac928ad06bb41130aa00826bfa2bb59b6acf\",\"date\":\"2026-09-22T22:51:22+05:30\",\"message\":\"Change BillableService id from int to Integer (#195)\",\"refs\":\"\",\"body\":\"* Change BillableService id from int to Integer\\n\\n Change BillableService.billableServiceId from primitive int to Integer so getId() returns null for unsaved instances. Also, cleanup the  handwritten getters and setters with Lombok\\n\\n Removed addServicePrice as it is not getting used anywhere.\\n\\n* Apply spotless\\n\\n* Apply spotless\\n\\n* Remove @Getter(AccessLevel.NONE) from billableServiceId\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"2e21085067a6cfc33f9c5c04f466aa983e63571b\",\"date\":\"2026-09-03T15:24:29Z\",\"message\":\"(chore) created local 'SECURITY.md' from remote 'docs/SECURITY.md'\",\"refs\":\"\",\"body\":\"Sync repo templates\\n\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"null\"},{\"hash\":\"c47f6d87e0352dcfa5a51b5a743016e0a8c40be9\",\"date\":\"2026-09-03T14:06:52+05:30\",\"message\":\"Add locationUuid, startDate and endDate filters to GET /bill (#193)\",\"refs\":\"\",\"body\":\"* Add locationUuid, startDate and endDate filters to GET /bill\\n\\nFilter by location through the bill's cash point location\\nApply startDate and endDate as inclusive bounds on dateCreate\\n\\n* Resolve sonar issues\\n\\n* Add tests\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"dc7d24615afc5c4adc62dcc9110bdff7dcc7c7cf\",\"date\":\"2026-08-12T16:00:48+05:30\",\"message\":\"Document content package configuration in the README (#191)\",\"refs\":\"\",\"body\":\"* Document content package configuration in the README\\n\\nReplace the Installation and Configuration sections with content package\\nsetup covering the globalproperties, billableservices, paymentmodes,\\ncashpoints and cashieritemprices Initializer domains.\\n\\nCorrect the requirements list: fhir2 and event are required modules, not\\noptional. Add the undocumented billing.currencySymbol property and fix the\\ndeclared default for billing.patientDashboard2BillCount.\\n\\n* Correct README inaccuracies and tidy the configuration section\\n\\n- Describe exemptions as concept-scoped JavaScript rules evaluated against\\n  the patient, age, order and active programs; there are no built-in\\n  location-based rules\\n- Note that timesheets are served at /rest/v2/billing/timesheet while the\\n  other resources are on v1\\n- Name the Initializer version that supports all four billing domains\\n- Point readers at omod/src/main/resources/config.xml for the property list\\n- Link the property tables to the receipt numbering and resolver sections\\n- Document the remaining causes of receipt sequence gaps and the per-JVM\\n  scope of reserved blocks\\n- Promote the content package subsections to h3\\n\\n* Document automatic order billing and how prices are resolved\\n\\n* Address review: REST namespace, exemption bindings, global property prefix, install deps\\n\\n* Address review: renew behaviour, CSV headers, strategy docs\\n\\nRenewing an order does not void the previous line item; only revise and\\ndiscontinue do.\\n\\nMove the file paths out of the CSV examples. Initializer reads the first\\nrow as the header, so the leading comment made the blocks uncopyable.\\n\\nSplit strategy customisation into adding a strategy for a new order type\\nand replacing a shipped one. Extending AbstractDefaultOrderBillingStrategy\\nrequires implementing resolveCashier and resolveCashPoint, which are\\ninherited returning null, and exemption checks live in createBillLineItem\\nrather than the shared pipeline.\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"3527b7126e38fadb9826702e51e5d2f08f731fd8\",\"date\":\"2026-08-07T16:29:06Z\",\"message\":\"[maven-release-plugin] prepare for next development iteration\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"1bc55ca292d69a83e94661f4e69a817cb14b9028\",\"date\":\"2026-08-07T16:29:04Z\",\"message\":\"[maven-release-plugin] prepare release 2.4.0\",\"refs\":\"tag: 2.4.0\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"8e25ae7ee9b0d2466f5a8b7aa2b530302d6504b9\",\"date\":\"2026-07-30T14:44:03+05:30\",\"message\":\"O3-5835: Fix duplicate receipt numbers by reserving sequence blocks wth row locking (#190)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"1eaa8f1f57dcdf3d3d03ee216ecca475016f5bd3\",\"date\":\"2026-07-15T17:38:20-04:00\",\"message\":\"Add Codecov job (#188)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Ian\",\"authorEmail\":\"52504170+ibacher@users.noreply.github.com\"},{\"hash\":\"77de2978eaf635a250e3b3193cabfc7d7e1c3cac\",\"date\":\"2026-07-08T00:37:30+03:00\",\"message\":\"Add Claude PR review (calls shared reusable workflow)\",\"refs\":\"\",\"body\":\"On-demand reviewer invoked by '@claude review' on a PR, gated to /dev/3+.\\nCalls the shared reusable workflow in openmrs-contrib-gha-workflows\\n(tracking @main); secrets pass via 'secrets: inherit'.\\n\\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>\\n\",\"authorName\":\"dkayiwa\",\"authorEmail\":\"dkayiwa@openmrs.org\"},{\"hash\":\"f4d815126831a042772d3d31c5a16e08d189047d\",\"date\":\"2026-06-04T10:39:07Z\",\"message\":\"[maven-release-plugin] prepare for next development iteration\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"97ca4da364f914c1c65090ceb095603e64facaad\",\"date\":\"2026-06-04T10:39:04Z\",\"message\":\"[maven-release-plugin] prepare release 2.3.0\",\"refs\":\"tag: v2.3.0\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"a65f5e7ed867e15c1333a8e00e57c8e5f8d2a24b\",\"date\":\"2026-06-04T16:00:24+05:30\",\"message\":\"Update GitHub Actions secrets in release.yml (#184)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"15e5e4cf71392d4d2235191f24bd4a5a264f0dae\",\"date\":\"2026-06-02T12:37:02+05:30\",\"message\":\"Show discounts and refunds on bill receipts (#180)\",\"refs\":\"\",\"body\":\"* Show discounts and refunds on bill receipts\\n\\n- Receipt now shows line-scoped discounts under each line item, plus Subtotal / Total Discount / Total in the totals block\\n  - New Refund section lists completed refunds with their reason\\n  - Due-amount math accounts for refunds\\n  - Fix NPE in Bill.synchronizeBillStatus() when payments is null\\n  - Add Liquibase 009b to drop orphaned payment_status column when both columns exist\\n\\n* Resolve Sonar issues\\n\\n* Resolve Sonar issues\\n\\n* Resolve Sonar issues\\n\\n* Use StringUtils.abbreviate\\n\\n* Drop trimming the refund reason\\n\\n* Fix due amount math\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"026c3f2aae45121810b0a36a50467ca29a4254c4\",\"date\":\"2026-05-28T21:54:48+05:30\",\"message\":\"Update README.md (#183)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"62a6f16b01904f153f1395b02a5c0dd4ae5e1f60\",\"date\":\"2026-05-28T15:12:21+05:30\",\"message\":\"Fix patient payment status returning PAID when no active bills exist (#182)\",\"refs\":\"\",\"body\":\"Co-authored-by: Claude Sonnet 4.6 <noreply@anthropic.com>\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"d384c1afe4b4df95549694ecef78d855a98df743\",\"date\":\"2026-05-27T19:21:03+05:30\",\"message\":\"Fix orphaned payment_status column on cashier_bill_line_item (#181)\",\"refs\":\"\",\"body\":\"On DBs where both payment_status and status ended up on cashier_bill_line_item after a partial migration, every line-item insert failed with Field 'payment_status' doesn't have a default value\\n\\n  - Tighten changeset 009 precondition so the rename only runs when status does not already exist\\n  - Add changeset 009b to backfill from payment_status and drop it when both columns exist\\n  - Pin <validCheckSum> on 009 so already-migrated DBs accept the precondition change\\n\\nCo-authored-by: Nethmi Rodrigo <nethmi.dilinika@gmail.com>\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"745c5878a82138cf6208239973c18f71fc05f1c2\",\"date\":\"2026-05-27T17:57:00+05:30\",\"message\":\"Add refundStatus filter to GET /bill and expose refunds in bill representation (#178)\",\"refs\":\"\",\"body\":\"* Add refundStatus filter to GET /bill and expose refunds in bill representation\\n\\nAdds a refundStatus query parameter to GET /ws/rest/v1/cashier/bill so callers\\ncan filter bills by the status of their (non-voided) refunds. Supports\\ncomma-separated values mapping to the RefundStatus enum. Also surfaces the bill's\\nrefunds in the default and full REST representations.\\n\\nBillSearch gains a refundStatuses list.\\nHibernateBillDAO filters via an EXISTS subquery on non-voided BillRefund rows.\\nBill gains getActiveRefunds() to exclude voided rows from the representation.\\nBillResource parses the param and rejects unknown values with InvalidSearchException (400).\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* Fix Sonar issues: extract constants and reduce cognitive complexity\\n\\n- Add FIELD_STATUS and FIELD_VOIDED constants to HibernateBillDAO to\\n  avoid duplicated string literals flagged by Sonar\\n- Extract patient-name lookup into buildPatientNamePredicate() to bring\\n  buildBillSearchPredicate cognitive complexity within the 15 limit\\n- Extract parseDiscountStatuses() and parseRefundStatuses() helpers in\\n  BillResource to bring buildBillSearchFromRequest within the 15 limit\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* Guard refund data behind View Bill Refunds privilege\\n\\n- @PropertyGetter(\\\"refunds\\\") returns empty list when caller lacks VIEW_REFUNDS,\\n  preventing bypass of BillRefundService's @Authorized check via the bill representation\\n- refundStatus filter param now calls Context.requirePrivilege(VIEW_REFUNDS) before\\n  processing, blocking privilege-less callers from inferring refund activity\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* Fix test: mock VIEW_REFUNDS privilege in getActiveRefunds_shouldExcludeVoidedRefunds\\n\\nThe static Context mock defaulted hasPrivilege() to false, causing the\\nprivilege guard to short-circuit and return an empty list before the\\nvoided-refund filter could run.\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* Fix test: mock VIEW_REFUNDS privilege in getActiveRefunds_shouldReturnEmptyWhenBillHasNoRefunds\\n\\nTest was passing because the privilege check short-circuited and returned\\nan empty list, not because the bill had no refunds. Added the privilege\\nmock so the test validates the actual no-refunds case.\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n---------\\n\\nCo-authored-by: Claude Sonnet 4.6 <noreply@anthropic.com>\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"dda906cbe46b2a75b0fa163b71b9e0f027d3de4c\",\"date\":\"2026-05-21T19:01:46+05:30\",\"message\":\"Update itextPdf to 8.0.5 (#177)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"59204a940f65cf2f6741556fc43ed0e1d375c55a\",\"date\":\"2026-05-21T14:32:44+05:30\",\"message\":\"Delete bill discounts and refunds when purging bill (#174)\",\"refs\":\"\",\"body\":\"* (chore) Delete bill discounts and refunds when purging bill\\n\\n* (fix) Fix bill refund test UUIDs and correct Liquibase changeset ordering\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* Apply suggestion from @wikumChamith\\n\\nCo-authored-by: Wikum Weerakutti <wikum@linuxdeveloper.space>\\n\\n* (fix) Use valid hex UUIDs for bill refund test fixtures\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* (fix) Sync test assertions with corrected refund fixture UUIDs\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n---------\\n\\nCo-authored-by: Claude Sonnet 4.6 <noreply@anthropic.com>\\nCo-authored-by: Wikum Weerakutti <wikum@linuxdeveloper.space>\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"16dbd6a44d2f85d12095de9255b66c888b43ef5e\",\"date\":\"2026-05-19T11:25:52-04:00\",\"message\":\"O#-5421: Follow-up: fix precondition check\",\"refs\":\"\",\"body\":\"Also moves test resources to the appropriate places\\n\",\"authorName\":\"Ian\",\"authorEmail\":\"ian.c.bacher@gmail.com\"},{\"hash\":\"1dee616c219772026e79dddd7a80e57e6ea35c2d\",\"date\":\"2026-05-19T17:28:06+05:30\",\"message\":\"O3-5421: Associate bills with patient visits (#172)\",\"refs\":\"\",\"body\":\"* (feat) Associate bills with patient visits\\n\\nAdds an optional visit association to Bill so bills can be linked to the\\nvisit they were generated during. The visit can be supplied explicitly\\nvia the REST API, is auto-populated from a patient's single active visit\\non create, and is auto-set from an order's encounter when a bill is\\ngenerated from orders. Bills can also be filtered by visitUuid.\\n\\n* Fix Patient mock failure on Java 21\\n\\nMockito's inline mock-maker cannot modify the full Patient class\\nhierarchy on Java 21. Use real Patient instances since the tests never\\nstub methods on them.\\n\\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\\n\\n* (fix) Replace Order mocks with real instances for Java 21 compatibility\\n\\nMockito's inline mock-maker cannot instrument the full Order class\\nhierarchy on Java 21, causing TestOrderBillingStrategyTest to fail with\\n\\\"Mockito cannot mock this class: class org.openmrs.Order\\\". Use real\\nOrder/Encounter/Visit/Provider instances wired via setters instead.\\n\\nAlso fixes stale setPaymentStatus calls in BillServiceImplTest left over\\nfrom the BillLineItemStatus rename in e54193f.\\n\\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\\n\\n* (fix) Replace CashPoint mock with real instance for Java 21 compatibility\\n\\nSame root cause as 4b75bc5: Mockito's inline mock-maker cannot\\ninstrument BaseOpenmrsMetadata's class hierarchy on Java 21.\\n\\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\\n\\n* (fix) Replace BillLineItem mock with real instance for Java 21 compatibility\\n\\nLast remaining mock that fails under Java 21's inline mock-maker. With\\nthis, the visit-association tests use real instances throughout.\\n\\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\\n\\n* Validate bill visit association\\n\\n* Refactor bill resource save setup\\n\\n* Add bill visit index\\n\\n---------\\n\\nCo-authored-by: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"49d6600c9d5a33b8bbac2b1c430c3c9725af0453\",\"date\":\"2026-05-19T16:41:39+05:30\",\"message\":\"O3-5410: Display Billing Payment Status Without Blocking Access to Clinical Forms (#173)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"e54193f25d8b3064aa9d6e407f456f9a10909551\",\"date\":\"2026-05-15T20:06:17+05:30\",\"message\":\"O3-5422: Introduce a dedicated `BillLineItemStatus` (#170)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"6110623e19edf474dd80432fcc60e2acd7a14663\",\"date\":\"2026-05-15T11:35:53+05:30\",\"message\":\"Enable refund and discount features by default (#171)\",\"refs\":\"\",\"body\":\"Co-authored-by: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"f18f721e6da5184c98a600c70354414f1b0e0b8b\",\"date\":\"2026-05-14T16:50:24+05:30\",\"message\":\"O3-5417: Filter bills by discount status (#168)\",\"refs\":\"\",\"body\":\"* Add discountStatus filter for bills\\n\\nFilter bills by non-voided line item discount status via EXISTS subquery\\nin BillSearch; parse discountStatus query param in BillResource and\\nvalidate against InvalidSearchException.\\n\\n* fix formatting issues\\n\\n* chore: address PR review comments\\n\\nMigrate BillResourceTest and BillLineItemResourceTest to JUnit Jupiter\\nto match the sibling PaymentResourceTest convention. Fix BillDiscount\\nimport order in HibernateBillDAO.\\n\\n* chore: use Locale.ROOT for status enum parsing\\n\\n* test: merge discount-status tests into existing HibernateBillDAOTest\\n\\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\\n\\n* chore: inline bill uuids to match existing test convention\\n\\nCo-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\\n\\n---------\\n\\nCo-authored-by: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"651dce6eabcec15fd7e7eab909b11fc7039ae7f7\",\"date\":\"2026-05-12T20:49:11+05:30\",\"message\":\"Bump maven-parent-openmrs-module to 2.2.0 (#169)\",\"refs\":\"\",\"body\":\"- Upgraded parent POM version from 2.1.0 to 2.2.0 in `pom.xml`.\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"71fc613004aa8313e0d01db46c298916d8a90d48\",\"date\":\"2026-05-12T20:44:10+05:30\",\"message\":\"O3-5413: Enable Refund Requests and Approval for Paid Bills (#167)\",\"refs\":\"\",\"body\":\"* O3-5413: Enable Refund Requests and Approval for Paid Bills\\n\\n  - New bill_refund table + JPA-mapped BillRefund entity (FK to bill, optional line item, audit fields)\\n  - RefundStatus enum: REQUESTED → APPROVED → COMPLETED (or → REJECTED)\\n  - BillRefundService / DAO / BillRefundValidator / REST resource at /billing/billRefund\\n  - New BillStatus values: REFUND_REQUESTED, REFUNDED, PARTIALLY_REFUNDED\\n  - 4 privileges: Request / Approve / Complete / View Bill Refunds\\n  - billing.refundEnabled feature flag\\n\\n* Update `BillRefundService` active refund criteria and fix indentation in `liquibase.xml`\\n\\n- Exclude `COMPLETED` refunds from active criteria in `BillRefundService` to clarify refund status lifecycle.\\n- Adjust indentation for `<createTable>` in `liquibase.xml` for consistency.\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"da2f5958f52b2e0b8999f37ed3a5a86797a80137\",\"date\":\"2026-05-07T19:37:06+05:30\",\"message\":\"O3 5417: Bill Discount Management with Audit Trail (#160)\",\"refs\":\"\",\"body\":\"* Bill Discount\\n\\n* Add tests and fix mapping for BillDiscount functionality\\n\\n* Refactor `saveBillDiscount` method placement across DAO and service layers\\n\\n* Support multiple discounts per bill and add `getActiveDiscount` functionality\\n\\n* Refactor BillDiscountValidator to use predefined set for eligible statuses\\n\\n* Add Line Item Discount\\n\\n* Fix issues\\n\\n* Fix issues\\n\\n* Apply standard OpenMRS MPL license headers across billing module files\\n\\n* Refactor discount logic to dynamically compute discount amounts and remove persisted `discount_amount` field\\n\\n* Refactor `BillDiscountValidator` to handle self-exclusion and enforce validation on updates, add regression tests\\n\\n* Add `getActiveDiscounts` method to `Bill` and update REST representation to exclude voided discounts\\n\\n* Update `Bill` REST representation to include active discounts and exclude voided discounts\\n\\n* Allow voided discounts to bypass validation rules and enforce required `bill` query parameter for discount search\\n\\n* Add `DiscountStatus` to manage discount approval workflow and update related logic, validations, and tests\\n\\n* Refactor: Remove redundant blank lines across billing module files, improve readability in tests, services, DAOs, and REST resources\\n\\n* Validate `APPROVED/REJECTED` discount reversal with privilege check, enforce non-null entity validation in REST setters, and ensure non-negative total in `Bill`.\\n\\n* Remove redundant blank lines in `Bill` model and `BillDiscountResource` class.\\n\\n* Implement discount status validation, enforce drift guard for excessive discounts, and update related tests and services\\n\\n* Add log warning for discount drift, enhance null validation, and improve REST conversion handling\\n\\n- Annotated `Bill` with `@Slf4j` for logging support.\\n- Added `addDiscount` method with null validation for discounts in `Bill`.\\n- Logged warnings for discount drift in bill processing.\\n- Simplified `getDiscountAmount` documentation in `BillDiscount`.\\n- Enhanced validation messages and handling in `BillDiscountValidator`, including concurrent row checks.\\n- Improved `BigDecimal` conversion error handling in `BillDiscountResource` with meaningful exception messages.\\n- Updated `BillResource` to explicitly exclude discounts in creatable properties.\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"56878333a0b52e16d532a2db7e2e9ba4d074a802\",\"date\":\"2026-05-04T09:06:29+05:30\",\"message\":\"Migrate build to maven-parent-openmrs-module 2.1.0 (#163)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"b741725ef3dcd816960b8bfa8859e1a72b5c68ca\",\"date\":\"2026-04-28T15:13:10+05:30\",\"message\":\"Apply standard OpenMRS MPL license headers (#162)\",\"refs\":\"\",\"body\":\"Co-authored-by: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"62557825f005a3c4430519d6fa69317df9111161\",\"date\":\"2026-04-28T11:06:09+05:30\",\"message\":\"Add permissions for GitHub Actions workflow (#161)\",\"refs\":\"\",\"body\":\"* Add permissions for GitHub Actions workflow\\n\\n* Fix indentation in build.yml permissions section\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"9985fc96f472b757fb47281937a9fbdbb14e43ea\",\"date\":\"2026-04-18T09:32:59-04:00\",\"message\":\"Drop obsolete run_owasp_check input and unused secrets\",\"refs\":\"\",\"body\":\"build-backend-module.yml no longer accepts run_owasp_check as an input,\\nand explicit undeclared secrets fail the workflow. Move the OWASP check\\ninto its own owasp-dependency-check.yml job that only runs on push /\\nworkflow_dispatch, and prune the build job's secrets to just the Maven\\ncredentials it actually consumes.\\n\",\"authorName\":\"Ian\",\"authorEmail\":\"ian.c.bacher@gmail.com\"},{\"hash\":\"e112d46bb9fa4b92d008b07f107528f1bcc3a315\",\"date\":\"2026-04-17T19:28:37+05:30\",\"message\":\"O3-5370: Auto-Generate Billable Items from Medication Orders (#156)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"a5e55249986519b18a851e28443928473ed0ffda\",\"date\":\"2026-04-13T17:26:52-04:00\",\"message\":\"Separate OWASP dependency check into its own job (#159)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Ian\",\"authorEmail\":\"52504170+ibacher@users.noreply.github.com\"},{\"hash\":\"b52412a0a7925469183c2590937d6720228f9ec6\",\"date\":\"2026-04-01T20:34:56+05:30\",\"message\":\"Payments should be associated with a cashier (#155)\",\"refs\":\"\",\"body\":\"* feat: add cashier (Provider) field to Payment model and HBM mapping\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* feat: add Liquibase migration for provider_id and error message key\\n\\n* feat: validate that new payments have an associated cashier\\n\\n* test: set cashier on payment in BillServiceImplTest\\n\\n* feat: auto-set cashier on payment from authenticated user; expose in REST representation\\n\\n* fix: run cashier validation before line-item DB query to avoid Hibernate auto-flush\\n\\nSwapped order so validateNewPaymentsHaveCashier runs before\\nvalidateLineItemsNotModified. The latter triggers a DB query that causes\\nHibernate to auto-flush transient payments, assigning them IDs and making\\nthe id==null check ineffective.\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* Allow client to set cashier\\n\\n* Update liquibase\\n\\n* test: move validator tests to BillValidatorTest and add voided payment edge case\\n\\nRelocates payment-cashier and line-item validation tests from\\nBillServiceImplTest to BillValidatorTest so each test class covers its\\nown layer. Adds validate_shouldTolerateVoidedNewPaymentWithNoCashier to\\ncover the voided-payment branch in BillValidator.\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* test: verify BillValidator cashier check is triggered via saveBill; require cashier in payment test\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n* chore: address PR review comments\\n\\n- Delegate getCurrentCashier() to ProviderUtil.getCurrentProvider() to remove duplication\\n- Migrate PaymentResourceTest from JUnit4 to JUnit5\\n- Add trailing newline to liquibase.xml\\n\\nCo-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>\\n\\n* chore: address PR review comments\\n\\n- Fix mixed tabs/spaces indentation in liquibase changeset\\n- Add null/blank UUID check in PaymentResource.setCashier\\n- Improve error message accuracy in BillResource\\n\\nCo-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>\\n\\n* chore: address PR review comments\\n\\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>\\n\\n---------\\n\\nCo-authored-by: Claude Sonnet 4.6 <noreply@anthropic.com>\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"42adbbca40343fbe1b378727aaf67c9e3eeb2afe\",\"date\":\"2026-03-30T20:57:03+05:30\",\"message\":\"(fix) O3-5477: Sort bills in the descending order of created date (#148)\",\"refs\":\"\",\"body\":\"* O3-5370: Sort Bill List in Descending Order (Newest First)\\n\\n* minor change\\n\\n* Enhancement\\n\\n* Enhancement\\n\\n* remove\",\"authorName\":\"Raj Prakash\",\"authorEmail\":\"rjnt452@gmail.com\"},{\"hash\":\"177823147533d83248360b5198e45079cf61d185\",\"date\":\"2026-03-20T21:07:01+05:30\",\"message\":\"(fix) O3-5519: Update the bot token secret key name in build workflow (#153)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Kavitha Kanchana\",\"authorEmail\":\"146015143+kanchana404@users.noreply.github.com\"},{\"hash\":\"f7ab185b4cd053174ac235a7beef6c0ac5864b86\",\"date\":\"2026-03-18T17:04:12+05:30\",\"message\":\"Update build workflow to use main branch\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Jayasanka Weerasinghe\",\"authorEmail\":\"33048395+jayasanka-sack@users.noreply.github.com\"},{\"hash\":\"d94591c16fa1b81e96cbf0fd5c3d4d0805353e52\",\"date\":\"2026-03-18T17:02:37+05:30\",\"message\":\"Modify build workflow for additional branch and secrets\",\"refs\":\"\",\"body\":\"Updated the build workflow to include the 'vulnerability-dashboard' branch and added a new secret for the OMRS bot GitHub token.\",\"authorName\":\"Jayasanka Weerasinghe\",\"authorEmail\":\"33048395+jayasanka-sack@users.noreply.github.com\"},{\"hash\":\"5d297ea453dfe841af1531c1bb6f3b03d33e3479\",\"date\":\"2026-03-13T12:37:04+05:30\",\"message\":\"Update build.yml (#150)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"1ec9e7c348613e53a36843f81c3c13a8dde14a61\",\"date\":\"2026-03-13T12:27:07+05:30\",\"message\":\"Migrate to Reusable GitHub Action (#149)\",\"refs\":\"\",\"body\":\"* Migrate to Reusable GitHub Action\\n\\n* Migrate to Reusable GitHub Action\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"7bf75db366a4f0b02213502475802465a2662de7\",\"date\":\"2026-03-05T19:27:21Z\",\"message\":\"[maven-release-plugin] prepare for next development iteration\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"info@openmrs.org\"},{\"hash\":\"cffaec79c85219934700931d319b0f9cf701fb2f\",\"date\":\"2026-03-05T19:27:20Z\",\"message\":\"[maven-release-plugin] prepare release v2.2.0\",\"refs\":\"tag: v2.2.0\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"info@openmrs.org\"},{\"hash\":\"7dfc3af97f42e94050d309742e38b580d3d8870e\",\"date\":\"2026-03-05T20:18:46+05:30\",\"message\":\"Revert \\\"O3-5197: Each payment should have an associated Cashier\\\" (#147)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"663c50261b1b43980722a0d660a50e0dd9e4ee96\",\"date\":\"2026-03-04T16:10:16+05:30\",\"message\":\"Use MEDIUM date format style in receipt generator (#146)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"edd63790481fe565d8dbeb767a1ac8f29a1fb636\",\"date\":\"2026-03-04T11:07:07+05:30\",\"message\":\"O3-5197: Each payment should have an associated Cashier (#109)\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"}],\"totalCount\":221}"}}

