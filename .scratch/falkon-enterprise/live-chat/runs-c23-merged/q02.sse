data: {"type":"tool-output-available","toolCallId":"call-a3045ed1-843f-4dd3-9fbd-796484ed5780","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/db/hibernate/HibernateBillDAO.java</path>\n<url>undefined</url>\n<content>\n100: \t\tcq.where(predicate);\n101: \t\tcq.orderBy(cb.desc(root.get(FIELD_DATE_CREATED)));\n102: \t\t\n103: \t\tTypedQuery<Bill> query = session.createQuery(cq);\n104: \t\t\n105: \t\tList<Predicate> predicates = new ArrayList<>();\n106: \t\tpredicates.add(predicate);\n107: \t\tapplyPaging(query, pagingInfo, predicates, sessionFactory, Bill.class);\n108: \t\t\n109: \t\treturn query.getResultList();\n110: \t}\n111: \t\n112: \t/**\n113: \t * {@inheritDoc}\n114: \t */\n115: \t@Override\n116: \tpublic List<Bill> getBills(@Nonnull BillSearch billSearch, PagingInfo pagingInfo) {\n117: \t\tSession session = sessionFactory.getCurrentSession();\n118: \t\t\n119: \t\tCriteriaBuilder cb = session.getCriteriaBuilder();\n120: \t\tCriteriaQuery<Bill> cq = cb.createQuery(Bill.class);\n121: \t\tRoot<Bill> root = cq.from(Bill.class);\n122: \t\t\n123: \t\tList<Predicate> predicates = buildBillSearchPredicate(cb, cq, root, billSearch);\n124: \t\t\n125: \t\tif (!predicates.isEmpty()) {\n126: \t\t\tcq.where(predicates.toArray(new Predicate[0]));\n127: \t\t}\n128: \t\tcq.orderBy(cb.desc(root.get(FIELD_DATE_CREATED)));\n129: \t\t\n130: \t\tTypedQuery<Bill> query = session.createQuery(cq);\n131: \t\t\n132: \t\tapplyPaging(query, pagingInfo, predicates, sessionFactory, Bill.class);\n133: \t\t\n134: \t\treturn query.getResultList();\n135: \t}\n136: \t\n137: \t/**\n138: \t * {@inheritDoc}\n139: \t */\n140: \t@Override\n141: \tpublic Bill saveBill(@Nonnull Bill bill) {\n142: \t\tsessionFactory.getCurrentSession().saveOrUpdate(bill);\n143: \t\treturn bill;\n144: \t}\n145: \t\n146: \t/**\n147: \t * {@inheritDoc}\n148: \t */\n149: \t@Override\n150: \tpublic void purgeBill(@Nonnull Bill bill) {\n151: \t\tsessionFactory.getCurrentSession().remove(bill);\n152: \t}\n153: \t\n154: \tprivate List<Predicate> buildBillSearchPredicate(CriteriaBuilder cb, CriteriaQuery<?> cq, Root<Bill> root,\n155: \t        BillSearch billSearch) {\n156: \t\tList<Predicate> predicates = new ArrayList<>();\n157: \t\t\n158: \t\tif (billSearch.getPatientUuid() != null) {\n159: \t\t\tpredicates.add(cb.equal(root.get(\"patient\").get(\"uuid\"), billSearch.getPatientUuid()));\n160: \t\t}\n161: \t\t\n162: \t\tif (StringUtils.isNotBlank(billSearch.getPatientName())) {\n163: \t\t\tpredicates.add(buildPatientNamePredicate(cb, root, billSearch.getPatientName()));\n164: \t\t}\n165: \t\t\n166: \t\tif (StringUtils.isNotEmpty(billSearch.getCashierUuid())) {\n167: \t\t\tpredicates.add(cb.equal(root.get(\"cashier\").get(\"uuid\"), billSearch.getCashierUuid()));\n168: \t\t}\n169: \t\t\n170: \t\tif (billSearch.getCashPointUuid() != null) {\n171: \t\t\tpredicates.add(cb.equal(root.get(\"cashPoint\").get(\"uuid\"), billSearch.getCashPointUuid()));\n172: \t\t}\n173: \t\t\n174: \t\tif (billSearch.getVisitUuid() != null) {\n175: \t\t\tpredicates.add(cb.equal(root.get(\"visit\").get(\"uuid\"), billSearch.getVisitUuid()));\n176: \t\t}\n177: \t\t\n178: \t\tif (StringUtils.isNotBlank(billSearch.getLocationUuid())) {\n179: \t\t\tpredicates.add(cb.equal(root.get(\"cashPoint\").get(\"location\").get(\"uuid\"), billSearch.getLocationUuid()));\n180: \t\t}\n181: \t\t\n182: \t\tif (billSearch.getStartDate() != null) {\n183: \t\t\tpredicates.add(cb.greaterThanOrEqualTo(root.get(FIELD_DATE_CREATED), billSearch.getStartDate()));\n184: \t\t}\n185: \t\t\n186: \t\tif (billSearch.getEndDate() != null) {\n187: \t\t\tpredicates.add(cb.lessThanOrEqualTo(root.get(FIELD_DATE_CREATED), billSearch.getEndDate()));\n188: \t\t}\n189: \t\t\n190: \t\tif (billSearch.getStatuses() != null && !billSearch.getStatuses().isEmpty()) {\n191: \t\t\tpredicates.add(root.get(FIELD_STATUS).in(billSearch.getStatuses()));\n192: \t\t}\n193: \t\t\n194: \t\tif (!Boolean.TRUE.equals(billSearch.getIncludeVoided())) {\n195: \t\t\tpredicates.add(cb.equal(root.get(FIELD_VOIDED), false));\n196: \t\t}\n197: \t\t\n198: \t\tif (billSearch.getDiscountStatuses() != null && !billSearch.getDiscountStatuses().isEmpty()) {\n199: \t\t\tSubquery<Integer> sub = cq.subquery(Integer.class);\n200: \t\t\tRoot<BillDiscount> discountRoot = sub.from(BillDiscount.class);\n201: \t\t\tsub.select(cb.literal(1)).where(cb.equal(discountRoot.get(\"bill\"), root),\n202: \t\t\t    cb.equal(discountRoot.get(FIELD_VOIDED), false),\n203: \t\t\t    discountRoot.get(FIELD_STATUS).in(billSearch.getDiscountStatuses()));\n204: \t\t\tpredicates.add(cb.exists(sub));\n205: \t\t}\n206: \t\t\n207: \t\tif (billSearch.getRefundStatuses() != null && !billSearch.getRefundStatuses().isEmpty()) {\n208: \t\t\tSubquery<Integer> sub = cq.subquery(Integer.class);\n209: \t\t\tRoot<BillRefund> refundRoot = sub.from(BillRefund.class);\n210: \t\t\tsub.select(cb.literal(1)).where(cb.equal(refundRoot.get(\"bill\"), root),\n211: \t\t\t    cb.equal(refundRoot.get(FIELD_VOIDED), false),\n212: \t\t\t    refundRoot.get(FIELD_STATUS).in(billSearch.getRefundStatuses()));\n213: \t\t\tpredicates.add(cb.exists(sub));\n214: \t\t}\n215: \t\t\n216: \t\treturn predicates;\n217: \t}\n218: \t\n219: \tprivate Predicate buildPatientNamePredicate(CriteriaBuilder cb, Root<Bill> root, String patientName) {\n\n(Showing lines 100-219 of 229. Use offset=220 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/db/hibernate/HibernateBillDAO.java","name":"HibernateBillDAO.java","revision":"HEAD"}]}}

