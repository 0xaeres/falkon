data: {"type":"tool-output-available","toolCallId":"call-c8ba2f02-1f31-4163-b2b1-3f3364166d0e","output":{"output":"<repo>github.com/openmrs/openmrs-esm-billing-app</repo>\n<path>src/billing.resource.ts</path>\n<url>undefined</url>\n<content>\n1: import useSWR, { type KeyedMutator } from 'swr';\n2: import dayjs from 'dayjs';\n3: import sortBy from 'lodash-es/sortBy';\n4: import {\n5:   openmrsFetch,\n6:   useSession,\n7:   useVisit,\n8:   type SessionLocation,\n9:   useOpenmrsFetchAll,\n10:   useOpenmrsPagination,\n11: } from '@openmrs/esm-framework';\n12: import { apiBasePath, omrsDateFormat } from './constants';\n13: import {\n14:   type MappedBill,\n15:   type PatientInvoice,\n16:   type BillableItem,\n17:   type PaymentRequestPayload,\n18:   type CreateBillPayload,\n19:   type UpdateBillPayload,\n20:   BillStatus,\n21:   type PatientPaymentStatus,\n22: } from './types';\n23: \n24: const parsePatientDisplay = (display: string | undefined): { identifier: string; name: string } => {\n25:   if (!display) {\n26:     return { identifier: '', name: '' };\n27:   }\n28: \n29:   const separator = ' - ';\n30:   const index = display.indexOf(separator);\n31: \n32:   if (index === -1) {\n33:     return { identifier: '', name: display.trim() };\n34:   }\n35: \n36:   return {\n37:     identifier: display.substring(0, index).trim(),\n38:     name: display.substring(index + separator.length).trim(),\n39:   };\n40: };\n41: \n42: export const mapBillProperties = (bill: PatientInvoice): MappedBill => {\n43:   const activeLineItems = bill?.lineItems?.filter((item) => !item.voided) ?? [];\n44:   const { identifier, name } = parsePatientDisplay(bill?.patient?.display);\n45: \n46:   return {\n47:     ...bill,\n48:     patientName: name,\n49:     identifier: identifier,\n50:     patientUuid: bill?.patient?.uuid,\n51:     visitUuid: bill?.visit?.uuid,\n52:     cashPointUuid: bill?.cashPoint?.uuid,\n53:     cashPointName: bill?.cashPoint?.name,\n54:     cashPointLocation: bill?.cashPoint?.location?.display,\n55:     status: bill.status as BillStatus,\n56:     lineItems: activeLineItems,\n57:     billingService: activeLineItems.map((lineItem) => lineItem?.item || lineItem?.billableService || '--').join('  '),\n58:     totalAmount: bill.total,\n59:     netAmount: bill.amountAfterDiscount,\n60:     tenderedAmount: (bill?.payments ?? [])\n61:       .map((item) => item.amountTendered ?? 0)\n62:       .reduce((prev, curr) => prev + curr, 0),\n63:   };\n64: };\n65: \n66: export const usePaginatedBills = (\n67:   pageSize: number,\n68:   status?: string,\n69:   patientName?: string,\n70:   startDate?: Date | null,\n71:   endDate?: Date | null,\n72: ) => {\n73:   const customRepresentation =\n74:     '(id,uuid,dateCreated,status,receiptNumber,patient:(uuid,display),lineItems:(uuid,item,billableService,voided))';\n75: \n76:   let url = `${apiBasePath}bill?v=custom:${customRepresentation}&pageSize=${pageSize}`;\n77: \n78:   if (status) {\n79:     url += `&status=${status}`;\n80:   }\n81: \n82:   if (patientName) {\n83:     url += `&patientName=${encodeURIComponent(patientName)}`;\n84:   }\n85: \n86:   if (startDate) {\n87:     url += `&startDate=${encodeURIComponent(dayjs(startDate).startOf('day').format(omrsDateFormat))}`;\n88:   }\n89: \n90:   if (endDate) {\n91:     url += `&endDate=${encodeURIComponent(dayjs(endDate).endOf('day').format(omrsDateFormat))}`;\n92:   }\n93: \n94:   // The backend rejects an inverted range with a 400, so skip the request (null URL disables fetching)\n95:   const isRangeValid = !startDate || !endDate || startDate <= endDate;\n96:   const { data, error, isLoading, isValidating, mutate, currentPage, totalCount, goTo } =\n97:     useOpenmrsPagination<PatientInvoice>(isRangeValid ? url : null, pageSize);\n98: \n99:   // Backend already sorts by ID descending (newest first), so no need to sort on frontend\n100:   const mappedResults = data?.map((bill) => mapBillProperties(bill)) ?? [];\n101: \n102:   return {\n103:     bills: mappedResults,\n104:     error,\n105:     isLoading,\n106:     isValidating,\n107:     mutate,\n108:     currentPage,\n109:     totalCount,\n110:     goTo,\n111:   };\n112: };\n113: \n114: export const useBills = (patientUuid?: string, billStatus?: string, visitUuid?: string) => {\n115:   let url = `${apiBasePath}bill?v=full`;\n116: \n117:   if (patientUuid) {\n118:     url += `&patientUuid=${patientUuid}`;\n119:   }\n120: \n121:   if (billStatus) {\n122:     url += `&status=${billStatus}`;\n123:   }\n124: \n125:   if (visitUuid) {\n126:     url += `&visitUuid=${visitUuid}`;\n127:   }\n128: \n129:   const { data, error, isLoading, isValidating, mutate } = useOpenmrsFetchAll<PatientInvoice>(url);\n130: \n131:   const sortedBills = sortBy(data ?? [], ['dateCreated']).reverse();\n132:   const mappedResults = sortedBills?.map((bill) => mapBillProperties(bill));\n133: \n134:   return {\n135:     bills: mappedResults,\n136:     error,\n137:     isLoading,\n138:     isValidating,\n139:     mutate,\n140:   };\n141: };\n142: \n143: export function useBill(\n144:   billUuid: string,\n145:   mapProperties: false,\n146: ): {\n147:   bill: PatientInvoice | null;\n148:   error: any;\n149:   isLoading: boolean;\n150:   isValidating: boolean;\n151:   mutate: KeyedMutator<{ data: PatientInvoice }>;\n152: };\n153: \n154: export function useBill(\n155:   billUuid: string,\n156:   mapProperties?: true,\n157: ): {\n158:   bill: MappedBill | null;\n159:   error: any;\n160:   isLoading: boolean;\n161:   isValidating: boolean;\n162:   mutate: KeyedMutator<{ data: PatientInvoice }>;\n163: };\n164: \n165: export function useBill(billUuid: string, mapProperties = true) {\n166:   const url = `${apiBasePath}bill/${billUuid}`;\n167:   const { data, error, isLoading, isValidating, mutate } = useSWR<{ data: PatientInvoice }>(\n168:     billUuid ? url : null,\n169:     openmrsFetch,\n170:   );\n171: \n172:   let bill: MappedBill | PatientInvoice | null = null;\n173:   if (data?.data) {\n174:     bill = mapProperties ? mapBillProperties(data.data) : data.data;\n175:   }\n176: \n177:   return { bill, error, isLoading, isValidating, mutate };\n178: }\n179: \n180: export const processBillPayment = (payload: PaymentRequestPayload, billUuid: string) => {\n181:   const url = `${apiBasePath}bill/${billUuid}/payment`;\n182: \n183:   return openmrsFetch(url, {\n\n(Output capped at 5KB. Showing lines 1-183 of 281. Use offset=184 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/billing.resource.ts","name":"billing.resource.ts","revision":"HEAD"}]}}

