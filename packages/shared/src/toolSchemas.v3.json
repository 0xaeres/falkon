{
  "ask": {
    "grep": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Regular expression to look for inside files."
        },
        "path": {
          "type": "string",
          "description": "Only search this directory (default: the repository root)."
        },
        "include": {
          "type": "string",
          "description": "Glob that file names must match, e.g. \"*.js\" or \"*.{ts,tsx}\"."
        },
        "repo": {
          "type": "string",
          "description": "Repository to search. Omit to search all of them."
        },
        "ref": {
          "type": "string",
          "description": "Commit SHA, branch or tag to search (default: the default branch)."
        },
        "limit": {
          "type": "number",
          "description": "Most matches to return (default 100, or 10000 when groupByRepo is true)."
        },
        "groupByRepo": {
          "type": "boolean",
          "description": "When true, return match and file counts per repository rather than individual file results."
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "glob": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Glob matched against file paths, e.g. \"**/*.ts\" or \"src/**/*.test.{ts,tsx}\"."
        },
        "path": {
          "type": "string",
          "description": "Only return files below this subdirectory."
        },
        "repo": {
          "type": "string",
          "description": "Repository to search. Omit to search all of them."
        },
        "ref": {
          "type": "string",
          "description": "Commit SHA, branch or tag to search (default: the default branch)."
        },
        "limit": {
          "type": "number",
          "description": "Most files to return (default 100)."
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "get_diff": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Full repository name."
        },
        "base": {
          "type": "string",
          "description": "Ref (branch, tag or commit SHA) to compare from."
        },
        "head": {
          "type": "string",
          "description": "Ref (branch, tag or commit SHA) to compare to."
        },
        "path": {
          "type": "string",
          "description": "Only include changes to this file. Omit to include every change between the two refs."
        }
      },
      "required": [
        "repo",
        "base",
        "head"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_commits": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository whose commits to list."
        },
        "query": {
          "type": "string",
          "description": "Text to find in commit messages (case-insensitive)."
        },
        "since": {
          "type": "string",
          "description": "Earliest date to include: an ISO date like '2024-01-01' or relative text like 'last week'."
        },
        "until": {
          "type": "string",
          "description": "Latest date to include: an ISO date like '2024-12-31' or relative text like 'yesterday'."
        },
        "author": {
          "type": "string",
          "description": "Part of an author's name or email (case-insensitive)."
        },
        "ref": {
          "type": "string",
          "description": "Commit SHA, branch or tag to list history of (default: the default branch)."
        },
        "path": {
          "type": "string",
          "description": "Only commits touching this file or directory, relative to the repository root."
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Page number, starting at 1 (default 1).",
          "default": 1
        },
        "perPage": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Commits per page, 1 to 100 (default 50).",
          "default": 50
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_branches": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository whose branches to list."
        },
        "query": {
          "type": "string",
          "description": "Keep only branches whose name contains this text (case-insensitive)."
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Page number, starting at 1 (default 1).",
          "default": 1
        },
        "perPage": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Branches per page, 1 to 100 (default 50).",
          "default": 50
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_repos": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Keep only repositories whose name contains this text (case-insensitive)."
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Page number, starting at 1 (default 1).",
          "default": 1
        },
        "perPage": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Repositories per page, 1 to 100 (default 30).",
          "default": 30
        },
        "sort": {
          "type": "string",
          "enum": [
            "name",
            "pushed"
          ],
          "description": "Order by 'name' or by 'pushed' (latest commit). Default 'name'.",
          "default": "name"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "description": "'asc' or 'desc'. Default 'asc'.",
          "default": "asc"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "read_file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path of the file inside the repository."
        },
        "repo": {
          "type": "string",
          "description": "Repository that holds the file."
        },
        "ref": {
          "type": "string",
          "description": "Commit SHA, branch or tag to read the file at (default: the default branch).",
          "default": "HEAD"
        },
        "offset": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "First line to return, 1-based. Omit to start at the top."
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Number of lines to return, at most 500. Omit for up to 500."
        }
      },
      "required": [
        "path",
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_tree": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository to list."
        },
        "path": {
          "type": "string",
          "description": "Directory to list, relative to the repository root. Omit for the root.",
          "default": ""
        },
        "ref": {
          "type": "string",
          "description": "Commit SHA, branch or tag to list at (default: the default branch).",
          "default": "HEAD"
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10,
          "description": "Directory levels to descend below `path`, 1 to 10 (default 1).",
          "default": 1
        },
        "includeFiles": {
          "type": "boolean",
          "description": "Return file entries (default true).",
          "default": true
        },
        "includeDirectories": {
          "type": "boolean",
          "description": "Return directory entries (default true).",
          "default": true
        },
        "maxEntries": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "description": "Most entries to return, 1 to 10000 (default 1000).",
          "default": 1000
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "find_symbol_definitions": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Exact name of the symbol to find definitions of."
        },
        "repo": {
          "type": "string",
          "description": "Repository to search in."
        }
      },
      "required": [
        "symbol",
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "find_symbol_references": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Exact name of the symbol to find uses of."
        },
        "repo": {
          "type": "string",
          "description": "Repository to search in."
        }
      },
      "required": [
        "symbol",
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "kb": {
    "list_tree": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository name; defaults to the repository being documented"
        },
        "prefix": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "read_file": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository name; defaults to the repository being documented"
        },
        "path": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "grep": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository name; defaults to the repository being documented"
        },
        "pattern": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "log_history": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository name; defaults to the repository being documented"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_candidate_systems": {
      "type": "object",
      "properties": {
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "thesis": {
                "type": "string"
              },
              "evidenceAnchors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "thesis",
              "evidenceAnchors"
            ],
            "additionalProperties": false
          }
        },
        "territoryTooBig": {
          "type": "boolean"
        }
      },
      "required": [
        "systems"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_system_list": {
      "type": "object",
      "properties": {
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "thesis": {
                "type": "string"
              },
              "evidenceAnchors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assignedDocPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "slug",
              "name",
              "thesis",
              "evidenceAnchors",
              "assignedDocPaths"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "systems"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_system_report": {
      "type": "object",
      "properties": {
        "proposedNewDocs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "keyClaims": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "3-8 claims, each naming a repository file that proves it"
              },
              "keyFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "rationale",
              "keyClaims",
              "keyFiles"
            ],
            "additionalProperties": false
          }
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "keep",
                  "merge",
                  "delete"
                ]
              },
              "mergeInto": {
                "type": "string"
              },
              "keyClaims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keyFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "disposition"
            ],
            "additionalProperties": false
          }
        },
        "systemSummary": {
          "type": "string"
        }
      },
      "required": [
        "proposedNewDocs",
        "dispositions",
        "systemSummary"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_work_list": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "keep",
                  "create",
                  "merge"
                ]
              },
              "absorbs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "system": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "system",
                    "path"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "path",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "deletes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "items",
        "deletes"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "write_doc": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "body"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "edit_doc": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "oldText": {
          "type": "string",
          "minLength": 1
        },
        "newText": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "oldText",
        "newText"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "finish_doc": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One plain sentence: when to read this document and what it covers."
        }
      },
      "required": [
        "path",
        "summary"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "delete_absorbed_doc": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_narrative": {
      "type": "object",
      "properties": {
        "narrative": {
          "type": "string"
        }
      },
      "required": [
        "narrative"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
}
