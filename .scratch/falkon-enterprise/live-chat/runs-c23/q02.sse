data: {"type":"data-evidence","data":{"id":32,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/impl/BillServiceImpl.java","revision":"HEAD","startLine":68,"code":["\t/**","\t * {@inheritDoc}","\t */","\t@Override","\t@Transactional","\tpublic Bill saveBill(Bill bill) {","\t\tif (bill == null) {","\t\t\tthrow new NullPointerException(\"The bill must be defined.\");","\t\t}","\t\treturn billDAO.saveBill(bill);","\t}","\t","\t/**","\t * {@inheritDoc}"],"highlightedLines":[71,72,73,74,75,76,77,78]}}

data: {"type":"data-evidence","data":{"id":33,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/db/hibernate/HibernateBillDAO.java","revision":"HEAD","startLine":137,"code":["\t/**","\t * {@inheritDoc}","\t */","\t@Override","\tpublic Bill saveBill(@Nonnull Bill bill) {","\t\tsessionFactory.getCurrentSession().saveOrUpdate(bill);","\t\treturn bill;","\t}","\t","\t/**","\t * {@inheritDoc}"],"highlightedLines":[140,141,142,143,144]}}

