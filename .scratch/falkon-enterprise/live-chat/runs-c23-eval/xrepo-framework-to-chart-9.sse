data: {"type":"tool-output-available","toolCallId":"call-ceae8dc5-ba6f-4801-a2f8-9ffe38e5dd82","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-react-utils/src/useVisit.ts</path>\n<url>undefined</url>\n<content>\n124:   useEffect(() => {\n125:     mutateVisitRef.current = mutateVisit;\n126:   }, [mutateVisit]);\n127: \n128:   const waitingForData = Boolean(!activeData || (retrospectiveVisitUuid && !retroData));\n129:   const hasRelevantError = Boolean(retrospectiveVisitUuid ? retroError : activeError);\n130:   const isLoading = waitingForData && !hasRelevantError;\n131: \n132:   return {\n133:     error: activeError || retroError,\n134:     mutate: mutateVisit,\n135:     isValidating: activeIsValidating || retroIsValidating,\n136:     activeVisit,\n137:     currentVisit,\n138:     currentVisitIsRetrospective: Boolean(retrospectiveVisitUuid),\n139:     isLoading,\n140:   };\n141: }\n142: \n\n(End of file - 142 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-react-utils/src/useVisit.ts","name":"useVisit.ts","revision":"HEAD"}]}}

