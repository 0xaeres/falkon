{
  "defaults": { "matches": 200, "contextLines": 1 },
  "queries": [
    { "id": "om-lit-service", "query": "PatientService" },
    { "id": "om-lit-and", "query": "getPatientByUuid return" },
    { "id": "om-lit-case", "query": "patientservice", "isCaseSensitivityEnabled": true },
    { "id": "om-lit-quoted", "query": "\"@Transactional(readOnly = true)\"" },
    { "id": "om-lit-annotation", "query": "@Authorized" },
    { "id": "om-lit-common", "query": "import", "matches": 500 },
    { "id": "om-lit-ts", "query": "useConfig" },
    { "id": "om-lit-call", "query": "openmrsFetch(" },
    { "id": "om-lit-unbalanced", "query": "(patient" },
    { "id": "om-or", "query": "ConceptService or EncounterService" },
    { "id": "om-paren", "query": "(Obs or Encounter) file:\\.java$ save" },
    { "id": "om-negate-file", "query": "PatientService -file:test" },
    { "id": "om-negate-group", "query": "Visit -(file:\\.ts$ or file:\\.tsx$)" },
    { "id": "om-repo", "query": "repo:openmrs-core Concept" },
    { "id": "om-repo-short", "query": "r:fhir2 Translator" },
    { "id": "om-repo-anchored", "query": "repo:^github\\.com/openmrs/openmrs-core$ class" },
    { "id": "om-repo-alt", "query": "repo:(billing|stock) Item" },
    { "id": "om-repo-only", "query": "repo:esm-patient-chart" },
    { "id": "om-reposet", "query": "reposet:github.com/openmrs/openmrs-core,github.com/openmrs/openmrs-module-fhir2 Patient" },
    { "id": "om-file", "query": "file:pom\\.xml$ openmrs" },
    { "id": "om-file-only", "query": "file:liquibase" },
    { "id": "om-file-alt", "query": "file:(test|spec) expect" },
    { "id": "om-file-case", "query": "file:README", "isCaseSensitivityEnabled": true },
    { "id": "om-lang-java", "query": "lang:java interface" },
    { "id": "om-lang-ts", "query": "lang:typescript export const" },
    { "id": "om-lang-tsx", "query": "lang:tsx useState" },
    { "id": "om-lang-xml", "query": "lang:xml changeSet" },
    { "id": "om-lang-md", "query": "lang:markdown install" },
    { "id": "om-lang-negate", "query": "Patient -lang:java" },
    { "id": "om-sym-class", "query": "sym:PatientServiceImpl" },
    { "id": "om-sym-method", "query": "sym:getPatient" },
    { "id": "om-sym-regex", "query": "sym:^save.*Encounter$" },
    { "id": "om-sym-repo", "query": "sym:Translator repo:fhir2" },
    { "id": "om-content", "query": "content:Concept file:Concept" },
    { "id": "om-rev-star", "query": "PatientService rev:*" },
    { "id": "om-rev-head", "query": "PatientService rev:HEAD" },
    { "id": "om-archived", "query": "Patient archived:no" },
    { "id": "om-fork", "query": "Patient fork:no" },
    { "id": "om-visibility", "query": "Patient visibility:public" },
    { "id": "om-re-alt", "query": "(Patient|Person)Service", "isRegexEnabled": true },
    { "id": "om-re-anchor", "query": "^public interface \\w+Service", "isRegexEnabled": true },
    { "id": "om-re-class", "query": "get[A-Z]\\w+ByUuid\\(", "isRegexEnabled": true },
    { "id": "om-re-group-filters", "query": "(file:\\.java$ or file:\\.ts$) Allergy", "isRegexEnabled": true },
    { "id": "om-re-multiline", "query": "@Override\\s+public", "isRegexEnabled": true },
    { "id": "om-re-invalid", "query": "(unclosed", "isRegexEnabled": true },
    { "id": "om-combo", "query": "repo:openmrs-core lang:java file:api -file:test sym:Service" },
    { "id": "om-ctx-0", "query": "PatientService repo:openmrs-core file:PatientService\\.java$", "contextLines": 0 },
    { "id": "om-ctx-3", "query": "voidPatient repo:openmrs-core", "contextLines": 3 },
    { "id": "om-whole", "query": "file:PatientService\\.java$ repo:openmrs-core interface", "whole": true },
    { "id": "om-limit-small", "query": "Patient", "matches": 10 },
    { "id": "om-limit-big", "query": "Patient", "matches": 2000 },
    { "id": "om-err-empty", "query": "" },
    { "id": "om-err-context", "query": "context:nope Patient" },
    { "id": "om-err-bad-value", "query": "fork:maybe x" }
  ]
}
