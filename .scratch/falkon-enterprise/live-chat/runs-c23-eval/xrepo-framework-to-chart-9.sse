data: {"type":"tool-output-available","toolCallId":"call-011a1cf0-e80b-4eba-9d3b-9daec5869a93","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-chart-app/src/patient-chart/patient-chart.resources.ts</path>\n<url>undefined</url>\n<content>\n1: import { useCallback, useEffect, useMemo, useRef } from 'react';\n2: import { useTranslation } from 'react-i18next';\n3: import useSWR from 'swr';\n4: import {\n5:   launchWorkspaceGroup2,\n6:   openmrsFetch,\n7:   restBaseUrl,\n8:   showSnackbar,\n9:   usePatient,\n10:   useVisit,\n11:   type Visit,\n12: } from '@openmrs/esm-framework';\n13: import {\n14:   type PatientWorkspaceGroupProps,\n15:   setPatientChartWorkspaceGroupVisitUuid,\n16:   usePatientChartStore,\n17: } from '@openmrs/esm-patient-common-lib';\n18: \n19: const defaultVisitCustomRepresentation =\n20:   'custom:(uuid,display,voided,indication,startDatetime,stopDatetime,' +\n21:   'encounters:(uuid,display,encounterDatetime,' +\n22:   'form:(uuid,name),location:ref,' +\n23:   'encounterType:ref,' +\n24:   'encounterProviders:(uuid,display,' +\n25:   'provider:(uuid,display))),' +\n26:   'patient:(uuid,display),' +\n27:   'visitType:(uuid,name,display),' +\n28:   'attributes:(uuid,display,attributeType:(name,datatypeClassname,uuid),value),' +\n29:   'location:(uuid,name,display))';\n30: \n31: type WorkspaceGroupLaunchKey = {\n32:   patientUuid: string | null;\n33:   visitContextUuid: string | null;\n34: };\n35: \n36: // The workspace group is current only when it was launched for this patient and visit context.\n37: function getWorkspaceGroupLaunchKey(groupProps: PatientWorkspaceGroupProps | null): WorkspaceGroupLaunchKey {\n38:   return {\n39:     patientUuid: groupProps?.patientUuid ?? null,\n40:     visitContextUuid: groupProps?.visitContext?.uuid ?? null,\n41:   };\n42: }\n43: \n44: function workspaceGroupLaunchKeysEqual(a: WorkspaceGroupLaunchKey | null, b: WorkspaceGroupLaunchKey | null) {\n45:   return a?.patientUuid === b?.patientUuid && a?.visitContextUuid === b?.visitContextUuid;\n46: }\n47: \n48: export function useVisitByUuid(visitUuid: string | null, representation: string = defaultVisitCustomRepresentation) {\n49:   const url = `${restBaseUrl}/visit/${visitUuid}?v=${representation}`;\n50:   const { data, ...rest } = useSWR<{ data: Visit }>(visitUuid ? url : null, openmrsFetch);\n51:   return { visit: data?.data, ...rest };\n52: }\n53: \n54: /**\n55:  * This hook manages fetching of the patient and the visitContext\n56:  * when entering the patient chart, and the associated updated to patient chart store.\n57:  *\n58:  * The patient chart store sets the patient when we enter the patient chart\n59:  * and unsets the patient when we leave. (This gives extensions and workspaces a way\n60:  * to check whether they are rendered within the patient chart app.)\n61:  * Note: We do not unset visitContext when leaving the chart, so it persists across\n62:  * in‑app navigation. On a full page reload, visitContext is rehydrated by refetching\n63:  * (via useVisit/useVisitByUuId) rather than restored from storage.\n64:  * When we enter the chart, we want to update the visit context as follows:\n65:  * does the the stored visitContext exist and belong to the patient?\n66:  * 1. If so, the visitContext should be valid but possibly stale; fetch the visit again\n67:  *    and update the context\n68:  * 2. If not, fetch the active visit of the patient, If it exists, set it as the\n69:  *    visitContext; otherwise, clear it.\n70:  * @param patientUuid\n71:  * @returns\n72:  */\n73: export function usePatientChartPatientAndVisit(patientUuid: string) {\n74:   const { t } = useTranslation();\n75:   const { isLoading: isLoadingPatient, patient } = usePatient(patientUuid);\n76:   const {\n77:     patientUuid: storePatientUuid,\n78:     setPatient,\n79:     visitContext,\n80:     mutateVisitContext,\n81:     setVisitContext,\n82:   } = usePatientChartStore(patientUuid);\n83: \n84:   const isVisitContextValid = visitContext?.patient.uuid === patientUuid;\n85:   const {\n86:     visit: newVisitContext,\n87:     mutate: newMutateVisitContext,\n88:     isValidating: isValidatingVisitContext,\n89:   } = useVisitByUuid(isVisitContextValid ? visitContext.uuid : null);\n90:   const {\n91:     activeVisit,\n92:     isValidating: isValidatingActiveVisit,\n93:     mutate: mutateActiveVisit,\n94:   } = useVisit(isVisitContextValid ? null : patientUuid);\n95: \n96:   const launchedWorkspaceGroupKey = useRef<WorkspaceGroupLaunchKey | null>(null);\n97:   const latestWorkspaceGroupProps = useRef<PatientWorkspaceGroupProps | null>(null);\n98:   const isWorkspaceGroupLaunchPending = useRef(false);\n99:   const isMounted = useRef(false);\n100: \n101:   useEffect(() => {\n102:     isMounted.current = true;\n103:     return () => {\n104:       isMounted.current = false;\n105:     };\n106:   }, []);\n107: \n108:   const launchLatestWorkspaceGroup = useCallback(async () => {\n109:     if (isWorkspaceGroupLaunchPending.current) {\n110:       return;\n111:     }\n112: \n113:     isWorkspaceGroupLaunchPending.current = true;\n114: \n115:     try {\n116:       let needsLaunch = true;\n117:       while (needsLaunch) {\n118:         const groupProps = latestWorkspaceGroupProps.current;\n119:         const launchKey = getWorkspaceGroupLaunchKey(groupProps);\n120: \n121:         if (workspaceGroupLaunchKeysEqual(launchKey, launchedWorkspaceGroupKey.current)) {\n122:           needsLaunch = false;\n123:           continue;\n124:         }\n125: \n126:         if (!isMounted.current) {\n127:           return;\n128:         }\n129: \n130:         const launched = await launchWorkspaceGroup2('patient-chart', groupProps);\n131: \n132:         if (!isMounted.current) {\n133:           return;\n134:         }\n135: \n136:         // launchWorkspaceGroup2 returns false when the user keeps the current workspace group open.\n137:         if (!launched) {\n138:           needsLaunch = false;\n139:           continue;\n140:         }\n141: \n142:         launchedWorkspaceGroupKey.current = launchKey;\n143: \n\n(Output capped at 5KB. Showing lines 1-143 of 239. Use offset=144 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/patient-chart/patient-chart.resources.ts","name":"patient-chart.resources.ts","revision":"HEAD"}]}}

