data: {"type":"tool-output-available","toolCallId":"call-0683a013-604c-484a-b2b0-e8a21907b7ff","output":{"output":"Found 13 matches in 6 files\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-config/mock.ts:\n  13: export enum Type {\n  27: export function defineConfigSchema(moduleName, schema) {\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-config/src/types.ts:\n  1: export enum Type {\n  17: export interface ConfigSchema {\n  65: export type Validator = (value: any) => void | string;\n  63: export type ValidatorFunction = (value: any) => boolean;\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-config/mock-jest.ts:\n  13: export enum Type {\n  29: export function defineConfigSchema(moduleName, schema) {\n\n[github.com/openmrs/openmrs-esm-core] packages/tooling/storybook/mocks/esm-config.ts:\n  6: export enum Type {\n  18: export interface ConfigSchema {\n  40: export function defineConfigSchema(_moduleName: string, _schema: any) {}\n\n[github.com/openmrs/openmrs-esm-core] packages/apps/esm-login-app/src/config-schema.ts:\n  154: export interface ConfigSchema {\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-config/src/module-config/module-config.ts:\n  369: export function defineConfigSchema(moduleName: string, schema: ConfigSchema) {","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-config/mock.ts","name":"mock.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-config/src/types.ts","name":"types.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-config/mock-jest.ts","name":"mock-jest.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/tooling/storybook/mocks/esm-config.ts","name":"esm-config.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/apps/esm-login-app/src/config-schema.ts","name":"config-schema.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-config/src/module-config/module-config.ts","name":"module-config.ts","revision":"HEAD"}]}}

