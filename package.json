{
  "name": "falkon-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "NODE_OPTIONS=--conditions=react-server tsx --test tests/*.test.mts && npm run test:ui",
    "format": "prettier --write src tests *.ts *.mjs *.json",
    "format:check": "prettier --check src tests *.ts *.mjs *.json",
    "test:ui": "tsx --test tests/*.test.tsx"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "geist": "^1.7.2",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
