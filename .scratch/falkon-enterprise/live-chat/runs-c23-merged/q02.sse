data: {"type":"tool-output-available","toolCallId":"call-17de8ce5-8089-4328-818a-ec26260f81b5","output":{"output":"<repo>github.com/openmrs/openmrs-esm-billing-app</repo>\n<path>src/invoice/payments/payment-form/payment-form.component.tsx</path>\n<url>undefined</url>\n<content>\n1: import React from 'react';\n2: import { Controller, useFormContext } from 'react-hook-form';\n3: import { useTranslation } from 'react-i18next';\n4: import { Dropdown, NumberInput, NumberInputSkeleton, TextInput } from '@carbon/react';\n5: import { ErrorState } from '@openmrs/esm-framework';\n6: import { type PaymentFormValue } from '../payments.component';\n7: import { usePaymentModes } from '../payment.resource';\n8: import styles from './payment-form.scss';\n9: \n10: type PaymentFormProps = {\n11:   disablePayment: boolean;\n12: };\n13: \n14: const PaymentForm: React.FC<PaymentFormProps> = ({ disablePayment }) => {\n15:   const { t } = useTranslation();\n16:   const {\n17:     control,\n18:     formState: { errors },\n19:   } = useFormContext<PaymentFormValue>();\n20:   const { paymentModes, isLoading, error } = usePaymentModes();\n21: \n22:   if (isLoading) {\n23:     return <NumberInputSkeleton />;\n24:   }\n25: \n26:   if (error) {\n27:     return (\n28:       <div className={styles.errorPaymentContainer}>\n29:         <ErrorState headerTitle={t('errorLoadingPaymentModes', 'Error loading payment modes')} error={error} />\n30:       </div>\n31:     );\n32:   }\n33: \n34:   if (disablePayment) {\n35:     return null;\n36:   }\n37: \n38:   return (\n39:     <div className={styles.container}>\n40:       <div className={styles.paymentMethodContainer}>\n41:         <Controller\n42:           control={control}\n43:           name=\"payment.method\"\n44:           render={({ field }) => (\n45:             <Dropdown\n46:               id=\"paymentMethod\"\n47:               selectedItem={paymentModes?.find((m) => m.uuid === field.value) ?? null}\n48:               onChange={({ selectedItem }) => field.onChange(selectedItem?.uuid ?? '')}\n49:               titleText={t('paymentMethod', 'Payment method')}\n50:               label={t('selectPaymentMethod', 'Select payment method')}\n51:               items={paymentModes}\n52:               itemToString={(item) => (item ? item.name : '')}\n53:               invalid={!!errors?.payment?.method}\n54:               invalidText={errors?.payment?.method?.message}\n55:             />\n56:           )}\n57:         />\n58:         <Controller\n59:           control={control}\n60:           name=\"payment.amount\"\n61:           render={({ field }) => (\n62:             <NumberInput\n63:               allowEmpty\n64:               disableWheel\n65:               hideSteppers\n66:               id=\"paymentAmount\"\n67:               invalid={!!errors?.payment?.amount}\n68:               invalidText={errors?.payment?.amount?.message}\n69:               label={t('amount', 'Amount')}\n70:               onChange={(_, { value }) => {\n71:                 const numValue = value === '' || value === undefined ? undefined : Number(value);\n72:                 field.onChange(numValue);\n73:               }}\n74:               placeholder={t('enterAmount', 'Enter amount')}\n75:               value={field.value ?? ''}\n76:             />\n77:           )}\n78:         />\n79:         <Controller\n80:           name=\"payment.referenceCode\"\n81:           control={control}\n82:           render={({ field }) => (\n83:             <TextInput\n84:               id=\"paymentReferenceCode\"\n85:               labelText={t('referenceNumber', 'Reference number')}\n86:               name={field.name}\n87:               onBlur={field.onBlur}\n88:               onChange={field.onChange}\n89:               placeholder={t('enterReferenceNumber', 'Enter reference number')}\n90:               type=\"text\"\n91:               value={field.value ?? ''}\n92:             />\n93:           )}\n94:         />\n95:       </div>\n96:     </div>\n97:   );\n98: };\n99: \n100: export default PaymentForm;\n101: \n\n(End of file - 101 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/invoice/payments/payment-form/payment-form.component.tsx","name":"payment-form.component.tsx","revision":"HEAD"}]}}

