data: {"type":"tool-output-available","toolCallId":"call-5c2e53bf-fdcf-4400-9cc8-3a12dff48781","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-extensions/src/store.ts</path>\n<url>undefined</url>\n<content>\n1: /** @module @category Extension */\n2: import type { ConfigExtensionStoreElement, ConfigObject } from '@openmrs/esm-config';\n3: import { configExtensionStore } from '@openmrs/esm-config';\n4: import { createGlobalStore, getGlobalStore } from '@openmrs/esm-state';\n5: import { type LifeCycles } from 'single-spa';\n6: \n7: export interface ExtensionMeta {\n8:   [_: string]: any;\n9: }\n10: \n11: export interface ExtensionRegistration {\n12:   readonly name: string;\n13:   load(): Promise<LifeCycles>;\n14:   readonly moduleName: string;\n15:   readonly meta: Readonly<ExtensionMeta>;\n16:   readonly order?: number;\n17:   readonly privileges?: string | Array<string>;\n18:   readonly featureFlag?: string;\n19:   readonly displayExpression?: string;\n20: }\n21: \n22: /**\n23:  * @deprecated Use `ExtensionRegistration`, which this aliases. Renderings are not reachable from\n24:  *   a registration; they are tracked separately.\n25:  */\n26: export type ExtensionInfo = ExtensionRegistration;\n27: \n28: /**\n29:  * A single rendering of an extension into a slot.\n30:  *\n31:  * Three things are easily confused, and the extension system distinguishes them:\n32:  *\n33:  *  - an *extension* is what a module registers, identified by its **name** (`obs`);\n34:  *  - an *extension instance* is a configurable use of one within a slot, identified by its\n35:  *    **ID** — the name plus an optional `#`-suffix (`obs#weight`) — which is what an implementer\n36:  *    writes under a slot's `configure` key, and what a config is derived for;\n37:  *  - a *rendering*, this type, is one live copy of an instance being rendered.\n38:  *\n39:  * One instance has any number of renderings at a time: a list renders the same slot once per row,\n40:  * so each row holds its own rendering of every instance assigned to that slot.\n41:  */\n42: export interface ExtensionRendering {\n43:   /** Uniquely identifies this rendering. Never reused. */\n44:   readonly renderingId: string;\n45:   /** The name of the extension being rendered. */\n46:   readonly extensionName: string;\n47:   /** The module which registered the extension. */\n48:   readonly extensionModuleName: string;\n49:   /** The ID of the extension instance being rendered: the name plus an optional `#`-suffix. */\n50:   readonly extensionId: string;\n51:   readonly slotName: string;\n52:   readonly slotModuleName: string;\n53: }\n54: \n55: export interface ExtensionInternalStore {\n56:   /** Slots indexed by name */\n57:   slots: Record<string, ExtensionSlotInfo>;\n58:   /** Extension registrations indexed by name */\n59:   extensions: Record<string, ExtensionRegistration>;\n60: }\n61: \n62: /** @internal */\n63: export interface ExtensionRenderingsStore {\n64:   /**\n65:    * Every rendering that has started and not yet been released, indexed by rendering ID.\n66:    *\n67:    * Mutated in place as extensions mount and unmount, retaining identity across mounts\n68:    * and unmounts.\n69:    */\n70:   renderings: ReadonlyMap<string, ExtensionRendering>;\n71: }\n72: \n73: /**\n74:  * The state one rendering of a slot is displaying, which its extensions' display conditions are\n75:  * evaluated against. Each key becomes a variable of that name in the expression, so only string\n76:  * keys are reachable from a condition.\n77:  */\n78: export type ExtensionSlotCustomState = Record<string, unknown> | undefined;\n79: \n80: export interface ExtensionSlotInfo {\n81:   /**\n82:    * The module in which the extension slot exists. Undefined if the slot\n83:    * hasn't been registered yet (but it has been attached or assigned to\n84:    * an extension.\n85:    */\n86:   moduleName?: string;\n87:   /** The name under which the extension slot has been registered. */\n88:   name: string;\n89:   /**\n90:    * The set of extension IDs which have been attached to this slot using `attach`.\n91:    * However, not all of these extension IDs should be rendered.\n92:    * `assignedIds` is the set defining those.\n93:    */\n94:   attachedIds: Array<string>;\n95: }\n96: \n97: export interface ExtensionStore {\n98:   slots: Record<string, ExtensionSlotState>;\n99: }\n100: \n101: export interface ExtensionSlotState {\n102:   moduleName?: string;\n103:   /**\n104:    * Candidates only. Call `getAssignedExtensions()` for the extensions a given rendering of\n105:    * this slot should actually display.\n106:    */\n107:   candidateExtensions: Array<AssignedExtension>;\n108: }\n109: \n110: export interface AssignedExtension {\n111:   readonly id: string;\n112:   readonly name: string;\n113:   readonly moduleName: string;\n114:   readonly meta: Readonly<ExtensionMeta>;\n115:   /** The extension's config. Note that this will be `null` until the slot is mounted. */\n116:   readonly config: Readonly<ConfigObject> | null;\n117:   readonly featureFlag?: string;\n118:   /** The condition under which this extension should be displayed. */\n119:   readonly displayConditionExpression?: string;\n120: }\n121: \n122: /** @deprecated replaced with AssignedExtension */\n123: export interface ConnectedExtension {\n124:   readonly id: string;\n125:   readonly name: string;\n126:   readonly moduleName: string;\n127:   readonly meta: Readonly<ExtensionMeta>;\n128:   /** The extension's config. Note that this will be `null` until the slot is mounted. */\n129:   readonly config: Readonly<ConfigObject> | null;\n130: }\n131: \n132: const extensionInternalStore = createGlobalStore<ExtensionInternalStore>('extensionsInternal', {\n133:   slots: {},\n134:   extensions: {},\n135: });\n136: \n137: const extensionRenderingsStore = createGlobalStore<ExtensionRenderingsStore>('extensionRenderings', {\n138:   renderings: new Map(),\n139: });\n140: \n141: /**\n142:  * This gets the extension system's internal store. It is subject\n\n(Output capped at 5KB. Showing lines 1-142 of 414. Use offset=143 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-extensions/src/store.ts","name":"store.ts","revision":"HEAD"}]}}

