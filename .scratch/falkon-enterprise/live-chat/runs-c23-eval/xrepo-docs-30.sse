data: {"type":"tool-output-available","toolCallId":"call-998eb4db-c587-405d-8989-4dc3866339a6","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-utils/src/dates/date-util.ts</path>\n<url>undefined</url>\n<content>\n180:   locale?: string;\n181:   /**\n182:    * - `standard`: \"03 Feb 2022\"\n183:    * - `wide`:     \"03 — Feb — 2022\"\n184:    */\n185:   mode: FormatDateMode;\n186:   /**\n187:    * Whether the time should be included in the output always (`true`),\n188:    * never (`false`), or only when the input date is today (`for today`).\n189:    */\n190:   time: true | false | 'for today';\n191:   /** Whether to include the day number */\n192:   day: boolean;\n193:   /** Whether to include the month number */\n194:   month: boolean;\n195:   /** Whether to include the year */\n196:   year: boolean;\n197:   /** The unicode numbering system to use */\n198:   numberingSystem?: string;\n199:   /**\n200:    * Disables the special handling of dates that are today. If false\n201:    * (the default), then dates that are today will be formatted as \"Today\"\n202:    * in the locale language. If true, then dates that are today will be\n203:    * formatted the same as all other dates.\n204:    */\n205:   noToday: boolean;\n206: };\n207: \n208: const defaultOptions: FormatDateOptions = {\n209:   mode: 'standard',\n210:   time: 'for today',\n211:   day: true,\n212:   month: true,\n213:   year: true,\n214:   noToday: false,\n215: };\n216: \n217: /**\n218:  * Formats the string representing a date, including partial representations of dates, according to the current\n219:  * locale and the given options.\n220:  *\n221:  * Default options:\n222:  *  - mode: \"standard\",\n223:  *  - time: \"for today\",\n224:  *  - day: true,\n225:  *  - month: true,\n226:  *  - year: true\n227:  *  - noToday: false\n228:  *\n229:  * If the date is today then \"Today\" is produced (in the locale language).\n230:  * This behavior can be disabled with `noToday: true`.\n231:  *\n232:  * When time is included, it is appended with a comma and a space. This\n233:  * agrees with the output of `Date.prototype.toLocaleString` for *most*\n234:  * locales.\n235:  *\n236:  * @param dateString The date string to parse and format.\n237:  * @param options Optional formatting options.\n238:  * @returns The formatted date string, or `null` if the input cannot be parsed.\n239:  */\n240: // TODO: Shouldn't throw on null input\n241: export function formatPartialDate(dateString: string, options: Partial<FormatDateOptions> = {}) {\n242:   const locale = getLocale();\n243:   let parsed: ReturnType<typeof attempt> & { date?: number } = attempt(dateString, locale);\n244: \n245:   if (parsed.invalid) {\n246:     console.warn(`Could not parse invalid date '${dateString}'`);\n247:     return null;\n248:   }\n249: \n250:   // hack here but any date interprets 2000-01, etc. as yyyy-dd rather than yyyy-mm\n251:   if (!isNil(parsed.day) && isNil(parsed.month)) {\n252:     parsed = Object.assign({}, omit(parsed, 'day'), { month: parsed.day });\n253:   }\n254: \n255:   // dayjs' object support uses 0-based months, whereas any-date-parser uses 1-based months\n256:   if (parsed.month) {\n257:     parsed.month -= 1;\n258:   }\n259: \n260:   // in dayjs day is day of week; in any-date-parser, its day of month, so we need to convert them\n261:   if (parsed.day) {\n262:     parsed = Object.assign({}, omit(parsed, 'day'), { date: parsed.day });\n263:   }\n264: \n265:   const date = dayjs().set(parsed).toDate();\n266: \n267:   if (isNil(parsed.year)) {\n268:     options.year = false;\n269:   }\n270: \n271:   if (isNil(parsed.month)) {\n272:     options.month = false;\n273:   }\n274: \n275:   if (isNil(parsed.date)) {\n276:     options.day = false;\n277:   }\n278: \n279:   return formatDate(date, options);\n280: }\n281: \n282: /**\n283:  * Formats the input date according to the current locale and the\n284:  * given options.\n285:  *\n286:  * Default options:\n287:  *  - mode: \"standard\",\n288:  *  - time: \"for today\",\n289:  *  - day: true,\n290:  *  - month: true,\n291:  *  - year: true\n292:  *  - noToday: false\n293:  *\n294:  * If the date is today then \"Today\" is produced (in the locale language).\n295:  * This behavior can be disabled with `noToday: true`.\n296:  *\n297:  * When time is included, it is appended with a comma and a space. This\n298:  * agrees with the output of `Date.prototype.toLocaleString` for *most*\n299:  * locales.\n300:  *\n301:  * @param date The date to format.\n302:  * @param options Optional formatting options.\n303:  * @returns The formatted date string.\n304:  */\n305: // TODO: Shouldn't throw on null input\n306: export function formatDate(date: Date, options?: Partial<FormatDateOptions>) {\n307:   let locale = options?.locale ?? getLocale();\n308:   const _locale = new Intl.Locale(locale);\n309: \n310:   const { calendar, mode, time, day, month, year, noToday, numberingSystem }: FormatDateOptions = {\n311:     ...defaultOptions,\n312:     ...{ noToday: _locale.language === 'am' ? true : false },\n313:     ...options,\n314:   };\n315: \n316:   const formatCalendar = calendar ?? getDefaultCalendar(_locale);\n317: \n318:   const formatterOptions: Intl.DateTimeFormatOptions = {\n319:     calendar: formatCalendar,\n320:     year: year ? 'numeric' : undefined,\n321:     month: month ? 'short' : undefined,\n322:     day: day ? '2-digit' : undefined,\n323:     numberingSystem,\n324:   };\n325: \n326:   let localeString: string;\n327:   const isToday = dayjs(date).isToday();\n328:   if (isToday && !noToday) {\n329:     // This produces the word \"Today\" in the language of `locale`\n330:     const rtf = new Intl.RelativeTimeFormat(locale, { numeric: 'auto' });\n331:     localeString = rtf.format(0, 'day');\n332:     localeString = localeString[0].toLocaleUpperCase(locale) + localeString.slice(1);\n333:   } else {\n334:     if (_locale.language === 'en') {\n335:       // This locale override is here rather than in `getLocale`\n336:       // because Americans should see AM/PM for times.\n337:       locale = 'en-GB';\n338:     }\n339: \n340:     const formatter = new Intl.DateTimeFormat(locale, formatterOptions);\n341:     let parts = formatter.formatToParts(date);\n342: \n\n(Output capped at 5KB. Showing lines 180-342 of 725. Use offset=343 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-utils/src/dates/date-util.ts","name":"date-util.ts","revision":"HEAD"}]}}

