data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/PaymentResource.java","name":"PaymentResource.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-fd2bb27c-0a69-4a0e-8140-8f018f4c03e4","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>omod/src/main/java/org/openmrs/module/billing/web/rest/resource/PaymentResource.java</path>\n<url>undefined</url>\n<content>\n124: \t\t} else {\n125: \t\t\tinstance.setAmount(BigDecimal.valueOf((Double) price));\n126: \t\t}\n127: \t}\n128: \t\n129: \t@PropertySetter(\"amountTendered\")\n130: \tpublic void setPaymentAmountTendered(Payment instance, Object price) {\n131: \t\t// TODO Conversion logic\n132: \t\tdouble amount;\n133: \t\tif (price instanceof Integer) {\n134: \t\t\tint rawAmount = (Integer) price;\n135: \t\t\tamount = Double.valueOf(rawAmount);\n136: \t\t\tinstance.setAmountTendered(BigDecimal.valueOf(amount));\n137: \t\t} else {\n138: \t\t\tinstance.setAmountTendered(BigDecimal.valueOf((Double) price));\n139: \t\t}\n140: \t}\n141: \t\n142: \t@PropertyGetter(\"dateCreated\")\n143: \tpublic Long getPaymentDate(Payment instance) {\n144: \t\treturn instance.getDateCreated().getTime();\n145: \t}\n146: \t\n147: \t@Override\n148: \tpublic Payment save(Payment delegate) {\n149: \t\tif (delegate.getCashier() == null) {\n150: \t\t\tProvider cashier = ProviderUtil.getCurrentProvider();\n151: \t\t\tif (cashier == null) {\n152: \t\t\t\tthrow new APIException(\n153: \t\t\t\t        \"The authenticated user is not associated with a Provider and cannot process payments.\");\n154: \t\t\t}\n155: \t\t\tdelegate.setCashier(cashier);\n156: \t\t}\n157: \t\t\n158: \t\tBillService service = Context.getService(BillService.class);\n159: \t\tBill bill = delegate.getBill();\n160: \t\tbill.addPayment(delegate);\n161: \t\tservice.saveBill(bill);\n162: \t\t\n163: \t\treturn delegate;\n164: \t}\n165: \t\n166: \t@Override\n167: \tprotected void delete(Payment delegate, String reason, RequestContext context) {\n168: \t\tdelete(delegate.getBill().getUuid(), delegate.getUuid(), reason, context);\n169: \t}\n170: \t\n171: \t@Override\n172: \tpublic void delete(String parentUniqueId, final String uuid, String reason, RequestContext context) {\n173: \t\tBillService service = Context.getService(BillService.class);\n174: \t\tBill bill = findBill(service, parentUniqueId);\n175: \t\tPayment payment = findPayment(bill, uuid);\n176: \t\t\n177: \t\tpayment.setVoided(true);\n178: \t\tpayment.setVoidReason(reason);\n179: \t\tpayment.setVoidedBy(Context.getAuthenticatedUser());\n180: \t\t\n181: \t\tservice.saveBill(bill);\n182: \t}\n183: \t\n184: \t@Override\n185: \tpublic void purge(Payment delegate, RequestContext context) {\n186: \t\tpurge(delegate.getBill().getUuid(), delegate.getUuid(), context);\n187: \t}\n188: \t\n189: \t@Override\n190: \tpublic void purge(String parentUniqueId, String uuid, RequestContext context) {\n191: \t\tBillService service = Context.getService(BillService.class);\n192: \t\tBill bill = findBill(service, parentUniqueId);\n193: \t\tPayment payment = findPayment(bill, uuid);\n194: \t\t\n195: \t\tbill.removePayment(payment);\n196: \t\tservice.saveBill(bill);\n197: \t}\n198: \t\n199: \t@Override\n200: \tpublic PageableResult doGetAll(Bill parent, RequestContext context) {\n201: \t\treturn new AlreadyPaged<Payment>(context, new ArrayList<Payment>(parent.getPayments()), false);\n202: \t}\n203: \t\n204: \t@Override\n205: \tpublic Payment getByUniqueId(String uniqueId) {\n206: \t\treturn null;\n207: \t}\n208: \t\n209: \t@Override\n210: \tpublic Bill getParent(Payment instance) {\n211: \t\treturn instance.getBill();\n212: \t}\n213: \t\n214: \t@Override\n215: \tpublic void setParent(Payment instance, Bill parent) {\n216: \t\tinstance.setBill(parent);\n217: \t}\n218: \t\n219: \t@Override\n220: \tpublic Payment newDelegate() {\n221: \t\treturn new Payment();\n222: \t}\n223: \t\n224: \tprivate Bill findBill(BillService service, String billUUID) {\n225: \t\tBill bill = service.getBillByUuid(billUUID);\n226: \t\tif (bill == null) {\n227: \t\t\tthrow new ObjectNotFoundException();\n228: \t\t}\n229: \t\t\n230: \t\treturn bill;\n231: \t}\n232: \t\n233: \tprivate Payment findPayment(Bill bill, final String paymentUUID) {\n234: \t\t\n235: \t\tfor (Payment payment : bill.getPayments()) {\n236: \t\t\tif (payment != null && payment.getUuid().equals(paymentUUID)) {\n237: \t\t\t\treturn payment;\n238: \t\t\t}\n239: \t\t}\n240: \t\tthrow new ObjectNotFoundException();\n241: \t}\n242: }\n243: \n\n(End of file - 243 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/PaymentResource.java","name":"PaymentResource.java","revision":"HEAD"}]}}

