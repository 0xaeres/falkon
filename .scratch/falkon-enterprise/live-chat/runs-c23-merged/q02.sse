data: {"type":"text-start","id":"txt-0"}

data: {"type":"text-delta","id":"txt-0","delta":"I"}

data: {"type":"text-delta","id":"txt-0","delta":" have the whole chain now, from the button"}

data: {"type":"text-delta","id":"txt-0","delta":" to the `cashier_bill_p"}

data: {"type":"text-delta","id":"txt-0","delta":"ayment` row.\n\n<!--answer-->\nThe payment starts as"}

data: {"type":"text-delta","id":"txt-0","delta":" a React Hook Form state value, gets"}

data: {"type":"text-delta","id":"txt-0","delta":" POSTed to a REST sub-resource,"}

data: {"type":"text-delta","id":"txt-0","delta":" and ends up as a row in `cashier"}

data: {"type":"text-delta","id":"txt-0","delta":"_bill_payment` through a Hibernate cascade from"}

data: {"type":"text-delta","id":"txt-0","delta":" the `Bill`. The interesting part is that the"}

data: {"type":"text-delta","id":"txt-0","delta":" frontend never sends the cashier or"}

data: {"type":"text-delta","id":"txt-0","delta":" the bill status — the backend fills those in,"}

data: {"type":"text-delta","id":"txt-0","delta":" and the bill's status flips as"}

data: {"type":"text-delta","id":"txt-0","delta":" a side effect of the save.\n\nHere is"}

data: {"type":"text-delta","id":"txt-0","delta":" the flow across the two repos: `open"}

data: {"type":"text-delta","id":"txt-0","delta":"mrs-esm-billing-app` (front"}

data: {"type":"text-delta","id":"txt-0","delta":"end) and `openmrs-mod"}

data: {"type":"text-delta","id":"txt-0","delta":"ule-billing` (backend module).\n\n"}

data: {"type":"text-delta","id":"txt-0","delta":"```archify\n{\"schema_version\":2,\""}

data: {"type":"text-delta","id":"txt-0","delta":"diagram_type\":\"sequence\",\"meta\":{\"title"}

data: {"type":"text-delta","id":"txt-0","delta":"\":\"Recording a bill payment\"},\"participants\":[{\""}

data: {"type":"text-delta","id":"txt-0","delta":"id\":\"cashier\",\"type\":\"frontend\",\""}

data: {"type":"text-delta","id":"txt-0","delta":"label\":\"Cashier UI\"},{\"id"}

data: {"type":"text-delta","id":"txt-0","delta":"\":\"payments\",\"type\":\"frontend"}

data: {"type":"text-delta","id":"txt-0","delta":"\",\"label\":\"Payments component\"},{\""}

data: {"type":"text-delta","id":"txt-0","delta":"id\":\"rest\",\"type\":\"backend\",\"label\":\"Payment"}

data: {"type":"text-delta","id":"txt-0","delta":"Resource\"},{\"id\":\"service\",\"type"}

data: {"type":"text-delta","id":"txt-0","delta":"\":\"backend\",\"label\":\"BillService\"},"}

data: {"type":"text-delta","id":"txt-0","delta":"{\"id\":\"dao\",\"type\":\"database"}

