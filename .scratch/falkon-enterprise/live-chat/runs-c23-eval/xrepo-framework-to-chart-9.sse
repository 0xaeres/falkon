data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/visit/visit-prompt/end-visit-dialog.modal.tsx","name":"end-visit-dialog.modal.tsx","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-b9a8555f-766d-4c33-88f4-6a16c9624924","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-chart-app/src/visit/visit-prompt/end-visit-dialog.modal.tsx</path>\n<url>undefined</url>\n<content>\n1: import React from 'react';\n2: import { useTranslation } from 'react-i18next';\n3: import { Button, ModalBody, ModalFooter, ModalHeader } from '@carbon/react';\n4: import { showSnackbar, updateVisit, useVisit } from '@openmrs/esm-framework';\n5: import { usePatientChartStore } from '@openmrs/esm-patient-common-lib';\n6: import styles from './end-visit-dialog.scss';\n7: \n8: interface EndVisitDialogProps {\n9:   patientUuid: string;\n10:   closeModal: () => void;\n11: }\n12: \n13: /**\n14:  * This modal shows up when user clicks on the \"End visit\" button in the action menu within the\n15:  * patient banner. It should only show when the patient has an active visit. See stop-visit.component.tsx\n16:  * for the button.\n17:  *\n18:  * This dialog uses the patient chart store and SHOULD only be mounted within the patient chart\n19:  */\n20: const EndVisitDialog: React.FC<EndVisitDialogProps> = ({ patientUuid, closeModal }) => {\n21:   const { t } = useTranslation();\n22:   const { activeVisit, mutate } = useVisit(patientUuid);\n23:   const { visitContext, setVisitContext } = usePatientChartStore(patientUuid);\n24: \n25:   const handleEndVisit = () => {\n26:     if (activeVisit) {\n27:       const endVisitPayload = {\n28:         stopDatetime: new Date(),\n29:       };\n30: \n31:       const abortController = new AbortController();\n32: \n33:       updateVisit(activeVisit.uuid, endVisitPayload, abortController)\n34:         .then((response) => {\n35:           mutate();\n36:           window.dispatchEvent(new CustomEvent('queue-entry-updated'));\n37:           closeModal();\n38:           if (visitContext?.uuid == activeVisit.uuid) {\n39:             setVisitContext(null, null);\n40:           }\n41:           showSnackbar({\n42:             isLowContrast: true,\n43:             kind: 'success',\n44:             subtitle: t('visitEndSuccessfully', `${response?.data?.visitType?.display} ended successfully`),\n45:             title: t('visitEnded', 'Visit ended'),\n46:           });\n47:         })\n48:         .catch((error) => {\n49:           showSnackbar({\n50:             title: t('errorEndingVisit', 'Error ending visit'),\n51:             kind: 'error',\n52:             isLowContrast: false,\n53:             subtitle: error?.message,\n54:           });\n55:         });\n56:     }\n57:   };\n58: \n59:   return (\n60:     <div>\n61:       <ModalHeader\n62:         closeModal={closeModal}\n63:         title={t('endActiveVisitConfirmation', 'Are you sure you want to end this active visit?')}\n64:       />\n65:       <ModalBody>\n66:         <p className={styles.bodyShort02}>\n67:           {t('youCanAddAdditionalEncounters', 'You can add additional encounters to this visit in the visit summary.')}\n68:         </p>\n69:       </ModalBody>\n70:       <ModalFooter>\n71:         <Button kind=\"secondary\" onClick={closeModal}>\n72:           {t('cancel', 'Cancel')}\n73:         </Button>\n74:         <Button kind=\"danger\" onClick={handleEndVisit}>\n75:           {t('endVisit_title', 'End Visit')}\n76:         </Button>\n77:       </ModalFooter>\n78:     </div>\n79:   );\n80: };\n81: \n82: export default EndVisitDialog;\n83: \n\n(End of file - 83 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/visit/visit-prompt/end-visit-dialog.modal.tsx","name":"end-visit-dialog.modal.tsx","revision":"HEAD"}]}}

data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/patient-banner-tags/visit-attribute-tags.extension.tsx","name":"visit-attribute-tags.extension.tsx","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-cc51a92a-bdad-41dd-961a-cb784910198a","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-chart-app/src/patient-banner-tags/visit-attribute-tags.extension.tsx</path>\n<url>undefined</url>\n<content>\n1: import React from 'react';\n2: import dayjs from 'dayjs';\n3: import { Tag } from '@carbon/react';\n4: import { formatDate, useConfig, useVisit } from '@openmrs/esm-framework';\n5: import { type ChartConfig } from '../config-schema';\n6: import styles from './visit-attribute-tags.scss';\n7: \n8: interface VisitAttributeTagsProps {\n9:   patientUuid: string;\n10: }\n11: \n12: const getAttributeValue = (attributeType, value) => {\n13:   switch (attributeType?.datatypeClassname) {\n14:     case 'org.openmrs.customdatatype.datatype.ConceptDatatype':\n15:       return value?.display;\n16:     case 'org.openmrs.customdatatype.datatype.FloatDatatype':\n17:     case 'org.openmrs.customdatatype.datatype.FreeTextDatatype':\n18:     case 'org.openmrs.customdatatype.datatype.LongFreeTextDatatype':\n19:     case 'org.openmrs.customdatatype.datatype.BooleanDatatype':\n20:       return value;\n21:     case 'org.openmrs.customdatatype.datatype.DateDatatype':\n22:       // The saved value is midnight in the server's offset, so read only the date part\n23:       // as local midnight. Otherwise a browser behind the server shows the previous day.\n24:       return formatDate(dayjs(String(value).split('T')[0]).toDate(), {\n25:         mode: 'wide',\n26:         time: false,\n27:       });\n28:     default:\n29:       return value;\n30:   }\n31: };\n32: \n33: /**\n34:  * This extension slots to the patient-banner-tags-slot by default.\n35:  */\n36: const VisitAttributeTags: React.FC<VisitAttributeTagsProps> = ({ patientUuid }) => {\n37:   const { activeVisit } = useVisit(patientUuid);\n38:   const { visitAttributeTypes } = useConfig<ChartConfig>();\n39: \n40:   const displayableAttributes = activeVisit?.attributes\n41:     ?.filter(\n42:       (attribute) =>\n43:         visitAttributeTypes?.find(({ uuid }) => attribute?.attributeType?.uuid === uuid)?.displayInThePatientBanner,\n44:     )\n45:     .map((attribute) => ({\n46:       attribute,\n47:       value: getAttributeValue(attribute?.attributeType, attribute?.value),\n48:     }))\n49:     .filter(({ value }) => value != null && value !== '');\n50: \n51:   if (!displayableAttributes?.length) {\n52:     return null;\n53:   }\n54: \n55:   return (\n56:     <div className={styles.tagsContainer}>\n57:       {displayableAttributes.map(({ attribute, value }) => (\n58:         <Tag key={attribute?.attributeType?.uuid} type=\"gray\">\n59:           {value}\n60:         </Tag>\n61:       ))}\n62:     </div>\n63:   );\n64: };\n65: \n66: export default VisitAttributeTags;\n67: \n\n(End of file - 67 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/patient-banner-tags/visit-attribute-tags.extension.tsx","name":"visit-attribute-tags.extension.tsx","revision":"HEAD"}]}}

