data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-config/src/module-config/module-config.ts","name":"module-config.ts","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-edcd7001-e4a3-44e6-8c26-9e3ab827fa71","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-config/src/module-config/module-config.ts</path>\n<url>undefined</url>\n<content>\n355:  */\n356: \n357: /**\n358:  * This defines a configuration schema for a module. The schema tells the\n359:  * configuration system how the module can be configured. It specifies\n360:  * what makes configuration valid or invalid.\n361:  *\n362:  * See [Configuration System](https://o3-docs.openmrs.org/en-US/docs/configuration-system)\n363:  * for more information about defining a config schema.\n364:  *\n365:  * @param moduleName Name of the module the schema is being defined for. Generally\n366:  *   should be the one in which the `defineConfigSchema` call takes place.\n367:  * @param schema The config schema for the module\n368:  */\n369: export function defineConfigSchema(moduleName: string, schema: ConfigSchema) {\n370:   validateConfigSchema(moduleName, schema);\n371:   const enhancedSchema = mergeDeepReplace(schema, implicitConfigSchema);\n372: \n373:   configInternalStore.setState((state) => ({\n374:     ...state,\n375:     schemas: { ...state.schemas, [moduleName]: enhancedSchema },\n376:     moduleLoaded: { ...state.moduleLoaded, [moduleName]: true },\n377:   }));\n378: }\n379: \n380: /**\n381:  * This alerts the configuration system that a module exists. This allows config to be\n382:  * processed, while still allowing the extension system to know whether the module has\n383:  * actually had its front bundle executed yet.\n384:  *\n385:  * This should only be used in esm-app-shell.\n386:  *\n387:  * @internal\n388:  * @param moduleName\n389:  */\n390: export function registerModuleWithConfigSystem(moduleName: string) {\n391:   configInternalStore.setState((state) => ({\n392:     ...state,\n393:     schemas: { ...state.schemas, [moduleName]: implicitConfigSchema },\n394:   }));\n\n(Showing lines 355-394 of 1310. Use offset=395 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-config/src/module-config/module-config.ts","name":"module-config.ts","revision":"HEAD"}]}}

