data: {"type":"data-evidence","data":{"id":16,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Bill.java","revision":"HEAD","startLine":236,"code":["\t\tdiscount.setBill(this);","\t}","\t","\tpublic void addPayment(Payment payment) {","\t\tif (payment == null) {","\t\t\tthrow new NullPointerException(\"The payment to add must be defined.\");","\t\t}","\t\t","\t\tif (this.payments == null) {","\t\t\tthis.payments = new HashSet<>();","\t\t}","\t\t","\t\tthis.payments.add(payment);","\t\tpayment.setBill(this);","\t\t","\t\tthis.synchronizeBillStatus();","\t}","\t","\tpublic void synchronizeBillStatus() {","\t\tBillStatus current = getStatus();"],"highlightedLines":[239,240,241,242,243,244,245,246,247,248,249,250,251,252]}}

data: {"type":"data-evidence","data":{"id":17,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Bill.java","revision":"HEAD","startLine":251,"code":["\t\tthis.synchronizeBillStatus();","\t}","\t","\tpublic void synchronizeBillStatus() {","\t\tBillStatus current = getStatus();","\t\tif (current == BillStatus.REFUND_REQUESTED || current == BillStatus.REFUNDED","\t\t        || current == BillStatus.PARTIALLY_REFUNDED) {","\t\t\treturn;","\t\t}","\t\tif (this.getPayments() != null && !this.getPayments().isEmpty()","\t\t        && getTotalPayments().compareTo(BigDecimal.ZERO) > 0) {","\t\t\t// Approved discount exceeds the current bill total — likely a line item was voided","\t\t\t// after approval. Stay POSTED so a human can void/reapply rather than letting any","\t\t\t// non-zero payment silently flip the bill to PAID.","\t\t\tif (hasDiscountDrift()) {","\t\t\t\tlog.warn(\"Bill {} has discount drift (total={}, effectiveTotal={}); staying POSTED for manual review\",","\t\t\t\t    getUuid(), getTotal(), effectiveTotal());","\t\t\t\tthis.setStatus(BillStatus.POSTED);","\t\t\t\treturn;","\t\t\t}","\t\t\tboolean billFullySettled = getTotalPayments().compareTo(getAmountAfterDiscount()) >= 0;","\t\t\tif (billFullySettled) {","\t\t\t\tthis.setStatus(BillStatus.PAID);","\t\t\t\t// Update all non-voided and non-refunded status bill line items to PAID status","\t\t\t\tif (this.lineItems != null) {","\t\t\t\t\tfor (BillLineItem lineItem : this.lineItems) {","\t\t\t\t\t\tif (lineItem != null && !lineItem.getVoided() && !isRefundStatus(lineItem.getStatus())) {","\t\t\t\t\t\t\tlineItem.setStatus(BillLineItemStatus.PAID);","\t\t\t\t\t\t}","\t\t\t\t\t}","\t\t\t\t}","\t\t\t} else {","\t\t\t\tthis.setStatus(BillStatus.POSTED);","\t\t\t}","\t\t}","\t}","\t","\tpublic void removePayment(Payment payment) {","\t\tif (payment != null && this.payments != null) {"],"highlightedLines":[254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286]}}

