data: {"type":"tool-output-available","toolCallId":"call-bbb60132-7834-4144-a7a3-559dfd14b38f","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-extensions/src/render.ts</path>\n<url>undefined</url>\n<content>\n360:     get mountPromise() {\n361:       return pending.then((parcel) => parcel.mountPromise);\n362:     },\n363:     get unmountPromise() {\n364:       return pending.then((parcel) => parcel.unmountPromise);\n365:     },\n366:   };\n367: }\n368: \n369: /**\n370:  * Mounts into a DOM node (representing an extension slot)\n371:  * a lazy-loaded component from *any* frontend module\n372:  * that registered an extension component for this slot.\n373:  */\n374: export async function renderExtension(\n375:   domElement: HTMLElement,\n376:   extensionSlotName: string,\n377:   extensionSlotModuleName: string,\n378:   extensionId: string,\n379:   renderFunction: (application: ParcelConfig) => ParcelConfig = (x) => x,\n380:   additionalProps: Record<string, any> = {},\n381: ): Promise<Parcel | null> {\n382:   const extensionName = getExtensionNameFromId(extensionId);\n383:   const extensionRegistration = getExtensionRegistration(extensionId);\n384:   let parcel: Parcel | null = null;\n385: \n386:   if (domElement) {\n387:     if (!extensionRegistration) {\n388:       throw Error(`Couldn't find extension '${extensionName}' to attach to '${extensionSlotName}'`);\n389:     }\n390: \n391:     const { meta, moduleName, load } = extensionRegistration;\n392: \n393:     const id = parcelCount++;\n394:     const renderingId = `${extensionSlotName}/${extensionId}-${id}`;\n395: \n396:     // Marks the node for the UI editor, which needs to pair a rendering with the element it went\n397:     // into and cannot tell two renderings of one extension apart by any other attribute.\n398:     domElement.dataset.extensionRenderingId = renderingId;\n399: \n400:     const forget = () => unregisterExtensionRendering(renderingId);\n401:     const forgetSafely = (cleanupErrorMessage: string) => {\n402:       try {\n403:         forget();\n404:       } catch (cleanupError) {\n405:         console.error(cleanupErrorMessage, cleanupError);\n406:       }\n407:     };\n408: \n409:     // Registered before loading so that the config system can start resolving this extension's\n410:     // config while its bundle is still in flight. Registering drives the config derivation\n411:     // synchronously, so a failure there has to release the record before it propagates — nothing\n412:     // else has a handle on it yet.\n413:     try {\n414:       registerExtensionRendering({\n415:         renderingId,\n416:         extensionName,\n417:         extensionModuleName: moduleName,\n418:         extensionId,\n419:         slotName: extensionSlotName,\n420:         slotModuleName: extensionSlotModuleName,\n421:       });\n422:     } catch (e) {\n423:       forgetSafely(`Recomputing configuration after registering '${extensionId}' failed also failed`);\n424: \n425:       throw e;\n426:     }\n427: \n428:     let lifecycle: LifeCycles;\n429: \n430:     try {\n431:       lifecycle = await load();\n432:     } catch (e) {\n433:       forgetSafely(`Recomputing configuration after '${extensionId}' failed to load also failed`);\n434: \n435:       throw e;\n436:     }\n437: \n438:     try {\n439:       parcel = await renderParcel(\n440:         renderFunction({\n441:           ...lifecycle,\n442:           name: `${extensionSlotName}/${extensionName}-${id}`,\n443:         }),\n444:         {\n445:           ...additionalProps,\n446:           _meta: meta,\n447:           _extensionContext: {\n448:             extensionId,\n449:             extensionSlotName,\n450:             extensionSlotModuleName,\n451:             extensionModuleName: moduleName,\n452:             extensionMeta: meta,\n453:           },\n454:           domElement,\n455:         },\n456:       );\n457:     } catch (e) {\n458:       forgetSafely(`Recomputing configuration after '${extensionId}' failed to mount also failed`);\n459: \n460:       throw e;\n461:     }\n462: \n463:     // A parcel that fails to bootstrap or mount never settles `unmountPromise`, so the mount\n464:     // rejection has to release the record too. single-spa hard-fails parcels, so its own error\n465:     // handlers never see either failure and the rejected promise is the only channel left.\n466:     parcel.mountPromise.then(undefined, (err) => {\n467:       console.error(`Extension '${extensionId}' in slot '${extensionSlotName}' failed to mount`, err);\n468:       forgetSafely(`Recomputing configuration after '${extensionId}' failed to mount also failed`);\n469:     });\n470:     parcel.unmountPromise.then(\n471:       () => forgetSafely(`Recomputing configuration after unmounting '${extensionId}' failed`),\n472:       (err) => {\n473:         console.error(`Extension '${extensionId}' in slot '${extensionSlotName}' failed to unmount`, err);\n474:         forgetSafely(`Recomputing configuration after '${extensionId}' failed to unmount also failed`);\n475:       },\n476:     );\n477:   } else {\n478:     console.warn(`Tried to render ${extensionId} into ${extensionSlotName} but no DOM element was available.`);\n479:   }\n480: \n481:   return parcel;\n482: }\n\n(Showing lines 360-482 of 483. Use offset=483 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-extensions/src/render.ts","name":"render.ts","revision":"HEAD"}]}}

