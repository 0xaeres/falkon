      "col": 2,
      "tag": "orphan"
    }
  ],
  "transitions": [
    {
      "from": "pending",
      "to": "syncing",
      "label": "repo-index job"
    },
    {
      "from": "syncing",
      "to": "indexed",
      "label": "shards written"
    },
    {
      "from": "syncing",
      "to": "failed",
