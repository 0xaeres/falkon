data: {"type":"text-delta","id":"txt-0","delta":".mdx:337-396}.\n\n## The"}

data: {"type":"text-delta","id":"txt-0","delta":" flow\n\n```mermaid\n---\ntitle: Config"}

data: {"type":"text-delta","id":"txt-0","delta":" schema to resolved setting\n---\nflowchart TD\n"}

data: {"type":"text-delta","id":"txt-0","delta":"  schema[\"src/config-schema.ts\"]"}

data: {"type":"text-delta","id":"txt-0","delta":" --> reg[\"startupApp calls defineConfigSchema\"]\n"}

data: {"type":"text-delta","id":"txt-0","delta":"  reg --> merge[\"mergeDeepReplace with implicit schema"}

data: {"type":"text-delta","id":"txt-0","delta":"\"]\n  merge --> store[\"config system"}

data: {"type":"text-delta","id":"txt-0","delta":" store\"]\n  impl[\"Implementer config files"}

data: {"type":"text-delta","id":"txt-0","delta":"\"] --> resolver[\"config resolver\"]\n "}

data: {"type":"text-delta","id":"txt-0","delta":" tools[\"Implementer Tools temporary config\"] --> resolver"}

data: {"type":"text-delta","id":"txt-0","delta":"\n  store --> resolver\n  resolver --> hook"}

data: {"type":"text-delta","id":"txt-0","delta":"[\"useConfig or getConfig\"]\n "}

data: {"type":"text-delta","id":"txt-0","delta":" hook --> component[\"Module component\"]\n```\n\n##"}

data: {"type":"text-delta","id":"txt-0","delta":" What I could not verify\n\nI did not open"}

data: {"type":"text-delta","id":"txt-0","delta":" the declaration of `defineExtensionConfigSchema` or"}

data: {"type":"text-delta","id":"txt-0","delta":" the extension/slot config-resolution code in `"}

data: {"type":"text-delta","id":"txt-0","delta":"esm-config`; those points are taken"}

data: {"type":"text-delta","id":"txt-0","delta":" from the documentation only. I also did not read the"}

data: {"type":"text-delta","id":"txt-0","delta":" rest of the login app's schema beyond"}

data: {"type":"text-delta","id":"txt-0","delta":" the first 60 lines, nor the validator"}

data: {"type":"text-delta","id":"txt-0","delta":" implementations (`oneOf`, `inRange`, `is"}

data: {"type":"text-delta","id":"txt-0","delta":"UrlWithTemplateParameters`), so their"}

data: {"type":"text-delta","id":"txt-0","delta":" internals are undocumented here."}

data: {"type":"text-end","id":"txt-0"}

