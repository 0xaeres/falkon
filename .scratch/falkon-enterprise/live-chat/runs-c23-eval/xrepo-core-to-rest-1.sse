gResourceDescription getRepresentationDescription(Representation representation) {\n105: \t\tif (representation instanceof DefaultRepresentation) {\n106: \t\t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n107: \t\t\tdescription.addProperty(\"uuid\");\n108: \t\t\tdescription.addProperty(\"diagnosis\", Representation.REF);\n109: \t\t\tdescription.addProperty(\"condition\", Representation.REF);\n110: \t\t\tdescription.addProperty(\"encounter\", Representation.REF);\n111: \t\t\tdescription.addProperty(\"certainty\");\n112: \t\t\tdescription.addProperty(\"rank\");\n113: \t\t\tdescription.addProperty(\"voided\");\n114: \t\t\tdescription.addProperty(\"display\");\n115: \t\t\tdescription.addProperty(\"patient\", Representation.REF);\n116: \t\t\tdescription.addLink(\"full\", \".?v=\" + RestConstants.REPRESENTATION_FULL);\n117: \t\t\tdescription.addSelfLink();\n118: \t\t\treturn description;\n119: \t\t} else if (representation instanceof FullRepresentation) {\n120: \t\t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n121: \t\t\tdescription.addProperty(\"uuid\");\n122: \t\t\tdescription.addProperty(\"diagnosis\");\n123: \t\t\tdescription.addProperty(\"patient\", Representation.REF);\n124: \t\t\tdescription.addProperty(\"condition\");\n125: \t\t\tdescription.addProperty(\"encounter\");\n126: \t\t\tdescription.addProperty(\"certainty\");\n127: \t\t\tdescription.addProperty(\"rank\");\n128: \t\t\tdescription.addProperty(\"voided\");\n129: \t\t\tdescription.addProperty(\"auditInfo\");\n130: \t\t\tdescription.addProperty(\"display\");\n131: \t\t\tdescription.addSelfLink();\n132: \t\t\treturn description;\n133: \t\t}\n134: \t\treturn null;\n135: \t}\n136: \t\n137: \t/**\n138: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingResourceHandler#getGETModel(Representation)\n139: \t */\n\n(Showing lines 60-139 of 252. Use offset=140 to continue.)\n</content>","sources":[{"type":"file","repo":"g