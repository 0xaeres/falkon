data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-8dc5f8df7f6f84d1","output":{"output":"{\"commits\":[{\"hash\":\"6409aa01cf31b462149416a7eeb19d1d34cd6f8d\",\"date\":\"2026-10-01T12:26:10-04:00\",\"message\":\"Remove distribution override\",\"refs\":\"HEAD, origin/main, origin/HEAD\",\"body\":\"\",\"authorName\":\"Ian\",\"authorEmail\":\"ian.c.bacher@gmail.com\"},{\"hash\":\"68a3ecae994f911e54c4cf0bd6c4c4fa25f822da\",\"date\":\"2026-10-01T12:07:23-04:00\",\"message\":\"Update parent to 2.3.0\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"Ian\",\"authorEmail\":\"ian.c.bacher@gmail.com\"},{\"hash\":\"cd2bd08216c22d8a82d77cad82d9ce968b6ed112\",\"date\":\"2026-09-24T11:55:56Z\",\"message\":\"[maven-release-plugin] prepare for next development iteration\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"648720c8ae09689595150fbd0ecbab9760a094b5\",\"date\":\"2026-09-24T11:55:54Z\",\"message\":\"[maven-release-plugin] prepare release 2.5.0\",\"refs\":\"tag: 2.5.0\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"5547ac928ad06bb41130aa00826bfa2bb59b6acf\",\"date\":\"2026-09-22T22:51:22+05:30\",\"message\":\"Change BillableService id from int to Integer (#195)\",\"refs\":\"\",\"body\":\"* Change BillableService id from int to Integer\\n\\n Change BillableService.billableServiceId from primitive int to Integer so getId() returns null for unsaved instances. Also, cleanup the  handwritten getters and setters with Lombok\\n\\n Removed addServicePrice as it is not getting used anywhere.\\n\\n* Apply spotless\\n\\n* Apply spotless\\n\\n* Remove @Getter(AccessLevel.NONE) from billableServiceId\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"2e21085067a6cfc33f9c5c04f466aa983e63571b\",\"date\":\"2026-09-03T15:24:29Z\",\"message\":\"(chore) created local 'SECURITY.md' from remote 'docs/SECURITY.md'\",\"refs\":\"\",\"body\":\"Sync repo templates\\n\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"null\"},{\"hash\":\"c47f6d87e0352dcfa5a51b5a743016e0a8c40be9\",\"date\":\"2026-09-03T14:06:52+05:30\",\"message\":\"Add locationUuid, startDate and endDate filters to GET /bill (#193)\",\"refs\":\"\",\"body\":\"* Add locationUuid, startDate and endDate filters to GET /bill\\n\\nFilter by location through the bill's cash point location\\nApply startDate and endDate as inclusive bounds on dateCreate\\n\\n* Resolve sonar issues\\n\\n* Add tests\",\"authorName\":\"Wikum Weerakutti\",\"authorEmail\":\"wikum@linuxdeveloper.space\"},{\"hash\":\"dc7d24615afc5c4adc62dcc9110bdff7dcc7c7cf\",\"date\":\"2026-08-12T16:00:48+05:30\",\"message\":\"Document content package configuration in the README (#191)\",\"refs\":\"\",\"body\":\"* Document content package configuration in the README\\n\\nReplace the Installation and Configuration sections with content package\\nsetup covering the globalproperties, billableservices, paymentmodes,\\ncashpoints and cashieritemprices Initializer domains.\\n\\nCorrect the requirements list: fhir2 and event are required modules, not\\noptional. Add the undocumented billing.currencySymbol property and fix the\\ndeclared default for billing.patientDashboard2BillCount.\\n\\n* Correct README inaccuracies and tidy the configuration section\\n\\n- Describe exemptions as concept-scoped JavaScript rules evaluated against\\n  the patient, age, order and active programs; there are no built-in\\n  location-based rules\\n- Note that timesheets are served at /rest/v2/billing/timesheet while the\\n  other resources are on v1\\n- Name the Initializer version that supports all four billing domains\\n- Point readers at omod/src/main/resources/config.xml for the property list\\n- Link the property tables to the receipt numbering and resolver sections\\n- Document the remaining causes of receipt sequence gaps and the per-JVM\\n  scope of reserved blocks\\n- Promote the content package subsections to h3\\n\\n* Document automatic order billing and how prices are resolved\\n\\n* Address review: REST namespace, exemption bindings, global property prefix, install deps\\n\\n* Address review: renew behaviour, CSV headers, strategy docs\\n\\nRenewing an order does not void the previous line item; only revise and\\ndiscontinue do.\\n\\nMove the file paths out of the CSV examples. Initializer reads the first\\nrow as the header, so the leading comment made the blocks uncopyable.\\n\\nSplit strategy customisation into adding a strategy for a new order type\\nand replacing a shipped one. Extending AbstractDefaultOrderBillingStrategy\\nrequires implementing resolveCashier and resolveCashPoint, which are\\ninherited returning null, and exemption checks live in createBillLineItem\\nrather than the shared pipeline.\",\"authorName\":\"Nethmi Rodrigo\",\"authorEmail\":\"nethmi.dilinika@gmail.com\"},{\"hash\":\"3527b7126e38fadb9826702e51e5d2f08f731fd8\",\"date\":\"2026-08-07T16:29:06Z\",\"message\":\"[maven-release-plugin] prepare for next development iteration\",\"refs\":\"\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"},{\"hash\":\"1bc55ca292d69a83e94661f4e69a817cb14b9028\",\"date\":\"2026-08-07T16:29:04Z\",\"message\":\"[maven-release-plugin] prepare release 2.4.0\",\"refs\":\"tag: 2.4.0\",\"body\":\"\",\"authorName\":\"openmrs-bot\",\"authorEmail\":\"infrastructure@openmrs.org\"}],\"totalCount\":221}"}}

