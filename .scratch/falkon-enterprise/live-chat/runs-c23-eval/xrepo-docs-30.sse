data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-utils/src/get-locale.ts","name":"get-locale.ts","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-f2bdc82c-0209-41a8-96a6-02dfee5a0b3f","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-utils/src/get-locale.ts</path>\n<url>undefined</url>\n<content>\n1: import { toLanguageTag } from './language-tag';\n2: \n3: /**\n4:  * Returns the current locale of the application.\n5:  * @returns string\n6:  */\n7: export function getLocale() {\n8:   // i18next detects the language from the `lang` attribute, a `?lang=` parameter, localStorage or\n9:   // the browser, none of which is guaranteed to be a BCP 47 tag, so normalize before returning.\n10:   const detected = window.i18next.language;\n11:   let language = toLanguageTag(detected) ?? detected;\n12:   // Hack for `ht` until all browsers update their unicode support with ht to fr mapping.\n13:   // See https://unicode-org.atlassian.net/browse/CLDR-14956\n14:   if (language === 'ht') {\n15:     language = 'fr-HT';\n16:   }\n17:   return language;\n18: }\n19: \n\n(End of file - 19 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-utils/src/get-locale.ts","name":"get-locale.ts","revision":"HEAD"}]}}

