data: {"type":"tool-output-available","toolCallId":"call-bf9c777c-ee16-41eb-aab0-68102c1a5b34","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>omod/src/main/java/org/openmrs/module/billing/web/rest/resource/PaymentResource.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.web.rest.resource;\n11: \n12: import org.apache.commons.lang3.StringUtils;\n13: import org.openmrs.Provider;\n14: import org.openmrs.api.APIException;\n15: import org.openmrs.api.context.Context;\n16: import org.openmrs.module.billing.api.BillService;\n17: import org.openmrs.module.billing.api.base.ProviderUtil;\n18: import org.openmrs.module.billing.api.PaymentModeService;\n19: import org.openmrs.module.billing.web.base.resource.BaseRestDataResource;\n20: import org.openmrs.module.billing.api.model.Bill;\n21: import org.openmrs.module.billing.api.model.Payment;\n22: import org.openmrs.module.billing.api.model.PaymentAttribute;\n23: import org.openmrs.module.billing.api.model.PaymentMode;\n24: import org.openmrs.module.webservices.rest.web.RequestContext;\n25: import org.openmrs.module.webservices.rest.web.annotation.PropertyGetter;\n26: import org.openmrs.module.webservices.rest.web.annotation.PropertySetter;\n27: import org.openmrs.module.webservices.rest.web.annotation.SubResource;\n28: import org.openmrs.module.webservices.rest.web.representation.DefaultRepresentation;\n29: import org.openmrs.module.webservices.rest.web.representation.FullRepresentation;\n30: import org.openmrs.module.webservices.rest.web.representation.Representation;\n31: import org.openmrs.module.webservices.rest.web.resource.api.PageableResult;\n32: import org.openmrs.module.webservices.rest.web.resource.impl.AlreadyPaged;\n33: import org.openmrs.module.webservices.rest.web.resource.impl.DelegatingResourceDescription;\n34: import org.openmrs.module.webservices.rest.web.resource.impl.DelegatingSubResource;\n35: import org.openmrs.module.webservices.rest.web.response.ObjectNotFoundException;\n36: \n37: import java.math.BigDecimal;\n38: import java.util.ArrayList;\n39: import java.util.HashSet;\n40: import java.util.Set;\n41: \n42: /**\n43:  * REST resource representing a {@link Payment}.\n44:  */\n45: @SubResource(parent = BillResource.class, path = \"payment\", supportedClass = Payment.class, supportedOpenmrsVersions = {\n46:         \"2.0 - 2.*\" })\n47: public class PaymentResource extends DelegatingSubResource<Payment, Bill, BillResource> {\n48: \t\n49: \t@Override\n50: \tpublic DelegatingResourceDescription getRepresentationDescription(Representation rep) {\n51: \t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n52: \t\tif (rep instanceof DefaultRepresentation || rep instanceof FullRepresentation) {\n53: \t\t\tdescription.addProperty(\"uuid\");\n54: \t\t\tdescription.addProperty(\"instanceType\", Representation.REF);\n55: \t\t\tdescription.addProperty(\"attributes\");\n56: \t\t\tdescription.addProperty(\"amount\");\n57: \t\t\tdescription.addProperty(\"amountTendered\");\n58: \t\t\tdescription.addProperty(\"cashier\", Representation.REF);\n59: \t\t\tdescription.addProperty(\"dateCreated\");\n60: \t\t\tdescription.addProperty(\"voided\");\n61: \t\t\treturn description;\n62: \t\t}\n63: \t\t\n64: \t\treturn null;\n65: \t}\n66: \t\n67: \t@Override\n68: \tpublic DelegatingResourceDescription getCreatableProperties() {\n69: \t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n70: \t\tdescription.addProperty(\"instanceType\");\n71: \t\tdescription.addProperty(\"attributes\");\n72: \t\tdescription.addProperty(\"amount\");\n73: \t\tdescription.addProperty(\"amountTendered\");\n74: \t\tdescription.addProperty(\"cashier\");\n75: \t\t\n76: \t\treturn description;\n77: \t}\n78: \t\n79: \t@PropertySetter(\"cashier\")\n80: \tpublic void setCashier(Payment instance, String uuid) {\n81: \t\tif (StringUtils.isBlank(uuid)) {\n82: \t\t\tthrow new APIException(\"Cashier UUID must not be null or blank.\");\n83: \t\t}\n84: \t\tProvider provider = Context.getProviderService().getProviderByUuid(uuid);\n85: \t\tif (provider == null) {\n86: \t\t\tthrow new ObjectNotFoundException();\n87: \t\t}\n88: \t\tinstance.setCashier(provider);\n89: \t}\n90: \t\n91: \t// Work around TypeVariable issue on base generic property (BaseCustomizableInstanceData.getInstanceType)\n92: \t@PropertySetter(\"instanceType\")\n93: \tpublic void setPaymentMode(Payment instance, String uuid) {\n94: \t\tPaymentModeService service = Context.getService(PaymentModeService.class);\n95: \t\t\n96: \t\tPaymentMode mode = service.getPaymentModeByUuid(uuid);\n97: \t\tif (mode == null) {\n98: \t\t\tthrow new ObjectNotFoundException();\n99: \t\t}\n100: \t\t\n101: \t\tinstance.setInstanceType(mode);\n102: \t}\n103: \t\n104: \t@PropertySetter(\"attributes\")\n105: \tpublic void setPaymentAttributes(Payment instance, Set<PaymentAttribute> attributes) {\n106: \t\tif (instance.getAttributes() == null) {\n107: \t\t\tinstance.setAttributes(new HashSet<PaymentAttribute>());\n108: \t\t}\n109: \t\t\n110: \t\tBaseRestDataResource.syncCollection(instance.getAttributes(), attributes);\n111: \t\tfor (PaymentAttribute attr : instance.getAttributes()) {\n112: \t\t\tattr.setOwner(instance);\n113: \t\t}\n114: \t}\n115: \t\n116: \t@PropertySetter(\"amount\")\n117: \tpublic void setPaymentAmount(Payment instance, Object price) {\n118: \t\t// TODO Conversion logic\n119: \t\tdouble amount;\n120: \t\tif (price instanceof Integer) {\n121: \t\t\tint rawAmount = (Integer) price;\n122: \t\t\tamount = Double.valueOf(rawAmount);\n123: \t\t\tinstance.setAmount(BigDecimal.valueOf(amount));\n124: \t\t} else {\n\n(Output capped at 5KB. Showing lines 1-124 of 243. Use offset=125 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/PaymentResource.java","name":"PaymentResource.java","revision":"HEAD"}]}}

