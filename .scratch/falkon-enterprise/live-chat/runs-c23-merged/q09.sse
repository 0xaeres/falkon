data: {"type":"text-delta","id":"txt-0","delta":"file:{github.com/openmrs/open"}

data: {"type":"text-delta","id":"txt-0","delta":"mrs-module-billing::api"}

data: {"type":"text-delta","id":"txt-0","delta":"/src/main/java/org/openmrs"}

