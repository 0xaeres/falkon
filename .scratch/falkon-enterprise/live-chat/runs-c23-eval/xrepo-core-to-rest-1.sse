data: {"type":"data-evidence","data":{"id":14,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_9/EncounterProviderResource1_9.java","revision":"HEAD","startLine":183,"code":["\tpublic EncounterProvider save(EncounterProvider delegate) {","\t\t","\t\tdelegate.getEncounter().addProvider(delegate.getEncounterRole(), delegate.getProvider());","\t\tContext.getEncounterService().saveEncounter(delegate.getEncounter());","\t\t","\t\t// bit of a hack, but since addProvider does not return the provider added, we need to fetch it","\t\t// so that the returned delegate has the proper persisted uuid"],"highlightedLines":[186]}}

data: {"type":"data-evidence","data":{"id":15,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_9/EncounterProviderResource1_9.java","revision":"HEAD","startLine":185,"code":["\t\tdelegate.getEncounter().addProvider(delegate.getEncounterRole(), delegate.getProvider());","\t\tContext.getEncounterService().saveEncounter(delegate.getEncounter());","\t\t","\t\t// bit of a hack, but since addProvider does not return the provider added, we need to fetch it","\t\t// so that the returned delegate has the proper persisted uuid","\t\t// see: https://issues.openmrs.org/browse/RESTWS-638","\t\tfor (EncounterProvider encounterProvider : delegate.getEncounter().getEncounterProviders()) {","\t\t\tif (encounterProvider.getEncounterRole().equals(delegate.getEncounterRole())","\t\t\t        && encounterProvider.getProvider().equals(delegate.getProvider()) && !encounterProvider.isVoided()) {","\t\t\t\treturn encounterProvider;","\t\t\t}","\t\t}","\t\t","\t\t// should never get here, hopefully!","\t\tthrow new APIException(\"Encounter Provider not properly saved\");","\t}","\t","\t@Override"],"highlightedLines":[188,189,190,191,192,193,194,195,196,197,198,199]}}

data: {"type":"data-evidence","data":{"id":16,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_8/EncounterResource1_8.java","revision":"HEAD","startLine":227,"code":["\t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#purge(Encounter,","\t *      RequestContext)","\t */","\t@Override","\tpublic void purge(Encounter enc, RequestContext context) throws ResponseException {","\t\tif (enc == null) {","\t\t\t// DELETE is idempotent, so we return success here","\t\t\treturn;","\t\t}","\t\tContext.getEncounterService().purgeEncounter(enc);","\t}","\t","\t/**","\t * @param encounter"],"highlightedLines":[230,231,232,233,234,235,236,237]}}

data: {"type":"data-evidence","data":{"id":17,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_8/EncounterResource1_8.java","revision":"HEAD","startLine":202,"code":["\t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#delete(Encounter,","\t *      String, RequestContext)","\t */","\t@Override","\tpublic void delete(Encounter enc, String reason, RequestContext context) throws ResponseException {","\t\tif (enc.isVoided()) {","\t\t\t// DELETE is idempotent, so we return success here","\t\t\treturn;","\t\t}","\t\tContext.getEncounterService().voidEncounter(enc, reason);","\t}","\t","\t/**","\t * @see org.openmrs.module.webservices.rest.web.resource.impl.BaseDelegatingResource#undelete(Object,","\t *      RequestContext)","\t */","\t@Override","\tprotected Encounter undelete(Encounter enc, RequestContext context) throws ResponseException {","\t\tif (enc.isVoided()) {","\t\t\tenc = Context.getEncounterService().unvoidEncounter(enc);","\t\t}","\t\treturn enc;","\t}","\t","\t/**","\t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#purge(Encounter,"],"highlightedLines":[205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224]}}

data: {"type":"data-evidence","data":{"id":18,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_8/EncounterResource1_8.java","revision":"HEAD","startLine":285,"code":["\t * @param context","\t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#doSearch(RequestContext)","\t */","\t@Override","\tprotected PageableResult doSearch(RequestContext context) {","\t\tString patientUuid = context.getRequest().getParameter(\"patient\");","\t\tif (patientUuid != null) {","\t\t\tPatient patient = ((PatientResource1_8) Context.getService(RestService.class).getResourceBySupportedClass(","\t\t\t    Patient.class)).getByUniqueId(patientUuid);","\t\t\tif (patient == null)","\t\t\t\treturn new EmptySearchResult();","\t\t\tList<Encounter> encs = Context.getEncounterService().getEncountersByPatient(patient);","\t\t\treturn new NeedsPaging<Encounter>(encs, context);","\t\t}","\t\t","\t\treturn new ServiceSearcher<Encounter>(EncounterService.class, \"getEncounters\", \"getCountOfEncounters\").search(","\t\t    context.getParameter(\"q\"), context);","\t}","\t","}"],"highlightedLines":[288,289,290,291,292,293,294,295,296,297,298,299,300,301,302]}}

