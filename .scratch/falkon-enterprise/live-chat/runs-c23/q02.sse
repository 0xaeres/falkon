   method: 'POST',\n219:     body: payload,\n220:     headers: {\n221:       'Content-Type': 'application/json',\n222:     },\n223:   });\n224: };\n225: \n226: export const updateBillItems = (payload: UpdateBillPayload) => {\n227:   const url = `${apiBasePath}bill/${payload.uuid}`;\n228:   return openmrsFetch(url, {\n229:     method: 'POST',\n230:     body: payload,\n231:     headers: {\n232:       'Content-Type': 'application/json',\n233:     },\n234:   });\n235: };\n236: \n237: export const finalizeBill = (billUuid: string) => {\n238:   const url = `${apiBasePath}bill/${billUuid}`;\n239:   return openmrsFetch(url, {\n240:     method: 'POST',\n241:     body: { status: BillStatus.POSTED },\n242:     headers: {\n243:       'Content-Type': 'application/json',\n244:     },\n245:   });\n246: };\n247: \n248: export const deleteBillItem = (itemUuid: string, voidReason: string) => {\n249:   const url = `${apiBasePath}billLineItem/${itemUuid}?reason=${encodeURIComponent(voidReason)}`;\n250: \n251:   return openmrsFetch(url, {\n252:     method: 'DELETE',\n253:   });\n254: };\n255: \n256: export const deleteBill = (billUuid: string, reason: string) => {\n257:   const url = `${apiBasePath}bill/${billUuid}?reason=${encodeURIComponent(reason)}`;\n258: \n259:   return openmrsFetch(url, {\n260:     method: 'DELETE',\n261:   });\n262: };\n263: \n264: export const patientPaymentStatusCacheKey = (patientUuid: string) =>\n265:   `${apiBasePath}patientPaymentStatus/${patientUuid}`;\n266: \n267: export const usePatientPaymentStatus = (patientUuid: string) => {\n268:   const url = patientPaymentStatusCacheKey(patientUuid);\n269:   const { data, error, isLoading, isValidating, mutate } = useSWR<{ data: PatientPaymentStatus }>(\n\n(Showing lines 170-269 of 281. Use offset=270 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/billing.resource.ts","name":"billing.resource.ts","revision":"HEAD"}]}}

