data: {"type":"text-delta","id":"txt-0","delta":" validates the schema, merges it with the implicit schema"}

data: {"type":"text-delta","id":"txt-0","delta":" via `mergeDeepReplace`, and stores"}

data: {"type":"text-delta","id":"txt-0","delta":" the result in the config store keyed"}

data: {"type":"text-delta","id":"txt-0","delta":" by module name, also flagging the module"}

data: {"type":"text-delta","id":"txt-0","delta":" as loaded @file:{github.com/openmrs/open"}

