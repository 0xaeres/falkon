data: {"type":"tool-output-available","toolCallId":"call-14818590-9515-415e-9ac5-864bd4510576","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-utils/src/dates/date-util.ts</path>\n<url>undefined</url>\n<content>\n1: /**\n2:  * @module\n3:  * @category Date and Time\n4:  */\n5: import {\n6:   type CalendarDate,\n7:   type CalendarDateTime,\n8:   type CalendarIdentifier,\n9:   type ZonedDateTime,\n10:   createCalendar,\n11:   toCalendar,\n12: } from '@internationalized/date';\n13: import { attempt } from 'any-date-parser';\n14: import dayjs from 'dayjs';\n15: import isToday from 'dayjs/plugin/isToday.js';\n16: import objectSupport from 'dayjs/plugin/objectSupport.js';\n17: import utc from 'dayjs/plugin/utc.js';\n18: import { isNil, omit } from 'lodash-es';\n19: import { getLocale } from '../';\n20: \n21: dayjs.extend(isToday);\n22: dayjs.extend(utc);\n23: dayjs.extend(objectSupport);\n24: \n25: export type DateInput = string | number | Date;\n26: \n27: const isoFormat = 'YYYY-MM-DDTHH:mm:ss.SSSZZ';\n28: \n29: /**\n30:  * This function checks whether a date string is the OpenMRS ISO format.\n31:  * The format should be YYYY-MM-DDTHH:mm:ss.SSSZZ\n32:  */\n33: export function isOmrsDateStrict(omrsPayloadString: string): boolean {\n34:   // omrs format 2018-03-19T00:00:00.000+0300\n35:   if (omrsPayloadString === null || omrsPayloadString === undefined || omrsPayloadString.trim().length !== 28) {\n36:     return false;\n37:   }\n38:   omrsPayloadString = omrsPayloadString.trim();\n39: \n40:   // 11th character will always be T\n41:   if (omrsPayloadString[10] !== 'T') {\n42:     return false;\n43:   }\n44: \n45:   // checking time format\n46:   if (omrsPayloadString[13] !== ':' || omrsPayloadString[16] !== ':' || omrsPayloadString[19] !== '.') {\n47:     return false;\n48:   }\n49: \n50:   // checking UTC offset format\n51:   if (!(omrsPayloadString[23] === '+' || omrsPayloadString[23] === '-')) {\n52:     return false;\n53:   }\n54: \n55:   return dayjs(omrsPayloadString, isoFormat).isValid();\n56: }\n57: \n58: /**\n59:  * Checks if the provided date is today.\n60:  *\n61:  * @param date The date to check.\n62:  * @returns `true` if the date is today, `false` otherwise.\n63:  */\n64: export function isOmrsDateToday(date: DateInput) {\n65:   return dayjs(date).isToday();\n66: }\n67: \n68: /**\n69:  * Converts the object to a date object if it is an OpenMRS ISO date time string.\n70:  * Otherwise returns null.\n71:  */\n72: export function toDateObjectStrict(omrsDateString: string): Date | null {\n73:   if (!isOmrsDateStrict(omrsDateString)) {\n74:     return null;\n75:   }\n76: \n77:   return dayjs(omrsDateString, isoFormat).toDate();\n78: }\n79: \n80: /**\n81:  * Formats the input to OpenMRS ISO format: \"YYYY-MM-DDTHH:mm:ss.SSSZZ\".\n82:  */\n83: export function toOmrsIsoString(date: DateInput, toUTC = false): string {\n84:   let d = dayjs(date);\n85: \n86:   if (toUTC) {\n87:     d = d.utc();\n88:   }\n89: \n90:   return d.format(isoFormat);\n91: }\n92: \n93: /**\n94:  * Utility function to parse an arbitrary string into a date.\n95:  * Uses `dayjs(dateString)`.\n96:  */\n97: export function parseDate(dateString: string) {\n98:   return dayjs(dateString).toDate();\n99: }\n100: \n\n(Showing lines 1-100 of 725. Use offset=101 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-utils/src/dates/date-util.ts","name":"date-util.ts","revision":"HEAD"}]}}

