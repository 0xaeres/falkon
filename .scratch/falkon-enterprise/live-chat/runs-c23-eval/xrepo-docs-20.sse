data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-routes/src/loaders/load-lifecycles.ts","name":"load-lifecycles.ts","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-b80139d6-4ec0-46c3-969e-1d23f4d838b7","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-routes/src/loaders/load-lifecycles.ts</path>\n<url>undefined</url>\n<content>\n1: import { importDynamic } from '@openmrs/esm-dynamic-loading';\n2: import { type LifeCycles } from 'single-spa';\n3: import { registerModuleLoad } from '@openmrs/esm-config';\n4: \n5: // Couldn't figure out how to express this as an interface\n6: type Module = Omit<Record<string, () => LifeCycles | Promise<LifeCycles>>, 'startupApp'> & {\n7:   startupApp?: () => unknown;\n8: };\n9: \n10: /**\n11:  * @internal\n12:  *\n13:  * Used internally to track which apps have had their `startupApp()` initializer called\n14:  *\n15:  * Values are promises to support asynchronous loading of the same app multiple times\n16:  */\n17: const initializedApps = new Map<string, Promise<unknown>>();\n18: \n19: /**\n20:  * This function loads a single-spa Lifecycles from the given app. The Lifecycles should be\n21:  * created using `getAsyncLifecycle()` or `getSyncLifecycle()` and exported in the app's\n22:  * index.ts file.\n23:  * The function is lazy and ensures that the appropriate module is loaded,\n24:  * that the module's `startupApp()` is called before the component is loaded. It\n25:  * then calls the component function, which should return either a single-spa\n26:  * {@link LifeCycles} object or a {@link Promise} that will resolve to such an object.\n27:  *\n28:  * @param routesAppName The app name of the routes.json file defining the component to load\n29:  *\n30:  * @param fullComponentName The name of the component to load. Note that this can optionally\n31:  * include the appName to load the component from (in the format `${appName}#${componentName}`),\n32:  * or omitted to implicitly use routesAppName\n33:  *\n34:  */\n35: export async function loadLifeCycles(routesAppName: string, fullComponentName: string): Promise<LifeCycles> {\n36:   const poundIndex = fullComponentName.indexOf('#');\n37:   const isNamespaced = poundIndex >= 0;\n38:   const appName = isNamespaced ? fullComponentName.substring(0, poundIndex) : routesAppName;\n39:   const componentName = isNamespaced ? fullComponentName.substring(poundIndex + 1) : fullComponentName;\n40: \n41:   const module = await importDynamic<Module>(appName);\n42: \n43:   if (module && Object.hasOwn(module, componentName) && typeof module[componentName] === 'function') {\n44:     return initializeApp(appName, module).then(() => module[componentName]());\n45:   } else {\n46:     if (!module) {\n47:       console.warn(`Unknown app ${appName} for ${fullComponentName} defined in ${routesAppName}'s routes.json`);\n48:     } else if (module && Object.hasOwn(module, componentName)) {\n49:       console.warn(`The export ${fullComponentName}, defined in ${routesAppName}'s routes.json, is not a function`);\n50:     } else {\n51:       console.warn(\n52:         `${appName} does not define a component called \"${componentName}\", referenced in ${routesAppName}'s routes.json. This cannot be loaded.`,\n53:       );\n54:     }\n55:   }\n56: \n57:   return emptyLifecycle;\n58: }\n59: \n60: const emptyLifecycle: LifeCycles<never> = {\n61:   bootstrap() {\n62:     return Promise.resolve();\n63:   },\n64:   mount() {\n65:     return Promise.resolve();\n66:   },\n67:   unmount() {\n68:     return Promise.resolve();\n69:   },\n70: };\n71: \n72: /**\n73:  * This function can be used to manually initialize an application without waiting for the\n74:  * framework to load it. This can sometimes be helpful if the framework doesn't load code\n75:  * at the point you think is appropriate.\n76:  *\n77:  * This will ensure that the module is available and that it's `startupApp()` function (if\n78:  * any) will be called. Note that these are only guaranteed to be complete once the Promise\n79:  * returned from the function completes.\n80:  *\n81:  * @param appName The name of the app to initialize\n82:  * @param module The loaded code module, if available; if this parameter is omitted, this\n83:  *   function will load it.\n84:  * @returns a Promise which completes once the app has been loaded and initialized\n85:  */\n86: async function initializeApp(appName: string, module?: Module) {\n87:   if (!(appName in initializedApps)) {\n88:     let _module: Module = module ?? (await importDynamic<Module>(appName));\n89: \n90:     await (initializedApps[appName] = new Promise((resolve, reject) => {\n91:       if (Object.hasOwn(_module, 'startupApp')) {\n92:         const startup = _module['startupApp'];\n93:         if (typeof startup === 'function') {\n94:           return Promise.resolve(startup())\n95:             .then(() => {\n96:               registerModuleLoad(appName);\n97:               resolve(null);\n98:             })\n99:             .catch(reject);\n100:         }\n101:       }\n102: \n103:       registerModuleLoad(appName);\n104:       resolve(null);\n105:     }));\n106:   } else {\n107:     await initializedApps[appName];\n108:   }\n109: }\n110: \n\n(End of file - 110 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-routes/src/loaders/load-lifecycles.ts","name":"load-lifecycles.ts","revision":"HEAD"}]}}

data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-routes/src/loaders/components.ts","name":"components.ts","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-af47dc5f-7ec3-40d2-a13e-4d80a2bc98e0","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-routes/src/loaders/components.ts</path>\n<url>undefined</url>\n<content>\n1: import {\n2:   attach,\n3:   registerExtension,\n4:   registerModal,\n5:   registerWorkspaceGroups2,\n6:   registerWorkspaces2,\n7:   registerWorkspaceWindows2,\n8: } from '@openmrs/esm-extensions';\n9: import {\n10:   type ExtensionDefinition,\n11:   type FeatureFlagDefinition,\n12:   type ModalDefinition,\n13:   type WorkspaceDefinition2,\n14:   type WorkspaceGroupDefinition2,\n15:   type WorkspaceWindowDefinition2,\n16: } from '@openmrs/esm-globals';\n17: import { registerFeatureFlag } from '@openmrs/esm-feature-flags';\n18: import { loadLifeCycles } from './load-lifecycles';\n19: \n20: /**\n21:  * This function registers an extension definition with the framework and will\n22:  * attach the extension to any configured slots.\n23:  *\n24:  * @param appName The name of the app containing this extension\n25:  * @param extension An object that describes the extension, derived from `routes.json`\n26:  */\n27: export function tryRegisterExtension(appName: string, extension: ExtensionDefinition) {\n28:   const name = extension.name;\n29:   if (!name) {\n30:     console.error(\n31:       `An extension definition in ${appName} is missing an name and thus cannot be\n32: registered. To fix this, ensure that you define the \"name\" field inside the\n33: extension definition.`,\n34:       extension,\n35:     );\n36:     return;\n37:   }\n38: \n39:   if (extension.slots && extension.slot) {\n40:     console.warn(\n41:       `The extension ${name} from ${appName} declares both a 'slots' property and\n42: a 'slot' property. Only the 'slots' property will be honored.`,\n43:     );\n44:   }\n45:   const slots = extension.slots ? extension.slots : extension.slot ? [extension.slot] : [];\n46: \n47:   if (!extension.component) {\n48:     console.error(\n49:       `The extension ${name} from ${appName} is missing a 'component' entry and thus cannot be registered.\n50: To fix this, ensure that you define a 'component' field inside the extension definition.`,\n51:       extension,\n52:     );\n53:     return;\n54:   }\n55: \n56:   registerExtension({\n57:     name,\n58:     load: () => loadLifeCycles(appName, extension.component),\n59:     meta: extension.meta || {},\n60:     order: extension.order,\n61:     moduleName: appName,\n62:     privileges: extension.privileges,\n63:     featureFlag: extension.featureFlag,\n64:     displayExpression: extension.displayExpression,\n65:   });\n66: \n67:   for (const slot of slots) {\n68:     attach(slot, name);\n69:   }\n70: }\n71: \n72: /**\n73:  * This function registers a modal definition with the framework so that it can be launched.\n74:  *\n75:  * @param appName The name of the app defining this modal\n76:  * @param modal An object that describes the modal, derived from `routes.json`\n77:  */\n78: export function tryRegisterModal(appName: string, modal: ModalDefinition) {\n79:   const name = modal.name;\n80:   if (!name) {\n81:     console.error(\n82:       `A modal definition in ${appName} is missing an name and thus cannot be\n83: registered. To fix this, ensure that you define the \"name\" field inside the\n84: modal definition.`,\n85:       modal,\n86:     );\n87:     return;\n88:   }\n89: \n90:   if (!modal.component) {\n91:     console.error(\n92:       `The modal ${name} from ${appName} is missing a 'component' entry and thus cannot be registered.\n93: To fix this, ensure that you define a 'component' field inside the modal definition.`,\n94:       modal,\n95:     );\n96:     return;\n97:   }\n98: \n99:   registerModal({\n100:     name,\n101:     moduleName: appName,\n102:     load: () => loadLifeCycles(appName, modal.component),\n103:   });\n104: }\n105: \n106: export function tryRegisterWorkspaceGroups2(appName: string, workspaceGroupDefs: Array<WorkspaceGroupDefinition2>) {\n107:   registerWorkspaceGroups2(appName, workspaceGroupDefs);\n108: }\n109: \n110: export function tryRegisterWorkspace2(appName: string, workspaceDefs: Array<WorkspaceDefinition2>) {\n111:   registerWorkspaces2(appName, workspaceDefs);\n112: }\n113: \n114: export function tryRegisterWorkspaceWindows2(appName: string, workspaceWindowDefs: Array<WorkspaceWindowDefinition2>) {\n115:   registerWorkspaceWindows2(appName, workspaceWindowDefs);\n116: \n117:   // register each window with icon as an extension to the slot with\n118:   // its workspace group name as slotName. This allows for configuration\n119:   // of the icons in the group, similar to extensions in extension slots\n120:   for (const windowDef of workspaceWindowDefs) {\n121:     if (windowDef.icon) {\n122:       const extension: ExtensionDefinition = {\n123:         name: windowDef.name,\n124:         component: windowDef.icon,\n125:         slot: windowDef.group,\n126:         order: windowDef.order,\n127:       };\n128:       tryRegisterExtension(appName, extension);\n129:     }\n130:   }\n131: }\n132: \n133: /**\n134:  * This function registers a feature flag definition with the framework.\n135:  *\n136:  * @param appName The name of the app defining this feature flag\n137:  * @param featureFlag An object that describes the feature flag, derived from `routes.json`\n138:  */\n139: export function tryRegisterFeatureFlag(appName: string, featureFlag: FeatureFlagDefinition) {\n140:   const name = featureFlag.flagName;\n141:   if (!name) {\n142:     console.error(\n143:       `A feature flag definition in ${appName} is missing a name and thus cannot be registered.\n144: To fix this, ensure that you define the \"name\" field inside the feature flag definition.`,\n145:       featureFlag,\n146:     );\n147:     return;\n148:   }\n149: \n150:   const label = featureFlag.label;\n151:   if (!label) {\n152:     console.error(\n153:       `A feature flag definition in ${appName} is missing a description and thus cannot be registered.\n154: To fix this, ensure that you define the \"label\" field inside the feature flag definition.`,\n155:       featureFlag,\n156:     );\n157:     return;\n158:   }\n159: \n\n(Output capped at 5KB. Showing lines 1-159 of 172. Use offset=160 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-routes/src/loaders/components.ts","name":"components.ts","revision":"HEAD"}]}}

