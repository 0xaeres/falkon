data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-9cabffd09edee968","output":{"output":"Found 60 matches in 5 files\n\n[github.com/openmrs/openmrs-module-billing] api/src/main/java/org/openmrs/module/billing/api/model/Payment.java:\n  29: public class Payment extends BaseInstanceCustomizableData<PaymentMode, PaymentAttribute> {\n  59: \tpublic PaymentAttribute addAttribute(PaymentModeAttributeType type, String value) {\n  67: \t\tPaymentAttribute attribute = new PaymentAttribute();\n\n[github.com/openmrs/openmrs-module-billing] api/src/main/java/org/openmrs/module/billing/api/model/PaymentMode.java:\n  17: public class PaymentMode extends BaseInstanceCustomizableType<PaymentModeAttributeType> {\n  31: \tpublic PaymentModeAttributeType addAttributeType(String name, String format, String regExp, boolean required) {\n  32: \t\tPaymentModeAttributeType attributeType = new PaymentModeAttributeType();\n\n[github.com/openmrs/openmrs-module-billing] api/src/main/java/org/openmrs/module/billing/api/model/PaymentAttribute.java:\n  17: public class PaymentAttribute extends BaseInstanceAttributeData<Payment, PaymentMode, PaymentModeAttributeType> {\n  15:  * Model class that represents a payment mode attribute for a particular {@link Payment}.\n\n[github.com/openmrs/openmrs-module-billing] api/src/main/java/org/openmrs/module/billing/api/impl/PaymentModeServiceImpl.java:\n  27: public class PaymentModeServiceImpl extends BaseOpenmrsService implements PaymentModeService {\n  37: \tpublic PaymentMode getPaymentMode(Integer id) {\n  49: \tpublic PaymentMode getPaymentModeByUuid(String uuid) {\n  61: \tpublic List<PaymentMode> getPaymentModes(boolean includeRetired) {\n  70: \tpublic PaymentMode savePaymentMode(PaymentMode paymentMode) {\n  82: \tpublic PaymentMode retirePaymentMode(PaymentMode paymentMode, String reason) {\n  94: \tpublic PaymentMode unretirePaymentMode(PaymentMode paymentMode) {\n  103: \tpublic void purgePaymentMode(PaymentMode paymentMode) {\n  15: import org.openmrs.module.billing.api.PaymentModeService;\n  16: import org.openmrs.module.billing.api.db.PaymentModeDAO;\n  17: import org.openmrs.module.billing.api.model.PaymentMode;\n  24:  * Default implementation of {@link PaymentModeService}.\n  30: \tprivate PaymentModeDAO paymentModeDAO;\n  41: \t\treturn paymentModeDAO.getPaymentMode(id);\n  53: \t\treturn paymentModeDAO.getPaymentModeByUuid(uuid);\n  62: \t\treturn paymentModeDAO.getPaymentModes(includeRetired);\n  72: \t\t\tthrow new NullPointerException(\"Payment mode cannot be null\");\n  74: \t\treturn paymentModeDAO.savePaymentMode(paymentMode);\n  86: \t\treturn paymentModeDAO.savePaymentMode(paymentMode);\n  95: \t\treturn paymentModeDAO.savePaymentMode(paymentMode);\n  (2 more lines)\n\n[github.com/openmrs/openmrs-module-billing] omod/src/main/java/org/openmrs/module/billing/web/rest/resource/PaymentResource.java:\n  47: public class PaymentResource extends DelegatingSubResource<Payment, Bill, BillResource> {\n  233: \tprivate Payment findPayment(Bill bill, final String paymentUUID) {\n  93: \tpublic void setPaymentMode(Payment instance, String uuid) {\n  105: \tpublic void setPaymentAttributes(Payment instance, Set<PaymentAttribute> attributes) {\n  117: \tpublic void setPaymentAmount(Payment instance, Object price) {\n\n(Output was cut short: narrow the path or pattern, name a repo, or raise the limit.)","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Payment.java","name":"Payment.java","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/PaymentMode.java","name":"PaymentMode.java","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/PaymentAttribute.java","name":"PaymentAttribute.java","revision":"HEAD"},{"type":"