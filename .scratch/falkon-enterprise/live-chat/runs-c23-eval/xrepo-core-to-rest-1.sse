data: {"type":"tool-output-available","toolCallId":"call-bb2f0f83-323c-4251-ae75-f12360ec89cc","output":{"output":"<repo>github.com/openmrs/openmrs-module-webservices.rest</repo>\n<path>omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_8/EncounterResource1_8.java</path>\n<url>undefined</url>\n<content>\n120: \t\t\tmodelImpl\n121: \t\t\t        .property(\"patient\", new RefProperty(\"#/definitions/PatientGet\")) //FIXME\n122: \t\t\t        .property(\"location\", new RefProperty(\"#/definitions/LocationGet\")) //FIXME\n123: \t\t\t        .property(\"form\", new RefProperty(\"#/definitions/FormGet\")) //FIXME\n124: \t\t\t        .property(\"encounterType\", new RefProperty(\"#/definitions/EncountertypeGet\")) //FIXME\n125: \t\t\t        .property(\"obs\", new ArrayProperty(new RefProperty(\"#/definitions/ObsGet\"))) //FIXME\n126: \t\t\t        .property(\"orders\", new ArrayProperty(new RefProperty(\"#/definitions/OrderGet\"))); //FIXME\n127: \t\t}\n128: \t\treturn modelImpl;\n129: \t}\n130: \t\n131: \t@Override\n132: \tpublic Model getCREATEModel(Representation rep) {\n133: \t\treturn new ModelImpl()\n134: \t\t        .property(\"patient\", new RefProperty(\"#/definitions/PatientCreate\"))\n135: \t\t        .property(\"encounterType\", new RefProperty(\"#/definitions/EncountertypeCreate\"))\n136: \t\t        .property(\"encounterDatetime\", new DateProperty())\n137: \t\t        .property(\"location\", new RefProperty(\"#/definitions/LocationCreate\"))\n138: \t\t        .property(\"form\", new RefProperty(\"#/definitions/FormCreate\"))\n139: \t\t        .property(\"provider\", new StringProperty())\n140: \t\t        .property(\"orders\", new ArrayProperty(new RefProperty(\"#/definitions/OrderCreate\")))\n141: \t\t        .property(\"obs\", new ArrayProperty(new RefProperty(\"#/definitions/ObsCreate\")))\n142: \t\t        \n143: \t\t        .required(\"patient\").required(\"encounterType\");\n144: \t}\n145: \t\n146: \t@Override\n147: \tpublic Model getUPDATEModel(Representation rep) {\n148: \t\treturn getCREATEModel(rep);\n149: \t}\n150: \t\n151: \t/**\n152: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.BaseDelegatingResource#getCreatableProperties()\n153: \t * <strong>Should</strong> create an encounter type\n154: \t */\n155: \t@Override\n156: \tpublic DelegatingResourceDescription getCreatableProperties() {\n157: \t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n158: \t\t\n159: \t\tdescription.addProperty(\"encounterDatetime\"); // has a default value set, hence not required here\n160: \t\tdescription.addRequiredProperty(\"patient\");\n161: \t\tdescription.addRequiredProperty(\"encounterType\");\n162: \t\t\n163: \t\tdescription.addProperty(\"location\");\n164: \t\tdescription.addProperty(\"form\");\n165: \t\tdescription.addProperty(\"provider\");\n166: \t\tdescription.addProperty(\"orders\");\n167: \t\tdescription.addProperty(\"obs\");\n168: \t\t\n169: \t\treturn description;\n170: \t}\n171: \t\n172: \t/**\n173: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#newDelegate()\n174: \t */\n175: \t@Override\n176: \tpublic Encounter newDelegate() {\n177: \t\tEncounter enc = new Encounter();\n178: \t\t// default to now(), so a web client can create a real-time encounter based on the server time\n179: \t\tenc.setEncounterDatetime(new Date());\n180: \t\t// As of 2012-04-27 there is a bug in Encounter.getOrders() where, if null, it returns an empty list without keeping a reference to it\n181: \t\tenc.setOrders(new LinkedHashSet<Order>());\n182: \t\treturn enc;\n183: \t}\n184: \t\n185: \t/**\n186: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#save(Encounter)\n187: \t */\n188: \t@Override\n189: \tpublic Encounter save(Encounter enc) {\n190: \t\treturn Context.getEncounterService().saveEncounter(enc);\n191: \t}\n192: \t\n193: \t/**\n194: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#getByUniqueId(String)\n195: \t */\n196: \t@Override\n197: \tpublic Encounter getByUniqueId(String uuid) {\n198: \t\treturn Context.getEncounterService().getEncounterByUuid(uuid);\n199: \t}\n200: \t\n201: \t/**\n202: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#delete(Encounter,\n203: \t *      String, RequestContext)\n204: \t */\n205: \t@Override\n206: \tpublic void delete(Encounter enc, String reason, RequestContext context) throws ResponseException {\n207: \t\tif (enc.isVoided()) {\n208: \t\t\t// DELETE is idempotent, so we return success here\n209: \t\t\treturn;\n210: \t\t}\n211: \t\tContext.getEncounterService().voidEncounter(enc, reason);\n212: \t}\n213: \t\n214: \t/**\n215: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.BaseDelegatingResource#undelete(Object,\n216: \t *      RequestContext)\n217: \t */\n218: \t@Override\n219: \tprotected Encounter undelete(Encounter enc, RequestContext context) throws ResponseException {\n220: \t\tif (enc.isVoided()) {\n221: \t\t\tenc = Context.getEncounterService().unvoidEncounter(enc);\n222: \t\t}\n223: \t\treturn enc;\n224: \t}\n225: \t\n226: \t/**\n227: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#purge(Encounter,\n228: \t *      RequestContext)\n229: \t */\n\n(Showing lines 120-229 of 305. Use offset=230 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_8/EncounterResource1_8.java","name":"EncounterResource1_8.java","revision":"HEAD"}]}}

