data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Bill.java","name":"Bill.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-b781d61e97372820","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/model/Bill.java</path>\n<url>undefined</url>\n<content>\n189: \t\t\tthrow new IllegalArgumentException(\"The item to add must be defined.\");\n190: \t\t}\n191: \t\tif (price == null) {\n192: \t\t\tthrow new IllegalArgumentException(\"The item price must be defined.\");\n193: \t\t}\n194: \t\t\n195: \t\tBillLineItem lineItem = new BillLineItem();\n196: \t\tlineItem.setBill(this);\n197: \t\tlineItem.setItem(item);\n198: \t\tlineItem.setPrice(price);\n199: \t\tlineItem.setPriceName(priceName);\n200: \t\tlineItem.setQuantity(quantity);\n201: \t\t\n202: \t\taddLineItem(lineItem);\n203: \t\t\n204: \t\treturn lineItem;\n205: \t}\n206: \t\n207: \tpublic void addLineItem(BillLineItem item) {\n208: \t\tif (item == null) {\n209: \t\t\tthrow new NullPointerException(\"The list item to add must be defined.\");\n210: \t\t}\n211: \t\t\n212: \t\tif (this.lineItems == null) {\n213: \t\t\tthis.lineItems = new ArrayList<>();\n214: \t\t}\n215: \t\t\n216: \t\tthis.lineItems.add(item);\n217: \t\titem.setBill(this);\n218: \t}\n219: \t\n220: \tpublic void removeLineItem(BillLineItem item) {\n221: \t\tif (item != null) {\n222: \t\t\tif (this.lineItems != null) {\n223: \t\t\t\tthis.lineItems.remove(item);\n224: \t\t\t}\n225: \t\t}\n226: \t}\n227: \t\n228: \tpublic void addDiscount(BillDiscount discount) {\n229: \t\tif (discount == null) {\n230: \t\t\tthrow new NullPointerException(\"The discount to add must be defined.\");\n231: \t\t}\n232: \t\tif (this.discounts == null) {\n233: \t\t\tthis.discounts = new HashSet<>();\n234: \t\t}\n235: \t\tthis.discounts.add(discount);\n236: \t\tdiscount.setBill(this);\n237: \t}\n238: \t\n239: \tpublic void addPayment(Payment payment) {\n240: \t\tif (payment == null) {\n241: \t\t\tthrow new NullPointerException(\"The payment to add must be defined.\");\n242: \t\t}\n243: \t\t\n244: \t\tif (this.payments == null) {\n245: \t\t\tthis.payments = new HashSet<>();\n246: \t\t}\n247: \t\t\n248: \t\tthis.payments.add(payment);\n249: \t\tpayment.setBill(this);\n250: \t\t\n251: \t\tthis.synchronizeBillStatus();\n252: \t}\n253: \t\n254: \tpublic void synchronizeBillStatus() {\n255: \t\tBillStatus current = getStatus();\n256: \t\tif (current == BillStatus.REFUND_REQUESTED || current == BillStatus.REFUNDED\n257: \t\t        || current == BillStatus.PARTIALLY_REFUNDED) {\n258: \t\t\treturn;\n259: \t\t}\n260: \t\tif (this.getPayments() != null && !this.getPayments().isEmpty()\n261: \t\t        && getTotalPayments().compareTo(BigDecimal.ZERO) > 0) {\n262: \t\t\t// Approved discount exceeds the current bill total — likely a line item was voided\n263: \t\t\t// after approval. Stay POSTED so a human can void/reapply rather than letting any\n264: \t\t\t// non-zero payment silently flip the bill to PAID.\n265: \t\t\tif (hasDiscountDrift()) {\n266: \t\t\t\tlog.warn(\"Bill {} has discount drift (total={}, effectiveTotal={}); staying POSTED for manual review\",\n267: \t\t\t\t    getUuid(), getTotal(), effectiveTotal());\n268: \t\t\t\tthis.setStatus(BillStatus.POSTED);\n269: \t\t\t\treturn;\n270: \t\t\t}\n271: \t\t\tboolean billFullySettled = getTotalPayments().compareTo(getAmountAfterDiscount()) >= 0;\n272: \t\t\tif (billFullySettled) {\n273: \t\t\t\tthis.setStatus(BillStatus.PAID);\n274: \t\t\t\t// Update all non-voided and non-refunded status bill line items to PAID status\n275: \t\t\t\tif (this.lineItems != null) {\n276: \t\t\t\t\tfor (BillLineItem lineItem : this.lineItems) {\n277: \t\t\t\t\t\tif (lineItem != null && !lineItem.getVoided() && !isRefundStatus(lineItem.getStatus())) {\n278: \t\t\t\t\t\t\tlineItem.setStatus(BillLineItemStatus.PAID);\n279: \t\t\t\t\t\t}\n280: \t\t\t\t\t}\n281: \t\t\t\t}\n282: \t\t\t} else {\n283: \t\t\t\tthis.setStatus(BillStatus.POSTED);\n284: \t\t\t}\n285: \t\t}\n286: \t}\n287: \t\n288: \tpublic void removePayment(Payment payment) {\n289: \t\tif (payment != null && this.payments != null) {\n290: \t\t\tthis.payments.remove(payment);\n291: \t\t}\n292: \t}\n293: \t\n294: \tpublic void addAdjustedBy(Bill adjustedBill) {\n295: \t\tcheckAuthorizedToAdjust();\n296: \t\tif (adjustedBill == null) {\n297: \t\t\tthrow new NullPointerException(\"The adjusted bill to add must be defined.\");\n298: \t\t}\n299: \t\t\n300: \t\tif (this.adjustedBy == null) {\n301: \t\t\tthis.adjustedBy = new HashSet<>();\n302: \t\t}\n303: \t\t\n304: \t\tadjustedBill.setBillAdjusted(this);\n305: \t\tthis.adjustedBy.add(adjustedBill);\n306: \t}\n307: \t\n308: \tprivate void checkAuthorizedToAdjust() {\n309: \t\tif (!Context.hasPrivilege(PrivilegeConstants.ADJUST_BILLS)) {\n310: \t\t\tthrow new AccessControlException(\"Access denied to adjust bill.\");\n311: \t\t}\n312: \t}\n313: \t\n314: \t/**\n315: \t * Checks if the bill is in PENDING state.\n316: \t * \n317: \t * @return {@code true} if the bill is new (no ID) or is in PENDING state, {@code false} otherwise\n318: \t */\n319: \tpublic boolean editable() {\n320: \t\t// New bills (no ID) are considered pending, existing bills must be in PENDING\n321: \t\t// state\n322: \t\treturn getStatus() == null || this.getId() == null || this.getStatus() == BillStatus.PENDING;\n323: \t}\n324: \t\n325: \tpublic void recalculateLineItemOrder() {\n326: \t\tint orderCounter = 0;\n327: \t\tfor (BillLineItem lineItem : this.getLineItems()) {\n328: \t\t\tlineItem.setLineItemOrder(orderCounter++);\n329: \t\t}\n330: \t}\n331: \t\n332: \tprivate boolean isRefundStatus(BillLineItemStatus lineItemStatus) {\n333: \t\treturn lineItemStatus == BillLineItemStatus.REFUND_REQUESTED || lineItemStatus == BillLineItemStatus.REFUNDED\n334: \t\t        || lineItemStatus == BillLineItemStatus.PARTIALLY_REFUNDED;\n335: \t}\n336: \t\n337: }\n338: \n\n(End of file - 338 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Bill.java","name":"Bill.java","revision":"HEAD"}]}}

