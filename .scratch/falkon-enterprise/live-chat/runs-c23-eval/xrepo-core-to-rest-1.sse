data: {"type":"data-evidence","data":{"id":5,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod-common/src/main/java/org/openmrs/module/webservices/rest/web/resource/impl/DelegatingCrudResource.java","revision":"HEAD","startLine":72,"code":["\t * @see org.openmrs.module.webservices.rest.web.resource.api.Creatable#create(org.springframework.web.context.request.WebRequest)","\t */","\t@Override","\tpublic Object create(SimpleObject propertiesToCreate, RequestContext context) throws ResponseException {","\t\tT delegate = convert(propertiesToCreate);","\t\tdelegate = save(delegate);","\t\tSimpleObject ret = (SimpleObject) ConversionUtil.convertToRepresentation(delegate, context.getRepresentation());","\t\t","\t\t// add the 'type' discriminator if we support subclasses","\t\tif (hasTypesDefined()) {","\t\t\tret.add(RestConstants.PROPERTY_FOR_TYPE, getTypeName(delegate));","\t\t}","\t\t","\t\treturn ret;","\t}","\t","\tpublic T convert(SimpleObject propertiesToCreate) {","\t\tDelegatingResourceHandler<? extends T> handler;"],"highlightedLines":[75,76,77,78,79,80,81,82,83,84,85,86]}}

data: {"type":"data-evidence","data":{"id":6,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod-common/src/main/java/org/openmrs/module/webservices/rest/web/resource/impl/DelegatingCrudResource.java","revision":"HEAD","startLine":109,"code":["\t *      org.openmrs.module.webservices.rest.SimpleObject)","\t */","\t@Override","\tpublic Object update(String uuid, SimpleObject propertiesToUpdate, RequestContext context) throws ResponseException {","\t\tT delegate = getByUniqueId(uuid);","\t\tif (delegate == null)","\t\t\tthrow new ObjectNotFoundException();","\t\t","\t\tif (hasTypesDefined() && propertiesToUpdate.containsKey(RestConstants.PROPERTY_FOR_TYPE)) {","\t\t\t// if they specify a type discriminator it must match the expected one--type can't be modified","\t\t\tString type = (String) propertiesToUpdate.remove(RestConstants.PROPERTY_FOR_TYPE);","\t\t\tif (!delegate.getClass().equals(getActualSubclass(type))) {","\t\t\t\tString nameToShow = getTypeName(delegate);","\t\t\t\tif (nameToShow == null)","\t\t\t\t\tnameToShow = delegate.getClass().getName();","\t\t\t\tthrow new IllegalArgumentException(\"You passed \" + RestConstants.PROPERTY_FOR_TYPE + \"=\" + type","\t\t\t\t        + \" but this instance is a \" + nameToShow);","\t\t\t}","\t\t}","\t\t","\t\tDelegatingResourceHandler<? extends T> handler = getResourceHandler(delegate);","\t\t","\t\tDelegatingResourceDescription description = handler.getUpdatableProperties();","\t\tif (isRetirable()) {","\t\t\tdescription.addProperty(\"retired\");","\t\t} else if (isVoidable()) {","\t\t\tdescription.addProperty(\"voided\");","\t\t}","\t\t","\t\tsetConvertedProperties(delegate, propertiesToUpdate, description, false);","\t\tdelegate = save(delegate);","\t\t","\t\tSimpleObject ret = (SimpleObject) ConversionUtil.convertToRepresentation(delegate, context.getRepresentation());","\t\t","\t\t// add the 'type' discriminator if we support subclasses","\t\tif (hasTypesDefined()) {","\t\t\tret.add(RestConstants.PROPERTY_FOR_TYPE, getTypeName(delegate));","\t\t}","\t\t","\t\treturn ret;","\t}","\t","\t/**","\t * @see org.openmrs.module.webservices.rest.web.resource.api.Deletable#delete(java.lang.String)"],"highlightedLines":[112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149]}}

