data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/apps/esm-login-app/src/config-schema.ts","name":"config-schema.ts","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-6d1bf966-2f97-4bcb-8295-9a6791f04fa7","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/apps/esm-login-app/src/config-schema.ts</path>\n<url>undefined</url>\n<content>\n1: import { validators, Type, validator } from '@openmrs/esm-framework';\n2: import {\n3:   type TwoFactorAuthConfigObject,\n4:   twoFactorAuthConfigSchema,\n5: } from './two-factor-auth/two-factor-auth-config-schema';\n6: \n7: export const configSchema = {\n8:   provider: {\n9:     type: {\n10:       _type: Type.String,\n11:       _default: 'basic',\n12:       _description:\n13:         \"Selects the login mechanism to use. Choices are 'basic', 'oauth2' and 'custom'. On log out, the user is redirected to the login Url in 'custom' mode, but NOT in 'oauth2' mode. \" +\n14:         \"For 'custom' and 'oauth2', you'll also need to set the 'loginUrl' property.\",\n15:       _validators: [validators.oneOf(['basic', 'custom', 'oauth2'])],\n16:     },\n17:     loginUrl: {\n18:       _type: Type.String,\n19:       _default: '${openmrsSpaBase}/login',\n20:       _description: \"The URL to use to login. This is only used if the login type is 'oauth2' or 'custom'.\",\n21:       _validators: [validators.isUrl],\n22:     },\n23:     _validators: [\n24:       validator(\n25:         (provider: { type: string; loginUrl: string }) => {\n26:           if (provider.type === 'custom' || provider.type === 'oauth2') {\n27:             return provider.loginUrl !== '${openmrsSpaBase}/login';\n28:           }\n29:           return true;\n30:         },\n31:         (provider: { type: string }) =>\n32:           `Provider type '${provider.type}' requires an explicit loginUrl that is not the default SPA login route.`,\n33:       ),\n34:     ],\n35:   },\n36:   chooseLocation: {\n37:     enabled: {\n38:       _type: Type.Boolean,\n39:       _default: true,\n40:       _description:\n41:         \"Whether to show a 'Choose Location' screen after login. \" +\n42:         \"If true, the user will be taken to the URL set in the 'links.loginSuccess' config property after choosing a location.\",\n43:     },\n44:     locationsPerRequest: {\n45:       _type: Type.Number,\n46:       _default: 50,\n47:       _description: 'The number of results to fetch in each cycle of infinite scroll.',\n48:       _validators: [validator((v: unknown) => typeof v === 'number' && v > 0, 'Must be greater than zero')],\n49:     },\n50:     useLoginLocationTag: {\n51:       _type: Type.Boolean,\n52:       _default: true,\n53:       _description:\n54:         \"Whether to display only locations with the 'Login Location' tag. If false, all locations are shown.\",\n55:     },\n56:   },\n57:   links: {\n58:     loginSuccess: {\n59:       _type: Type.String,\n60:       _default: '${openmrsSpaBase}/home',\n\n(Showing lines 1-60 of 189. Use offset=61 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/apps/esm-login-app/src/config-schema.ts","name":"config-schema.ts","revision":"HEAD"}]}}

