data: {"type":"tool-output-available","toolCallId":"call-e7ae7fdb-602c-48c6-aa40-01f1259889ef","output":{"output":"<repo>github.com/openmrs/openmrs-module-webservices.rest</repo>\n<path>omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_9/EncounterProviderResource1_9.java</path>\n<url>undefined</url>\n<content>\n28: import org.openmrs.module.webservices.rest.web.representation.DefaultRepresentation;\n29: import org.openmrs.module.webservices.rest.web.representation.FullRepresentation;\n30: import org.openmrs.module.webservices.rest.web.representation.Representation;\n31: import org.openmrs.module.webservices.rest.web.resource.api.PageableResult;\n32: import org.openmrs.module.webservices.rest.web.resource.impl.DelegatingResourceDescription;\n33: import org.openmrs.module.webservices.rest.web.resource.impl.DelegatingSubResource;\n34: import org.openmrs.module.webservices.rest.web.resource.impl.NeedsPaging;\n35: import org.openmrs.module.webservices.rest.web.response.ResourceDoesNotSupportOperationException;\n36: import org.openmrs.module.webservices.rest.web.response.ResponseException;\n37: \n38: import java.util.ArrayList;\n39: import java.util.Date;\n40: import java.util.Iterator;\n41: import java.util.List;\n42: \n43: /**\n44:  * {@link org.openmrs.module.webservices.rest.web.annotation.Resource} for EncounterProvider,\n45:  * supporting standard CRUD operations\n46:  */\n47: @SubResource(path = \"encounterprovider\", parent = EncounterResource1_9.class, supportedClass = EncounterProvider.class, supportedOpenmrsVersions = {\n48:         \"1.9.* - 9.*\" })\n49: public class EncounterProviderResource1_9 extends DelegatingSubResource<EncounterProvider, Encounter, EncounterResource1_9> {\n50: \t\n51: \t@Override\n52: \tpublic DelegatingResourceDescription getRepresentationDescription(Representation rep) {\n53: \t\tif (rep instanceof DefaultRepresentation) {\n54: \t\t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n55: \t\t\tdescription.addProperty(\"uuid\");\n56: \t\t\tdescription.addProperty(\"provider\", Representation.REF);\n57: \t\t\tdescription.addProperty(\"encounterRole\", Representation.REF);\n58: \t\t\tdescription.addProperty(\"voided\");\n59: \t\t\tdescription.addLink(\"full\", \".?v=\" + RestConstants.REPRESENTATION_FULL);\n60: \t\t\treturn description;\n61: \t\t}\n62: \t\tif (rep instanceof FullRepresentation) {\n63: \t\t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n64: \t\t\tdescription.addProperty(\"uuid\");\n65: \t\t\tdescription.addProperty(\"provider\", Representation.DEFAULT);\n66: \t\t\tdescription.addProperty(\"encounterRole\", Representation.DEFAULT);\n67: \t\t\tdescription.addProperty(\"voided\");\n68: \t\t\tdescription.addProperty(\"auditInfo\");\n69: \t\t\tdescription.addSelfLink();\n70: \t\t\treturn description;\n71: \t\t}\n72: \t\treturn null;\n73: \t}\n74: \t\n75: \t@Override\n76: \tpublic DelegatingResourceDescription getCreatableProperties() {\n77: \t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n78: \t\tdescription.addProperty(\"provider\");\n79: \t\tdescription.addProperty(\"encounter\");\n80: \t\tdescription.addProperty(\"encounterRole\");\n81: \t\treturn description;\n82: \t}\n83: \t\n84: \t@Override\n85: \tpublic DelegatingResourceDescription getUpdatableProperties() {\n86: \t\tDelegatingResourceDescription description = new DelegatingResourceDescription();\n87: \t\tdescription.addProperty(\"encounterRole\");\n\n(Showing lines 28-87 of 237. Use offset=88 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_9/EncounterProviderResource1_9.java","name":"EncounterProviderResource1_9.java","revision":"HEAD"}]}}

