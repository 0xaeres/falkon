data: {"type":"tool-output-available","toolCallId":"call-e6d46035-d442-41d3-b984-a11e15bc38f9","output":{"output":"<repo>github.com/openmrs/openmrs-module-webservices.rest</repo>\n<path>omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_8/EncounterResource1_8.java</path>\n<url>undefined</url>\n<content>\n230: \t@Override\n231: \tpublic void purge(Encounter enc, RequestContext context) throws ResponseException {\n232: \t\tif (enc == null) {\n233: \t\t\t// DELETE is idempotent, so we return success here\n234: \t\t\treturn;\n235: \t\t}\n236: \t\tContext.getEncounterService().purgeEncounter(enc);\n237: \t}\n238: \t\n239: \t/**\n240: \t * @param encounter\n241: \t * @return encounter type and date\n242: \t */\n243: \t@PropertyGetter(\"display\")\n244: \tpublic String getDisplayString(Encounter encounter) {\n245: \t\tString ret = encounter.getEncounterType() == null ? \"?\" : encounter.getEncounterType().getName();\n246: \t\tret += \" \";\n247: \t\tret += encounter.getEncounterDatetime() == null ? \"?\" : Context.getDateFormat().format(\n248: \t\t    encounter.getEncounterDatetime());\n249: \t\treturn ret;\n250: \t}\n251: \t\n252: \t/**\n253: \t * @param instance\n254: \t * @return all non-voided top-level obs from the given encounter\n255: \t */\n256: \t@PropertyGetter(\"obs\")\n257: \tpublic static Object getObsAtTopLevel(Encounter instance) {\n258: \t\treturn instance.getObsAtTopLevel(false);\n259: \t}\n260: \t\n261: \t@PropertySetter(\"obs\")\n262: \tpublic static void setObs(Encounter instance, Set<Obs> obs) {\n263: \t\tinstance.getAllObs(true).clear();\n264: \t\tfor (Obs o : obs)\n265: \t\t\tinstance.addObs(o);\n266: \t}\n267: \n268:     @PropertyGetter(\"orders\")\n269:     public static Set<Order> getOrders(Encounter instance) {\n270:         return instance.getOrders().stream().filter(order -> !order.getVoided()).collect(Collectors.toCollection(LinkedHashSet::new));\n271:     }\n272: \n273: \t\n274: \t@PropertySetter(\"orders\")\n275: \tpublic static void setOrders(Encounter instance, Set<Order> orders) {\n276: \t\tfor (Order o : orders)\n277: \t\t\tinstance.addOrder(o);\n278: \t}\n279: \t\n280: \t/**\n281: \t * Gets encounters for the given patient (paged according to context if necessary) only if a\n282: \t * patient parameter exists in the request set on the {@link RequestContext} otherwise searches\n283: \t * for encounters that match the specified query\n284: \t * \n285: \t * @param context\n286: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.DelegatingCrudResource#doSearch(RequestContext)\n287: \t */\n288: \t@Override\n289: \tprotected PageableResult doSearch(RequestContext context) {\n290: \t\tString patientUuid = context.getRequest().getParameter(\"patient\");\n291: \t\tif (patientUuid != null) {\n292: \t\t\tPatient patient = ((PatientResource1_8) Context.getService(RestService.class).getResourceBySupportedClass(\n293: \t\t\t    Patient.class)).getByUniqueId(patientUuid);\n294: \t\t\tif (patient == null)\n295: \t\t\t\treturn new EmptySearchResult();\n296: \t\t\tList<Encounter> encs = Context.getEncounterService().getEncountersByPatient(patient);\n297: \t\t\treturn new NeedsPaging<Encounter>(encs, context);\n298: \t\t}\n299: \t\t\n300: \t\treturn new ServiceSearcher<Encounter>(EncounterService.class, \"getEncounters\", \"getCountOfEncounters\").search(\n301: \t\t    context.getParameter(\"q\"), context);\n302: \t}\n303: \t\n304: }\n\n(Showing lines 230-304 of 305. Use offset=305 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_8/EncounterResource1_8.java","name":"EncounterResource1_8.java","revision":"HEAD"}]}}

