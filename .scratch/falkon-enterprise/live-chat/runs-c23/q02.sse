Attribute(PaymentModeAttributeType type, String value) {\n60: \t\tif (type == null) {\n61: \t\t\tthrow new NullPointerException(\"The payment mode attribute type must be defined.\");\n62: \t\t}\n63: \t\tif (value == null) {\n64: \t\t\tthrow new NullPointerException((\"The payment attribute value must be defined.\"));\n65: \t\t}\n66: \t\t\n67: \t\tPaymentAttribute attribute = new PaymentAttribute();\n68: \t\tattribute.setAttributeType(type);\n69: \t\tattribute.setValue(value);\n70: \t\t\n71: \t\taddAttribute(attribute);\n72: \t\t\n73: \t\treturn attribute;\n74: \t}\n75: }\n76: \n\n(End of file - 76 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Payment.java","name":"Payment.java","revision":"HEAD"}]}}

