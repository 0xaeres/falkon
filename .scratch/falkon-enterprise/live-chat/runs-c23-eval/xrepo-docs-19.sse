data: {"type":"tool-input-delta","toolCallId":"call-1dbcdb7a-b0ac-4733-a6cd-b003e5bc0dc0","inputTextDelta":"{\"path\": \"content/en-US/docs/configuration-system.mdx\", \"repo\": \"github.com/openmrs/openmrs-contrib-o3-docs\", \"ref\": \"HEAD\", \"offset\": 337, \"limit\": 103}"}

