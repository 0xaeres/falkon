data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/DrugOrderBillingStrategy.java","name":"DrugOrderBillingStrategy.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-8f389050a9a9e5b2","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/billing/impl/DrugOrderBillingStrategy.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.api.billing.impl;\n11: \n12: import java.math.BigDecimal;\n13: import java.util.List;\n14: import java.util.Optional;\n15: \n16: import lombok.Setter;\n17: import lombok.extern.slf4j.Slf4j;\n18: import org.openmrs.DrugOrder;\n19: import org.openmrs.Order;\n20: import org.openmrs.Provider;\n21: import org.openmrs.module.billing.api.model.BillLineItemStatus;\n22: import org.openmrs.module.billing.api.model.CashPoint;\n23: import org.openmrs.module.billing.api.ItemPriceService;\n24: import org.openmrs.module.billing.api.model.BillLineItem;\n25: import org.openmrs.module.billing.api.model.BillStatus;\n26: import org.openmrs.module.billing.api.model.CashierItemPrice;\n27: import org.openmrs.module.billing.api.model.ExemptionType;\n28: import org.openmrs.module.stockmanagement.api.StockManagementService;\n29: import org.openmrs.module.stockmanagement.api.model.StockItem;\n30: import org.springframework.beans.factory.annotation.Autowired;\n31: \n32: /**\n33:  * Default billing strategy for {@link DrugOrder}s. Creates a bill line item based on the stock item\n34:  * linked to the ordered drug.\n35:  */\n36: @Slf4j\n37: @Setter(onMethod_ = @Autowired)\n38: public class DrugOrderBillingStrategy extends AbstractDefaultOrderBillingStrategy {\n39: \t\n40: \tprivate StockManagementService stockManagementService;\n41: \t\n42: \tprivate ItemPriceService itemPriceService;\n43: \t\n44: \t@Override\n45: \tprotected boolean supportsOrder(Order order) {\n46: \t\treturn order instanceof DrugOrder;\n47: \t}\n48: \t\n49: \t@Override\n50: \tprotected Optional<BillLineItem> createBillLineItem(Order order) {\n51: \t\tDrugOrder drugOrder = (DrugOrder) order;\n52: \t\t\n53: \t\tif (drugOrder.getDrug() == null) {\n54: \t\t\tlog.warn(\"DrugOrder {} has no drug set, cannot generate bill\", order.getUuid());\n55: \t\t\treturn Optional.empty();\n56: \t\t}\n57: \t\t\n58: \t\tInteger drugId = drugOrder.getDrug().getDrugId();\n59: \t\tList<StockItem> stockItems = stockManagementService.getStockItemByDrug(drugId);\n60: \t\t\n61: \t\tif (stockItems.isEmpty()) {\n62: \t\t\tlog.debug(\"No stock item found for drug ID: {}\", drugId);\n63: \t\t\treturn Optional.empty();\n64: \t\t}\n65: \t\t\n66: \t\tint quantity = (int) (drugOrder.getQuantity() != null ? drugOrder.getQuantity() : 0.0);\n67: \t\tboolean isExempted = checkIfOrderIsExempted(order, ExemptionType.COMMODITY);\n68: \t\tBillLineItemStatus lineItemStatus = isExempted ? BillLineItemStatus.EXEMPTED : BillLineItemStatus.PENDING;\n69: \t\t\n70: \t\tStockItem stockItem = stockItems.get(0);\n71: \t\tBillLineItem lineItem = createLineItem(resolvePrice(stockItem), quantity, lineItemStatus, order);\n72: \t\tlineItem.setItem(stockItem);\n73: \t\treturn Optional.of(lineItem);\n74: \t}\n75: \t\n76: \tprivate BigDecimal resolvePrice(StockItem stockItem) {\n77: \t\tList<CashierItemPrice> itemPrices = itemPriceService.getItemPrice(stockItem);\n78: \t\tif (!itemPrices.isEmpty()) {\n79: \t\t\treturn itemPrices.get(0).getPrice();\n80: \t\t} else if (stockItem.getPurchasePrice() != null) {\n81: \t\t\treturn stockItem.getPurchasePrice();\n82: \t\t}\n83: \t\treturn BigDecimal.ZERO;\n84: \t}\n85: \t\n86: \t@Override\n87: \tpublic Provider resolveCashier(Order order) {\n88: \t\treturn order.getOrderer();\n89: \t}\n90: \t\n91: \t@Override\n92: \tpublic CashPoint resolveCashPoint() {\n93: \t\tList<CashPoint> cashPoints = cashPointService.getAllCashPoints(false);\n94: \t\treturn cashPoints.isEmpty() ? null : cashPoints.get(0);\n95: \t}\n96: }\n97: \n\n(End of file - 97 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/DrugOrderBillingStrategy.java","name":"DrugOrderBillingStrategy.java","revision":"HEAD"}]}}

