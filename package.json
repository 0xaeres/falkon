{
  "name": "falkon",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @sbc/db generate",
    "db:push": "pnpm --filter @sbc/db push",
    "eval": "pnpm --filter @sbc/eval eval",
    "dev:backend": "pnpm --filter @sbc/backend dev",
    "dev:web": "pnpm --filter @sbc/web dev",
    "test": "pnpm -r --if-present test",
    "convert-config": "pnpm --filter @sbc/shared exec tsx ../../scripts/convert-config.ts",
    "golden:record": "pnpm --filter @sbc/shared exec tsx ../../tests/golden/run.ts",
    "golden:diff": "pnpm --filter @sbc/shared exec tsx ../../tests/golden/diff.ts",
    "originality": "pnpm --filter @sbc/eval exec tsx ../originality/originality.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
