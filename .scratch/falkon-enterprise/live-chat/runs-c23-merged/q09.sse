data: {"type":"tool-output-available","toolCallId":"call-70427d34-4a05-46a4-af88-020d189e94db","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillResource.java</path>\n<url>undefined</url>\n<content>\n130: \t\tif (!Context.hasPrivilege(PrivilegeConstants.VIEW_REFUNDS)) {\n131: \t\t\treturn java.util.Collections.emptyList();\n132: \t\t}\n133: \t\treturn bill.getActiveRefunds();\n134: \t}\n135: \t\n136: \t@PropertySetter(\"lineItems\")\n137: \tpublic void setBillLineItems(Bill instance, List<BillLineItem> lineItems) {\n138: \t\tif (instance.getLineItems() == null) {\n139: \t\t\tinstance.setLineItems(new ArrayList<>(lineItems.size()));\n140: \t\t}\n141: \t\tBaseRestDataResource.syncCollection(instance.getLineItems(), lineItems);\n142: \t\tfor (BillLineItem item : instance.getLineItems()) {\n143: \t\t\titem.setBill(instance);\n144: \t\t}\n145: \t}\n146: \t\n147: \t@PropertySetter(\"payments\")\n148: \tpublic void setBillPayments(Bill instance, Set<Payment> payments) {\n149: \t\tif (instance.getPayments() == null) {\n150: \t\t\tinstance.setPayments(new HashSet<Payment>(payments.size()));\n151: \t\t}\n152: \t\tBaseRestDataResource.syncCollection(instance.getPayments(), payments);\n153: \t\tProvider cashier = null;\n154: \t\tfor (Payment payment : instance.getPayments()) {\n155: \t\t\tif (payment.getId() == null && payment.getCashier() == null) {\n156: \t\t\t\tif (cashier == null) {\n157: \t\t\t\t\tcashier = getCurrentCashier();\n158: \t\t\t\t\tif (cashier == null) {\n159: \t\t\t\t\t\tthrow new RestClientException(\n160: \t\t\t\t\t\t        \"The current user (\" + Context.getAuthenticatedUser().getUsername() + \") is not a provider\");\n161: \t\t\t\t\t}\n162: \t\t\t\t}\n163: \t\t\t\tpayment.setCashier(cashier);\n164: \t\t\t}\n165: \t\t\tinstance.addPayment(payment);\n166: \t\t}\n167: \t}\n168: \t\n169: \t@PropertySetter(\"billAdjusted\")\n170: \tpublic void setBillAdjusted(Bill instance, Bill billAdjusted) {\n171: \t\tbillAdjusted.addAdjustedBy(instance);\n172: \t\tinstance.setBillAdjusted(billAdjusted);\n173: \t}\n174: \t\n175: \t@PropertySetter(\"status\")\n176: \tpublic void setBillStatus(Bill instance, BillStatus status) {\n177: \t\tif (instance.getStatus() == null) {\n178: \t\t\tinstance.setStatus(status);\n179: \t\t} else if (instance.getStatus() == BillStatus.PENDING && status == BillStatus.POSTED) {\n180: \t\t\tinstance.setStatus(status);\n181: \t\t}\n182: \t\tif (status == BillStatus.POSTED) {\n183: \t\t\tRoundingUtil.handleRoundingLineItem(instance);\n184: \t\t}\n185: \t}\n186: \t\n187: \t@PropertySetter(\"adjustmentReason\")\n188: \tpublic void setAdjustReason(Bill instance, String adjustReason) {\n189: \t\tif (instance.getBillAdjusted().getUuid() != null) {\n190: \t\t\tinstance.getBillAdjusted().setAdjustmentReason(adjustReason);\n191: \t\t}\n192: \t}\n193: \t\n194: \t@Override\n195: \tpublic Bill save(Bill bill) {\n196: \t\t//TODO: Test all the ways that this could fail\n197: \t\t\n198: \t\tif (bill.getId() == null) {\n199: \t\t\tif (bill.getCashier() == null) {\n200: \t\t\t\tassignCurrentCashier(bill);\n201: \t\t\t}\n202: \t\t\t\n203: \t\t\tif (bill.getCashPoint() == null) {\n204: \t\t\t\tloadBillCashPoint(bill);\n205: \t\t\t}\n206: \t\t\t\n207: \t\t\tif (bill.getVisit() == null && bill.getPatient() != null) {\n208: \t\t\t\tassignActiveVisit(bill);\n209: \t\t\t}\n210: \t\t\t\n211: \t\t\tinitializeBillStatus(bill);\n212: \t\t}\n213: \t\t\n214: \t\treturn Context.getService(BillService.class).saveBill(bill);\n215: \t}\n216: \t\n217: \t@Override\n218: \tprotected AlreadyPaged<Bill> doSearch(RequestContext context) {\n219: \t\tBillSearch billSearch = buildBillSearchFromRequest(context);\n220: \t\tPagingInfo pagingInfo = PagingUtil.getPagingInfoFromContext(context);\n221: \t\t\n222: \t\tBillService service = Context.getService(BillService.class);\n223: \t\tList<Bill> result = service.getBills(billSearch, pagingInfo);\n224: \t\t\n225: \t\treturn new AlreadyPaged<>(context, result, pagingInfo.hasMoreResults(), pagingInfo.getTotalRecordCount());\n226: \t}\n227: \t\n228: \t/**\n229: \t * Gets a bill by UUID\n230: \t *\n231: \t * @param uniqueId The bill UUID.\n232: \t * @return The bill with the specified UUID without voided line items.\n233: \t */\n234: \t@Override\n235: \tpublic Bill getByUniqueId(String uniqueId) {\n236: \t\tif (StringUtils.isBlank(uniqueId)) {\n237: \t\t\treturn null;\n238: \t\t}\n239: \t\t\n240: \t\treturn Context.getService(BillService.class).getBillByUuid(uniqueId);\n241: \t}\n242: \t\n243: \t@Override\n244: \tprotected void delete(Bill bill, String s, RequestContext requestContext) throws ResponseException {\n245: \t\tContext.getService(BillService.class).voidBill(bill, s);\n246: \t}\n247: \t\n248: \t@Override\n249: \tpublic void purge(Bill bill, RequestContext requestContext) throws ResponseException {\n250: \t\tContext.getService(BillService.class).purgeBill(bill);\n251: \t}\n252: \t\n253: \t@Override\n254: \tpublic Bill newDelegate() {\n255: \t\treturn new Bill();\n256: \t}\n257: \t\n258: \tprivate Provider getCurrentCashier() {\n259: \t\treturn ProviderUtil.getCurrentProvider();\n260: \t}\n261: \t\n262: \tprivate void assignCurrentCashier(Bill bill) {\n263: \t\tProvider cashier = getCurrentCashier();\n264: \t\tif (cashier == null) {\n265: \t\t\tthrow new RestClientException(\n266: \t\t\t        \"The current user (\" + Context.getAuthenticatedUser().getUsername() + \") is not a provider\");\n267: \t\t}\n268: \t\t\n269: \t\tbill.setCashier(cashier);\n270: \t}\n271: \t\n272: \tprivate void assignActiveVisit(Bill bill) {\n273: \t\tList<Visit> activeVisits = Context.getVisitService().getActiveVisitsByPatient(bill.getPatient());\n274: \t\tif (activeVisits == null || activeVisits.isEmpty()) {\n275: \t\t\treturn;\n276: \t\t}\n277: \t\t\n278: \t\tif (activeVisits.size() == 1) {\n279: \t\t\tbill.setVisit(activeVisits.get(0));\n\n(Showing lines 130-279 of 429. Use offset=280 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillResource.java","name":"BillResource.java","revision":"HEAD"}]}}

data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/validator/BillValidator.java","name":"BillValidator.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-a6d573e4-49ac-4582-8fdb-b5ca207860e3","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/validator/BillValidator.java</path>\n<url>undefined</url>\n<content>\n30: \n31: @Handler(supports = { Bill.class }, order = 50)\n32: public class BillValidator implements Validator {\n33: \t\n34: \t@Override\n35: \tpublic boolean supports(@Nonnull Class<?> clazz) {\n36: \t\treturn Bill.class.isAssignableFrom(clazz);\n37: \t}\n38: \t\n39: \t@Override\n40: \tpublic void validate(@Nonnull Object target, @Nonnull Errors errors) {\n41: \t\tif (!(target instanceof Bill)) {\n42: \t\t\terrors.reject(\"error.general\");\n43: \t\t} else {\n44: \t\t\tBill bill = (Bill) target;\n45: \t\t\t\n46: \t\t\tif (bill.getVoided() && StringUtils.isBlank(bill.getVoidReason())) {\n47: \t\t\t\terrors.rejectValue(\"voided\", \"error.null\");\n48: \t\t\t}\n49: \t\t\t\n50: \t\t\tvalidateNewPaymentsHaveCashier(bill, errors);\n51: \t\t\tvalidateLineItemsNotModified(bill, errors);\n52: \t\t\tvalidateVisitExistsAndBelongsToPatient(bill, errors);\n53: \t\t}\n54: \t}\n55: \t\n56: \t/**\n57: \t * Validates that line items have not been added or removed from a non-editable bill. This check is\n58: \t * necessary because the ImmutableBillInterceptor cannot detect collection changes due to\n59: \t * Hibernate's inverse=\"true\" mapping on the lineItems collection.\n60: \t *\n61: \t * @param bill the bill to validate\n62: \t * @param errors the errors object to add validation errors to\n63: \t */\n64: \tprivate void validateLineItemsNotModified(Bill bill, Errors errors) {\n65: \t\t// Only check existing bills that are not editable\n66: \t\tif (bill.getId() == null || bill.editable()) {\n67: \t\t\treturn;\n68: \t\t}\n69: \t\t\n70: \t\t// Get the original line item IDs from the database\n71: \t\tBillLineItemService billLineItemService = Context.getService(BillLineItemService.class);\n72: \t\tList<Integer> originalLineItemIds = billLineItemService.getPersistedLineItemIds(bill.getId());\n73: \t\t\n74: \t\tSet<Integer> originalIds = new HashSet<>(originalLineItemIds);\n75: \t\t\n76: \t\t// Get current line item IDs (only those that have been persisted, i.e., have an ID)\n77: \t\tSet<Integer> currentIds = new HashSet<>();\n78: \t\tif (bill.getLineItems() != null) {\n79: \t\t\tcurrentIds = bill.getLineItems().stream().map(BillLineItem::getId).filter(id -> id != null)\n80: \t\t\t        .collect(Collectors.toSet());\n81: \t\t}\n82: \t\t\n83: \t\t// Check if any line items were removed\n84: \t\tSet<Integer> removedIds = new HashSet<>(originalIds);\n85: \t\tremovedIds.removeAll(currentIds);\n86: \t\tif (!removedIds.isEmpty()) {\n87: \t\t\terrors.reject(\"billing.error.lineItemsCannotBeRemovedFromNonPendingBill\");\n88: \t\t}\n89: \t\t\n90: \t\t// Check if any new line items were added (new items have null ID)\n91: \t\tif (bill.getLineItems() != null) {\n92: \t\t\tboolean hasNewLineItems = bill.getLineItems().stream().anyMatch(item -> item.getId() == null);\n93: \t\t\tif (hasNewLineItems) {\n94: \t\t\t\terrors.reject(\"billing.error.lineItemsCannotBeAddedToNonPendingBill\");\n95: \t\t\t}\n96: \t\t}\n97: \t}\n98: \t\n99: \t/**\n100: \t * Validates that any new (unsaved) non-voided payment has a cashier. Existing persisted payments\n101: \t * (id != null) are exempt to allow legacy data.\n102: \t */\n103: \tprivate void validateNewPaymentsHaveCashier(Bill bill, Errors errors) {\n104: \t\tif (bill.getPayments() == null) {\n105: \t\t\treturn;\n106: \t\t}\n107: \t\tfor (Payment payment : bill.getPayments()) {\n108: \t\t\tif (payment != null && !payment.getVoided() && payment.getId() == null && payment.getCashier() == null) {\n109: \t\t\t\terrors.reject(\"billing.error.paymentCashierRequired\");\n110: \t\t\t\treturn;\n111: \t\t\t}\n112: \t\t}\n113: \t}\n114: \t\n115: \tprivate void validateVisitExistsAndBelongsToPatient(Bill bill, Errors errors) {\n116: \t\tif (bill.getVisit() == null) {\n117: \t\t\treturn;\n118: \t\t}\n119: \t\t\n120: \t\tif (bill.getVisit().getVisitId() == null) {\n121: \t\t\terrors.reject(\"billing.error.visitDoesNotExist\");\n122: \t\t\treturn;\n123: \t\t}\n124: \t\t\n\n(Showing lines 30-124 of 137. Use offset=125 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/validator/BillValidator.java","name":"BillValidator.java","revision":"HEAD"}]}}

