data: {"type":"tool-input-delta","toolCallId":"call-0683a013-604c-484a-b2b0-e8a21907b7ff","inputTextDelta":"{\"pattern\": \"export function defineConfigSchema|export enum Type|export interface ConfigSchema|export type Validator\", \"repo\": \"github.com/openmrs/openmrs-esm-core\", \"limit\": 30}"}

