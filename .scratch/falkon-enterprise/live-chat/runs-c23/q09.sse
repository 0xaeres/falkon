data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/validator/BillValidator.java","name":"BillValidator.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-96bd9002ee3791c2","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/validator/BillValidator.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.validator;\n11: \n12: import java.util.HashSet;\n13: import java.util.List;\n14: import java.util.Objects;\n15: import java.util.Set;\n16: import java.util.stream.Collectors;\n17: \n18: import javax.annotation.Nonnull;\n19: \n20: import org.apache.commons.lang3.StringUtils;\n21: import org.openmrs.Visit;\n22: import org.openmrs.annotation.Handler;\n23: import org.openmrs.api.context.Context;\n24: import org.openmrs.module.billing.api.BillLineItemService;\n25: import org.openmrs.module.billing.api.model.Bill;\n26: import org.openmrs.module.billing.api.model.BillLineItem;\n27: import org.openmrs.module.billing.api.model.Payment;\n28: import org.springframework.validation.Errors;\n29: import org.springframework.validation.Validator;\n30: \n31: @Handler(supports = { Bill.class }, order = 50)\n32: public class BillValidator implements Validator {\n33: \t\n34: \t@Override\n35: \tpublic boolean supports(@Nonnull Class<?> clazz) {\n36: \t\treturn Bill.class.isAssignableFrom(clazz);\n37: \t}\n38: \t\n39: \t@Override\n40: \tpublic void validate(@Nonnull Object target, @Nonnull Errors errors) {\n41: \t\tif (!(target instanceof Bill)) {\n42: \t\t\terrors.reject(\"error.general\");\n43: \t\t} else {\n44: \t\t\tBill bill = (Bill) target;\n45: \t\t\t\n46: \t\t\tif (bill.getVoided() && StringUtils.isBlank(bill.getVoidReason())) {\n47: \t\t\t\terrors.rejectValue(\"voided\", \"error.null\");\n48: \t\t\t}\n49: \t\t\t\n50: \t\t\tvalidateNewPaymentsHaveCashier(bill, errors);\n51: \t\t\tvalidateLineItemsNotModified(bill, errors);\n52: \t\t\tvalidateVisitExistsAndBelongsToPatient(bill, errors);\n53: \t\t}\n54: \t}\n55: \t\n56: \t/**\n57: \t * Validates that line items have not been added or removed from a non-editable bill. This check is\n58: \t * necessary because the ImmutableBillInterceptor cannot detect collection changes due to\n59: \t * Hibernate's inverse=\"true\" mapping on the lineItems collection.\n60: \t *\n61: \t * @param bill the bill to validate\n62: \t * @param errors the errors object to add validation errors to\n63: \t */\n64: \tprivate void validateLineItemsNotModified(Bill bill, Errors errors) {\n65: \t\t// Only check existing bills that are not editable\n66: \t\tif (bill.getId() == null || bill.editable()) {\n67: \t\t\treturn;\n68: \t\t}\n69: \t\t\n70: \t\t// Get the original line item IDs from the database\n71: \t\tBillLineItemService billLineItemService = Context.getService(BillLineItemService.class);\n72: \t\tList<Integer> originalLineItemIds = billLineItemService.getPersistedLineItemIds(bill.getId());\n73: \t\t\n74: \t\tSet<Integer> originalIds = new HashSet<>(originalLineItemIds);\n75: \t\t\n76: \t\t// Get current line item IDs (only those that have been persisted, i.e., have an ID)\n77: \t\tSet<Integer> currentIds = new HashSet<>();\n78: \t\tif (bill.getLineItems() != null) {\n79: \t\t\tcurrentIds = bill.getLineItems().stream().map(BillLineItem::getId).filter(id -> id != null)\n80: \t\t\t        .collect(Collectors.toSet());\n81: \t\t}\n82: \t\t\n83: \t\t// Check if any line items were removed\n84: \t\tSet<Integer> removedIds = new HashSet<>(originalIds);\n85: \t\tremovedIds.removeAll(currentIds);\n86: \t\tif (!removedIds.isEmpty()) {\n87: \t\t\terrors.reject(\"billing.error.lineItemsCannotBeRemovedFromNonPendingBill\");\n88: \t\t}\n89: \t\t\n90: \t\t// Check if any new line items were added (new items have null ID)\n91: \t\tif (bill.getLineItems() != null) {\n92: \t\t\tboolean hasNewLineItems = bill.getLineItems().stream().anyMatch(item -> item.getId() == null);\n93: \t\t\tif (hasNewLineItems) {\n94: \t\t\t\terrors.reject(\"billing.error.lineItemsCannotBeAddedToNonPendingBill\");\n95: \t\t\t}\n96: \t\t}\n97: \t}\n98: \t\n99: \t/**\n100: \t * Validates that any new (unsaved) non-voided payment has a cashier. Existing persisted payments\n101: \t * (id != null) are exempt to allow legacy data.\n102: \t */\n103: \tprivate void validateNewPaymentsHaveCashier(Bill bill, Errors errors) {\n104: \t\tif (bill.getPayments() == null) {\n105: \t\t\treturn;\n106: \t\t}\n107: \t\tfor (Payment payment : bill.getPayments()) {\n108: \t\t\tif (payment != null && !payment.getVoided() && payment.getId() == null && payment.getCashier() == null) {\n109: \t\t\t\terrors.reject(\"billing.error.paymentCashierRequired\");\n110: \t\t\t\treturn;\n\n(Showing lines 1-110 of 137. Use offset=111 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/validator/BillValidator.java","name":"BillValidator.java","revision":"HEAD"}]}}

