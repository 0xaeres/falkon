data: {"type":"data-evidence","data":{"id":1,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-core","path":"api/src/main/java/org/openmrs/api/EncounterService.java","revision":"HEAD","startLine":84,"code":["\t */","\t@PreAuthorize(\"hasPermission(#encounter, '\" + PrivilegeConstants.ADD_ENCOUNTERS + \"') or hasPermission(#encounter, '\"","\t        + PrivilegeConstants.EDIT_ENCOUNTERS + \"')\")","\tpublic Encounter saveEncounter(Encounter encounter) throws APIException;","","\t/**","\t * Get encounter by internal identifier"],"highlightedLines":[87]}}

data: {"type":"data-evidence","data":{"id":2,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-core","path":"api/src/main/java/org/openmrs/api/impl/EncounterServiceImpl.java","revision":"HEAD","startLine":98,"code":["\t * @see org.openmrs.api.EncounterService#saveEncounter(org.openmrs.Encounter)","\t */","\t@Override","\tpublic Encounter saveEncounter(Encounter encounter) throws APIException {","","\t\t// if authenticated user is not supposed to edit encounter of certain type","\t\tfailIfDeniedToEdit(encounter);","","\t\t//If new encounter, try to assign a visit using the registered visit assignment handler.","\t\tcreateVisitForNewEncounter(encounter);","","\t\t// check permissions","\t\tboolean isNewEncounter = requirePrivilege(encounter);","","\t\t// This must be done after setting dateCreated etc on the obs because","\t\t// of the way the ORM tools flush things and check for nullity","\t\t// This also must be done before the save encounter so we can use the","\t\t// orig date","\t\t// after the save","\t\tPatient p = encounter.getPatient();","\t\tDate originalDate;","\t\tLocation originalLocation = null;","","\t\tif (!isNewEncounter) {","\t\t\t// fetch the datetime from the database prior to saving for this","\t\t\t// encounter","\t\t\t// to see if it has changed and change all obs after saving if so","\t\t\toriginalDate = dao.getSavedEncounterDatetime(encounter);","\t\t\tif (encounter.getLocation() != null) {","\t\t\t\toriginalLocation = dao.getSavedEncounterLocation(encounter);","\t\t\t}","\t\t\t// Our data model duplicates the patient column to allow for","\t\t\t// observations to","\t\t\t// not have to look up the parent Encounter to find the patient","\t\t\t// Therefore, encounter.patient must always equal","\t\t\t// encounter.observations[0-n].patient","","\t\t\t// If we are changing encounter.encounterDatetime, then we need to","\t\t\t// also apply that","\t\t\t// to Obs that inherited their obsDatetime from the encounter in the","\t\t\t// first place","","\t\t\tDate newDate = encounter.getEncounterDatetime();","\t\t\tLocation newLocation = encounter.getLocation();","\t\t\tfor (Obs obs : encounter.getAllFlattenedObs(true)) {","\t\t\t\t// if the date was changed","\t\t\t\tif (OpenmrsUtil.compare(originalDate, newDate) != 0","\t\t\t\t        && OpenmrsUtil.compare(obs.getObsDatetime(), originalDate) == 0) {","","\t\t\t\t\t// if the obs datetime is the same as the","\t\t\t\t\t// original encounter datetime, fix it","\t\t\t\t\tobs.setObsDatetime(newDate);","","\t\t\t\t}","","\t\t\t\tif (!OpenmrsUtil.nullSafeEquals(newLocation, originalLocation)","\t\t\t\t        && obs.getLocation().equals(originalLocation)) {","\t\t\t\t\tobs.setLocation(newLocation);","\t\t\t\t}",""],"highlightedLines":[101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157]}}

