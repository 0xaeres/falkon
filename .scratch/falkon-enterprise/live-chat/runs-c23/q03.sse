illLineItemId;\n57: \t}\n58: \t\n59: \t@Override\n60: \tpublic void setId(Integer id) {\n61: \t\tbillLineItemId = id;\n62: \t}\n63: \t\n64: \t/**\n65: \t * Get the total price for the line item\n66: \t *\n67: \t * @return double the total price for the line item\n68: \t */\n69: \tpublic BigDecimal getTotal() {\n70: \t\treturn price.multiply(BigDecimal.valueOf(quantity));\n71: \t}\n72: \t\n73: }\n74: \n\n(End of file - 74 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/BillLineItem.java","name":"BillLineItem.java","revision":"HEAD"}]}}

