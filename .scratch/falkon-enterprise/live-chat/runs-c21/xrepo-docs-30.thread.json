            "",
            "    if (locale.calendar) {",
            "      return locale.calendar as CalendarIdentifier;",
            "    }",
            "",
            "    if (locale.region) {",
            "      const key = `${locale.language}-${locale.region}`;",
            "      if (this.#registry.has(key)) {",
