{
  "ask": {
    "grep": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "The regex pattern to search for in file contents"
        },
        "path": {
          "type": "string",
          "description": "The directory to search in. Defaults to the repository root."
        },
        "include": {
          "type": "string",
          "description": "File pattern to include in the search (e.g. \"*.js\", \"*.{ts,tsx}\")"
        },
        "repo": {
          "type": "string",
          "description": "The name of the repository to search in. If not provided, searches all repositories."
        },
        "ref": {
          "type": "string",
          "description": "The commit SHA, branch or tag name to search on. If not provided, defaults to the default branch (usually 'main' or 'master')."
        },
        "limit": {
          "type": "number",
          "description": "The maximum number of matches to return (default: 100 when groupByRepo=false, 10000 when groupByRepo=true)"
        },
        "groupByRepo": {
          "type": "boolean",
          "description": "If true, returns a summary of match counts grouped by repository instead of individual file results."
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "glob": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "The glob pattern to match file paths against (e.g. \"**/*.ts\", \"src/**/*.test.{ts,tsx}\")"
        },
        "path": {
          "type": "string",
          "description": "Restrict results to files under this subdirectory."
        },
        "repo": {
          "type": "string",
          "description": "The name of the repository to search in. If not provided, searches all repositories."
        },
        "ref": {
          "type": "string",
          "description": "The commit SHA, branch or tag name to search on. If not provided, defaults to the default branch (usually 'main' or 'master')."
        },
        "limit": {
          "type": "number",
          "description": "The maximum number of files to return (default: 100)"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "get_diff": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "The fully-qualified repository name."
        },
        "base": {
          "type": "string",
          "description": "The base git ref (branch, tag, or commit SHA) to diff from."
        },
        "head": {
          "type": "string",
          "description": "The head git ref (branch, tag, or commit SHA) to diff to."
        },
        "path": {
          "type": "string",
          "description": "Restrict the diff to changes touching this file path. Omit to diff all changes between the two refs."
        }
      },
      "required": [
        "repo",
        "base",
        "head"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_commits": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "The repository to list commits from"
        },
        "query": {
          "type": "string",
          "description": "Search query to filter commits by message (case-insensitive)"
        },
        "since": {
          "type": "string",
          "description": "Start date for commit range (e.g., '30 days ago', '2024-01-01', 'last week')"
        },
        "until": {
          "type": "string",
          "description": "End date for commit range (e.g., 'yesterday', '2024-12-31', 'today')"
        },
        "author": {
          "type": "string",
          "description": "Filter commits by author name or email (case-insensitive)"
        },
        "ref": {
          "type": "string",
          "description": "Commit SHA, branch or tag name to list commits of. If not provided, uses the default branch."
        },
        "path": {
          "type": "string",
          "description": "Filter commits to only those that touched this file or directory path (relative to repo root)."
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Page number for pagination (min 1). Default: 1",
          "default": 1
        },
        "perPage": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Results per page for pagination (min 1, max 100). Default: 50",
          "default": 50
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_branches": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "The repository to list branches from"
        },
        "query": {
          "type": "string",
          "description": "Filter branches by name (case-insensitive substring match)"
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Page number for pagination (min 1). Default: 1",
          "default": 1
        },
        "perPage": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Results per page for pagination (min 1, max 100). Default: 50",
          "default": 50
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_repos": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Filter repositories by name (case-insensitive)"
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Page number for pagination (min 1). Default: 1",
          "default": 1
        },
        "perPage": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Results per page for pagination (min 1, max 100). Default: 30",
          "default": 30
        },
        "sort": {
          "type": "string",
          "enum": [
            "name",
            "pushed"
          ],
          "description": "Sort repositories by 'name' or 'pushed' (most recent commit). Default: 'name'",
          "default": "name"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "description": "Sort direction: 'asc' or 'desc'. Default: 'asc'",
          "default": "asc"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "read_file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The path to the file"
        },
        "repo": {
          "type": "string",
          "description": "The repository to read the file from"
        },
        "ref": {
          "type": "string",
          "description": "Commit SHA, branch or tag name to read the file from. If not provided, uses the default branch.",
          "default": "HEAD"
        },
        "offset": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Line number to start reading from (1-indexed). Omit to start from the beginning."
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Maximum number of lines to read (max: 500). Omit to read up to 500 lines."
        }
      },
      "required": [
        "path",
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "list_tree": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "The name of the repository to list files from."
        },
        "path": {
          "type": "string",
          "description": "Directory path (relative to repo root). If omitted, the repo root is used.",
          "default": ""
        },
        "ref": {
          "type": "string",
          "description": "Commit SHA, branch or tag name to list files from. If not provided, uses the default branch.",
          "default": "HEAD"
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10,
          "description": "How many directory levels to traverse below `path` (min 1, max 10, default 1).",
          "default": 1
        },
        "includeFiles": {
          "type": "boolean",
          "description": "Whether to include files in the output (default: true).",
          "default": true
        },
        "includeDirectories": {
          "type": "boolean",
          "description": "Whether to include directories in the output (default: true).",
          "default": true
        },
        "maxEntries": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "description": "Maximum number of entries to return (min 1, max 10000, default 1000).",
          "default": 1000
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "find_symbol_definitions": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "The symbol to find definitions of"
        },
        "repo": {
          "type": "string",
          "description": "The repository to scope the search to"
        }
      },
      "required": [
        "symbol",
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "find_symbol_references": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "The symbol to find references to"
        },
        "repo": {
          "type": "string",
          "description": "The repository to scope the search to"
        }
      },
      "required": [
        "symbol",
        "repo"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "kb": {
    "list_tree": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository name; defaults to the repository being documented"
        },
        "prefix": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "read_file": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository name; defaults to the repository being documented"
        },
        "path": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "grep": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository name; defaults to the repository being documented"
        },
        "pattern": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "log_history": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Repository name; defaults to the repository being documented"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_candidate_systems": {
      "type": "object",
      "properties": {
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "thesis": {
                "type": "string"
              },
              "evidenceAnchors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "thesis",
              "evidenceAnchors"
            ],
            "additionalProperties": false
          }
        },
        "territoryTooBig": {
          "type": "boolean"
        }
      },
      "required": [
        "systems"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_system_list": {
      "type": "object",
      "properties": {
        "systems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "thesis": {
                "type": "string"
              },
              "evidenceAnchors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assignedDocPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "slug",
              "name",
              "thesis",
              "evidenceAnchors",
              "assignedDocPaths"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "systems"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_system_report": {
      "type": "object",
      "properties": {
        "proposedNewDocs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "keyClaims": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "3-8 claims, each naming a repository file that proves it"
              },
              "keyFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "rationale",
              "keyClaims",
              "keyFiles"
            ],
            "additionalProperties": false
          }
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "keep",
                  "merge",
                  "delete"
                ]
              },
              "mergeInto": {
                "type": "string"
              },
              "keyClaims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keyFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "disposition"
            ],
            "additionalProperties": false
          }
        },
        "systemSummary": {
          "type": "string"
        }
      },
      "required": [
        "proposedNewDocs",
        "dispositions",
        "systemSummary"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_work_list": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "keep",
                  "create",
                  "merge"
                ]
              },
              "absorbs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "system": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "system",
                    "path"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "path",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "deletes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "items",
        "deletes"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "write_doc": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "body"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "edit_doc": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "oldText": {
          "type": "string",
          "minLength": 1
        },
        "newText": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "oldText",
        "newText"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "finish_doc": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One plain sentence: when to read this document and what it covers."
        }
      },
      "required": [
        "path",
        "summary"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "delete_absorbed_doc": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "submit_narrative": {
      "type": "object",
      "properties": {
        "narrative": {
          "type": "string"
        }
      },
      "required": [
        "narrative"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
}
