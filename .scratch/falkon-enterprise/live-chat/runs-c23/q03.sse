data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-badec3e4b3ef788a","output":{"output":"<repo>github.com/openmrs/openmrs-esm-billing-app</repo>\n<path>src/billing-form/billing-form.resource.ts</path>\n<url>undefined</url>\n<content>\n1: import { useMemo } from 'react';\n2: import useSWR from 'swr';\n3: import { type OpenmrsResource, openmrsFetch, restBaseUrl } from '@openmrs/esm-framework';\n4: import { apiBasePath } from '../constants';\n5: \n6: type LastVisitInfo = {\n7:   diffDays: number;\n8:   type: string;\n9:   location: string;\n10: };\n11: \n12: export const useLastVisitInfo = (\n13:   patientUuid: string,\n14: ): { lastVisitInfo: LastVisitInfo | null; isLoading: boolean; error: any } => {\n15:   const url = `${restBaseUrl}/visit?patient=${patientUuid}&v=default&limit=1&sort=desc:startDatetime`;\n16:   const { data, isLoading, error } = useSWR<{ data: { results: Array<any> } }>(patientUuid ? url : null, openmrsFetch);\n17: \n18:   const lastVisitInfo = useMemo((): LastVisitInfo | null => {\n19:     const results = data?.data?.results;\n20:     if (!results?.length) return null;\n21: \n22:     const visit = results[0];\n23:     const visitDate = new Date(visit.startDatetime);\n24:     if (isNaN(visitDate.getTime())) return null;\n25:     const diffTime = Math.abs(Date.now() - visitDate.getTime());\n26:     const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));\n27: \n28:     return {\n29:       diffDays,\n30:       type: visit.visitType?.display ?? '',\n31:       location: visit.location?.display ?? '',\n32:     };\n33:   }, [data]);\n34: \n35:   return { lastVisitInfo, isLoading, error };\n36: };\n37: \n38: export const useBillableItems = () => {\n39:   const url = `${apiBasePath}billableService?v=custom:(uuid,name,shortName,serviceStatus,serviceType:(display),servicePrices:(uuid,name,price,paymentMode))`;\n40:   const { data, isLoading, error } = useSWR<{ data: { results: Array<OpenmrsResource> } }>(url, openmrsFetch);\n41:   return {\n42:     lineItems: data?.data?.results ?? [],\n43:     isLoading,\n44:     error,\n45:   };\n46: };\n47: \n48: export const useCashPoint = () => {\n49:   const url = `${apiBasePath}cashPoint`;\n50:   const { data, isLoading, error } = useSWR<{ data: { results: Array<OpenmrsResource> } }>(url, openmrsFetch);\n51: \n52:   return { isLoading, error, cashPoints: data?.data?.results ?? [] };\n53: };\n54: \n55: export const createPatientBill = (payload) => {\n56:   const postUrl = `${apiBasePath}bill`;\n57:   return openmrsFetch(postUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload });\n58: };\n59: \n60: export const usePaymentMethods = () => {\n61:   const url = `${apiBasePath}paymentMode`;\n62:   const { data, isLoading, error } = useSWR<{ data: { results: Array<OpenmrsResource> } }>(url, openmrsFetch);\n63: \n64:   return { isLoading, error, paymentModes: data?.data?.results ?? [] };\n65: };\n66: \n\n(End of file - 66 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/billing-form/billing-form.resource.ts","name":"billing-form.resource.ts","revision":"HEAD"}]}}

