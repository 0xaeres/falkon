generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum RepoKind {
  CODE
  KNOWLEDGE // managed repo holding generated docs for an owner repo
}

enum ScanMode {
  FULL
  DELTA
}

enum ScanStatus {
  RUNNING
  SUCCEEDED
  FAILED
  BUDGET_EXHAUSTED
  SKIPPED
}

enum RepoStatus {
  PENDING
  SYNCING
  INDEXED
  FAILED
}

enum CodeHostType {
  github
  gitlab
  gitea
  gerrit
  bitbucketServer @map("bitbucket-server")
  bitbucketCloud  @map("bitbucket-cloud")
  genericGitHost  @map("generic-git-host")
  azuredevops
}

enum ConnectionType {
  github
  gitlab
  gitea
  gerrit
  bitbucket
  azuredevops
  git
}

enum ConnectionSource {
  config // mirrored from config.json by the backend sync
  api // created through the admin API; the config mirror never touches it
}

/// A code-host token, AES-256-GCM sealed (packages/shared/src/credentialStore.ts, the only reader of `ciphertext`).
model Credential {
  id            String       @id // 16 random bytes, base64url
  kind          String // "github-token"
  host          String
  keyId         String
  nonce         Bytes
  ciphertext    Bytes
  scopes        String[]
  createdAt     DateTime     @default(now())
  rotatedAt     DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  connections   Connection[]
}

/// One entry of config.json `connections`, keyed by its name there, or an api-created one.
model Connection {
  id             Int                @id @default(autoincrement())
  name           String             @unique
  connectionType ConnectionType
  config         Json
  syncedAt       DateTime?
  syncError      String?
  source         ConnectionSource   @default(config)
  credential     Credential?        @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  credentialId   String?
  syncRequestedAt DateTime? // set by the api, claimed by the backend tick
  repos          RepoToConnection[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model RepoToConnection {
  repo         Repo       @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId       Int
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId Int
  addedAt      DateTime   @default(now())

  @@id([repoId, connectionId])
}

model Repo {
  id                    Int                @id @default(autoincrement())
  name                  String             @unique // e.g. github.com/org/repo
  displayName           String?
  cloneUrl              String
  webUrl                String?
  imageUrl              String?
  defaultBranch         String?
  branches              String[]
  isFork                Boolean            @default(false)
  isArchived            Boolean            @default(false)
  isPublic              Boolean            @default(false)
  isAutoCleanupDisabled Boolean            @default(false)
  /// { gitConfig?: Record<string,string>, branches?: string[], tags?: string[], codeHostMetadata?: {...} }
  metadata              Json               @default("{}")
  external_id           String
  external_codeHostType CodeHostType
  external_codeHostUrl  String
  connections           RepoToConnection[]
  kind                  RepoKind           @default(CODE)
  ownerRepoId           Int?               @unique // set when kind = KNOWLEDGE
  kbExcluded            Boolean            @default(false) // docs deleted; skip until re-included
  headCommit            String? // default-branch commit after the last sync; what scans pin to
  kbRequest             String? // "scan" | "delete" | "include": set by the web app, handled by the backend
  kbRequestedAt         DateTime?
  indexRequestedAt      DateTime? // set by the api (retry), claimed by the backend tick
  kbScannedCommit       String? // commit the last successful scan covered
  kbLastFullScanAt      DateTime?
  status                RepoStatus         @default(PENDING)
  error                 String?
  pushedAt              DateTime?
  lastIndexedAt         DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  discussions           Discussion[]
  provenanceLinks       ProvenanceLink[]
  commitPullProbes      CommitPullProbe[]
  discussionSync        DiscussionSyncState?

  @@unique([external_id, external_codeHostUrl])
}

/// config.json `contexts`, resolved to repo names at sync time.
model SearchContext {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  repoNames   String[]
  updatedAt   DateTime @updatedAt
}

enum ProductSource {
  config // imported from config.json `contexts` by the backend sync; read-only through the admin API
  api // created through the admin API; config import never touches it
}

/// A Product: a named repository set served at /mcp/<slug>. `definition` has the shape of a config context
/// (include/exclude globs, connections, topics); `repoNames` is its resolution against Repo rows.
model Product {
  id          Int           @id @default(autoincrement())
  slug        String        @unique // ^[a-z0-9][a-z0-9-]{0,62}$, immutable
  name        String
  description String?
  source      ProductSource
  definition  Json
  repoNames   String[]
  connectionId Int? // the api Connection a UI-created Product draws its repositories from
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ChatVisibility {
  PRIVATE
  PUBLIC
}

/// An Ask conversation: AI SDK UI messages (parts include tool calls and data-source refs).
model Chat {
  id         String         @id @default(cuid())
  name       String?
  visibility ChatVisibility @default(PRIVATE)
  /// Who created it: the caller's principal (access key name, "admin", "anonymous").
  createdBy  String?
  /// The Product a UI thread belongs to (its slug); null for chats made through the web Ask routes.
  productId  String?
  messages   Json           @default("[]")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([productId, updatedAt])
}

model KnowledgeScan {
  id          Int        @id @default(autoincrement())
  repoId      Int // owner repo
  mode        ScanMode
  status      ScanStatus @default(RUNNING)
  baseCommit  String?
  headCommit  String
  tokensUsed  Int        @default(0)
  docsWritten Int        @default(0)
  docsRemoved Int        @default(0)
  error       String?
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?

  @@index([repoId, startedAt])
}

/// One generated document plus the citations it was verified against: the index delta scans consult.
model KnowledgeDoc {
  id                Int      @id @default(autoincrement())
  repoId            Int // owner repo
  path              String // relative to the knowledge repo root, e.g. knowledge-base/<system>/<concept>.md
  title             String
  summary           String
  /// [{ repo: string, path: string, commit: string }]: every file the doc cites and the commit it was checked at
  citations         Json     @default("[]")
  model             String
  generatedAtCommit String // owner commit this doc was written against
  scanId            Int // scan that last wrote it
  updatedAt         DateTime @updatedAt

  @@unique([repoId, path])
}

// ---- Pull request provenance (ADR 0001, 4.11; P12) ----------------------------------------------------------------
// Rows are keyed by repository, so they are visible exactly when the repository is. Written by the backend import job
// through the ProvenanceStore port (packages/shared/src/provenance.ts, raw SQL), read by the tools through the same port.

enum DiscussionKind {
  PR
  ISSUE
}

/// A pull request (later an issue) of one repository. Third-party text; author logins only, never emails.
model Discussion {
  id             Int                 @id @default(autoincrement())
  repo           Repo                @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId         Int
  number         Int
  kind           DiscussionKind      @default(PR)
  title          String
  body           String // at most 64K characters; "body" in `truncated` when cut
  state          String // open | closed | merged
  authorLogin    String?
  createdAt      DateTime
  updatedAt      DateTime // the provider's, not ours
  mergedAt       DateTime?
  closedAt       DateTime?
  mergeCommitSha String?
  headRef        String?
  baseRef        String?
  url            String?
  labels         String[]
  /// Parts cut short: comments, reviews, reviewComments, files (by the source), body, commentBodies (on import).
  truncated      String[]
  comments       DiscussionComment[]
  files          DiscussionFile[]

  @@unique([repoId, number])
  @@index([repoId, mergedAt])
}

/// A comment, review or review comment; replaced with its discussion as a set.
model DiscussionComment {
  id           Int        @id @default(autoincrement())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId Int
  externalId   String
  kind         String // issue_comment | review | review_comment
  authorLogin  String?
  body         String
  state        String? // a review's verdict
  path         String?
  line         Int?
  createdAt    DateTime
  updatedAt    DateTime?

  @@index([discussionId])
}

model DiscussionFile {
  id           Int        @id @default(autoincrement())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId Int
  path         String
  additions    Int
  deletions    Int

  @@index([discussionId])
}

/// commit -> pr (merge-commit-sha, squash-subject, merge-subject), pr -> ticket (ticket-pattern), pr -> pr (body-ref).
/// Commit links are verified against the local clone; unverified ones are hidden by default. Head-branch SHAs are never stored.
model ProvenanceLink {
  id       Int     @id @default(autoincrement())
  repo     Repo    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId   Int
  fromKind String // commit | pr
  fromRef  String // full sha or pull request number
  toKind   String // pr | ticket
  toRef    String // pull request number or ticket key
  toRepo   String? // repository name of a pr target elsewhere; null for this repository
  source   String
  verified Boolean

  @@index([repoId, fromKind, fromRef])
  @@index([toKind, toRef])
}

/// A default-branch commit already asked GitHub `commits/{sha}/pulls`; `found`: a stored pull request was linked. A commit is asked once.
model CommitPullProbe {
  repo     Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId   Int
  sha      String
  probedAt DateTime
  found    Boolean

  @@id([repoId, sha])
}

/// Per repository: where the last import got to. A repository without a successful import is a coverage gap.
model DiscussionSyncState {
  repo            Repo      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  repoId          Int       @id
  cursorUpdatedAt DateTime?
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  headCommit      String? // the head the commit links were computed against
  status          String // running | ok | failed | waiting
  access          String    @default("unknown") // unknown | ok | no-access: whether the token may read the repository's pull requests
  waitUntil       DateTime? // when status is waiting: the provider's rate-limit reset
  reconciledAt    DateTime? // the last full reconcile
  error           String? // fixed strings only, never provider text
  importedCount   Int       @default(0)
  skippedCount    Int       @default(0) // malformed source items in the last run; the cursor waits for them
}
