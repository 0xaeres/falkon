{
  "$schema": "./packages/shared/schemas/falkon/config.json",
  // Falkon config: connections, settings, contexts, knowledgeBase. Comments allowed.
  "settings": {
    "reindexIntervalMs": 3600000,
    "resyncConnectionIntervalMs": 86400000
  },
  "connections": {
    "github": {
      "type": "github",
      "token": { "env": "GITHUB_TOKEN" },
      "repos": ["octocat/Hello-World"],
      "orgs": [],
      "exclude": { "forks": true, "archived": true }
    },
    "hello": { "type": "git", "url": "https://github.com/octocat/Hello-World.git" },
    "local": { "type": "git", "url": "file:///absolute/path/to/repos/*" }
  },
  "contexts": {
    "octocat": { "include": ["github.com/octocat/*"], "description": "Octocat repos" }
  },
  // Generated architecture docs (on by default; needs LLM_* env vars, skipped without them).
  "knowledgeBase": {
    "enabled": true,
    "repos": "all",
    "scanMode": "delta",
    "refreshIntervalHours": 24,
    "tokenBudget": 2000000,
    "parallelism": 4,
    "citeRepos": [],
    "models": {}
  }
}
