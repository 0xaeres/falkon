data: {"type":"tool-output-available","toolCallId":"call-1d6bb22a-8f8a-42a4-ac0e-fc7966f3a564","output":{"output":"<repo>github.com/openmrs/openmrs-module-webservices.rest</repo>\n<path>omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs2_2/EncounterResource2_2.java</path>\n<url>undefined</url>\n<content>\n1: /**\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.webservices.rest.web.v1_0.resource.openmrs2_2;\n11: \n12: import org.openmrs.Diagnosis;\n13: import org.openmrs.Encounter;\n14: import org.openmrs.Order;\n15: import org.openmrs.module.webservices.rest.web.RestConstants;\n16: import org.openmrs.module.webservices.rest.web.annotation.PropertyGetter;\n17: import org.openmrs.module.webservices.rest.web.annotation.Resource;\n18: import org.openmrs.module.webservices.rest.web.representation.DefaultRepresentation;\n19: import org.openmrs.module.webservices.rest.web.representation.FullRepresentation;\n20: import org.openmrs.module.webservices.rest.web.representation.Representation;\n21: import org.openmrs.module.webservices.rest.web.resource.impl.DelegatingResourceDescription;\n22: import org.openmrs.module.webservices.rest.web.v1_0.resource.openmrs1_9.EncounterResource1_9;\n23: \n24: import java.util.LinkedHashSet;\n25: import java.util.Set;\n26: import java.util.stream.Collectors;\n27: \n28: /**\n29:  * {@link Resource} for {@link EncounterResource2_2}, supporting standard CRUD operations\n30:  */\n31: @Resource(name = RestConstants.VERSION_1 + \"/encounter\", supportedClass = Encounter.class, supportedOpenmrsVersions = {\n32:         \"2.2.* - 9.*\" })\n33: public class EncounterResource2_2 extends EncounterResource1_9 {\n34: \t\n35: \t@Override\n36: \tpublic DelegatingResourceDescription getRepresentationDescription(Representation rep) {\n37: \t\tDelegatingResourceDescription description = null;\n38: \t\tif (rep instanceof DefaultRepresentation || rep instanceof FullRepresentation) {\n39: \t\t\tdescription = super.getRepresentationDescription(rep);\n40: \t\t\tdescription.addProperty(\"diagnoses\");\n41: \t\t}\n42: \t\treturn description;\n43: \t}\n44: \t\n45: \t/**\n46: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.BaseDelegatingResource#getCreatableProperties()\n47: \t */\n48: \t@Override\n49: \tpublic DelegatingResourceDescription getCreatableProperties() {\n50: \t\tDelegatingResourceDescription description = super.getCreatableProperties();\n51: \t\tdescription.addProperty(\"diagnoses\");\n52: \t\treturn description;\n53: \t}\n54: \t\n55: \t/**\n56: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.BaseDelegatingResource#getCreatableProperties()\n57: \t */\n58: \t@Override\n59: \tpublic DelegatingResourceDescription getUpdatableProperties() {\n60: \t\tDelegatingResourceDescription description = super.getUpdatableProperties();\n61: \t\tdescription.addProperty(\"diagnoses\");\n62: \t\treturn description;\n63: \t}\n64: \n65:     @PropertyGetter(\"diagnoses\")\n66:     public static Set<Diagnosis> getDiagnoses(Encounter instance) {\n67:         return instance.getDiagnoses().stream().filter(diagnosis -> !diagnosis.getVoided()).collect(Collectors.toCollection(LinkedHashSet::new));\n68:     }\n69: \n70: \n71:     /**\n72: \t * @see org.openmrs.module.webservices.rest.web.resource.impl.BaseDelegatingResource#getResourceVersion()\n73: \t */\n74: \t@Override\n75: \tpublic String getResourceVersion() {\n76: \t\treturn RestConstants2_2.RESOURCE_VERSION;\n77: \t}\n78: }\n79: \n\n(End of file - 79 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs2_2/EncounterResource2_2.java","name":"EncounterResource2_2.java","revision":"HEAD"}]}}

