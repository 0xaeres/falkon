data: {"type":"tool-output-available","toolCallId":"call-0f8da5c6-3a3d-4914-90ea-5e7f6974f10c","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-react-utils/src/useVisit.ts</path>\n<url>undefined</url>\n<content>\n1: /** @module @category API */\n2: import { useCallback, useEffect, useMemo, useRef } from 'react';\n3: import useSWR from 'swr';\n4: import dayjs from 'dayjs';\n5: import isToday from 'dayjs/plugin/isToday.js';\n6: import { openmrsFetch, restBaseUrl } from '@openmrs/esm-api';\n7: import { defaultVisitCustomRepresentation, type Visit } from '@openmrs/esm-emr-api';\n8: import { useVisitContextStore } from './useVisitContextStore';\n9: \n10: dayjs.extend(isToday);\n11: \n12: export interface VisitReturnType {\n13:   error: Error;\n14:   mutate: () => void;\n15:   isValidating: boolean;\n16:   activeVisit: Visit | null;\n17: \n18:   /**\n19:    * @deprecated \"current visit\" is not well defined outside of the patient chart.\n20:    * Use `visitContext` in the patient chart instead.\n21:    */\n22:   currentVisit: Visit | null;\n23: \n24:   /**\n25:    * @deprecated \"current visit\" is not well defined outside of the patient chart.\n26:    * Use `visitContext` in the patient chart instead.\n27:    */\n28:   currentVisitIsRetrospective: boolean;\n29:   isLoading: boolean;\n30: }\n31: \n32: /**\n33:  * This React hook returns visit information if the patient UUID is not null. There are\n34:  * potentially two relevant visits at a time: \"active\" and \"current\".\n35:  *\n36:  * The active visit is the most recent visit without an end date. The presence of an active\n37:  * visit generally means that the patient is in the facility.\n38:  *\n39:  * The current visit is the active visit, unless a retrospective visit has been selected.\n40:  * If there is no active visit and no selected retrospective visit, then there is no\n41:  * current visit. If there is no active visit but there is a retrospective visit, then\n42:  * the retrospective visit is the current visit. `currentVisitIsRetrospective` tells you\n43:  * whether the current visit is a retrospective visit.\n44:  *\n45:  * The active visit and current visit require two separate API calls. `error` contains\n46:  * the error from either one, if there is an error. `isValidating` is true if either\n47:  * API call is in progress. `mutate` refreshes the data from both API calls.\n48:  *\n49:  * @param patientUuid Unique patient identifier `string`\n50:  * @param representation The custom representation of the visit\n51:  */\n52: export function useVisit(patientUuid: string, representation = defaultVisitCustomRepresentation): VisitReturnType {\n53:   // The callback we register has to exist before we read the store, but the mutate functions\n54:   // it calls come from SWR calls that are keyed off what the store holds. Registering a stable\n55:   // indirection through a ref breaks that cycle, so the store is read once per hook rather than\n56:   // once to get the key and again to register.\n57:   const mutateVisitRef = useRef<() => void>(undefined);\n58:   const registeredMutateVisit = useCallback(() => mutateVisitRef.current?.(), []);\n59:   const {\n60:     patientUuid: visitStorePatientUuid,\n61:     manuallySetVisitUuid,\n62:     setVisitContext,\n63:   } = useVisitContextStore(registeredMutateVisit);\n64:   // Ignore the visit store data if it is not for this patient\n65:   const retrospectiveVisitUuid = patientUuid && visitStorePatientUuid == patientUuid ? manuallySetVisitUuid : null;\n66:   const activeVisitUrlSuffix = `?patient=${patientUuid}&v=${representation}&includeInactive=false`;\n67:   const retrospectiveVisitUrlSuffix = `/${retrospectiveVisitUuid}?v=${representation}`;\n68: \n69:   const {\n70:     data: activeData,\n71:     error: activeError,\n72:     mutate: activeMutate,\n73:     isValidating: activeIsValidating,\n74:   } = useSWR<{\n75:     data: { results: Array<Visit> };\n76:   }>(patientUuid ? `${restBaseUrl}/visit${activeVisitUrlSuffix}` : null, openmrsFetch);\n77: \n78:   const {\n79:     data: retroData,\n80:     error: retroError,\n81:     mutate: retroMutate,\n82:     isValidating: retroIsValidating,\n83:   } = useSWR<{\n84:     data: Visit;\n85:   }>(patientUuid && retrospectiveVisitUuid ? `${restBaseUrl}/visit${retrospectiveVisitUrlSuffix}` : null, openmrsFetch);\n86: \n87:   const activeVisit = useMemo(\n88:     () => activeData?.data.results.find((visit) => visit.stopDatetime === null) ?? null,\n89:     [activeData],\n90:   );\n91: \n92:   const currentVisit = useMemo(\n93:     () => (retrospectiveVisitUuid && retroData ? retroData.data : null),\n94:     [retroData, retrospectiveVisitUuid],\n95:   );\n96:   const previousCurrentVisit = useRef<Visit | null>(null);\n97: \n98:   useEffect(() => {\n99:     // if an active visit is created for the visit store patient and they have no visit in context, set the context to the active visit\n100:     if (!activeIsValidating && activeVisit && visitStorePatientUuid === patientUuid && manuallySetVisitUuid === null) {\n101:       setVisitContext(activeVisit);\n102:     }\n103:     if (!retroIsValidating) {\n104:       // if the current visit happened to be active but it just got ended (inactive), remove the\n105:       // visit from context\n106:       if (\n107:         previousCurrentVisit.current &&\n108:         currentVisit &&\n109:         previousCurrentVisit.current.uuid === currentVisit.uuid &&\n110:         !previousCurrentVisit.current.stopDatetime &&\n111:         currentVisit.stopDatetime\n112:       ) {\n113:         setVisitContext(null);\n114:       }\n115:       previousCurrentVisit.current = currentVisit;\n116:     }\n117:   }, [currentVisit, manuallySetVisitUuid, activeVisit, activeIsValidating, retroIsValidating, visitStorePatientUuid]);\n118: \n119:   const mutateVisit = useCallback(() => {\n120:     activeMutate();\n121:     retroMutate();\n122:   }, [activeMutate, retroMutate]);\n123: \n124:   useEffect(() => {\n\n(Output capped at 5KB. Showing lines 1-124 of 142. Use offset=125 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-react-utils/src/useVisit.ts","name":"useVisit.ts","revision":"HEAD"}]}}

