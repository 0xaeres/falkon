data: {"type":"tool-output-available","toolCallId":"call-b034e414-0a10-4c5d-bcea-be606b46c4b3","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-chart-app/src/visit/visit-form/exported-visit-form.workspace.tsx</path>\n<url>undefined</url>\n<content>\n120:     onVisitStarted,\n121:     patient,\n122:     patientUuid,\n123:     visitContext: visitToEdit,\n124:   },\n125: }) => {\n126:   const { t } = useTranslation();\n127:   const isTablet = useLayoutType() === 'tablet';\n128:   const config = useConfig<ChartConfig>();\n129:   const { emrConfiguration } = useEmrConfiguration();\n130:   const [visitTypeContentSwitcherIndex, setVisitTypeContentSwitcherIndex] = useState(\n131:     config.showRecommendedVisitTypeTab ? 0 : 1,\n132:   );\n133:   const visitHeaderSlotState = useMemo(() => ({ patientUuid, patient }), [patientUuid, patient]);\n134:   const { activePatientEnrollment, isLoading } = useActivePatientEnrollment(patientUuid);\n135:   const { activeVisit, isLoading: isLoadingVisit } = useVisit(patientUuid);\n136:   const { allowOverlappingVisits, isLoading: isLoadingOverlapSetting } = useAllowOverlappingVisits();\n137: \n138:   const { mutate: globalMutate } = useSWRConfig();\n139:   const allVisitTypes = useVisitTypes();\n140:   const { earliestAllowedStartDate, isLoading: isLoadingBirthdateCheck } =\n141:     useEarliestAllowedVisitStartDate(patientUuid);\n142: \n143:   const [isVisitSaved, setIsVisitSaved] = useState(false);\n144:   const [errorFetchingResources, setErrorFetchingResources] = useState<{\n145:     blockSavingForm: boolean;\n146:   } | null>(null);\n147:   const { visitAttributeTypes } = useVisitAttributeTypes();\n148:   const [visitFormCallbacks, setVisitFormCallbacks] = useVisitFormCallbacks();\n149:   const [extraVisitInfo, setExtraVisitInfo] = useState<ExtraVisitInfo | null>(null);\n150:   const { visitFormSchema, defaultValues, firstEncounterDateTime, lastEncounterDateTime } =\n151:     useVisitFormSchemaAndDefaultValues(visitToEdit, earliestAllowedStartDate);\n152: \n153:   const methods = useForm<VisitFormData>({\n154:     mode: 'all',\n155:     resolver: zodResolver(visitFormSchema),\n156:     defaultValues,\n157:   });\n158: \n159:   const {\n160:     handleSubmit,\n161:     control,\n162:     getValues,\n163:     formState: { errors, isDirty, isSubmitting },\n164:     reset,\n165:   } = methods;\n166: \n167:   const visitStatus = useWatch({ control, name: 'visitStatus' });\n168:   const hasActiveVisitConflict = !visitToEdit && visitStatus !== 'past' && !!activeVisit && !allowOverlappingVisits;\n169: \n170:   // default values are cached so form needs to be reset when they change (e.g. when default visit location finishes loading)\n171:   useEffect(() => {\n172:     reset(defaultValues, {\n173:       keepDirty: true,\n174:       keepDirtyValues: true,\n175:       keepErrors: true,\n176:       keepTouched: true,\n177:     });\n178:   }, [defaultValues, reset]);\n179: \n180:   const getErrorDescription = useCallback(\n181:     (error: unknown) => {\n182:       if (OpenmrsFetchError && error instanceof OpenmrsFetchError) {\n183:         return typeof error.responseBody === 'string'\n184:           ? error.responseBody\n185:           : extractErrorMessagesFromResponse(error.responseBody as ErrorObject, t);\n186:       }\n187:       return (error as Error)?.message;\n188:     },\n189:     [t],\n190:   );\n191: \n192:   const handleVisitAttributes = useCallback(\n193:     (visitAttributes: { [p: string]: string }, visitUuid: string) => {\n194:       const existingVisitAttributeTypes =\n195:         visitToEdit?.attributes?.map((attribute) => attribute.attributeType.uuid) || [];\n196: \n197:       const promises = [];\n198: \n199:       for (const [attributeType, value] of Object.entries(visitAttributes)) {\n200:         if (attributeType && existingVisitAttributeTypes.includes(attributeType)) {\n201:           const attributeToEdit = visitToEdit.attributes.find((attr) => attr.attributeType.uuid === attributeType);\n202: \n203:           if (attributeToEdit) {\n204:             // continue to next attribute if the previous value is same as new value\n205:             const isSameValue =\n206:               typeof attributeToEdit.value === 'object'\n207:                 ? attributeToEdit.value.uuid === value\n208:                 : attributeToEdit.value === value;\n209: \n210:             if (isSameValue) {\n211:               continue;\n212:             }\n213: \n214:             if (value) {\n215:               // Update attribute with new value\n216:               promises.push(\n217:                 updateVisitAttribute(visitUuid, attributeToEdit.uuid, value).catch((error) => {\n218:                   showSnackbar({\n219:                     title: t('errorUpdatingVisitAttribute', 'Error updating the {{attributeName}} visit attribute', {\n220:                       attributeName: attributeToEdit.attributeType.display,\n221:                     }),\n222:                     kind: 'error',\n223:                     isLowContrast: false,\n224:                     subtitle: getErrorDescription(error),\n225:                   });\n226:                   return Promise.reject(error); // short-circuit promise chain\n227:                 }),\n228:               );\n229:             } else {\n230:               // Delete attribute if no value is provided\n231:               promises.push(\n232:                 deleteVisitAttribute(visitUuid, attributeToEdit.uuid).catch((error) => {\n233:                   showSnackbar({\n234:                     title: t('errorDeletingVisitAttribute', 'Error deleting the {{attributeName}} visit attribute', {\n235:                       attributeName: attributeToEdit.attributeType.display,\n236:                     }),\n237:                     kind: 'error',\n238:                     isLowContrast: false,\n239:                     subtitle: getErrorDescription(error),\n\n(Showing lines 120-239 of 717. Use offset=240 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/visit/visit-form/exported-visit-form.workspace.tsx","name":"exported-visit-form.workspace.tsx","revision":"HEAD"}]}}

