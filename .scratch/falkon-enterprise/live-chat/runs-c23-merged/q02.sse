data: {"type":"tool-output-available","toolCallId":"call-574e2bdc-e939-4cf1-b93b-95a0a7ee1290","output":{"output":"<repo>github.com/openmrs/openmrs-esm-billing-app</repo>\n<path>src/billing.resource.ts</path>\n<url>undefined</url>\n<content>\n180: export const processBillPayment = (payload: PaymentRequestPayload, billUuid: string) => {\n181:   const url = `${apiBasePath}bill/${billUuid}/payment`;\n182: \n183:   return openmrsFetch(url, {\n184:     method: 'POST',\n185:     body: payload,\n186:     headers: {\n187:       'Content-Type': 'application/json',\n188:     },\n189:   });\n190: };\n191: \n192: export function useDefaultFacility(): { data: SessionLocation | null } {\n193:   const { sessionLocation } = useSession();\n194:   return { data: sessionLocation };\n195: }\n196: \n197: export const usePatientPaymentInfo = (patientUuid: string) => {\n198:   const { currentVisit } = useVisit(patientUuid);\n199:   const attributes = currentVisit?.attributes ?? [];\n200:   const paymentInformation = attributes\n201:     .map((attribute) => ({\n202:       name: attribute.attributeType.name,\n203:       value: attribute.value,\n204:     }))\n205:     .filter(({ name }) => name === 'Insurance scheme' || name === 'Policy Number');\n206: \n207:   return paymentInformation;\n208: };\n209: \n210: export function useBillableServices() {\n211:   const url = `${apiBasePath}billableService?v=custom:(uuid,name,shortName,serviceStatus,serviceType:(display),servicePrices:(uuid,name,price,paymentMode))`;\n212:   return useOpenmrsFetchAll<BillableItem>(url);\n213: }\n214: \n215: export const processBillItems = (payload: CreateBillPayload) => {\n216:   const url = `${apiBasePath}bill`;\n217:   return openmrsFetch(url, {\n218:     method: 'POST',\n219:     body: payload,\n220:     headers: {\n221:       'Content-Type': 'application/json',\n222:     },\n223:   });\n224: };\n225: \n226: export const updateBillItems = (payload: UpdateBillPayload) => {\n227:   const url = `${apiBasePath}bill/${payload.uuid}`;\n228:   return openmrsFetch(url, {\n229:     method: 'POST',\n230:     body: payload,\n231:     headers: {\n232:       'Content-Type': 'application/json',\n233:     },\n234:   });\n235: };\n236: \n237: export const finalizeBill = (billUuid: string) => {\n238:   const url = `${apiBasePath}bill/${billUuid}`;\n239:   return openmrsFetch(url, {\n240:     method: 'POST',\n241:     body: { status: BillStatus.POSTED },\n242:     headers: {\n243:       'Content-Type': 'application/json',\n244:     },\n245:   });\n246: };\n247: \n248: export const deleteBillItem = (itemUuid: string, voidReason: string) => {\n249:   const url = `${apiBasePath}billLineItem/${itemUuid}?reason=${encodeURIComponent(voidReason)}`;\n250: \n251:   return openmrsFetch(url, {\n252:     method: 'DELETE',\n253:   });\n254: };\n255: \n256: export const deleteBill = (billUuid: string, reason: string) => {\n257:   const url = `${apiBasePath}bill/${billUuid}?reason=${encodeURIComponent(reason)}`;\n258: \n259:   return openmrsFetch(url, {\n260:     method: 'DELETE',\n261:   });\n262: };\n263: \n264: export const patientPaymentStatusCacheKey = (patientUuid: string) =>\n265:   `${apiBasePath}patientPaymentStatus/${patientUuid}`;\n266: \n267: export const usePatientPaymentStatus = (patientUuid: string) => {\n268:   const url = patientPaymentStatusCacheKey(patientUuid);\n269:   const { data, error, isLoading, isValidating, mutate } = useSWR<{ data: PatientPaymentStatus }>(\n270:     patientUuid ? url : null,\n271:     openmrsFetch,\n272:   );\n273:   return {\n274:     paymentStatus: data?.data,\n275:     error,\n276:     isLoading,\n277:     isValidating,\n278:     mutate,\n279:   };\n280: };\n\n(Showing lines 180-280 of 281. Use offset=281 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/billing.resource.ts","name":"billing.resource.ts","revision":"HEAD"}]}}

