data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillResource.java","name":"BillResource.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-b17e3b7a1bd1cefe","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillResource.java</path>\n<url>undefined</url>\n<content>\n250: \t\tContext.getService(BillService.class).purgeBill(bill);\n251: \t}\n252: \t\n253: \t@Override\n254: \tpublic Bill newDelegate() {\n255: \t\treturn new Bill();\n256: \t}\n257: \t\n258: \tprivate Provider getCurrentCashier() {\n259: \t\treturn ProviderUtil.getCurrentProvider();\n260: \t}\n261: \t\n262: \tprivate void assignCurrentCashier(Bill bill) {\n263: \t\tProvider cashier = getCurrentCashier();\n264: \t\tif (cashier == null) {\n265: \t\t\tthrow new RestClientException(\n266: \t\t\t        \"The current user (\" + Context.getAuthenticatedUser().getUsername() + \") is not a provider\");\n267: \t\t}\n268: \t\t\n269: \t\tbill.setCashier(cashier);\n270: \t}\n271: \t\n272: \tprivate void assignActiveVisit(Bill bill) {\n273: \t\tList<Visit> activeVisits = Context.getVisitService().getActiveVisitsByPatient(bill.getPatient());\n274: \t\tif (activeVisits == null || activeVisits.isEmpty()) {\n275: \t\t\treturn;\n276: \t\t}\n277: \t\t\n278: \t\tif (activeVisits.size() == 1) {\n279: \t\t\tbill.setVisit(activeVisits.get(0));\n280: \t\t\treturn;\n281: \t\t}\n282: \t\t\n283: \t\tlog.info(\"Bill for patient {} has {} active visits; leaving visit unset\", bill.getPatient().getUuid(),\n284: \t\t    activeVisits.size());\n285: \t}\n286: \t\n287: \tprivate void initializeBillStatus(Bill bill) {\n288: \t\t// Now that all attributes have been set (i.e., payments and bill status) we can check to see if the bill\n289: \t\t// is fully paid.\n290: \t\tbill.synchronizeBillStatus();\n291: \t\tif (bill.getStatus() == null) {\n292: \t\t\tbill.setStatus(BillStatus.PENDING);\n293: \t\t}\n294: \t}\n295: \t\n296: \tprivate void loadBillCashPoint(Bill bill) {\n297: \t\tITimesheetService service = Context.getService(ITimesheetService.class);\n298: \t\tTimesheet timesheet = service.getCurrentTimesheet(bill.getCashier());\n299: \t\tif (timesheet == null) {\n300: \t\t\tAdministrationService adminService = Context.getAdministrationService();\n301: \t\t\tboolean timesheetRequired;\n302: \t\t\ttry {\n303: \t\t\t\ttimesheetRequired = Boolean\n304: \t\t\t\t        .parseBoolean(adminService.getGlobalProperty(ModuleSettings.TIMESHEET_REQUIRED_PROPERTY));\n305: \t\t\t}\n306: \t\t\tcatch (Exception e) {\n307: \t\t\t\ttimesheetRequired = false;\n308: \t\t\t}\n309: \t\t\t\n310: \t\t\tif (timesheetRequired) {\n311: \t\t\t\tthrow new RestClientException(\"A current timesheet does not exist for cashier \" + bill.getCashier());\n312: \t\t\t} else if (bill.getBillAdjusted() != null) {\n313: \t\t\t\t// If this is an adjusting bill, copy cash point from billAdjusted\n314: \t\t\t\tbill.setCashPoint(bill.getBillAdjusted().getCashPoint());\n315: \t\t\t} else {\n316: \t\t\t\tthrow new RestClientException(\"Cash point cannot be null!\");\n317: \t\t\t}\n318: \t\t} else {\n319: \t\t\tCashPoint cashPoint = timesheet.getCashPoint();\n320: \t\t\tif (cashPoint == null) {\n321: \t\t\t\tthrow new RestClientException(\"No cash points defined for the current timesheet!\");\n322: \t\t\t}\n323: \t\t\tbill.setCashPoint(cashPoint);\n324: \t\t}\n325: \t}\n326: \t\n327: \tprivate BillSearch buildBillSearchFromRequest(RequestContext context) {\n328: \t\tBillSearch billSearch = new BillSearch();\n329: \t\t\n330: \t\tString patientUuid = context.getRequest().getParameter(\"patientUuid\");\n331: \t\tif (StringUtils.isNotBlank(patientUuid)) {\n332: \t\t\tbillSearch.setPatientUuid(patientUuid);\n333: \t\t}\n334: \t\t\n335: \t\tString patientName = context.getRequest().getParameter(\"patientName\");\n336: \t\tif (StringUtils.isNotBlank(patientName)) {\n337: \t\t\tbillSearch.setPatientName(patientName);\n338: \t\t}\n339: \t\t\n340: \t\tString status = context.getRequest().getParameter(\"status\");\n341: \t\tif (StringUtils.isNotBlank(status)) {\n342: \t\t\tList<BillStatus> statuses = Arrays.stream(status.split(\",\")).map(String::trim).filter(StringUtils::isNotBlank)\n343: \t\t\t        .map(s -> BillStatus.valueOf(s.toUpperCase(Locale.ROOT))).collect(Collectors.toList());\n344: \t\t\tbillSearch.setStatuses(statuses);\n345: \t\t}\n346: \t\t\n347: \t\tString cashPointUuid = context.getRequest().getParameter(\"cashPointUuid\");\n348: \t\tif (StringUtils.isNotBlank(cashPointUuid)) {\n349: \t\t\tbillSearch.setCashPointUuid(cashPointUuid);\n350: \t\t}\n351: \t\t\n352: \t\tString visitUuid = context.getRequest().getParameter(\"visitUuid\");\n353: \t\tif (StringUtils.isNotBlank(visitUuid)) {\n354: \t\t\tbillSearch.setVisitUuid(visitUuid);\n355: \t\t}\n356: \t\t\n357: \t\tString locationUuid = context.getRequest().getParameter(\"locationUuid\");\n358: \t\tif (StringUtils.isNotBlank(locationUuid)) {\n359: \t\t\tbillSearch.setLocationUuid(locationUuid);\n360: \t\t}\n361: \t\t\n362: \t\tbillSearch.setStartDate(parseDateParameter(context, \"startDate\"));\n363: \t\tbillSearch.setEndDate(parseDateParameter(context, \"endDate\"));\n364: \t\tif (billSearch.getStartDate() != null && billSearch.getEndDate() != null\n365: \t\t        && billSearch.getStartDate().after(billSearch.getEndDate())) {\n366: \t\t\tthrow new InvalidSearchException(\"startDate must not be after endDate\");\n367: \t\t}\n368: \t\t\n369: \t\tString discountStatus = context.getRequest().getParameter(\"discountStatus\");\n370: \t\tif (StringUtils.isNotBlank(discountStatus)) {\n371: \t\t\tbillSearch.setDiscountStatuses(parseDiscountStatuses(discountStatus));\n372: \t\t}\n373: \t\t\n374: \t\tString refundStatus = context.getRequest().getParameter(\"refundStatus\");\n375: \t\tif (StringUtils.isNotBlank(refundStatus)) {\n376: \t\t\tContext.requirePrivilege(PrivilegeConstants.VIEW_REFUNDS);\n377: \t\t\tList<RefundStatus> refundStatuses = parseRefundStatuses(refundStatus);\n378: \t\t\tif (refundStatuses.isEmpty()) {\n379: \t\t\t\tthrow new InvalidSearchException(\"refundStatus parameter contained no valid values\");\n380: \t\t\t}\n381: \t\t\tbillSearch.setRefundStatuses(refundStatuses);\n382: \t\t}\n383: \t\t\n384: \t\tString includeAll = context.getRequest().getParameter(\"includeAll\");\n385: \t\tif (StringUtils.isNotBlank(includeAll)) {\n386: \t\t\tbillSearch.setIncludeVoidedLineItems(Boolean.parseBoolean(includeAll));\n387: \t\t}\n388: \t\t\n389: \t\treturn billSearch;\n390: \t}\n391: \t\n392: \tprivate Date parseDateParameter(RequestContext context, String name) {\n393: \t\tString value = context.getRequest().getParameter(name);\n\n(Output capped at 5KB. Showing lines 250-393 of 429. Use offset=394 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillResource.java","name":"BillResource.java","revision":"HEAD"}]}}

