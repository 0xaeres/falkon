data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-8eb73c38efadc271","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/impl/ItemPriceServiceImpl.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.api.impl;\n11: \n12: import java.util.List;\n13: \n14: import lombok.extern.slf4j.Slf4j;\n15: import org.hibernate.Criteria;\n16: import org.hibernate.criterion.Order;\n17: import org.hibernate.criterion.Restrictions;\n18: import org.openmrs.module.billing.api.ItemPriceService;\n19: import org.openmrs.module.billing.api.base.entity.impl.BaseMetadataDataServiceImpl;\n20: import org.openmrs.module.billing.api.base.entity.security.IMetadataAuthorizationPrivileges;\n21: import org.openmrs.module.billing.api.model.BillableService;\n22: import org.openmrs.module.billing.api.model.CashierItemPrice;\n23: import org.openmrs.module.stockmanagement.api.model.StockItem;\n24: import org.springframework.transaction.annotation.Transactional;\n25: \n26: @Slf4j\n27: @Transactional\n28: public class ItemPriceServiceImpl extends BaseMetadataDataServiceImpl<CashierItemPrice> implements IMetadataAuthorizationPrivileges, ItemPriceService {\n29: \t\n30: \t@Override\n31: \tprotected IMetadataAuthorizationPrivileges getPrivileges() {\n32: \t\treturn this;\n33: \t}\n34: \t\n35: \t@Override\n36: \tprotected void validate(CashierItemPrice object) {\n37: \t\t\n38: \t}\n39: \t\n40: \t@Override\n41: \tpublic CashierItemPrice save(CashierItemPrice object) {\n42: \t\tlog.debug(\"Processing save Price\");\n43: \t\treturn super.save(object);\n44: \t}\n45: \t\n46: \t@Override\n47: \tpublic String getRetirePrivilege() {\n48: \t\treturn null;\n49: \t}\n50: \t\n51: \t@Override\n52: \tpublic String getSavePrivilege() {\n53: \t\treturn null;\n54: \t}\n55: \t\n56: \t@Override\n57: \tpublic String getPurgePrivilege() {\n58: \t\treturn null;\n59: \t}\n60: \t\n61: \t@Override\n62: \tpublic String getGetPrivilege() {\n63: \t\treturn null;\n64: \t}\n65: \t\n66: \t@Override\n67: \tpublic List<CashierItemPrice> getItemPrice(StockItem stockItem) {\n68: \t\t// Criteria criteria = getRepository().createCriteria(getEntityClass());\n69: \t\tCriteria criteria = getRepository().createCriteria(CashierItemPrice.class);\n70: \t\t\n71: \t\tcriteria.add(Restrictions.eq(\"item\", stockItem));\n72: \t\tcriteria.addOrder(Order.desc(\"id\"));\n73: \t\t\n74: \t\t// List<ItemPrice> results = getRepository().select(getEntityClass(), criteria);\n75: \t\t// return(results);\n76: \t\treturn criteria.list();\n77: \t}\n78: \t\n79: \t@Override\n80: \tpublic List<CashierItemPrice> getServicePrice(BillableService billableService) {\n81: \t\tCriteria criteria = getRepository().createCriteria(CashierItemPrice.class);\n82: \t\t\n83: \t\tcriteria.add(Restrictions.eq(\"billableService\", billableService));\n84: \t\tcriteria.addOrder(Order.desc(\"id\"));\n85: \t\treturn criteria.list();\n86: \t}\n87: }\n88: \n\n(End of file - 88 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/impl/ItemPriceServiceImpl.java","name":"ItemPriceServiceImpl.java","revision":"HEAD"}]}}

