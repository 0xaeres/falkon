{
  "_doc": "tools/call corpus over the falkon OpenMRS repos. Each output must match v6 text for text.",
  "calls": [
    { "id": "repos-default", "tool": "list_repos", "args": {} },
    { "id": "repos-query", "tool": "list_repos", "args": { "query": "ESM", "perPage": 5 } },
    { "id": "repos-page2", "tool": "list_repos", "args": { "perPage": 10, "page": 2 } },
    { "id": "repos-pushed", "tool": "list_repos", "args": { "sort": "pushed", "direction": "desc", "perPage": 8 } },
    { "id": "repos-none", "tool": "list_repos", "args": { "query": "zzz-nothing" } },

    { "id": "read-pom", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "pom.xml" } },
    { "id": "read-range", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "pom.xml", "offset": 40, "limit": 15 } },
    { "id": "read-end", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "README.md", "offset": 1, "limit": 500 } },
    { "id": "read-java", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "api/src/main/java/org/openmrs/api/PatientService.java", "offset": 100, "limit": 30 } },
    { "id": "read-missing", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "nope/missing.txt" } },
    { "id": "read-dotdot", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "../etc/passwd" } },
    { "id": "read-badref", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "pom.xml", "ref": "no-such-branch" } },
    { "id": "read-dashref", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "pom.xml", "ref": "-x" } },
    { "id": "read-norepo", "tool": "read_file", "args": { "repo": "github.com/openmrs/nope", "path": "pom.xml" } },
    { "id": "read-ts", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-esm-patient-chart", "path": "package.json" } },

    { "id": "tree-root", "tool": "list_tree", "args": { "repo": "github.com/openmrs/openmrs-core" } },
    { "id": "tree-depth2", "tool": "list_tree", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "api/src/main", "depth": 3 } },
    { "id": "tree-dirs", "tool": "list_tree", "args": { "repo": "github.com/openmrs/openmrs-esm-patient-chart", "depth": 2, "includeFiles": false } },
    { "id": "tree-files", "tool": "list_tree", "args": { "repo": "github.com/openmrs/openmrs-esm-patient-chart", "path": "/packages/", "includeDirectories": false } },
    { "id": "tree-max", "tool": "list_tree", "args": { "repo": "github.com/openmrs/openmrs-core", "depth": 4, "maxEntries": 7 } },
    { "id": "tree-none", "tool": "list_tree", "args": { "repo": "github.com/openmrs/openmrs-core", "includeFiles": false, "includeDirectories": false } },
    { "id": "tree-missing-dir", "tool": "list_tree", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "no/such/dir" } },

    { "id": "branches", "tool": "list_branches", "args": { "repo": "github.com/openmrs/openmrs-core" } },
    { "id": "branches-query", "tool": "list_branches", "args": { "repo": "github.com/openmrs/openmrs-esm-patient-chart", "query": "MAIN" } },
    { "id": "branches-norepo", "tool": "list_branches", "args": { "repo": "github.com/openmrs/nope" } },

    { "id": "commits", "tool": "list_commits", "args": { "repo": "github.com/openmrs/openmrs-core", "perPage": 5 } },
    { "id": "commits-page", "tool": "list_commits", "args": { "repo": "github.com/openmrs/openmrs-core", "perPage": 3, "page": 4 } },
    { "id": "commits-path", "tool": "list_commits", "args": { "repo": "github.com/openmrs/openmrs-core", "path": "api/src/main/java/org/openmrs/api/PatientService.java", "perPage": 5 } },
    { "id": "commits-query", "tool": "list_commits", "args": { "repo": "github.com/openmrs/openmrs-core", "query": "TRUNK-6", "perPage": 4 } },
    { "id": "commits-author", "tool": "list_commits", "args": { "repo": "github.com/openmrs/openmrs-core", "author": "dkayiwa", "perPage": 3 } },
    { "id": "commits-range", "tool": "list_commits", "args": { "repo": "github.com/openmrs/openmrs-core", "since": "2024-01-01", "until": "2024-06-30", "perPage": 5 } },
    { "id": "commits-badrange", "tool": "list_commits", "args": { "repo": "github.com/openmrs/openmrs-core", "since": "2025-01-01", "until": "2024-01-01" } },

    { "id": "diff", "tool": "get_diff", "args": { "repo": "github.com/openmrs/openmrs-core", "base": "HEAD~2", "head": "HEAD" } },
    { "id": "diff-path", "tool": "get_diff", "args": { "repo": "github.com/openmrs/openmrs-core", "base": "HEAD~10", "head": "HEAD", "path": "api" } },
    { "id": "diff-empty", "tool": "get_diff", "args": { "repo": "github.com/openmrs/openmrs-core", "base": "HEAD", "head": "HEAD" } },
    { "id": "diff-badref", "tool": "get_diff", "args": { "repo": "github.com/openmrs/openmrs-core", "base": "nope", "head": "HEAD" } },

    { "id": "grep-class", "tool": "grep", "args": { "pattern": "class PatientServiceImpl", "repo": "github.com/openmrs/openmrs-core" } },
    { "id": "grep-include", "tool": "grep", "args": { "pattern": "voidPatient\\(", "include": "*.java", "limit": 500 } },
    { "id": "grep-path", "tool": "grep", "args": { "pattern": "useConfig", "path": "packages/esm-patient-vitals-app", "limit": 500 } },
    { "id": "grep-group", "tool": "grep", "args": { "pattern": "TRUNK-6823", "groupByRepo": true } },
    { "id": "grep-none", "tool": "grep", "args": { "pattern": "zzzNoSuchTokenqq" } },
    { "id": "grep-norepo", "tool": "grep", "args": { "pattern": "x", "repo": "github.com/openmrs/nope" } },
    { "id": "grep-brace-include", "tool": "grep", "args": { "pattern": "openmrsFetch", "include": "*.{ts,tsx}", "repo": "github.com/openmrs/openmrs-esm-patient-chart", "limit": 1000 } },

    { "id": "glob-pom", "tool": "glob", "args": { "pattern": "**/pom.xml", "limit": 1000 } },
    { "id": "glob-repo", "tool": "glob", "args": { "pattern": "*.tsx", "repo": "github.com/openmrs/openmrs-esm-patient-chart", "path": "packages/esm-patient-vitals-app", "limit": 1000 } },
    { "id": "glob-none", "tool": "glob", "args": { "pattern": "**/*.nosuchext" } },

    { "id": "defs", "tool": "find_symbol_definitions", "args": { "symbol": "PatientServiceImpl", "repo": "github.com/openmrs/openmrs-core" } },
    { "id": "defs-method", "tool": "find_symbol_definitions", "args": { "symbol": "getPatientByUuid", "repo": "github.com/openmrs/openmrs-core" } },
    { "id": "refs", "tool": "find_symbol_references", "args": { "symbol": "getPatientByUuid", "repo": "github.com/openmrs/openmrs-module-fhir2" } },
    { "id": "refs-none", "tool": "find_symbol_references", "args": { "symbol": "zzzNope", "repo": "github.com/openmrs/openmrs-core" } },
    { "id": "defs-norepo", "tool": "find_symbol_definitions", "args": { "symbol": "x", "repo": "github.com/openmrs/nope" } },

    { "id": "models", "tool": "list_language_models", "args": {} },
    { "id": "bad-args", "tool": "read_file", "args": { "repo": "github.com/openmrs/openmrs-core" } }
  ]
}
