data: {"type":"tool-output-available","toolCallId":"call-bbe040df-e2aa-47be-b438-991bf54d0a00","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-common-lib/src/visit/visit-mutations.ts</path>\n<url>undefined</url>\n<content>\n1: import { useCallback } from 'react';\n2: import { useSWRConfig } from 'swr';\n3: import { useVisit, type Visit, restBaseUrl } from '@openmrs/esm-framework';\n4: import { usePatientChartStore } from '../store/patient-chart-store';\n5: \n6: export interface VisitMutationOptions {\n7:   encounters?: boolean;\n8:   notes?: boolean;\n9:   orders?: boolean;\n10:   observations?: boolean;\n11: }\n12: \n13: /**\n14:  * Hook providing optimistic update utilities for visit-related data.\n15:  * This hook helps reduce the number of network requests by updating SWR caches directly\n16:  * instead of triggering full revalidations across all visit-related hooks.\n17:  *\n18:  * @param patientUuid The UUID of the patient\n19:  * @returns Object containing optimistic update functions\n20:  */\n21: export function useOptimisticVisitMutations(patientUuid: string) {\n22:   const { mutate } = useSWRConfig();\n23:   const { visitContext, mutateVisitContext } = usePatientChartStore(patientUuid);\n24: \n25:   /**\n26:    * Optimistically updates visit data in SWR caches without triggering network requests.\n27:    * Updates both the current visit cache and visit list caches.\n28:    */\n29:   const updateVisitOptimistically = useCallback(\n30:     (visitUuid: string, updates: Partial<Visit>) => {\n31:       // Update current visit SWR cache if it matches\n32:       if (visitContext?.uuid === visitUuid) {\n33:         mutateVisitContext?.();\n34:       }\n35: \n36:       // Update visit lists across all hooks using regex pattern matching\n37:       const visitListPattern = new RegExp(`${restBaseUrl}/visit\\\\?patient=${patientUuid}`);\n38: \n39:       mutate(\n40:         visitListPattern,\n41:         (current: any) => {\n42:           if (!current?.data?.results) return current;\n43:           return {\n44:             ...current,\n45:             data: {\n46:               ...current.data,\n47:               results: current.data.results.map((visit: Visit) =>\n48:                 visit.uuid === visitUuid ? { ...visit, ...updates } : visit,\n49:               ),\n50:             },\n51:           };\n52:         },\n53:         false, // Don't revalidate\n54:       );\n55:     },\n56:     [visitContext, mutateVisitContext, mutate, patientUuid],\n57:   );\n58: \n59:   /**\n60:    * Optimistically removes a visit from SWR caches without triggering network requests.\n61:    * Removes from visit lists and revalidates current visit if the deleted visit was current.\n62:    */\n63:   const removeVisitOptimistically = useCallback(\n64:     (visitUuid: string) => {\n65:       // Remove from all visit list caches\n66:       const visitListPattern = new RegExp(`${restBaseUrl}/visit\\\\?patient=${patientUuid}`);\n67: \n68:       mutate(\n69:         visitListPattern,\n70:         (current: any) => {\n71:           if (!current?.data?.results) return current;\n72:           return {\n73:             ...current,\n74:             data: {\n75:               ...current.data,\n76:               results: current.data.results.filter((visit: Visit) => visit.uuid !== visitUuid),\n77:             },\n78:           };\n79:         },\n80:         false, // Don't revalidate\n81:       );\n82: \n83:       // If deleted visit was current, revalidate current visit to get new state\n84:       if (visitContext?.uuid === visitUuid) {\n85:         mutateVisitContext?.();\n86:       }\n87:     },\n88:     [visitContext, mutateVisitContext, mutate, patientUuid],\n89:   );\n90: \n91:   /**\n92:    * Optimistically adds a new visit to SWR caches without triggering network requests.\n93:    * Adds to visit lists and updates current visit cache if appropriate.\n94:    */\n95:   const addVisitOptimistically = useCallback(\n96:     (newVisit: Visit) => {\n97:       // Add to visit list caches\n98:       const visitListPattern = new RegExp(`${restBaseUrl}/visit\\\\?patient=${patientUuid}`);\n99: \n100:       mutate(\n101:         visitListPattern,\n102:         (current: any) => {\n103:           if (!current?.data?.results) return current;\n104:           return {\n105:             ...current,\n106:             data: {\n107:               ...current.data,\n108:               results: [newVisit, ...current.data.results],\n109:             },\n110:           };\n111:         },\n112:         false, // Don't revalidate\n113:       );\n114: \n115:       // If this is an active visit (no stopDatetime), update current visit cache\n116:       if (!newVisit.stopDatetime) {\n117:         mutate(\n118:           `${restBaseUrl}/visit?patient=${patientUuid}&v=custom`,\n119:           (current: any) => ({\n120:             ...current,\n121:             data: newVisit,\n122:           }),\n123:           false, // Don't revalidate\n124:         );\n125:       }\n126:     },\n127:     [mutate, patientUuid],\n128:   );\n129: \n130:   /**\n131:    * Selectively invalidates only specific visit-related data that cannot be optimistically updated.\n132:    * This replaces the global mutateVisit() pattern with targeted revalidation.\n133:    */\n134:   const invalidateVisitRelatedData = useCallback(\n135:     (options: VisitMutationOptions = {}) => {\n136:       const promises = [];\n137: \n138:       if (options.encounters) {\n139:         promises.push(mutate(new RegExp(`${restBaseUrl}/encounter\\\\?patient=${patientUuid}`)));\n140:       }\n141:       if (options.notes) {\n142:         promises.push(mutate(new RegExp(`${restBaseUrl}/encounter\\\\?patient=${patientUuid}.*obs=`)));\n143:       }\n144:       if (options.orders) {\n145:         promises.push(mutate(new RegExp(`${restBaseUrl}/order\\\\?patient=${patientUuid}`)));\n146:       }\n147:       if (options.observations) {\n148:         promises.push(mutate(new RegExp(`${restBaseUrl}/obs\\\\?patient=${patientUuid}`)));\n149:       }\n150: \n151:       return Promise.all(promises);\n152:     },\n153:     [mutate, patientUuid],\n154:   );\n155: \n156:   /**\n\n(Output capped at 5KB. Showing lines 1-156 of 194. Use offset=157 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-common-lib/src/visit/visit-mutations.ts","name":"visit-mutations.ts","revision":"HEAD"}]}}

