{
  "name": "@falkon/ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "NODE_OPTIONS=--conditions=react-server tsx --test tests/*.test.mts && pnpm run test:ui",
    "format": "prettier --write src tests *.ts *.mjs *.json",
    "format:check": "prettier --check src tests *.ts *.mjs *.json",
    "test:ui": "tsx --test tests/*.test.tsx"
  },
  "dependencies": {
