data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-afd79b6a053bd9a5","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>omod/src/main/java/org/openmrs/module/billing/web/rest/resource/PaymentResource.java</path>\n<url>undefined</url>\n<content>\n120: \t\tif (price instanceof Integer) {\n121: \t\t\tint rawAmount = (Integer) price;\n122: \t\t\tamount = Double.valueOf(rawAmount);\n123: \t\t\tinstance.setAmount(BigDecimal.valueOf(amount));\n124: \t\t} else {\n125: \t\t\tinstance.setAmount(BigDecimal.valueOf((Double) price));\n126: \t\t}\n127: \t}\n128: \t\n129: \t@PropertySetter(\"amountTendered\")\n130: \tpublic void setPaymentAmountTendered(Payment instance, Object price) {\n131: \t\t// TODO Conversion logic\n132: \t\tdouble amount;\n133: \t\tif (price instanceof Integer) {\n134: \t\t\tint rawAmount = (Integer) price;\n135: \t\t\tamount = Double.valueOf(rawAmount);\n136: \t\t\tinstance.setAmountTendered(BigDecimal.valueOf(amount));\n137: \t\t} else {\n138: \t\t\tinstance.setAmountTendered(BigDecimal.valueOf((Double) price));\n139: \t\t}\n140: \t}\n141: \t\n142: \t@PropertyGetter(\"dateCreated\")\n143: \tpublic Long getPaymentDate(Payment instance) {\n144: \t\treturn instance.getDateCreated().getTime();\n145: \t}\n146: \t\n147: \t@Override\n148: \tpublic Payment save(Payment delegate) {\n149: \t\tif (delegate.getCashier() == null) {\n150: \t\t\tProvider cashier = ProviderUtil.getCurrentProvider();\n151: \t\t\tif (cashier == null) {\n152: \t\t\t\tthrow new APIException(\n153: \t\t\t\t        \"The authenticated user is not associated with a Provider and cannot process payments.\");\n154: \t\t\t}\n155: \t\t\tdelegate.setCashier(cashier);\n156: \t\t}\n157: \t\t\n158: \t\tBillService service = Context.getService(BillService.class);\n159: \t\tBill bill = delegate.getBill();\n160: \t\tbill.addPayment(delegate);\n161: \t\tservice.saveBill(bill);\n162: \t\t\n163: \t\treturn delegate;\n164: \t}\n165: \t\n166: \t@Override\n167: \tprotected void delete(Payment delegate, String reason, RequestContext context) {\n168: \t\tdelete(delegate.getBill().getUuid(), delegate.getUuid(), reason, context);\n169: \t}\n170: \t\n171: \t@Override\n172: \tpublic void delete(String parentUniqueId, final String uuid, String reason, RequestContext context) {\n173: \t\tBillService service = Context.getService(BillService.class);\n174: \t\tBill bill = findBill(service, parentUniqueId);\n175: \t\tPayment payment = findPayment(bill, uuid);\n176: \t\t\n177: \t\tpayment.setVoided(true);\n178: \t\tpayment.setVoidReason(reason);\n179: \t\tpayment.setVoidedBy(Context.getAuthenticatedUser());\n\n(Showing lines 120-179 of 243. Use offset=180 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/PaymentResource.java","name":"PaymentResource.java","revision":"HEAD"}]}}

