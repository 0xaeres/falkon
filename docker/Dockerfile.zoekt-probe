# Probe image: a copy of docker/Dockerfile whose Zoekt stage builds upstream sourcegraph/zoekt
# at a pinned commit. Select it with SMOKE_DOCKERFILE=docker/Dockerfile.zoekt-probe.
#
# Upstream zoekt-git-index has no -tenant_id / -repo_id flags; it reads the repository id and
# tenant from git config (zoekt.repoid, zoekt.tenantID). The module path is
# github.com/sourcegraph/zoekt, so build from a checkout.
FROM golang:1.26-alpine AS zoekt
RUN apk add --no-cache git
ARG ZOEKT_REPO=https://github.com/sourcegraph/zoekt
ARG ZOEKT_REF=0e68f41329d9c37f46942d4731495fa05b07882a
RUN git clone "$ZOEKT_REPO" /src && git -C /src checkout "$ZOEKT_REF"
WORKDIR /src
RUN go build -o /out/ ./cmd/zoekt-webserver ./cmd/zoekt-git-index

FROM node:24-alpine
RUN apk add --no-cache git ctags && corepack enable
COPY --from=zoekt /out/ /usr/local/bin/
# Zoekt is Apache-2.0: ship its license text with the binaries.
COPY --from=zoekt /src/LICENSE /usr/share/licenses/zoekt/LICENSE
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile=false \
 && pnpm --filter @sbc/db generate \
 && pnpm --filter @sbc/web build
ENV NODE_ENV=production DATA_DIR=/data CTAGS_COMMAND=ctags
