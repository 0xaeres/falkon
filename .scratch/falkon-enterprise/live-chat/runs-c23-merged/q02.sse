data: {"type":"text-delta","id":"txt-0","delta":" is why the whole bill is re-read and re-m"}

data: {"type":"text-delta","id":"txt-0","delta":"utated for each payment, and why concurrent"}

data: {"type":"text-delta","id":"txt-0","delta":" payments on the same bill are worth watching"}

data: {"type":"text-delta","id":"txt-0","delta":". And `getByUniqueId` returns"}

data: {"type":"text-delta","id":"txt-0","delta":" `null` @file:{github.com"}

data: {"type":"text-delta","id":"txt-0","delta":"/openmrs/openmrs-module"}

data: {"type":"text-delta","id":"txt-0","delta":"-billing::omod/src/main/java/org/openm"}

data: {"type":"text-delta","id":"txt-0","delta":"rs/module/billing/web/rest/resource/P"}

data: {"type":"text-delta","id":"txt-0","delta":"aymentResource.java:204-207},"}

data: {"type":"text-delta","id":"txt-0","delta":" so a payment cannot be fetched by its own uuid"}

data: {"type":"text-delta","id":"txt-0","delta":"; you read payments through their parent bill."}

data: {"type":"text-end","id":"txt-0"}

data: {"type":"finish-step"}

