data: {"type":"tool-output-available","toolCallId":"call-e1c99ab0-5a12-4c17-b8bf-6123a1c09cb7","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/model/Bill.java</path>\n<url>undefined</url>\n<content>\n220: \tpublic void removeLineItem(BillLineItem item) {\n221: \t\tif (item != null) {\n222: \t\t\tif (this.lineItems != null) {\n223: \t\t\t\tthis.lineItems.remove(item);\n224: \t\t\t}\n225: \t\t}\n226: \t}\n227: \t\n228: \tpublic void addDiscount(BillDiscount discount) {\n229: \t\tif (discount == null) {\n230: \t\t\tthrow new NullPointerException(\"The discount to add must be defined.\");\n231: \t\t}\n232: \t\tif (this.discounts == null) {\n233: \t\t\tthis.discounts = new HashSet<>();\n234: \t\t}\n235: \t\tthis.discounts.add(discount);\n236: \t\tdiscount.setBill(this);\n237: \t}\n238: \t\n239: \tpublic void addPayment(Payment payment) {\n240: \t\tif (payment == null) {\n241: \t\t\tthrow new NullPointerException(\"The payment to add must be defined.\");\n242: \t\t}\n243: \t\t\n244: \t\tif (this.payments == null) {\n245: \t\t\tthis.payments = new HashSet<>();\n246: \t\t}\n247: \t\t\n248: \t\tthis.payments.add(payment);\n249: \t\tpayment.setBill(this);\n250: \t\t\n251: \t\tthis.synchronizeBillStatus();\n252: \t}\n253: \t\n254: \tpublic void synchronizeBillStatus() {\n255: \t\tBillStatus current = getStatus();\n256: \t\tif (current == BillStatus.REFUND_REQUESTED || current == BillStatus.REFUNDED\n257: \t\t        || current == BillStatus.PARTIALLY_REFUNDED) {\n258: \t\t\treturn;\n259: \t\t}\n260: \t\tif (this.getPayments() != null && !this.getPayments().isEmpty()\n261: \t\t        && getTotalPayments().compareTo(BigDecimal.ZERO) > 0) {\n262: \t\t\t// Approved discount exceeds the current bill total — likely a line item was voided\n263: \t\t\t// after approval. Stay POSTED so a human can void/reapply rather than letting any\n264: \t\t\t// non-zero payment silently flip the bill to PAID.\n265: \t\t\tif (hasDiscountDrift()) {\n266: \t\t\t\tlog.warn(\"Bill {} has discount drift (total={}, effectiveTotal={}); staying POSTED for manual review\",\n267: \t\t\t\t    getUuid(), getTotal(), effectiveTotal());\n268: \t\t\t\tthis.setStatus(BillStatus.POSTED);\n269: \t\t\t\treturn;\n270: \t\t\t}\n271: \t\t\tboolean billFullySettled = getTotalPayments().compareTo(getAmountAfterDiscount()) >= 0;\n272: \t\t\tif (billFullySettled) {\n273: \t\t\t\tthis.setStatus(BillStatus.PAID);\n274: \t\t\t\t// Update all non-voided and non-refunded status bill line items to PAID status\n275: \t\t\t\tif (this.lineItems != null) {\n276: \t\t\t\t\tfor (BillLineItem lineItem : this.lineItems) {\n277: \t\t\t\t\t\tif (lineItem != null && !lineItem.getVoided() && !isRefundStatus(lineItem.getStatus())) {\n278: \t\t\t\t\t\t\tlineItem.setStatus(BillLineItemStatus.PAID);\n279: \t\t\t\t\t\t}\n280: \t\t\t\t\t}\n281: \t\t\t\t}\n282: \t\t\t} else {\n283: \t\t\t\tthis.setStatus(BillStatus.POSTED);\n284: \t\t\t}\n285: \t\t}\n286: \t}\n287: \t\n288: \tpublic void removePayment(Payment payment) {\n289: \t\tif (payment != null && this.payments != null) {\n290: \t\t\tthis.payments.remove(payment);\n291: \t\t}\n292: \t}\n293: \t\n294: \tpublic void addAdjustedBy(Bill adjustedBill) {\n295: \t\tcheckAuthorizedToAdjust();\n296: \t\tif (adjustedBill == null) {\n297: \t\t\tthrow new NullPointerException(\"The adjusted bill to add must be defined.\");\n298: \t\t}\n299: \t\t\n\n(Showing lines 220-299 of 338. Use offset=300 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Bill.java","name":"Bill.java","revision":"HEAD"}]}}

