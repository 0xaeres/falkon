data: {"type":"data-evidence","data":{"id":11,"productId":"openmrs","generation":"g-b59a21","repository":"github.com/openmrs/openmrs-core","path":"api/src/main/java/org/openmrs/api/impl/EncounterServiceImpl.java","revision":"HEAD","startLine":215,"code":["\t\t// save the allergies","\t\tencounter.getAllergies().forEach(Context.getPatientService()::saveAllergy);","","\t\t// save the diagnoses","\t\tencounter.getDiagnoses().stream().forEach(diagnosis -> {","\t\t\tdiagnosis.setPatient(p);","\t\t\tdiagnosis.setEncounter(encounter);","\t\t});","\t\tencounter.getDiagnoses().forEach(Context.getDiagnosisService()::save);","","\t\treturn encounter;","\t}"],"highlightedLines":[218,219,220,221,222,223]}}

