data: {"type":"tool-output-available","toolCallId":"call-08851208-2104-43b6-a1bb-4b4dc99ab911","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/SequentialReceiptNumberGenerator.java</path>\n<url>undefined</url>\n<content>\n40: \t\tcheckDigitGenerator = new LuhnIdentifierValidator();\n41: \t}\n42: \t\n43: \t@Override\n44: \tpublic String getName() {\n45: \t\treturn \"Sequential Receipt Number Generator\";\n46: \t}\n47: \t\n48: \t@Override\n49: \tpublic String getDescription() {\n50: \t\treturn \"This receipt number generator provides support for grouped sequential receipt numbers.\";\n51: \t}\n52: \t\n53: \t@Override\n54: \tpublic String getConfigurationPage() {\n55: \t\treturn CashierWebConstants.SEQ_RECEIPT_NUMBER_GENERATOR_PAGE;\n56: \t}\n57: \t\n58: \t@Override\n59: \tpublic boolean isLoaded() {\n60: \t\treturn loaded;\n61: \t}\n62: \t\n63: \t/**\n64: \t * Loads the generator settings from the database.\n65: \t */\n66: \t@Override\n67: \tpublic void load() {\n68: \t\tmodel = service.getOnly();\n69: \t\tloaded = true;\n70: \t}\n71: \t\n72: \t/**\n73: \t * Generates a sequential receipt number for the specified bill.\n74: \t *\n75: \t * @param bill The bill to generate a new receipt number for.\n76: \t * @return The receipt number.\n77: \t * @should Create a new receipt number by grouping type\n78: \t * @should Create a new receipt number by sequence type\n79: \t * @should Create a new receipt number using the specified separator\n80: \t * @should Generate and set the correct check digit\n81: \t * @should Update sequence table with the new sequence by group\n82: \t * @should Throw NullPointerException if bill is null.\n83: \t */\n84: \t@Override\n85: \tpublic String generateNumber(Bill bill) {\n86: \t\tif (bill == null) {\n87: \t\t\tthrow new NullPointerException(\"The bill must be defined.\");\n88: \t\t}\n89: \t\t\n90: \t\tlog.debug(\"Generating receipt number for bill {}...\", bill.getUuid());\n91: \t\t\n92: \t\tString grouping = createGrouping(bill);\n93: \t\tString sequence = getSequence(grouping);\n94: \t\t\n95: \t\tString number = buildReceiptNumber(grouping, sequence);\n96: \t\tlog.debug(\"Generated receipt number '{}' for bill {}.\", number, bill.getUuid());\n97: \t\t\n98: \t\treturn number;\n99: \t}\n100: \t\n101: \tpublic String generateCheckDigit(String number) {\n102: \t\t// Remove the separator from the number\n103: \t\tString numberWithoutSep = number;\n104: \t\tif (!model.getSeparator().isEmpty()) {\n105: \t\t\tnumberWithoutSep = numberWithoutSep.replace(model.getSeparator(), \"\");\n106: \t\t}\n107: \t\t\n108: \t\t// Generate the check digit\n109: \t\tnumberWithoutSep = checkDigitGenerator.getValidIdentifier(numberWithoutSep);\n110: \t\t\n111: \t\t// Get the check digit from the end of the returned identifier\n112: \t\treturn numberWithoutSep.substring(numberWithoutSep.length() - 1);\n113: \t}\n114: \t\n115: \tprivate String createGrouping(Bill bill) {\n116: \t\tString result = \"\";\n117: \t\t\n118: \t\tswitch (model.getGroupingType()) {\n119: \t\t\tcase CASHIER:\n120: \t\t\t\tresult = model.getCashierPrefix() + bill.getCashier().getId();\n121: \t\t\t\tbreak;\n122: \t\t\tcase CASH_POINT:\n123: \t\t\t\tresult = model.getCashPointPrefix() + bill.getCashPoint().getId();\n124: \t\t\t\tbreak;\n125: \t\t\tcase CASHIER_AND_CASH_POINT:\n126: \t\t\t\tresult = model.getCashierPrefix() + bill.getCashier().getId() + model.getSeparator()\n127: \t\t\t\t        + model.getCashPointPrefix() + bill.getCashPoint().getId();\n128: \t\t\t\tbreak;\n129: \t\t\tdefault:\n130: \t\t\t\tbreak;\n131: \t\t}\n132: \t\t\n133: \t\treturn result;\n134: \t}\n135: \t\n136: \tprivate String getSequence(String grouping) {\n137: \t\t// Do not include the separator when getting the next sequence\n138: \t\tString groupingWithoutSep = grouping;\n139: \t\tif (!model.getSeparator().isEmpty()) {\n140: \t\t\tgroupingWithoutSep = groupingWithoutSep.replace(model.getSeparator(), \"\");\n141: \t\t}\n142: \t\t\n143: \t\tint sequenceNumber = service.reserveNextSequence(groupingWithoutSep);\n144: \t\t\n145: \t\t// Any changes to the date/time generation must be also applied to the unit tests that mock the date generation\n146: \t\tSimpleDateFormat format;\n147: \t\tCalendar cal = Calendar.getInstance();\n148: \t\tString sequence = String.format(\"%0\" + model.getSequencePadding() + \"d\", sequenceNumber);\n149: \t\tswitch (model.getSequenceType()) {\n150: \t\t\tcase DATE_COUNTER:\n151: \t\t\t\tformat = new SimpleDateFormat(\"yyMMdd\");\n152: \t\t\t\tsequence = format.format(new Date(cal.getTimeInMillis())) + sequence;\n153: \t\t\t\t\n154: \t\t\t\tbreak;\n155: \t\t\tcase DATE_TIME_COUNTER:\n156: \t\t\t\tformat = new SimpleDateFormat(\"yyMMddHHmmss\");\n157: \t\t\t\tsequence = format.format(new Date(cal.getTimeInMillis())) + sequence;\n158: \t\t\t\t\n159: \t\t\t\tbreak;\n160: \t\t\tdefault:\n161: \t\t\t\tbreak;\n162: \t\t}\n163: \t\t\n164: \t\treturn sequence;\n165: \t}\n166: \t\n167: \tprivate String buildReceiptNumber(String grouping, String sequence) {\n168: \t\tString number;\n169: \t\tif (StringUtils.isEmpty(grouping)) {\n\n(Showing lines 40-169 of 215. Use offset=170 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/SequentialReceiptNumberGenerator.java","name":"SequentialReceiptNumberGenerator.java","revision":"HEAD"}]}}

