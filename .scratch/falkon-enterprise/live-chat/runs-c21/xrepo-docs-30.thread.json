            "class LocaleCalendars {",
            "  #registry = new Map<string, CalendarIdentifier>();",
            "",
            "  constructor() {}",
            "",
            "  register(locale: string, calendar: CalendarIdentifier) {",
            "    this.#registry.set(locale, calendar);",
