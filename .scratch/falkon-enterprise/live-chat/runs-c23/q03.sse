data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillLineItemResource.java","name":"BillLineItemResource.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-be869c9c901befff","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillLineItemResource.java</path>\n<url>undefined</url>\n<content>\n100: \t@PropertySetter(value = \"price\")\n101: \tpublic void setPriceValue(BillLineItem instance, Object price) {\n102: \t\tif (price instanceof Double || price instanceof Integer) {\n103: \t\t\tdouble priceValue = ((Number) price).doubleValue();\n104: \t\t\tinstance.setPrice(BigDecimal.valueOf(priceValue));\n105: \t\t} else {\n106: \t\t\tthrow new IllegalArgumentException(\"Unsupported price type: \" + price.getClass().getName());\n107: \t\t}\n108: \t}\n109: \t\n110: \t@PropertySetter(value = \"priceName\")\n111: \tpublic void setPriceName(BillLineItem instance, String name) {\n112: \t\tinstance.setPriceName(name);\n113: \t}\n114: \t\n115: \t@PropertyGetter(value = \"priceName\")\n116: \tpublic String getPriceName(BillLineItem instance) {\n117: \t\tString itemName = instance.getPriceName();\n118: \t\treturn StringUtils.isNotBlank(itemName) ? itemName : \"\";\n119: \t}\n120: \t\n121: \t@PropertySetter(value = \"priceUuid\")\n122: \tpublic void setItemPrice(BillLineItem instance, String uuid) {\n123: \t\tStockManagementService itemDataService = Context.getService(StockManagementService.class);\n124: \t\tCashierItemPrice itemPrice = null;\n125: \t\tif (itemPrice != null) {\n126: \t\t\tinstance.setItemPrice(itemPrice);\n127: \t\t\tinstance.setPriceName(\"\");\n128: \t\t}\n129: \t}\n130: \t\n131: \t@PropertyGetter(value = \"priceUuid\")\n132: \tpublic String getItemPriceUuid(BillLineItem instance) {\n133: \t\ttry {\n134: \t\t\tCashierItemPrice itemPrice = instance.getItemPrice();\n135: \t\t\treturn \"\";\n136: \t\t}\n137: \t\tcatch (Exception e) {\n138: \t\t\tlog.warn(\"Price probably was deleted\", e);\n139: \t\t\treturn \"\";\n140: \t\t}\n141: \t}\n142: \t\n143: \t@Override\n144: \tpublic BillLineItem getByUniqueId(String uuid) {\n145: \t\tif (StringUtils.isEmpty(uuid)) {\n146: \t\t\treturn null;\n147: \t\t}\n148: \t\t\n149: \t\treturn Context.getService(BillLineItemService.class).getBillLineItemByUuid(uuid);\n150: \t}\n151: \t\n152: \t@Override\n153: \tpublic BillLineItem newDelegate() {\n154: \t\treturn new BillLineItem();\n155: \t}\n156: \t\n157: \t@Override\n158: \tpublic Class<IEntityDataService<BillLineItem>> getServiceClass() {\n159: \t\t// BillLineItemService doesn't implement IEntityDataService, so return null\n160: \t\t// Line items are managed through BillService, not directly\n161: \t\treturn null;\n162: \t}\n163: \t\n164: \t@Override\n165: \tpublic void delete(BillLineItem lineItem, String reason, RequestContext context) {\n166: \t\tif (StringUtils.isBlank(reason)) {\n167: \t\t\tthrow new IllegalArgumentException(\"Reason is required\");\n168: \t\t}\n169: \t\t\n\n(Showing lines 100-169 of 177. Use offset=170 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillLineItemResource.java","name":"BillLineItemResource.java","revision":"HEAD"}]}}

