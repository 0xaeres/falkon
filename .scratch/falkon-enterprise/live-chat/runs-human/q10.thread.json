          "code": [
            " * A scheduled task that automatically closes all open timesheets",
            " */",
            "@Slf4j",
            "public class AutoCloseTimesheetsTask extends AbstractTask {",
            "\t",
            "\t@Override",
            "\tpublic void execute() {",
            "\t\tif (!isExecuting) {",
            "\t\t\tif (log.isDebugEnabled()) {",
            "\t\t\t\tlog.debug(\"Starting Auto Close Timesheets Task...\");",
            "\t\t\t}",
            "\t\t\t",
            "\t\t\tstartExecuting();",
            "\t\t\t",
            "\t\t\ttry {",
            "\t\t\t\tITimesheetService timesheetService = Context.getService(ITimesheetService.class);",
            "\t\t\t\t",
            "\t\t\t\ttimesheetService.closeOpenTimesheets();",
            "\t\t\t}",
            "\t\t\tcatch (Exception e) {",
            "\t\t\t\tlog.error(\"Error while auto closing open timesheets:\", e);",
            "\t\t\t}",
            "\t\t\tfinally {",
            "\t\t\t\tstopExecuting();",
            "\t\t\t}",
            "\t\t}",
            "\t}",
            "}"
          ],
