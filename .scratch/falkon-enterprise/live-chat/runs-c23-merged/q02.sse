data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/invoice/payments/payments.component.tsx","name":"payments.component.tsx","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-fce84ae9-4d42-441b-84bc-aa20c8a54954","output":{"output":"<repo>github.com/openmrs/openmrs-esm-billing-app</repo>\n<path>src/invoice/payments/payments.component.tsx</path>\n<url>undefined</url>\n<content>\n1: import React from 'react';\n2: import { Button, Layer, Tile } from '@carbon/react';\n3: import { FormProvider, useForm, useWatch } from 'react-hook-form';\n4: import { useTranslation } from 'react-i18next';\n5: import { z } from 'zod';\n6: import { zodResolver } from '@hookform/resolvers/zod';\n7: import { CardHeader, navigate, showSnackbar, useConfig, useVisit } from '@openmrs/esm-framework';\n8: import { InvoiceBreakDown } from './invoice-breakdown/invoice-breakdown.component';\n9: import PaymentForm from './payment-form/payment-form.component';\n10: import PaymentHistory from './payment-history/payment-history.component';\n11: import { useSWRConfig } from 'swr';\n12: import { processBillPayment, patientPaymentStatusCacheKey } from '../../billing.resource';\n13: import { updateBillVisitAttribute } from './payment.resource';\n14: import { convertToCurrency } from '../../helpers';\n15: import { BillStatus, RefundStatus, type MappedBill } from '../../types';\n16: import styles from './payments.scss';\n17: \n18: type PaymentProps = {\n19:   bill: MappedBill;\n20:   mutate: () => void;\n21:   onFinalizeBill: () => void;\n22: };\n23: \n24: export type Payment = { method: string; amount: number | undefined; referenceCode?: number | string };\n25: \n26: export type PaymentFormValue = {\n27:   payment: Payment;\n28: };\n29: \n30: const Payments: React.FC<PaymentProps> = ({ bill, mutate, onFinalizeBill }) => {\n31:   const { t } = useTranslation();\n32:   const { mutate: swrMutate } = useSWRConfig();\n33:   const paymentSchema = z.object({\n34:     method: z.string().refine((value) => !!value, 'Payment method is required'),\n35:     amount: z\n36:       .number({\n37:         required_error: t('amountRequired', 'Amount is required'),\n38:         invalid_type_error: t('amountRequired', 'Amount is required'),\n39:       })\n40:       .positive({ message: t('amountMustBePositive', 'Amount must be greater than 0') })\n41:       .max((bill?.netAmount ?? 0) - (bill?.tenderedAmount ?? 0), {\n42:         message: t('paymentAmountCannotExceedAmountDue', 'Payment amount cannot exceed amount due'),\n43:       }),\n44:     referenceCode: z.union([z.number(), z.string()]).optional(),\n45:   });\n46: \n47:   const paymentFormSchema = z.object({ payment: paymentSchema });\n48:   const { currentVisit } = useVisit(bill?.patientUuid);\n49:   const { defaultCurrency } = useConfig();\n50:   const defaultPaymentValues: PaymentFormValue = {\n51:     payment: { method: '', amount: undefined, referenceCode: '' },\n52:   };\n53: \n54:   const methods = useForm<PaymentFormValue>({\n55:     mode: 'all',\n56:     defaultValues: defaultPaymentValues,\n57:     resolver: zodResolver(paymentFormSchema),\n58:   });\n59: \n60:   const formValues = useWatch({\n61:     name: 'payment',\n62:     control: methods.control,\n63:     defaultValue: defaultPaymentValues.payment,\n64:   });\n65: \n66:   const handleNavigateToBillingDashboard = () =>\n67:     navigate({\n68:       to: window.getOpenmrsSpaBase() + 'home/billing',\n69:     });\n70: \n71:   if (!bill) {\n72:     return null;\n73:   }\n74: \n75:   const refundTotal = (bill.refunds ?? [])\n76:     .filter((r) => r.status === RefundStatus.COMPLETED)\n77:     .reduce((sum, r) => sum + r.refundAmount, 0);\n78: \n79:   const amountDue = (bill.netAmount ?? 0) - (bill.tenderedAmount ?? 0);\n80:   const isPending = bill.status === BillStatus.PENDING;\n81: \n82:   const handleProcessPayment = async () => {\n83:     if (!formValues?.method || formValues.amount == null) {\n84:       return;\n85:     }\n86: \n87:     try {\n88:       await processBillPayment(\n89:         {\n90:           instanceType: formValues.method,\n91:           amountTendered: Number(formValues.amount),\n92:           amount: bill.totalAmount ?? 0,\n93:         },\n94:         bill.uuid,\n95:       );\n96:       showSnackbar({\n97:         title: t('billPayment', 'Bill payment'),\n98:         subtitle: t('paymentProcessedSuccessfully', 'Payment processed successfully'),\n99:         kind: 'success',\n100:       });\n101:       if (currentVisit) {\n102:         updateBillVisitAttribute(currentVisit);\n103:       }\n104:       methods.reset(defaultPaymentValues);\n105:       mutate();\n106:       swrMutate(patientPaymentStatusCacheKey(bill.patientUuid));\n107:     } catch (error) {\n108:       showSnackbar({\n109:         title: t('errorProcessingPayment', 'Error processing payment'),\n110:         kind: 'error',\n111:         subtitle: error?.message,\n112:       });\n113:     }\n114:   };\n115: \n116:   return (\n117:     <FormProvider {...methods}>\n118:       <div className={styles.wrapper}>\n119:         <div className={styles.paymentContainer}>\n120:           <CardHeader title={t('payments', 'Payments')}>\n121:             <span></span>\n122:           </CardHeader>\n123:           <div>\n124:             {isPending ? (\n125:               <div className={styles.pendingEmptyState}>\n126:                 <Layer>\n127:                   <Tile className={styles.pendingEmptyStateTile}>\n128:                     <p className={styles.pendingEmptyStateContent}>{t('billNotFinalized', 'Bill not finalized')}</p>\n129:                     <p className={styles.pendingEmptyStateHelper}>\n130:                       {t('finalizeBillToRecordPayment', 'Finalize this bill before recording a payment.')}\n131:                     </p>\n132:                     <Button className={styles.finalizeButton} kind=\"primary\" size=\"sm\" onClick={onFinalizeBill}>\n133:                       {t('finalizeBill', 'Finalize bill')}\n134:                     </Button>\n135:                   </Tile>\n136:                 </Layer>\n137:               </div>\n138:             ) : (\n139:               <>\n140:                 <PaymentHistory bill={bill} />\n\n(Output capped at 5KB. Showing lines 1-140 of 188. Use offset=141 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-billing-app","path":"src/invoice/payments/payments.component.tsx","name":"payments.component.tsx","revision":"HEAD"}]}}

