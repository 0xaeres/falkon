data: {"type":"tool-output-available","toolCallId":"call-eac6f01c-f146-4453-b5ba-dfee4f046329","output":{"output":"Found 6 definitions in 6 files\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-utils/src/get-locale.ts:\n  7: export function getLocale() {\n\n[github.com/openmrs/openmrs-esm-core] packages/tooling/storybook/mocks/esm-react-utils.ts:\n  148: export function getLocale() {\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-react-utils/mock.tsx:\n  144: export const getLocale = vi.fn(() => 'en');\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-utils/src/dates/date-util.ts:\n  165:   const locale_ = locale ?? getLocale();\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-react-utils/mock-jest.tsx:\n  139: export const getLocale = jest.fn().mockReturnValue('en');\n\n[github.com/openmrs/openmrs-esm-core] packages/framework/esm-framework/docs/functions/getLocale.md:\n  3: # Function: getLocale()","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-utils/src/get-locale.ts","name":"get-locale.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/tooling/storybook/mocks/esm-react-utils.ts","name":"esm-react-utils.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-react-utils/mock.tsx","name":"mock.tsx","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-utils/src/dates/date-util.ts","name":"date-util.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-react-utils/mock-jest.tsx","name":"mock-jest.tsx","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-framework/docs/functions/getLocale.md","name":"getLocale.md","revision":"HEAD"}]}}

