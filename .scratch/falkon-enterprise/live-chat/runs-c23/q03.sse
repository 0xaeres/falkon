data: {"type":"data-evidence","data":{"id":24,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/AbstractDefaultOrderBillingStrategy.java","revision":"HEAD","startLine":138,"code":["\t\treturn createBill(order.getPatient(), lineItemOpt.get(), order);","\t}","\t","\tprotected BillingResult createBill(Patient patient, BillLineItem lineItem, Order order) {","\t\tProvider cashier = resolveCashier(order);","\t\tif (cashier == null) {","\t\t\tlog.error(\"Cannot resolve cashier for order: {}\", order.getUuid());","\t\t\treturn BillingResult.skipped(\"Cannot resolve cashier\");","\t\t}","\t\t","\t\tCashPoint cashPoint = resolveCashPoint();","\t\tif (cashPoint == null) {","\t\t\tlog.error(\"Cannot resolve cash point for order: {}\", order.getUuid());","\t\t\treturn BillingResult.skipped(\"Cannot resolve cash point\");","\t\t}","\t\t","\t\tBill bill = new Bill();","\t\tbill.setPatient(patient);","\t\tbill.setStatus(BillStatus.PENDING);","\t\tbill.setCashier(cashier);","\t\tbill.setCashPoint(cashPoint);","\t\tif (order.getEncounter() != null) {","\t\t\tbill.setVisit(order.getEncounter().getVisit());","\t\t}","\t\tbill.addLineItem(lineItem);","\t\t","\t\tBill savedBill = billService.saveBill(bill);","\t\treturn BillingResult.created(savedBill);","\t}","\t","\t// resolveCashier() and resolveCashPoint() are inherited from the interface","\t// and must be implemented by concrete strategy classes."],"highlightedLines":[141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,161,162,163,164,165,166]}}

data: {"type":"data-evidence","data":{"id":25,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/AbstractDefaultOrderBillingStrategy.java","revision":"HEAD","startLine":172,"code":["\t * Create a bill line item with the common fields populated. Subclasses should set the type-specific","\t * fields (item or billable service) on the returned line item.","\t */","\tprotected BillLineItem createLineItem(BigDecimal price, int quantity, BillLineItemStatus paymentStatus, Order order) {","\t\tBillLineItem lineItem = new BillLineItem();","\t\tlineItem.setPrice(price);","\t\tlineItem.setQuantity(quantity);","\t\tlineItem.setStatus(paymentStatus);","\t\tlineItem.setLineItemOrder(0);","\t\tlineItem.setOrder(order);","\t\treturn lineItem;","\t}","\t","\tprotected boolean checkIfOrderIsExempted(Order order, ExemptionType exemptionType) {","\t\tif (order == null || order.getConcept() == null) {"],"highlightedLines":[175,176,177,178,179,180,181,182,183]}}

