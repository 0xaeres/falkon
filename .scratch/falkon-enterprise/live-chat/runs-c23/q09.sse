data: {"type":"data-evidence","data":{"id":7,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"omod/src/main/java/org/openmrs/module/billing/web/rest/resource/BillResource.java","revision":"b52412a0a7925469183c2590937d6720228f9ec6","startLine":100,"code":["\t@PropertySetter(\"payments\")","\tpublic void setBillPayments(Bill instance, Set<Payment> payments) {","\t\tif (instance.getPayments() == null) {","\t\t\tinstance.setPayments(new HashSet<Payment>(payments.size()));","\t\t}","\t\tBaseRestDataResource.syncCollection(instance.getPayments(), payments);","\t\tProvider cashier = null;","\t\tfor (Payment payment : instance.getPayments()) {","\t\t\tif (payment.getId() == null && payment.getCashier() == null) {","\t\t\t\tif (cashier == null) {","\t\t\t\t\tcashier = getCurrentCashier();","\t\t\t\t\tif (cashier == null) {","\t\t\t\t\t\tthrow new RestClientException(\"The current user (\"","\t\t\t\t\t\t        + Context.getAuthenticatedUser().getUsername() + \") is not a provider\");","\t\t\t\t\t}","\t\t\t\t}","\t\t\t\tpayment.setCashier(cashier);","\t\t\t}","\t\t\tinstance.addPayment(payment);","\t\t}","\t}","\t","\t@PropertySetter(\"billAdjusted\")","\tpublic void setBillAdjusted(Bill instance, Bill billAdjusted) {","\t\tbillAdjusted.addAdjustedBy(instance);"],"highlightedLines":[103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121]}}

