data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-common-lib/src/visit/revalidation-utils.ts","name":"revalidation-utils.ts","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-ec4cec5e-4be6-4150-8ac5-53f3c797d881","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-common-lib/src/visit/revalidation-utils.ts</path>\n<url>undefined</url>\n<content>\n1: import type { KeyedMutator } from 'swr';\n2: import { restBaseUrl } from '@openmrs/esm-framework';\n3: \n4: /**\n5:  * Invalidates visit history table data without triggering global visit revalidation cascade.\n6:  *\n7:  * This function provides surgical SWR cache invalidation for visit operations. It targets only\n8:  * the paginated visit data used by the visit history table, avoiding unnecessary revalidation\n9:  * of the 28+ components that use current visit data via the useVisit hook.\n10:  *\n11:  * The implementation uses URL pattern matching to discriminate between:\n12:  * - Current visit keys (includeInactive=false) - these are NOT invalidated\n13:  * - Visit history keys (no includeInactive param, or pagination params) - these ARE invalidated\n14:  *\n15:  * Cache key patterns:\n16:  * - Current visit: /visit?patient=123&v=custom&includeInactive=false\n17:  * - Visit history: /visit?patient=123&v=custom:(uuid,location...)&limit=10&startIndex=0&totalCount=true\n18:  *\n19:  * This approach eliminates the 13+ cascade revalidation requests that were previously triggered\n20:  * by global mutateVisit() calls, reducing network traffic and improving performance.\n21:  *\n22:  * @param mutate - SWR mutate function from useSWRConfig()\n23:  * @param patientUuid - Patient UUID to target visit data for\n24:  *\n25:  * @example\n26:  * ```typescript\n27:  * import { useSWRConfig } from 'swr';\n28:  * import { invalidateVisitHistory } from '@openmrs/esm-patient-common-lib';\n29:  *\n30:  * function MyComponent({ patientUuid }) {\n31:  *   const { mutate } = useSWRConfig();\n32:  *\n33:  *   const handleVisitUpdate = async () => {\n34:  *     // Perform visit operation...\n35:  *     await updateVisit(visitData);\n36:  *\n37:  *     // Invalidate only visit history table, not current visit components\n38:  *     invalidateVisitHistory(mutate, patientUuid);\n39:  *   };\n40:  * }\n41:  * ```\n42:  */\n43: export function invalidateVisitHistory(mutate: KeyedMutator<unknown>, patientUuid: string): void {\n44:   mutate((key) => {\n45:     if (typeof key === 'string' && key.includes(`${restBaseUrl}/visit?patient=${patientUuid}`)) {\n46:       // Current visit keys have includeInactive=false\n47:       const isCurrentVisitKey = key.includes('includeInactive=false');\n48: \n49:       // Visit history keys typically have pagination parameters or no includeInactive parameter\n50:       const hasHistoryParams = key.includes('limit=') || key.includes('startIndex=') || key.includes('totalCount=');\n51:       const hasNoIncludeInactive = !key.includes('includeInactive');\n52: \n53:       // Invalidate if it's clearly a history key OR if it doesn't have includeInactive=false\n54:       // This ensures we target visit history while preserving current visit cache\n55:       return !isCurrentVisitKey && (hasHistoryParams || hasNoIncludeInactive);\n56:     }\n57:     return false;\n58:   });\n59: }\n60: \n61: /**\n62:  * Invalidates visit-related encounter data for a specific patient.\n63:  *\n64:  * This function is useful when operations create or modify encounters within visits,\n65:  * requiring the encounter lists and related data to be refreshed.\n66:  *\n67:  * @param mutate - SWR mutate function from useSWRConfig()\n68:  * @param patientUuid - Patient UUID to target encounter data for\n69:  *\n70:  * @example\n71:  * ```typescript\n72:  * // After creating a visit note (which creates an encounter)\n73:  * invalidatePatientEncounters(mutate, patientUuid);\n74:  * ```\n75:  */\n76: export function invalidatePatientEncounters(mutate: KeyedMutator<unknown>, patientUuid: string): void {\n77:   mutate((key) => {\n78:     return (\n79:       typeof key === 'string' && key.includes(`${restBaseUrl}/encounter`) && key.includes(`patient=${patientUuid}`)\n80:     );\n81:   });\n82: }\n83: \n84: /**\n85:  * Invalidates only the current (active) visit cache for a specific patient.\n86:  *\n87:  * This refreshes components using useVisit without triggering the visit revalidation cascade.\n88:  *\n89:  * @param mutate - SWR mutate function from useSWRConfig()\n90:  * @param patientUuid - Patient UUID to target current visit data for\n91:  */\n92: export function invalidateCurrentVisit(mutate: KeyedMutator<unknown>, patientUuid: string): void {\n93:   mutate((key) => {\n94:     return (\n95:       typeof key === 'string' &&\n96:       key.includes(`${restBaseUrl}/visit?patient=${patientUuid}`) &&\n97:       key.includes('includeInactive=false')\n98:     );\n99:   });\n100: }\n101: \n102: /**\n103:  * Combination utility that invalidates both visit history and encounter data.\n104:  *\n105:  * This is commonly needed when operations affect both visit structure and encounter content,\n106:  * such as form submissions, visit note creation, or encounter deletion.\n107:  *\n108:  * @param mutate - SWR mutate function from useSWRConfig()\n109:  * @param patientUuid - Patient UUID to target data for\n110:  *\n111:  * @example\n112:  * ```typescript\n113:  * // After form submission that creates encounters within a visit\n114:  * invalidateVisitAndEncounterData(mutate, patientUuid);\n115:  * ```\n116:  */\n117: export function invalidateVisitAndEncounterData(mutate: KeyedMutator<unknown>, patientUuid: string): void {\n118:   invalidateVisitHistory(mutate, patientUuid);\n119:   invalidatePatientEncounters(mutate, patientUuid);\n120: }\n121: \n122: /**\n123:  * Invalidates a visit fetched by URL /visit/<uuid>\n124:  * @param mutate - SWR mutate function from useSWRConfig()\n125:  * @param visitUuid - UUID of the visit to invalidate. Does nothing if undefined.\n126:  */\n127: export function invalidateVisitByUuid(mutate: KeyedMutator<unknown>, visitUuid: string | undefined) {\n128:   if (!visitUuid) {\n\n(Output capped at 5KB. Showing lines 1-128 of 134. Use offset=129 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-common-lib/src/visit/revalidation-utils.ts","name":"revalidation-utils.ts","revision":"HEAD"}]}}

