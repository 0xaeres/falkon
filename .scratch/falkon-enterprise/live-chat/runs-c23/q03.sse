data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/AbstractDefaultOrderBillingStrategy.java","name":"AbstractDefaultOrderBillingStrategy.java","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-b29a6f634e6713a6","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/billing/impl/AbstractDefaultOrderBillingStrategy.java</path>\n<url>undefined</url>\n<content>\n138: \t\treturn createBill(order.getPatient(), lineItemOpt.get(), order);\n139: \t}\n140: \t\n141: \tprotected BillingResult createBill(Patient patient, BillLineItem lineItem, Order order) {\n142: \t\tProvider cashier = resolveCashier(order);\n143: \t\tif (cashier == null) {\n144: \t\t\tlog.error(\"Cannot resolve cashier for order: {}\", order.getUuid());\n145: \t\t\treturn BillingResult.skipped(\"Cannot resolve cashier\");\n146: \t\t}\n147: \t\t\n148: \t\tCashPoint cashPoint = resolveCashPoint();\n149: \t\tif (cashPoint == null) {\n150: \t\t\tlog.error(\"Cannot resolve cash point for order: {}\", order.getUuid());\n151: \t\t\treturn BillingResult.skipped(\"Cannot resolve cash point\");\n152: \t\t}\n153: \t\t\n154: \t\tBill bill = new Bill();\n155: \t\tbill.setPatient(patient);\n156: \t\tbill.setStatus(BillStatus.PENDING);\n157: \t\tbill.setCashier(cashier);\n158: \t\tbill.setCashPoint(cashPoint);\n159: \t\tif (order.getEncounter() != null) {\n160: \t\t\tbill.setVisit(order.getEncounter().getVisit());\n161: \t\t}\n162: \t\tbill.addLineItem(lineItem);\n163: \t\t\n164: \t\tBill savedBill = billService.saveBill(bill);\n165: \t\treturn BillingResult.created(savedBill);\n166: \t}\n167: \t\n168: \t// resolveCashier() and resolveCashPoint() are inherited from the interface\n169: \t// and must be implemented by concrete strategy classes.\n170: \t\n171: \t/**\n172: \t * Create a bill line item with the common fields populated. Subclasses should set the type-specific\n173: \t * fields (item or billable service) on the returned line item.\n174: \t */\n175: \tprotected BillLineItem createLineItem(BigDecimal price, int quantity, BillLineItemStatus paymentStatus, Order order) {\n176: \t\tBillLineItem lineItem = new BillLineItem();\n177: \t\tlineItem.setPrice(price);\n178: \t\tlineItem.setQuantity(quantity);\n179: \t\tlineItem.setStatus(paymentStatus);\n180: \t\tlineItem.setLineItemOrder(0);\n181: \t\tlineItem.setOrder(order);\n182: \t\treturn lineItem;\n183: \t}\n184: \t\n185: \tprotected boolean checkIfOrderIsExempted(Order order, ExemptionType exemptionType) {\n186: \t\tif (order == null || order.getConcept() == null) {\n187: \t\t\treturn false;\n188: \t\t}\n189: \t\t\n190: \t\tList<BillExemption> exemptions = billExemptionService.getExemptionsByConcept(order.getConcept(), exemptionType,\n191: \t\t    false);\n192: \t\tif (exemptions == null || exemptions.isEmpty()) {\n193: \t\t\treturn false;\n194: \t\t}\n195: \t\t\n196: \t\tMap<String, Object> variables = buildExemptionVariables(order);\n197: \t\t\n198: \t\tfor (BillExemption exemption : exemptions) {\n199: \t\t\tif (exemptionRuleEngine.isExemptionApplicable(exemption, variables)) {\n200: \t\t\t\treturn true;\n201: \t\t\t}\n202: \t\t}\n203: \t\t\n204: \t\treturn false;\n205: \t}\n206: \t\n207: \tprotected Map<String, Object> buildExemptionVariables(Order order) {\n208: \t\tMap<String, Object> variables = new HashMap<>();\n209: \t\t\n210: \t\tPatient patient = order.getPatient();\n211: \t\tvariables.put(\"patient\", patient);\n212: \t\tif (patient != null) {\n213: \t\t\tvariables.put(\"patientAge\", patient.getAge());\n214: \t\t}\n215: \t\t\n216: \t\tMap<String, Object> orderData = new HashMap<>();\n217: \t\torderData.put(\"uuid\", order.getUuid());\n218: \t\tif (order.getConcept() != null) {\n219: \t\t\torderData.put(\"conceptId\", order.getConcept().getConceptId());\n220: \t\t}\n221: \t\tvariables.put(\"order\", orderData);\n222: \t\t\n223: \t\tList<PatientProgram> programs = programWorkflowService.getPatientPrograms(patient, null, null, null, new Date(),\n224: \t\t    null, false);\n225: \t\tList<String> activePrograms = programs.stream().filter(PatientProgram::getActive)\n226: \t\t        .map(pp -> pp.getProgram().getName()).collect(Collectors.toList());\n227: \t\tvariables.put(\"activePrograms\", activePrograms);\n228: \t\t\n229: \t\treturn variables;\n230: \t}\n231: }\n232: \n\n(End of file - 232 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/AbstractDefaultOrderBillingStrategy.java","name":"AbstractDefaultOrderBillingStrategy.java","revision":"HEAD"}]}}

