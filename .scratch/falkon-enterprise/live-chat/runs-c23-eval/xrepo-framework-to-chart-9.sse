data: {"type":"tool-output-available","toolCallId":"call-0d9e4c89-0c4e-48ce-ada8-131875d82792","output":{"output":"Found 32 matches in 5 files\n\n[github.com/openmrs/openmrs-esm-patient-chart] packages/esm-patient-common-lib/src/visit/revalidation-utils.ts:\n  12:  * - Current visit keys (includeInactive=false) - these are NOT invalidated\n  16:  * - Current visit: /visit?patient=123&v=custom&includeInactive=false\n  17:  * - Visit history: /visit?patient=123&v=custom:(uuid,location...)&limit=10&startIndex=0&totalCount=true\n  46:       // Current visit keys have includeInactive=false\n  47:       const isCurrentVisitKey = key.includes('includeInactive=false');\n  53:       // Invalidate if it's clearly a history key OR if it doesn't have includeInactive=false\n  97:       key.includes('includeInactive=false')\n  45:     if (typeof key === 'string' && key.includes(`${restBaseUrl}/visit?patient=${patientUuid}`)) {\n  96:       key.includes(`${restBaseUrl}/visit?patient=${patientUuid}`) &&\n\n[github.com/openmrs/openmrs-esm-patient-chart] packages/esm-patient-common-lib/src/visit/revalidation-utils.test.ts:\n  28:           '/ws/rest/v1/visit?patient=test-patient-123&v=custom:(uuid,location)&limit=10&startIndex=0&totalCount=true',\n  33:       expect(matcherFn('/ws/rest/v1/visit?patient=test-patient-123&v=custom:(uuid,location)')).toBe(true);\n  35:       // Should NOT invalidate current visit keys (with includeInactive=false)\n  36:       expect(matcherFn('/ws/rest/v1/visit?patient=test-patient-123&v=custom&includeInactive=false')).toBe(false);\n  39:       expect(matcherFn('/ws/rest/v1/visit?patient=other-patient&v=custom')).toBe(false);\n  45:       expect(matcherFn({ url: '/ws/rest/v1/visit?patient=test-patient-123' })).toBe(false);\n  72:       expect(matcherFn('/ws/rest/v1/visit?patient=test-patient-123')).toBe(false);\n  95:       expect(visitMatcherFn('/ws/rest/v1/visit?patient=test-patient-123&v=custom&limit=10')).toBe(true);\n  113:       // Should match current visit key (includeInactive=false)\n  114:       expect(matcherFn('/ws/rest/v1/visit?patient=test-patient-123&v=custom&includeInactive=false')).toBe(true);\n  117:       expect(matcherFn('/ws/rest/v1/visit?patient=test-patient-123&v=custom&includeInactive=true')).toBe(false);\n  119:         matcherFn('/ws/rest/v1/visit?patient=test-patient-123&v=custom&limit=10&startIndex=0&totalCount=true'),\n  146:       expect(matcherFn('/ws/rest/v1/visit?patient=test-patient-123&v=custom&includeInactive=false')).toBe(false);\n\n[github.com/openmrs/openmrs-esm-patient-chart] packages/esm-form-entry-app/src/app/openmrs-api/visit-resource.service.ts:\n  23:     url += '/' + uuid + '?v=custom:(uuid,startDatetime,stopDatetime)&includeInactive=false';\n\n[github.com/openmrs/openmrs-esm-patient-chart] packages/esm-patient-common-lib/src/visit/visit-mutations.ts:\n  118:           `${restBaseUrl}/visit?patient=${patientUuid}&v=custom`,\n  162:     return mutate(`${restBaseUrl}/visit?patient=${patientUuid}&v=custom`);\n  171:     mutate(`${restBaseUrl}/visit?patient=${patientUuid}&v=custom`);\n\n[github.com/openmrs/openmrs-esm-patient-chart] packages/esm-patient-chart-app/src/visit/visits-widget/visit.resource.tsx:\n  19:     `${window.openmrsBase}/${restBaseUrl}/visit?patient=${patientUuid}&v=${rep}`,\n  37:     `${window.openmrsBase}/${restBaseUrl}/visit?patient=${patientUuid}&v=${customRepresentation}`,","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-common-lib/src/visit/revalidation-utils.ts","name":"revalidation-utils.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-common-lib/src/visit/revalidation-utils.test.ts","name":"revalidation-utils.test.ts","revision":"HEAD"},{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-form-entry-app/src/app/openmrs-api/visit-resource.service.ts","name":"visit-resource.servic