    "@tailwindcss/postcss": "^4.3.3",
    "ai": "6.0.167",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.55.0",
    "mermaid": "^12.2.0",
    "motion": "^14.6.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "postcss": "^8.5.31",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "remark-gfm": "^4.0.1",
