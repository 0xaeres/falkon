data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-aba790b390692a49","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/billing/impl/TestOrderBillingStrategy.java</path>\n<url>undefined</url>\n<content>\n1: /*\n2:  * This Source Code Form is subject to the terms of the Mozilla Public License,\n3:  * v. 2.0. If a copy of the MPL was not distributed with this file, You can\n4:  * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under\n5:  * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.\n6:  *\n7:  * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS\n8:  * graphic logo is a trademark of OpenMRS Inc.\n9:  */\n10: package org.openmrs.module.billing.api.billing.impl;\n11: \n12: import java.math.BigDecimal;\n13: import java.util.List;\n14: import java.util.Optional;\n15: \n16: import lombok.Setter;\n17: import lombok.extern.slf4j.Slf4j;\n18: import org.openmrs.Order;\n19: import org.openmrs.Provider;\n20: import org.openmrs.TestOrder;\n21: import org.openmrs.module.billing.api.model.BillLineItemStatus;\n22: import org.openmrs.module.billing.api.model.CashPoint;\n23: import org.openmrs.module.billing.api.BillableServiceService;\n24: import org.openmrs.module.billing.api.ItemPriceService;\n25: import org.openmrs.module.billing.api.model.BillLineItem;\n26: import org.openmrs.module.billing.api.model.BillStatus;\n27: import org.openmrs.module.billing.api.model.BillableService;\n28: import org.openmrs.module.billing.api.model.BillableServiceStatus;\n29: import org.openmrs.module.billing.api.model.CashierItemPrice;\n30: import org.openmrs.module.billing.api.model.ExemptionType;\n31: import org.openmrs.module.billing.api.search.BillableServiceSearch;\n32: import org.springframework.beans.factory.annotation.Autowired;\n33: \n34: /**\n35:  * Default billing strategy for {@link TestOrder}s. Creates a bill line item based on the billable\n36:  * service linked to the test order's concept.\n37:  */\n38: @Slf4j\n39: @Setter(onMethod_ = @Autowired)\n40: public class TestOrderBillingStrategy extends AbstractDefaultOrderBillingStrategy {\n41: \t\n42: \tprivate BillableServiceService billableServiceService;\n43: \t\n44: \tprivate ItemPriceService itemPriceService;\n45: \t\n46: \t@Override\n47: \tprotected boolean supportsOrder(Order order) {\n48: \t\treturn order instanceof TestOrder;\n49: \t}\n50: \t\n51: \t@Override\n52: \tprotected Optional<BillLineItem> createBillLineItem(Order order) {\n53: \t\tTestOrder testOrder = (TestOrder) order;\n54: \t\t\n55: \t\tif (testOrder.getConcept() == null) {\n56: \t\t\tlog.warn(\"TestOrder {} has no concept set, cannot generate bill\", order.getUuid());\n57: \t\t\treturn Optional.empty();\n58: \t\t}\n59: \t\t\n60: \t\tBillableServiceSearch searchTemplate = new BillableServiceSearch();\n61: \t\tsearchTemplate.setConceptUuid(testOrder.getConcept().getUuid());\n62: \t\tsearchTemplate.setServiceStatus(BillableServiceStatus.ENABLED);\n63: \t\t\n64: \t\tList<BillableService> searchResult = billableServiceService.getBillableServices(searchTemplate, null);\n65: \t\tif (searchResult.isEmpty()) {\n66: \t\t\tlog.debug(\"No billable service found for concept: {}\", testOrder.getConcept().getUuid());\n67: \t\t\treturn Optional.empty();\n68: \t\t}\n69: \t\t\n70: \t\tBillableService billableService = searchResult.get(0);\n71: \t\tBillLineItemStatus lineItemStatus = checkIfOrderIsExempted(order, ExemptionType.SERVICE)\n72: \t\t        ? BillLineItemStatus.EXEMPTED\n73: \t\t        : BillLineItemStatus.PENDING;\n74: \t\t\n75: \t\tBillLineItem lineItem = createLineItem(resolvePrice(billableService), 1, lineItemStatus, order);\n76: \t\tlineItem.setBillableService(billableService);\n77: \t\treturn Optional.of(lineItem);\n78: \t}\n79: \t\n80: \tprivate BigDecimal resolvePrice(BillableService billableService) {\n81: \t\tList<CashierItemPrice> itemPrices = itemPriceService.getServicePrice(billableService);\n82: \t\tif (!itemPrices.isEmpty()) {\n83: \t\t\treturn itemPrices.get(0).getPrice();\n84: \t\t}\n85: \t\treturn BigDecimal.ZERO;\n86: \t}\n87: \t\n88: \t@Override\n89: \tpublic Provider resolveCashier(Order order) {\n90: \t\treturn order.getOrderer();\n91: \t}\n92: \t\n93: \t@Override\n94: \tpublic CashPoint resolveCashPoint() {\n95: \t\tList<CashPoint> cashPoints = cashPointService.getAllCashPoints(false);\n96: \t\treturn cashPoints.isEmpty() ? null : cashPoints.get(0);\n97: \t}\n98: }\n99: \n\n(End of file - 99 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/billing/impl/TestOrderBillingStrategy.java","name":"TestOrderBillingStrategy.java","revision":"HEAD"}]}}

