data: {"type":"data-evidence","data":{"id":29,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Bill.java","revision":"HEAD","startLine":135,"code":["\t\treturn total;","\t}","\t","\tpublic BigDecimal getTotal() {","\t\tBigDecimal total = BigDecimal.ZERO;","\t\t","\t\tList<BillLineItem> lineItems = getLineItems();","\t\tif (lineItems != null) {","\t\t\tfor (BillLineItem line : lineItems) {","\t\t\t\tif (line != null && !line.getVoided()) {","\t\t\t\t\ttotal = total.add(line.getTotal());","\t\t\t\t}","\t\t\t}","\t\t}","\t\t","\t\treturn total;","\t}","\t","\tpublic BigDecimal getTotalPayments() {","\t\tBigDecimal total = BigDecimal.ZERO;"],"highlightedLines":[138,139,140,141,142,143,144,145,146,147,148,149,150,151]}}

data: {"type":"data-evidence","data":{"id":30,"productId":"openmrs","generation":"g-ab363e","repository":"github.com/openmrs/openmrs-module-billing","path":"api/src/main/java/org/openmrs/module/billing/api/model/Bill.java","revision":"HEAD","startLine":150,"code":["\t\treturn total;","\t}","\t","\tpublic BigDecimal getTotalPayments() {","\t\tBigDecimal total = BigDecimal.ZERO;","\t\t","\t\tSet<Payment> payments = getPayments();","\t\tif (payments != null) {","\t\t\tfor (Payment payment : payments) {","\t\t\t\tif (payment != null && !payment.getVoided()) {","\t\t\t\t\ttotal = total.add(payment.getAmountTendered());","\t\t\t\t}","\t\t\t}","\t\t}","\t\t","\t\treturn total;","\t}","\t","\t@Override","\tpublic Integer getId() {"],"highlightedLines":[153,154,155,156,157,158,159,160,161,162,163,164,165,166]}}

