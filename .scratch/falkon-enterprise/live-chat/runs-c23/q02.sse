data: {"type":"tool-output-available","toolCallId":"chatcmpl-tool-a2378c1330cef2c6","output":{"output":"<repo>github.com/openmrs/openmrs-module-billing</repo>\n<path>api/src/main/java/org/openmrs/module/billing/api/impl/BillServiceImpl.java</path>\n<url>undefined</url>\n<content>\n36:  * @see BillDAO\n37:  */\n38: @Transactional\n39: public class BillServiceImpl extends BaseOpenmrsService implements BillService {\n40: \t\n41: \t@Setter(onMethod_ = { @Autowired })\n42: \tprivate BillDAO billDAO;\n43: \t\n44: \t/**\n45: \t * {@inheritDoc}\n46: \t */\n47: \t@Override\n48: \t@Transactional(readOnly = true)\n49: \tpublic Bill getBill(Integer id) {\n50: \t\tif (id == null) {\n51: \t\t\treturn null;\n52: \t\t}\n53: \t\treturn billDAO.getBill(id);\n54: \t}\n55: \t\n56: \t/**\n57: \t * {@inheritDoc}\n58: \t */\n59: \t@Override\n60: \t@Transactional(readOnly = true)\n61: \tpublic Bill getBillByUuid(String uuid) {\n62: \t\tif (uuid == null) {\n63: \t\t\treturn null;\n64: \t\t}\n65: \t\treturn billDAO.getBillByUuid(uuid);\n66: \t}\n67: \t\n68: \t/**\n69: \t * {@inheritDoc}\n70: \t */\n71: \t@Override\n72: \t@Transactional\n73: \tpublic Bill saveBill(Bill bill) {\n74: \t\tif (bill == null) {\n75: \t\t\tthrow new NullPointerException(\"The bill must be defined.\");\n76: \t\t}\n77: \t\treturn billDAO.saveBill(bill);\n78: \t}\n79: \t\n80: \t/**\n81: \t * {@inheritDoc}\n82: \t */\n83: \t@Override\n84: \t@Transactional(readOnly = true)\n85: \tpublic Bill getBillByReceiptNumber(String receiptNumber) {\n86: \t\tif (receiptNumber == null) {\n87: \t\t\treturn null;\n88: \t\t}\n89: \t\treturn billDAO.getBillByReceiptNumber(receiptNumber);\n90: \t}\n91: \t\n92: \t/**\n93: \t * {@inheritDoc}\n94: \t */\n95: \t@Override\n96: \t@Transactional(readOnly = true)\n97: \tpublic List<Bill> getBillsByPatientUuid(String patientUuid, PagingInfo pagingInfo) {\n98: \t\tif (StringUtils.isEmpty(patientUuid)) {\n99: \t\t\treturn Collections.emptyList();\n100: \t\t}\n101: \t\treturn billDAO.getBillsByPatientUuid(patientUuid, pagingInfo);\n102: \t}\n103: \t\n104: \t/**\n105: \t * {@inheritDoc}\n106: \t */\n107: \t@Override\n108: \t@Transactional(readOnly = true)\n109: \tpublic List<Bill> getBills(BillSearch billSearch, PagingInfo pagingInfo) {\n110: \t\tif (billSearch == null) {\n111: \t\t\treturn Collections.emptyList();\n112: \t\t}\n113: \t\treturn billDAO.getBills(billSearch, pagingInfo);\n114: \t}\n115: \t\n116: \t/**\n117: \t * {@inheritDoc}\n118: \t */\n119: \t@Override\n120: \t@Transactional(readOnly = true)\n121: \tpublic byte[] downloadBillReceipt(Bill bill) {\n122: \t\tif (bill == null) {\n123: \t\t\tthrow new NullPointerException(\"The bill must be defined.\");\n124: \t\t}\n125: \t\treturn ReceiptGenerator.createBillReceipt(bill);\n126: \t}\n127: \t\n128: \t/**\n129: \t * {@inheritDoc}\n130: \t */\n131: \t@Override\n132: \t@Transactional\n133: \tpublic void purgeBill(Bill bill) {\n134: \t\tif (bill == null) {\n135: \t\t\tthrow new NullPointerException(\"The bill must be defined.\");\n136: \t\t}\n137: \t\tbillDAO.purgeBill(bill);\n138: \t}\n139: \t\n140: \t/**\n141: \t * {@inheritDoc}\n142: \t */\n143: \t@Override\n144: \t@Transactional\n145: \tpublic Bill voidBill(Bill bill, String voidReason) {\n146: \t\tif (StringUtils.isBlank(voidReason)) {\n147: \t\t\tthrow new IllegalArgumentException(\"voidReason cannot be null or empty\");\n148: \t\t}\n149: \t\treturn billDAO.saveBill(bill);\n150: \t}\n151: \t\n152: \t/**\n153: \t * {@inheritDoc}\n154: \t */\n155: \t@Override\n156: \t@Transactional\n157: \tpublic Bill unvoidBill(Bill bill) {\n158: \t\treturn billDAO.saveBill(bill);\n159: \t}\n160: \t\n161: \t@Override\n162: \t@Transactional(readOnly = true)\n163: \tpublic boolean isBillEditable(Bill bill) {\n164: \t\tif (bill == null) {\n165: \t\t\tthrow new IllegalArgumentException(\"Bill cannot be null\");\n\n(Showing lines 36-165 of 175. Use offset=166 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-billing","path":"ap