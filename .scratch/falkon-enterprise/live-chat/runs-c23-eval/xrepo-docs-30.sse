data: {"type":"tool-output-available","toolCallId":"call-e59d6c45-ea0c-42c6-acfb-2ba81cfef5d3","output":{"output":"<repo>github.com/openmrs/openmrs-esm-core</repo>\n<path>packages/framework/esm-utils/src/dates/date-util.ts</path>\n<url>undefined</url>\n<content>\n120:     }\n121: \n122:     if (locale.region) {\n123:       const key = `${locale.language}-${locale.region}`;\n124:       if (this.#registry.has(key)) {\n125:         return this.#registry.get(key);\n126:       }\n127:     }\n128: \n129:     if (locale.language && this.#registry.has(locale.language)) {\n130:       return this.#registry.get(locale.language);\n131:     }\n132: \n133:     const defaultCalendar = new Intl.DateTimeFormat(locale.toString()).resolvedOptions().calendar as CalendarIdentifier;\n134: \n135:     // cache this result\n136:     this.#registry.set(`${locale.language}${locale.region ? `-${locale.region}` : ''}`, defaultCalendar);\n137: \n138:     return defaultCalendar;\n139:   }\n140: }\n141: \n142: const registeredLocaleCalendars = new LocaleCalendars();\n143: \n144: /**\n145:  * Provides the name of the calendar to associate, as a default, with the given base locale.\n146:  *\n147:  * @example\n148:  * ```\n149:  * registerDefaultCalendar('en', 'buddhist') // sets the default calendar for the 'en' locale to Buddhist.\n150:  * ```\n151:  *\n152:  * @param locale the locale to register this calendar for\n153:  * @param calendar the calendar to use for this registration\n154:  */\n155: export function registerDefaultCalendar(locale: string, calendar: CalendarIdentifier) {\n156:   registeredLocaleCalendars.register(locale, calendar);\n157: }\n158: \n159: /**\n160:  * Retrieves the default calendar for the specified locale if any.\n161:  *\n162:  * @param locale the locale to look-up\n163:  */\n164: export function getDefaultCalendar(locale: Intl.Locale | string | undefined) {\n165:   const locale_ = locale ?? getLocale();\n166: \n167:   return registeredLocaleCalendars.getCalendar(locale_ instanceof Intl.Locale ? locale_ : new Intl.Locale(locale_));\n168: }\n169: \n170: export type FormatDateMode = 'standard' | 'wide';\n171: \n172: export type FormatDateOptions = {\n173:   /**\n174:    * The calendar to use when formatting this date.\n175:    */\n176:   calendar?: string;\n177:   /**\n178:    * The locale to use when formatting this date\n179:    */\n180:   locale?: string;\n181:   /**\n182:    * - `standard`: \"03 Feb 2022\"\n183:    * - `wide`:     \"03 — Feb — 2022\"\n184:    */\n185:   mode: FormatDateMode;\n186:   /**\n187:    * Whether the time should be included in the output always (`true`),\n188:    * never (`false`), or only when the input date is today (`for today`).\n189:    */\n190:   time: true | false | 'for today';\n191:   /** Whether to include the day number */\n192:   day: boolean;\n193:   /** Whether to include the month number */\n194:   month: boolean;\n195:   /** Whether to include the year */\n196:   year: boolean;\n197:   /** The unicode numbering system to use */\n198:   numberingSystem?: string;\n199:   /**\n\n(Showing lines 120-199 of 725. Use offset=200 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-core","path":"packages/framework/esm-utils/src/dates/date-util.ts","name":"date-util.ts","revision":"HEAD"}]}}

