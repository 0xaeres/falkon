data: {"type":"data-source","data":{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/visit/visit-form/visit-form.workspace.tsx","name":"visit-form.workspace.tsx","revision":"HEAD"}}

data: {"type":"tool-output-available","toolCallId":"call-d27feb8e-7925-4c21-9690-eeff154dc030","output":{"output":"<repo>github.com/openmrs/openmrs-esm-patient-chart</repo>\n<path>packages/esm-patient-chart-app/src/visit/visit-form/visit-form.workspace.tsx</path>\n<url>undefined</url>\n<content>\n1: import React from 'react';\n2: import { useSWRConfig } from 'swr';\n3: import { useVisit, type Visit } from '@openmrs/esm-framework';\n4: import {\n5:   invalidateVisitByUuid,\n6:   type PatientWorkspace2DefinitionProps,\n7:   usePatientChartStore,\n8: } from '@openmrs/esm-patient-common-lib';\n9: import ExportedVisitForm from './exported-visit-form.workspace';\n10: \n11: export interface VisitFormProps {\n12:   /**\n13:    * A unique string identifying where the visit form is opened from.\n14:    * This string is passed into various extensions within the form to\n15:    * affect how / if they should be rendered.\n16:    */\n17:   openedFrom: string;\n18:   showPatientHeader?: boolean;\n19:   /**\n20:    * Called after the visit is saved and set as the patient chart's visit context.\n21:    */\n22:   onVisitStarted?: (visit: Visit) => void;\n23: }\n24: \n25: /**\n26:  * This form is used for starting a new visit and for editing\n27:  * an existing visit\n28:  *\n29:  * This workspace must only be used within the patient chart.\n30:  * @see exported-visit-form.workspace.tsx\n31:  */\n32: const VisitForm: React.FC<PatientWorkspace2DefinitionProps<VisitFormProps, {}>> = ({\n33:   workspaceProps: { openedFrom, showPatientHeader = false, onVisitStarted: onVisitStartedCallback },\n34:   groupProps: { patient, patientUuid, visitContext },\n35:   ...rest\n36: }) => {\n37:   const { mutate: mutateActiveVisit } = useVisit(patientUuid);\n38:   const { mutate: globalMutate } = useSWRConfig();\n39:   const { setVisitContext } = usePatientChartStore(patientUuid);\n40: \n41:   const onVisitStarted = (visit: Visit) => {\n42:     // For visit creation, we need to update:\n43:     // 1. Current visit data (for critical components like visit summary, action buttons)\n44:     // 2. Visit history table (for the paginated visit list)\n45:     const mutateSavedOrUpdatedVisit = () => invalidateVisitByUuid(globalMutate, visit.uuid);\n46:     mutateActiveVisit();\n47:     setVisitContext?.(visit, mutateSavedOrUpdatedVisit);\n48:     onVisitStartedCallback?.(visit);\n49:   };\n50:   return (\n51:     <ExportedVisitForm\n52:       {...rest}\n53:       workspaceProps={{\n54:         openedFrom,\n55:         showPatientHeader,\n56:         onVisitStarted,\n57:         patient,\n58:         patientUuid,\n59:         visitContext,\n60:       }}\n61:       groupProps={{}}\n62:     />\n63:   );\n64: };\n65: \n66: export default VisitForm;\n67: \n\n(End of file - 67 lines total)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-esm-patient-chart","path":"packages/esm-patient-chart-app/src/visit/visit-form/visit-form.workspace.tsx","name":"visit-form.workspace.tsx","revision":"HEAD"}]}}

