{
  "defaults": { "matches": 200, "contextLines": 1 },
  "queries": [
    { "id": "lit-basic", "query": "ParityNeedle" },
    { "id": "lit-common", "query": "func" },
    { "id": "lit-and", "query": "return error" },
    { "id": "lit-case-default", "query": "parityneedle" },
    { "id": "lit-case-sensitive", "query": "parityneedle", "isCaseSensitivityEnabled": true },
    { "id": "lit-case-upper", "query": "PARITYNEEDLE" },
    { "id": "lit-quoted", "query": "\"hello %s\"" },
    { "id": "lit-quoted-escape", "query": "\"foo\\\"bar\"" },
    { "id": "lit-dot", "query": "foo.bar" },
    { "id": "lit-plus", "query": "foo+bar" },
    { "id": "lit-pipe", "query": "a|b" },
    { "id": "lit-brackets", "query": "[class]" },
    { "id": "lit-call-parens", "query": "Greet()" },
    { "id": "lit-unbalanced-open", "query": "(pr" },
    { "id": "lit-unbalanced-close", "query": "test)" },
    { "id": "lit-unicode", "query": "wörld" },
    { "id": "lit-emoji", "query": "🎉 after" },
    { "id": "lit-cjk", "query": "日本語" },
    { "id": "lit-crlf", "query": "CRLF line" },
    { "id": "lit-tabs", "query": "with\ttabs" },
    { "id": "lit-longline", "query": "ParityNeedle yyyy" },
    { "id": "lit-minified", "query": "var a39999" },
    { "id": "lit-binary", "query": "binary" },
    { "id": "lit-oversized", "query": "big file line" },
    { "id": "lit-or-word-start", "query": "or test" },
    { "id": "lit-or-trailing", "query": "test or" },
    { "id": "lit-orange", "query": "orange" },
    { "id": "lit-dash-word", "query": "-foo:bar" },
    { "id": "lit-url", "query": "http://www" },
    { "id": "lit-many-matches", "query": "the", "matches": 50 },
    { "id": "lit-many-matches-big", "query": "e", "matches": 1000 },

    { "id": "op-or", "query": "ParityNeedle or BranchOnlyNeedle" },
    { "id": "op-or-three", "query": "fzf or ripgrep or gson" },
    { "id": "op-paren", "query": "(ParityNeedle or Greet) file:\\.go$" },
    { "id": "op-nested-paren", "query": "((ParityNeedle))" },
    { "id": "op-precedence", "query": "a b or c d" },
    { "id": "op-negate-group", "query": "ParityNeedle -(file:docs)" },
    { "id": "op-negate-file", "query": "ParityNeedle -file:\\.md$" },
    { "id": "op-negate-repo", "query": "TODO -repo:fzf" },
    { "id": "op-empty-paren", "query": "ParityNeedle ()" },

    { "id": "f-repo", "query": "repo:fzf func main" },
    { "id": "f-repo-short", "query": "r:gson JsonParser" },
    { "id": "f-repo-regex", "query": "repo:^github\\.com/(pallets|expressjs)/ require" },
    { "id": "f-repo-alt", "query": "repo:(click|express) license" },
    { "id": "f-file", "query": "file:\\.rs$ fn main" },
    { "id": "f-file-short", "query": "f:README ParityNeedle" },
    { "id": "f-file-only", "query": "file:Cargo.toml" },
    { "id": "f-file-alt", "query": "file:(test|spec) assert" },
    { "id": "f-file-name-only", "query": "file:parityneedle_name_only" },
    { "id": "f-file-quoted", "query": "file:\"deep/nested\"" },
    { "id": "f-content", "query": "content:ParityNeedle" },
    { "id": "f-content-short", "query": "c:README" },
    { "id": "f-lang-go", "query": "lang:go ParityNeedle" },
    { "id": "f-lang-python", "query": "lang:python def" },
    { "id": "f-lang-rust", "query": "lang:rust impl" },
    { "id": "f-lang-js", "query": "lang:javascript module.exports" },
    { "id": "f-lang-java", "query": "lang:java class" },
    { "id": "f-lang-markdown", "query": "lang:markdown ParityNeedle" },
    { "id": "f-lang-negate", "query": "ParityNeedle -lang:go" },
    { "id": "f-sym", "query": "sym:ParityNeedle" },
    { "id": "f-sym-func", "query": "sym:Greet" },
    { "id": "f-sym-repo", "query": "sym:main repo:fzf" },
    { "id": "f-rev-branch", "query": "BranchOnlyNeedle rev:feature/branch-only" },
    { "id": "f-rev-default-miss", "query": "BranchOnlyNeedle" },
    { "id": "f-rev-star", "query": "Needle rev:*" },
    { "id": "f-rev-tag", "query": "ParityNeedle rev:v1.0.0" },
    { "id": "f-rev-release", "query": "ReleaseNeedle rev:release/1.0" },
    { "id": "f-rev-head", "query": "MainOnlyNeedle rev:HEAD" },
    { "id": "f-archived", "query": "ParityNeedle archived:no" },
    { "id": "f-archived-only", "query": "ParityNeedle archived:only" },
    { "id": "f-fork-no", "query": "ParityNeedle fork:no" },
    { "id": "f-fork-only", "query": "ParityNeedle fork:only" },
    { "id": "f-visibility", "query": "ParityNeedle visibility:any" },
    { "id": "f-reposet", "query": "reposet:github.com/junegunn/fzf,github.com/google/gson main" },
    { "id": "f-context", "query": "context:nonexistent main" },
    { "id": "f-repo-only", "query": "repo:gson" },
    { "id": "f-combo", "query": "repo:ripgrep lang:rust file:src -file:test fn" },

    { "id": "re-alt", "query": "(Parity|Release)Needle", "isRegexEnabled": true },
    { "id": "re-class", "query": "a3999[0-9]=", "isRegexEnabled": true },
    { "id": "re-anchor", "query": "^package main$", "isRegexEnabled": true },
    { "id": "re-dot", "query": "foo.bar", "isRegexEnabled": true },
    { "id": "re-case", "query": "parityneedle", "isRegexEnabled": true, "isCaseSensitivityEnabled": true },
    { "id": "re-group-filters", "query": "(file:\\.go$ or file:\\.py$) Needle", "isRegexEnabled": true },
    { "id": "re-negate-group", "query": "Needle -(file:docs)", "isRegexEnabled": true },
    { "id": "re-word-boundary", "query": "\\bGreet\\b", "isRegexEnabled": true },
    { "id": "re-invalid", "query": "(unclosed", "isRegexEnabled": true },
    { "id": "re-multiline", "query": "func main\\(\\) \\{", "isRegexEnabled": true },

    { "id": "err-empty", "query": "" },
    { "id": "err-bad-archived", "query": "archived:maybe x" },
    { "id": "err-unclosed-quote", "query": "\"unclosed" },
    { "id": "err-only-negate", "query": "-file:foo" },

    { "id": "whole-file", "query": "ParityNeedle file:util\\.py", "whole": true },
    { "id": "ctx-0", "query": "ParityNeedle repo:edge", "contextLines": 0 },
    { "id": "ctx-5", "query": "Greet repo:edge", "contextLines": 5 }
  ]
}
