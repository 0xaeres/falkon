data: {"type":"tool-output-available","toolCallId":"call-5d958da6-3db7-410f-821e-f01852f01f89","output":{"output":"<repo>github.com/openmrs/openmrs-module-webservices.rest</repo>\n<path>omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_9/EncounterProviderResource1_9.java</path>\n<url>undefined</url>\n<content>\n120: \t\t\t        .property(\"encounter\", new RefProperty(\"#/definitions/EncounterCreate\"))\n121: \t\t\t        .property(\"encounterRole\", new RefProperty(\"#/definitions/EncounterroleCreate\"));\n122: \t\t}\n123: \t\treturn model;\n124: \t}\n125: \t\n126: \t@Override\n127: \tpublic Model getUPDATEModel(Representation rep) {\n128: \t\treturn new ModelImpl()\n129: \t\t        .property(\"encounterRole\", new StringProperty())\n130: \t\t        .property(\"voided\", new BooleanProperty())\n131: \t\t        .property(\"voidReason\", new StringProperty());\n132: \t}\n133: \t\n134: \t@Override\n135: \tpublic Encounter getParent(EncounterProvider instance) {\n136: \t\treturn instance.getEncounter();\n137: \t}\n138: \t\n139: \t@Override\n140: \tpublic void setParent(EncounterProvider instance, Encounter parent) {\n141: \t\tinstance.setEncounter(parent);\n142: \t}\n143: \t\n144: \t@Override\n145: \tpublic PageableResult doGetAll(Encounter parent, RequestContext context) throws ResponseException {\n146: \t\tList<EncounterProvider> encounterProviders = new ArrayList<EncounterProvider>(parent.getEncounterProviders());\n147: \t\tif (!context.getIncludeAll()) {\n148: \t\t\tfor (Iterator<EncounterProvider> i = encounterProviders.iterator(); i.hasNext();) {\n149: \t\t\t\tif (i.next().getVoided()) {\n150: \t\t\t\t\ti.remove();\n151: \t\t\t\t}\n152: \t\t\t}\n153: \t\t}\n154: \t\treturn new NeedsPaging<EncounterProvider>(encounterProviders, context);\n155: \t}\n156: \t\n157: \t@Override\n158: \tpublic EncounterProvider getByUniqueId(String uniqueId) {\n159: \t\treturn Context.getService(RestHelperService.class).getObjectByUuid(EncounterProvider.class, uniqueId);\n160: \t}\n161: \t\n162: \t@Override\n163: \tprotected void delete(EncounterProvider delegate, String reason, RequestContext context) throws ResponseException {\n164: \t\t// workaround for removing providers until TRUNK-5017 is fixed\n165: \t\tfor (EncounterProvider encounterProvider : delegate.getEncounter().getEncounterProviders()) {\n166: \t\t\tif (encounterProvider.getEncounterRole().equals(delegate.getEncounterRole())\n167: \t\t\t        && encounterProvider.getProvider().equals(delegate.getProvider()) && !encounterProvider.isVoided()) {\n168: \t\t\t\tencounterProvider.setVoided(true);\n169: \t\t\t\tencounterProvider.setDateVoided(new Date());\n170: \t\t\t\tencounterProvider.setVoidedBy(Context.getAuthenticatedUser());\n171: \t\t\t}\n172: \t\t}\n173: \t\t\n174: \t\tContext.getEncounterService().saveEncounter(delegate.getEncounter());\n175: \t}\n176: \t\n177: \t@Override\n178: \tpublic EncounterProvider newDelegate() {\n179: \t\treturn new EncounterProvider();\n180: \t}\n181: \t\n182: \t@Override\n183: \tpublic EncounterProvider save(EncounterProvider delegate) {\n184: \t\t\n185: \t\tdelegate.getEncounter().addProvider(delegate.getEncounterRole(), delegate.getProvider());\n186: \t\tContext.getEncounterService().saveEncounter(delegate.getEncounter());\n187: \t\t\n188: \t\t// bit of a hack, but since addProvider does not return the provider added, we need to fetch it\n189: \t\t// so that the returned delegate has the proper persisted uuid\n190: \t\t// see: https://issues.openmrs.org/browse/RESTWS-638\n191: \t\tfor (EncounterProvider encounterProvider : delegate.getEncounter().getEncounterProviders()) {\n192: \t\t\tif (encounterProvider.getEncounterRole().equals(delegate.getEncounterRole())\n193: \t\t\t        && encounterProvider.getProvider().equals(delegate.getProvider()) && !encounterProvider.isVoided()) {\n194: \t\t\t\treturn encounterProvider;\n195: \t\t\t}\n196: \t\t}\n197: \t\t\n198: \t\t// should never get here, hopefully!\n199: \t\tthrow new APIException(\"Encounter Provider not properly saved\");\n200: \t}\n201: \t\n202: \t@Override\n203: \tpublic void purge(EncounterProvider delegate, RequestContext context) throws ResponseException {\n204: \t\tthrow new ResourceDoesNotSupportOperationException();\n205: \t}\n206: \t\n207: \t/**\n208: \t * Display string for EncounterProvider\n209: \t * \n210: \t * @param encounterProvider\n211: \t * @return String uuid\n212: \t */\n213: \t@PropertyGetter(\"display\")\n214: \tpublic String getDisplayString(EncounterProvider encounterProvider) {\n215: \t\tif (encounterProvider == null) {\n216: \t\t\treturn \"\";\n217: \t\t}\n218: \t\t\n219: \t\tProvider provider = encounterProvider.getProvider();\n\n(Showing lines 120-219 of 237. Use offset=220 to continue.)\n</content>","sources":[{"type":"file","repo":"github.com/openmrs/openmrs-module-webservices.rest","path":"omod/src/main/java/org/openmrs/module/webservices/rest/web/v1_0/resource/openmrs1_9/EncounterProviderResource1_9.java","name":"EncounterProviderResource1_9.java","revision":"HEAD"}]}}

